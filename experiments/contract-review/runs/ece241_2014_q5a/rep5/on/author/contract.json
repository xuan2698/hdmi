            "x": 0
          }
        ],
        "expected": [
          {
            "z": 0
          },
          {
            "z": 1
          },
          {
            "z": 1
          }
        ]
      }
    },
    {
      "id": "B_on_x1",
      "outputs": [
        "z"
      ],
      "condition": "areset=0, current state B, and x=1 at posedge; after the edge state becomes C and z=0.",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 13,
      "spec_quote": "2's complement of the input",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 1,
            "x": 0
          },
          {
            "areset": 0,
            "x": 1
