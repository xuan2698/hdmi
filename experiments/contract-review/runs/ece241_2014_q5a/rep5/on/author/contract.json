      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 15,
      "spec_quote": "2's complement of the input",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 1,
            "x": 0
          },
          {
            "areset": 0,
            "x": 1
          },
          {
            "areset": 0,
