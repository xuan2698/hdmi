          {
            "z": 0
          }
        ]
      }
    },
    {
      "id": "C_on_x0",
      "outputs": [
        "z"
      ],
      "condition": "areset=0, current state C, and x=0 at posedge; after the edge state becomes B and z=1.",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 14,
      "spec_quote": "2's complement of the input",
      "uncertain": false,
      "example": {
        "vectors": [
