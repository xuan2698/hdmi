{
  "ports": {
    "inputs": {
      "areset": 1,
      "x": 1
    },
    "outputs": {
      "z": 1
    },
    "clock": "clk"
  },
  "states": [
    {
      "name": "A",
      "meaning": "Reset/no-first-1 state: no input 1 has occurred since reset in the processed lower bits; Moore output z=0.",
      "update_time": "Asynchronously to A when areset=1; on posedge clk when areset=0 according to the transition rules.",
      "update_during_reset": true
    },
    {
      "name": "B",
      "meaning": "A first 1 has occurred and the current converted Moore output bit is 1; z=1.",
      "update_time": "posedge clk when areset=0 according to the transition rules.",
      "update_during_reset": false
    },
    {
      "name": "C",
      "meaning": "A first 1 has occurred and the current converted Moore output bit is 0; z=0.",
      "update_time": "posedge clk when areset=0 according to the transition rules.",
      "update_during_reset": false
    }
  ],
  "rules": [
    {
      "id": "async_reset_assert",
      "outputs": [
        "z"
      ],
      "condition": "areset=1; asynchronous reset is active and forces state A with z=0. The reset output value is inferred.",
      "edge": "asynchronous",
      "visible": "same_cycle",
      "priority": 0,
      "spec_quote": "stops when Reset is asserted",
      "uncertain": true,
      "example": {
        "vectors": [
          {
            "areset": 1,
            "x": 0
          },
          {
            "areset": 1,
            "x": 1
          },
          {
            "areset": 1,
            "x": 0
          }
        ],
        "expected": [
          {
            "z": 0
          },
          {
            "z": 0
          },
          {
            "z": 0
          }
        ]
      }
    },
    {
      "id": "A_on_x0",
      "outputs": [
        "z"
      ],
      "condition": "areset=0, current state A, and x=0 at posedge; after the edge state remains A and z=0.",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 10,
      "spec_quote": "2's complement of the input",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 1,
            "x": 0
          },
          {
            "areset": 0,
            "x": 0
          }
        ],
        "expected": [
          {
            "z": 0
          },
          {
            "z": 0
          }
        ]
      }
    },
    {
      "id": "A_on_x1",
      "outputs": [
        "z"
      ],
      "condition": "areset=0, current state A, and x=1 at posedge; after the edge state becomes B and z=1.",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 11,
      "spec_quote": "2's complement of the input",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 1,
            "x": 0
          },
          {
            "areset": 0,
            "x": 1
          }
        ],
        "expected": [
          {
            "z": 0
          },
          {
            "z": 1
          }
        ]
      }
    },
    {
      "id": "B_on_x0",
      "outputs": [
        "z"
      ],
      "condition": "areset=0, current state B, and x=0 at posedge; after the edge state remains B and z=1.",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 12,
      "spec_quote": "2's complement of the input",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 1,
            "x": 0
          },
          {
