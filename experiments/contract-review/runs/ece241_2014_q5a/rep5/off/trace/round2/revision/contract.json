{
  "ports": {
    "inputs": {
      "areset": 1,
      "x": 1
    },
    "outputs": {
      "z": 1
    },
    "clock": "clk"
  },
  "states": [
    {
      "name": "S0",
      "meaning": "No 1-bit has been seen yet in the input stream (all bits so far are 0); output equals input bit.",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "S1",
      "meaning": "At least one 1-bit has been seen; now complementing subsequent bits.",
      "update_time": "posedge",
      "update_during_reset": false
    }
  ],
  "rules": [
    {
      "id": "R1",
      "outputs": [
        "z"
      ],
      "condition": "In state S0, z = x (pass through the bit unchanged).",
      "edge": "combinational",
      "visible": "same_cycle",
      "priority": 1,
      "spec_quote": "the output (Z) is the 2's complement of the input",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "x": 1
          },
          {
            "areset": 0,
            "x": 0
          },
          {
            "areset": 0,
            "x": 1
          }
        ],
        "expected": [
          {
            "z": 1
          },
          {
            "z": 0
          },
          {
            "z": 1
          }
        ]
      }
    },
    {
      "id": "R2",
      "outputs": [
        "z"
      ],
      "condition": "In state S1, z = NOT x (complement the bit).",
      "edge": "combinational",
      "visible": "same_cycle",
      "priority": 1,
      "spec_quote": "the output (Z) is the 2's complement of the input",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "x": 1
          },
          {
            "areset": 0,
            "x": 0
          },
          {
            "areset": 0,
            "x": 1
          }
        ],
        "expected": [
          {
            "z": 0
          },
          {
            "z": 1
          },
          {
            "z": 0
          }
        ]
      }
    },
    {
      "id": "R3",
      "outputs": [
        "z"
      ],
      "condition": "On posedge, if x=1 then next state is S1 (first 1 seen); if x=0 state stays S0.",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 2,
      "spec_quote": "beginning with the least-significant bit of the number",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "x": 0
          },
          {
            "areset": 0,
            "x": 1
          },
          {
            "areset": 0,
            "x": 0
          }
        ],
        "expected": [
          {
            "z": 0
          },
          {
            "z": 0
          },
          {
            "z": 1
          }
        ]
      }
    },
    {
      "id": "R4",
      "outputs": [
        "z"
      ],
      "condition": "On posedge, once in S1, state remains S1 regardless of x.",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 2,
      "spec_quote": "accept input numbers of arbitrary length",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "x": 1
          },
          {
            "areset": 0,
            "x": 0
          },
          {
            "areset": 0,
            "x": 0
          }
        ],
        "expected": [
          {
            "z": 0
          },
          {
            "z": 1
          },
          {
            "z": 1
          }
        ]
      }
    },
    {
      "id": "R5",
      "outputs": [
        "z"
      ],
      "condition": "Asynchronous reset asserted (areset=1) forces state to S0 immediately, independent of clk, and forces z=0 (conversion stopped); when areset=0, z follows R1/R2 from the current state.",
      "edge": "asynchronous",
      "visible": "same_cycle",
      "priority": 0,
      "spec_quote": "positive edge triggered asynchronous reset",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 1,
            "x": 1
          },
          {
            "areset": 1,
            "x": 0
          },
          {
            "areset": 0,
            "x": 0
          }
        ],
        "expected": [
          {
            "z": 0
          },
          {
            "z": 0
          },
          {
            "z": 0
          }
        ]
      }
    }
  ],
  "reset": {
    "kind": "async",
    "name": "areset",
    "active": "high",
    "values": {},
    "first_released_cycle": "first posedge after areset deasserts"
  },
  "mid": "Optional mid-cycle input changes occur after sampling and are carried to the start of the next row.",
  "uncertain": []
}
