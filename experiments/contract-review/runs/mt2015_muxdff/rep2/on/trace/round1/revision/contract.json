{
  "ports": {
    "inputs": {
      "L": 1,
      "q_in": 1,
      "r_in": 1
    },
    "outputs": {
      "Q": 1
    },
    "clock": "clk"
  },
  "states": [
    {
      "name": "Q_reg",
      "meaning": "Registered state for the hierarchical design: top_module instantiates the flipflop plus 2-1 multiplexer submodule three times for the public 3-bit q[2:0]. The fixed 1-bit contract port Q represents the q[2] slice, so L=0 holds Q; q_in is not used for feedback.",
      "update_time": "posedge clk",
      "update_during_reset": false
    }
  ],
  "rules": [
    {
      "id": "load_L_high",
      "outputs": [
        "Q"
      ],
      "condition": "At posedge clk, if L == 1 then Q_next = r_in",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 1,
      "spec_quote": "q <= r;",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "L": 1,
            "q_in": 0,
            "r_in": 0
          },
          {
            "L": 1,
            "q_in": 1,
            "r_in": 1
          },
          {
            "L": 1,
            "q_in": 0,
            "r_in": 1
          }
        ],
        "expected": [
          {
            "Q": 0
          },
          {
            "Q": 1
          },
          {
            "Q": 1
          }
        ]
      }
    },
    {
      "id": "feedback_L_low",
      "outputs": [
        "Q"
      ],
      "condition": "At posedge clk, if L == 0 then the registered q_next is q_next = {q[1]^q[2], q[0], q[2]}; for the exposed q[2] slice, Q_next = Q (hold). q_in is not used as the L-low data source.",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 2,
      "spec_quote": "q <= {q[1] ^ q[2], q[0], q[2]};",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "L": 1,
            "q_in": 0,
            "r_in": 0
          },
          {
            "L": 0,
            "q_in": 1,
            "r_in": 0
          },
          {
            "L": 0,
            "q_in": 0,
            "r_in": 1
          }
        ],
        "expected": [
          {
            "Q": 0
          },
          {
            "Q": 0
          },
          {
            "Q": 0
          }
        ]
      }
    }
  ],
  "reset": {
    "kind": "none",
    "name": null,
    "active": "none",
    "values": {
      "Q": null
    },
    "first_released_cycle": "N/A"
  },
  "mid": "No mid-cycle changes are used in these examples; if present, changes after the posedge sample are carried to the start of the next row.",
  "uncertain": []
}
