{
  "ports": {
    "inputs": {
      "d": 1,
      "r": 1
    },
    "outputs": {
      "q": 1
    },
    "clock": "clk"
  },
  "states": [
    {
      "name": "q",
      "meaning": "Registered output; at each posedge, q becomes 0 when r is high, otherwise q becomes d.",
      "update_time": "posedge clk after sampling settles",
      "update_during_reset": true
    }
  ],
  "rules": [
    {
      "id": "sync_active_high_reset",
      "outputs": [
        "q"
      ],
      "condition": "r == 1",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 2,
      "spec_quote": "active high synchronous reset (reset output to 0)",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "d": 0,
            "r": 1
          },
          {
            "d": 1,
            "r": 1,
            "mid": {
              "d": 0
            }
          },
          {
            "d": 0,
            "r": 1
          }
        ],
        "expected": [
          {
            "q": 0
          },
          {
            "q": 0
          },
          {
            "q": 0
          }
        ]
      }
    },
    {
      "id": "d_update_when_not_reset",
      "outputs": [
        "q"
      ],
      "condition": "r == 0",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 1,
      "spec_quote": "simple D flip flop",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "d": 1,
            "r": 0
          },
          {
            "d": 0,
            "r": 0
          },
          {
            "d": 1,
            "r": 0,
            "mid": {
              "d": 0
            }
          },
          {
            "d": 0,
            "r": 0
          }
        ],
        "expected": [
          {
            "q": 1
          },
          {
            "q": 0
          },
          {
            "q": 1
          },
          {
            "q": 0
          }
        ]
      }
    }
  ],
  "reset": {
    "kind": "sync",
    "name": "r",
    "active": "high",
    "values": {
      "q": 0
    },
    "first_released_cycle": "first posedge with r==0; on that edge reset is inactive and d may update q"
  },
  "mid": "Optional mid changes are applied after the current row's posedge sampling and before the next sampled posedge, then carried as starting inputs for the next row.",
  "uncertain": [
    {
      "rule_id": "global",
      "note": "Public specification does not specify the active clock edge; contract currently assumes posedge clk.",
      "candidates": [
        "posedge clk",
        "negedge clk"
      ]
    }
  ],
  "remaining_uncertain_fields": {
    "global": [
      "posedge clk",
      "negedge clk"
    ]
  },
  "selected_interpretations": []
}
