{
  "ports": {
    "inputs": {
      "d": 1,
      "r": 1
    },
    "outputs": {
      "q": 1
    },
    "clock": "clk"
  },
  "states": [
    {
      "name": "Q",
      "meaning": "Stored flip-flop value, driven to q; initial value before any posedge clk is unspecified",
      "update_time": "posedge clk",
      "update_during_reset": true
    }
  ],
  "rules": [
    {
      "id": "R1",
      "outputs": [
        "q"
      ],
      "condition": "r == 1",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 1,
      "spec_quote": "active high synchronous reset (reset output to 0)",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "d": 1,
            "r": 1
          },
          {
            "d": 0,
            "r": 1
          },
          {
            "d": 1,
            "r": 0
          }
        ],
        "expected": [
          {
            "q": 0
          },
          {
            "q": 0
          },
          {
            "q": 1
          }
        ]
      }
    },
    {
      "id": "R2",
      "outputs": [
        "q"
      ],
      "condition": "r == 0",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 2,
      "spec_quote": "Implement a simple D flip flop",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "d": 0,
            "r": 0
          },
          {
            "d": 1,
            "r": 0
          },
          {
            "d": 0,
            "r": 0
          }
        ],
        "expected": [
          {
            "q": 0
          },
          {
            "q": 1
          },
          {
            "q": 0
          }
        ]
      }
    }
  ],
  "reset": {
    "kind": "sync",
    "name": "r",
    "active": "high",
    "values": {
      "q": 0
    },
    "first_released_cycle": "first posedge clk with r == 0"
  },
  "mid": "Optional mid input changes occur AFTER sampling, before the other edge, and are carried to the start of the next row.",
  "uncertain": [
    {
      "rule_id": "global",
      "note": "Initial state of Q before any posedge clk is unspecified; affects first-cycle output.",
      "candidates": [
        "Q initializes to 0 at time 0",
        "Q initializes to 1 at time 0",
        "Q initial value is unspecified"
      ]
    }
  ]
