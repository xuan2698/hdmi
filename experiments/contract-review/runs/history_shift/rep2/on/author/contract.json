{
  "ports": {
    "inputs": {
      "areset": 1,
      "predict_valid": 1,
      "predict_taken": 1,
      "train_mispredicted": 1,
      "train_taken": 1,
      "train_history": 32
    },
    "outputs": {
      "predict_history": 32
    },
    "clock": "clk"
  },
  "states": [
    {
      "name": "history_register",
      "meaning": "32-bit global branch history shift register. predict_history[0] is the direction of the youngest branch; higher indices are older history bits. It retains its value when no reset or update condition applies.",
      "update_time": "Asynchronously set to zero while areset is asserted; otherwise updated at posedge clk when train_mispredicted=1 or predict_valid=1, with train_mispredicted having priority over prediction.",
      "update_during_reset": true
    }
  ],
  "rules": [
    {
      "id": "async_reset",
      "outputs": [
        "predict_history"
      ],
      "condition": "areset == 1; predict_history <- 0 asynchronously",
      "edge": "asynchronous",
      "visible": "same_cycle",
      "priority": 30,
      "spec_quote": "areset is a positive edge triggered asynchronous reset that resets the history counter to zero",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 1,
            "predict_valid": 0,
            "predict_taken": 0,
            "train_mispredicted": 0,
            "train_taken": 0,
            "train_history": 4294967295
          },
          {
            "areset": 0,
            "predict_valid": 0,
            "predict_taken": 0,
            "train_mispredicted": 0,
            "train_taken": 0,
            "train_history": 0
          }
        ],
        "expected": [
          {
            "predict_history": 0
          },
          {
            "predict_history": 0
          }
        ]
      }
    },
    {
      "id": "train_mispredicted_rollback",
      "outputs": [
        "predict_history"
      ],
      "condition": "areset == 0 && train_mispredicted == 1; predict_history <- ((train_history << 1) & 0xffffffff) | train_taken",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 20,
      "spec_quote": "This is the history before the mispredicted branch (train_history) concatenated with the actual result of the branch (train_taken)",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 1,
            "predict_valid": 0,
            "predict_taken": 0,
            "train_mispredicted": 0,
            "train_taken": 0,
            "train_history": 0
          },
          {
            "areset": 0,
            "predict_valid": 1,
            "predict_taken": 0,
            "train_mispredicted": 1,
            "train_taken": 1,
            "train_history": 305419896
          },
          {
            "areset": 0,
            "predict_valid": 0,
            "predict_taken": 0,
            "train_mispredicted": 0,
            "train_taken": 0,
            "train_history": 0
          }
        ],
        "expected": [
          {
            "predict_history": 0
          },
          {
            "predict_history": 610839793
          },
          {
            "predict_history": 610839793
          }
        ]
      }
    },
    {
      "id": "predict_shift",
      "outputs": [
        "predict_history"
      ],
      "condition": "areset == 0 && train_mispredicted == 0 && predict_valid == 1; predict_history <- ((predict_history << 1) & 0xffffffff) | predict_taken",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 10,
      "spec_quote": "shift in predict_taken from the LSB side to update the branch history for the predicted branch",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 1,
            "predict_valid": 0,
            "predict_taken": 0,
            "train_mispredicted": 0,
            "train_taken": 0,
            "train_history": 0
          },
          {
            "areset": 0,
            "predict_valid": 1,
            "predict_taken": 1,
            "train_mispredicted": 0,
            "train_taken": 0,
            "train_history": 0
          },
          {
            "areset": 0,
            "predict_valid": 1,
            "predict_taken": 0,
            "train_mispredicted": 0,
            "train_taken": 0,
            "train_history": 0
          }
        ],
        "expected": [
          {
            "predict_history": 0
          },
          {
            "predict_history": 1
          },
          {
            "predict_history": 2
          }
        ]
      }
    }
  ],
  "reset": {
    "kind": "async",
    "name": "areset",
    "active": "high",
    "values": {
      "predict_history": 0
    },
    "first_released_cycle": "after areset deasserts and before the next posedge clk"
  },
  "mid": "Inputs may change after a sampled edge; carried changes affect only the next row. An asynchronous areset assertion can asynchronously force predict_history to zero.",
  "uncertain": []
}
