            "predict_history": 0
          },
          {
            "predict_history": 0
          }
        ]
      }
    },
    {
      "id": "R2_mispredict_priority",
      "outputs": [
        "predict_history"
      ],
      "condition": "areset == 0 && train_mispredicted == 1",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 2,
      "spec_quote": "If both a prediction and misprediction occur at the same time, the misprediction takes precedence",
      "uncertain": true,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "predict_valid": 1,
            "predict_taken": 1,
            "train_mispredicted": 1,
