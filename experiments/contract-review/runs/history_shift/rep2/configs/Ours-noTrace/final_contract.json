  "rules": [
    {
      "id": "R1_async_reset",
      "outputs": [
        "predict_history"
      ],
      "condition": "areset == 1",
      "edge": "asynchronous",
      "visible": "same_cycle",
      "priority": 1,
      "spec_quote": "areset is a positive edge triggered asynchronous reset that resets the history counter to zero",
      "uncertain": true,
      "example": {
        "vectors": [
          {
            "areset": 1,
            "predict_valid": 0,
