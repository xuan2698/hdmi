            "predict_valid": 0,
            "predict_taken": 0,
            "train_mispredicted": 0,
            "train_taken": 0,
            "train_history": 0
          }
        ],
        "expected": [
          {
            "predict_history": 1
          },
          {
            "predict_history": 2
          },
          {
            "predict_history": 2
          }
        ]
      }
    },
