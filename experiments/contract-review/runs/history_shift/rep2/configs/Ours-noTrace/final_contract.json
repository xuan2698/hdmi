            "areset": 0,
            "predict_valid": 0,
            "predict_taken": 0,
            "train_mispredicted": 0,
            "train_taken": 0,
            "train_history": 0
          }
        ],
        "expected": [
          {
            "predict_history": 3435973836
          },
          {
            "predict_history": 3435973836
          }
        ]
      }
    },
    {
      "id": "R3_predict_shift",
      "outputs": [
        "predict_history"
      ],
      "condition": "areset == 0 && train_mispredicted == 0 && predict_valid == 1",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 3,
      "spec_quote": "shift in predict_taken from the LSB side to update the branch history for the predicted branch",
      "uncertain": true,
