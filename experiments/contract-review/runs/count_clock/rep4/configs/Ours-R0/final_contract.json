{
  "ports": {
    "inputs": {
      "reset": 1,
      "ena": 1
    },
    "outputs": {
      "pm": 1,
      "hh": 8,
      "mm": 8,
      "ss": 8
    },
    "clock": "clk"
  },
  "states": [
    {
      "name": "ss_lo",
      "meaning": "seconds ones BCD digit 0-9",
      "update_time": "posedge clk when ena and not reset",
      "update_during_reset": true
    },
    {
      "name": "ss_hi",
      "meaning": "seconds tens BCD digit 0-5",
      "update_time": "posedge clk when ena and not reset",
      "update_during_reset": true
    },
    {
      "name": "mm_lo",
      "meaning": "minutes ones BCD digit 0-9",
      "update_time": "posedge clk when ena and not reset",
      "update_during_reset": true
    },
    {
      "name": "mm_hi",
      "meaning": "minutes tens BCD digit 0-5",
      "update_time": "posedge clk when ena and not reset",
      "update_during_reset": true
    },
    {
      "name": "hh_lo",
      "meaning": "hours ones BCD digit 1-9,0",
      "update_time": "posedge clk when ena and not reset",
      "update_during_reset": true
    },
    {
      "name": "hh_hi",
      "meaning": "hours tens BCD digit 0-1",
      "update_time": "posedge clk when ena and not reset",
      "update_during_reset": true
    },
    {
      "name": "pm_reg",
      "meaning": "AM/PM indicator, 0=AM 1=PM",
      "update_time": "posedge clk when ena and not reset",
      "update_during_reset": true
    }
  ],
  "rules": [
    {
      "id": "R1_reset",
      "outputs": [
        "pm",
        "hh",
        "mm",
        "ss"
      ],
      "condition": "reset == 1",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 1,
      "spec_quote": "Reset is the active high synchronous signal that resets the clock to \"12:00 AM.\"",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "reset": 1,
            "ena": 0
          },
          {
            "reset": 0,
            "ena": 0
          },
          {
            "reset": 0,
            "ena": 1
          }
        ],
        "expected": [
          {
            "pm": 0,
            "hh": 18,
            "mm": 0,
            "ss": 0
          },
          {
            "pm": 0,
            "hh": 18,
            "mm": 0,
            "ss": 0
          },
          {
            "pm": 0,
            "hh": 18,
            "mm": 0,
            "ss": 0
          }
        ]
      }
    },
    {
      "id": "R2_hold",
      "outputs": [
        "pm",
        "hh",
        "mm",
        "ss"
      ],
      "condition": "reset == 0 && ena == 0",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 2,
      "spec_quote": "with a pulse on ena whenever your clock should increment",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "reset": 0,
            "ena": 0
          },
          {
            "reset": 0,
            "ena": 0
          },
          {
            "reset": 0,
            "ena": 1
          }
        ],
        "expected": [
          {
            "pm": 0,
            "hh": 18,
            "mm": 0,
            "ss": 0
          },
          {
            "pm": 0,
            "hh": 18,
            "mm": 0,
            "ss": 0
          },
          {
            "pm": 0,
            "hh": 18,
            "mm": 0,
            "ss": 1
          }
        ]
      }
    },
    {
      "id": "R3_seconds",
      "outputs": [
        "ss"
      ],
      "condition": "reset == 0 && ena == 1 && ss != 8'h59",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 3,
      "spec_quote": "ss are two BCD (Binary-Coded Decimal) digits each for hours (01-12), minutes (00-59), and seconds (00-59)",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "reset": 0,
            "ena": 1
          },
          {
            "reset": 0,
            "ena": 1
          },
          {
            "reset": 0,
            "ena": 1
          }
        ],
        "expected": [
          {
            "pm": 0,
            "hh": 18,
            "mm": 0,
            "ss": 1
          },
          {
            "pm": 0,
            "hh": 18,
            "mm": 0,
            "ss": 2
          },
          {
            "pm": 0,
            "hh": 18,
            "mm": 0,
            "ss": 3
          }
        ]
      }
    },
    {
      "id": "R4_seconds_roll",
      "outputs": [
        "ss",
        "mm"
      ],
      "condition": "reset == 0 && ena == 1 && ss == 8'h59 && mm != 8'h59",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 3,
      "spec_quote": "minutes (00-59), and seconds (00-59)",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "reset": 0,
            "ena": 1
          },
          {
            "reset": 0,
            "ena": 1
          },
          {
            "reset": 0,
            "ena": 0
          }
        ],
        "expected": [
          {
            "pm": 0,
            "hh": 18,
            "mm": 1,
            "ss": 0
          },
          {
            "pm": 0,
            "hh": 18,
            "mm": 1,
            "ss": 1
          },
          {
            "pm": 0,
            "hh": 18,
            "mm": 1,
            "ss": 1
          }
        ]
      }
    },
    {
      "id": "R5_minutes_roll",
      "outputs": [
        "ss",
        "mm",
        "hh"
      ],
      "condition": "reset == 0 && ena == 1 && ss == 8'h59 && mm == 8'h59 && hh != 8'h12",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 3,
      "spec_quote": "hours (01-12)",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "reset": 0,
            "ena": 1
          },
          {
            "reset": 0,
            "ena": 1
          },
          {
            "reset": 0,
            "ena": 0
          }
        ],
        "expected": [
          {
            "pm": 0,
            "hh": 19,
            "mm": 0,
            "ss": 0
          },
          {
            "pm": 0,
            "hh": 19,
            "mm": 0,
            "ss": 1
          },
          {
            "pm": 0,
            "hh": 19,
            "mm": 0,
            "ss": 1
          }
        ]
      }
    },
    {
      "id": "R6_hour_roll_am_pm",
      "outputs": [
        "ss",
        "mm",
        "hh",
        "pm"
      ],
      "condition": "reset == 0 && ena == 1 && ss == 8'h59 && mm == 8'h59 && hh == 8'h12",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 3,
      "spec_quote": "The signal \"pm\" is asserted if the clock is PM, or is otherwise AM",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "reset": 0,
            "ena": 1
          },
          {
            "reset": 0,
            "ena": 1
          },
          {
            "reset": 0,
            "ena": 0
          }
        ],
        "expected": [
          {
            "pm": 1,
            "hh": 1,
            "mm": 0,
            "ss": 0
          },
          {
            "pm": 1,
            "hh": 1,
            "mm": 0,
            "ss": 1
          },
          {
            "pm": 1,
            "hh": 1,
            "mm": 0,
            "ss": 1
          }
        ]
      }
    },
    {
      "id": "R7_hour_roll_12",
      "outputs": [
        "ss",
        "mm",
        "hh",
        "pm"
      ],
      "condition": "reset == 0 && ena == 1 && ss == 8'h59 && mm == 8'h59 && hh == 8'h11",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 3,
      "spec_quote": "hours (01-12)",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "reset": 0,
            "ena": 1
          },
          {
            "reset": 0,
            "ena": 1
          },
          {
            "reset": 0,
            "ena": 0
          }
        ],
        "expected": [
          {
            "pm": 0,
            "hh": 18,
            "mm": 0,
            "ss": 0
          },
          {
            "pm": 0,
            "hh": 18,
            "mm": 0,
            "ss": 1
          },
          {
            "pm": 0,
            "hh": 18,
            "mm": 0,
            "ss": 1
          }
        ]
      }
    }
  ],
  "reset": {
    "kind": "sync",
    "name": "reset",
    "active": "high",
    "values": {
      "pm": 0,
      "hh": 18,
      "mm": 0,
      "ss": 0
    },
    "first_released_cycle": "cycle after reset deasserted at posedge"
  },
  "mid": "Optional mid input changes occur AFTER sampling, before the other edge, and are carried to the start of the next row.",
  "uncertain": [],
  "remaining_uncertain_fields": {},
  "selected_interpretations": []
}
