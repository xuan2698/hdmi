{
  "ports": {
    "inputs": {
      "d": 8,
      "reset": 1
    },
    "outputs": {
      "q": 8
    },
    "clock": "clk"
  },
  "states": [
    {
      "name": "q_state",
      "meaning": "The 8-bit registered output q, updated on the positive edge of clk; when reset is high at the edge, q becomes 0.",
      "update_time": "posedge clk",
      "update_during_reset": true
    }
  ],
  "rules": [
    {
      "id": "R1",
      "outputs": [
        "q"
      ],
      "condition": "reset == 1",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 1,
      "spec_quote": "active high synchronous reset setting the output to zero",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "d": 7,
            "reset": 1
          },
          {
            "d": 42,
            "reset": 1
          },
          {
            "d": 200,
            "reset": 1
          }
        ],
        "expected": [
          {
            "q": 0
          },
          {
            "q": 0
          },
          {
            "q": 0
          }
        ]
      }
    },
    {
      "id": "R2",
      "outputs": [
        "q"
      ],
      "condition": "reset == 0",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 2,
      "spec_quote": "Create 8 D flip-flops",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "d": 5,
            "reset": 0
          },
          {
            "d": 9,
            "reset": 0
          },
          {
            "d": 255,
            "reset": 0
          }
        ],
        "expected": [
          {
            "q": 0
          },
          {
            "q": 5
          },
          {
            "q": 9
          }
        ]
      }
    }
  ],
  "reset": {
    "kind": "sync",
    "name": "reset",
    "active": "high",
    "values": {
      "q": 0
    },
    "first_released_cycle": "first posedge clk with reset == 0"
  },
  "mid": "Optional mid input changes occur AFTER sampling, before the other edge, and are carried to the start of the next row.",
  "uncertain": []
}
