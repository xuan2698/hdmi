      "outputs": [
        "q"
      ],
      "condition": "reset == 1",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 2,
      "spec_quote": "active high synchronous reset setting the output to zero",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "d": 255,
            "reset": 1
          },
          {
            "d": 1,
            "reset": 1
          },
          {
            "d": 128,
            "reset": 1
          }
        ],
        "expected": [
          {
            "q": 0
          },
          {
            "q": 0
          },
          {
            "q": 0
          }
        ]
      }
    },
    {
      "id": "dff_capture_d",
      "outputs": [
        "q"
      ],
      "condition": "reset == 0",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 1,
      "spec_quote": "Create 8 D flip-flops",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "d": 17,
            "reset": 0
