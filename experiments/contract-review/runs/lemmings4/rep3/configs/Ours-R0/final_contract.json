{
  "ports": {
    "inputs": {
      "areset": 1,
      "bump_left": 1,
      "bump_right": 1,
      "ground": 1,
      "dig": 1
    },
    "outputs": {
      "walk_left": 1,
      "walk_right": 1,
      "aaah": 1,
      "digging": 1
    },
    "clock": "clk"
  },
  "states": [
    {
      "name": "WALK_LEFT",
      "meaning": "walking left on ground",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "WALK_RIGHT",
      "meaning": "walking right on ground",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "FALL_LEFT",
      "meaning": "falling, will resume walking left",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "FALL_RIGHT",
      "meaning": "falling, will resume walking right",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "DIG_LEFT",
      "meaning": "digging while facing left",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "DIG_RIGHT",
      "meaning": "digging while facing right",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "SPLAT",
      "meaning": "splattered, all outputs 0 forever",
      "update_time": "posedge",
      "update_during_reset": false
    }
  ],
  "rules": [
    {
      "id": "R1_reset",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "areset=1 (async, positive edge triggered)",
      "edge": "asynchronous",
      "visible": "same_cycle",
      "priority": 0,
      "spec_quote": "areset is positive edge triggered asynchronous reseting the Lemming machine to walk left",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 1,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R2_walk_outputs",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state is WALK_LEFT or WALK_RIGHT",
      "edge": "combinational",
      "visible": "same_cycle",
      "priority": 1,
      "spec_quote": "Lemmings can be in one of two states: walking left (walk_left is 1) or walking right (walk_right is 1)",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 1,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 1,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 1,
            "aaah": 0,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R3_fall_outputs",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state is FALL_LEFT or FALL_RIGHT",
      "edge": "combinational",
      "visible": "same_cycle",
      "priority": 1,
      "spec_quote": "when ground=0, the Lemming will fall and say \"\"aaah!\"\"",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 0,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 0,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 1,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 1,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R4_dig_outputs",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state is DIG_LEFT or DIG_RIGHT",
      "edge": "combinational",
      "visible": "same_cycle",
      "priority": 1,
      "spec_quote": "Lemmings can sometimes be told to do useful things, like dig (it starts digging when dig=1)",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 1
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 1
          }
        ],
        "expected": [
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 1
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 1
          }
        ]
      }
    },
    {
      "id": "R5_splat_outputs",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state is SPLAT",
      "edge": "combinational",
      "visible": "same_cycle",
      "priority": 1,
      "spec_quote": "it will splatter and cease walking, falling, or digging (all 4 outputs become 0), forever",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 0,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 1,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R6_walk_transition",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "in WALK_LEFT/WALK_RIGHT, ground=1: if dig=1 -> DIG (same dir); else if bump_left=1 or bump_right=1 -> switch direction; else keep direction",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 2,
      "spec_quote": "If it's bumped on the left (by receiving a 1 on bump_left), it will walk right",
      "uncertain": true,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 1,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 1,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 1,
            "aaah": 0,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R7_walk_to_fall",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "in WALK_LEFT/WALK_RIGHT and ground=0 -> FALL (same direction)",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 3,
      "spec_quote": "when ground=0, the Lemming will fall",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 0,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 0,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 1,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 1,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R8_fall_transition",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "in FALL_*: if ground=1 and fall_count<=20 -> WALK (same dir); if ground=1 and fall_count>20 -> SPLAT; else stay FALL",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 2,
      "spec_quote": "if a Lemming falls for more than 20 clock cycles then hits the ground, it will splatter",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 0,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 1,
            "digging": 0
          },
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R9_dig_transition",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "in DIG_*: if ground=0 -> FALL (same dir); else stay DIG",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 2,
      "spec_quote": "will continue digging until it reaches the other side (ground=0)",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 1
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 0,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 0,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 1
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 1,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 1,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R10_splat_stay",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "in SPLAT -> stay SPLAT",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 2,
      "spec_quote": "forever (Or until the FSM gets reset)",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 1,
            "bump_right": 1,
            "ground": 1,
            "dig": 1
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          }
        ]
      }
    }
  ],
  "reset": {
    "kind": "async",
    "name": "areset",
    "active": "high",
    "values": {
