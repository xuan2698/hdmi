{
  "ports": {
    "inputs": {
      "areset": 1,
      "bump_left": 1,
      "bump_right": 1,
      "ground": 1,
      "dig": 1
    },
    "outputs": {
      "walk_left": 1,
      "walk_right": 1,
      "aaah": 1,
      "digging": 1
    },
    "clock": "clk"
  },
  "states": [
    {
      "name": "WALK_LEFT",
      "meaning": "walking left on ground",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "WALK_RIGHT",
      "meaning": "walking right on ground",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "FALL_LEFT",
      "meaning": "falling, remembered direction left",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "FALL_RIGHT",
      "meaning": "falling, remembered direction right",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "DIG_LEFT",
      "meaning": "digging, remembered direction left",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "DIG_RIGHT",
      "meaning": "digging, remembered direction right",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "SPLAT",
      "meaning": "splattered, all outputs zero forever",
      "update_time": "posedge",
      "update_during_reset": false
    }
  ],
  "rules": [
    {
      "id": "R1",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "posedge of areset asynchronously forces WALK_LEFT (edge-triggered async reset)",
      "edge": "asynchronous",
      "visible": "same_cycle",
      "priority": 0,
      "spec_quote": "areset is positive edge triggered asynchronous reseting the Lemming machine to walk left",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 1,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R2",
