{
  "ports": {
    "inputs": {
      "areset": 1,
      "bump_left": 1,
      "bump_right": 1,
      "ground": 1,
      "dig": 1
    },
    "outputs": {
      "walk_left": 1,
      "walk_right": 1,
      "aaah": 1,
      "digging": 1
    },
    "clock": "clk"
  },
  "states": [
    {
      "name": "WALK_LEFT",
      "meaning": "walking left on ground",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "WALK_RIGHT",
      "meaning": "walking right on ground",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "FALL_LEFT",
      "meaning": "falling, remembered direction left",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "FALL_RIGHT",
      "meaning": "falling, remembered direction right",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "DIG_LEFT",
      "meaning": "digging, remembered direction left",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "DIG_RIGHT",
      "meaning": "digging, remembered direction right",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "SPLAT",
      "meaning": "splattered, all outputs zero forever",
      "update_time": "posedge",
      "update_during_reset": false
    }
  ],
  "rules": [
    {
      "id": "R1_reset",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "areset=1 (asynchronous positive-edge reset)",
      "edge": "asynchronous",
      "visible": "same_cycle",
      "priority": 0,
      "spec_quote": "areset is positive edge triggered asynchronous reseting the Lemming machine to walk left",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 1,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R2_walk_outputs",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state is WALK_LEFT or WALK_RIGHT",
      "edge": "combinational",
      "visible": "same_cycle",
      "priority": 1,
      "spec_quote": "Lemmings can be in one of two states: walking left (walk_left is 1) or walking right (walk_right is 1)",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 1,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 1,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 1,
            "aaah": 0,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R3_fall_outputs",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state is FALL_LEFT or FALL_RIGHT",
      "edge": "combinational",
      "visible": "same_cycle",
      "priority": 1,
      "spec_quote": "when ground=0, the Lemming will fall and say \"\"aaah!\"\"",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 0,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 0,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 1,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 1,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R4_dig_outputs",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state is DIG_LEFT or DIG_RIGHT",
      "edge": "combinational",
      "visible": "same_cycle",
      "priority": 1,
      "spec_quote": "Lemmings can sometimes be told to do useful things, like dig (it starts digging when dig=1)",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 1
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 1
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 1
          }
        ]
      }
    },
    {
      "id": "R5_splat_outputs",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state is SPLAT",
      "edge": "combinational",
      "visible": "same_cycle",
      "priority": 1,
      "spec_quote": "it will splatter and cease walking, falling, or digging (all 4 outputs become 0), forever",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 0,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 1,
            "bump_right": 1,
            "ground": 1,
            "dig": 1
          }
        ],
        "expected": [
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 1,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R6_walk_bump_switch",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state WALK_LEFT/WALK_RIGHT, ground=1, dig=0, bump_left or bump_right (or both) = 1 -> switch direction",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 3,
      "spec_quote": "if a Lemming is bumped on the left (by receiving a 1 on bump_left), it will walk right",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 1,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 1,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 1,
            "aaah": 0,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R7_walk_bump_both_switch",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state WALK_LEFT/WALK_RIGHT, ground=1, dig=0, bump_left=1 and bump_right=1 -> switch direction",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 3,
      "spec_quote": "If it's bumped on both sides at the same time, it will still switch directions",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 1,
            "bump_right": 1,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 1,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 1,
            "aaah": 0,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R8_walk_start_dig",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state WALK_LEFT/WALK_RIGHT, ground=1, dig=1 -> enter DIG state (dig precedence over bump)",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 2,
      "spec_quote": "A Lemming can dig if it is currently walking on ground (ground=1 and not falling)",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 1,
            "bump_right": 0,
            "ground": 1,
            "dig": 1
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 1
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 1
          }
        ]
      }
    },
    {
      "id": "R9_walk_fall",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state WALK_LEFT/WALK_RIGHT, ground=0 -> enter FALL (fall precedence over dig and bump)",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 1,
      "spec_quote": "when ground=0, the Lemming will fall and say \"\"aaah!\"\"",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 1,
            "bump_right": 1,
            "ground": 0,
            "dig": 1
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 0,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 1,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 1,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R10_fall_land",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state FALL_LEFT/FALL_RIGHT, ground=1, fall counter <= 20 -> resume walking in remembered direction",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 1,
      "spec_quote": "When the ground reappears (ground=1), the Lemming will resume walking in the same direction as before the fall",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 0,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 1,
            "bump_right": 1,
            "ground": 1,
            "dig": 1
          }
