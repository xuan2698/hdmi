        "expected": [
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 1,
            "digging": 0
          },
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R11_fall_splat",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state FALL_LEFT/FALL_RIGHT, ground=1, fall counter > 20 -> enter SPLAT",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 1,
      "spec_quote": "if a Lemming falls for more than 20 clock cycles then hits the ground, it will splatter",
      "uncertain": false,
      "example": {
        "vectors": [
          {
