{
  "ports": {
    "inputs": {
      "areset": 1,
      "bump_left": 1,
      "bump_right": 1,
      "ground": 1,
      "dig": 1
    },
    "outputs": {
      "walk_left": 1,
      "walk_right": 1,
      "aaah": 1,
      "digging": 1
    },
    "clock": "clk"
  },
  "states": [
    {
      "name": "WALK_LEFT",
      "meaning": "walking left on ground",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "WALK_RIGHT",
      "meaning": "walking right on ground",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "FALL_LEFT",
      "meaning": "falling, will resume walking left",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "FALL_RIGHT",
      "meaning": "falling, will resume walking right",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "DIG_LEFT",
      "meaning": "digging while facing left",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "DIG_RIGHT",
      "meaning": "digging while facing right",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "SPLAT",
      "meaning": "splattered, all outputs zero forever",
      "update_time": "posedge",
      "update_during_reset": false
    }
  ],
  "rules": [
    {
      "id": "R_RESET",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "areset=1 (asynchronous, positive edge triggered)",
      "edge": "asynchronous",
      "visible": "same_cycle",
      "priority": 0,
      "spec_quote": "areset is positive edge triggered asynchronous reseting the Lemming machine to walk left",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 1,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R_WALK_LEFT",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state=WALK_LEFT and ground=1 and dig=0 and not splatting",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 5,
      "spec_quote": "Lemmings can be in one of two states: walking left (walk_left is 1) or walking right (walk_right is 1)",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R_WALK_RIGHT",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state=WALK_RIGHT and ground=1 and dig=0 and not splatting",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 5,
      "spec_quote": "walking right (walk_right is 1)",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 1,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 1,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 1,
            "aaah": 0,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R_BUMP_SWITCH",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state in {WALK_LEFT, WALK_RIGHT} and ground=1 and dig=0 and (bump_left or bump_right)",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 4,
      "spec_quote": "if a Lemming is bumped on the left (by receiving a 1 on bump_left), it will walk right",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 1,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 1,
            "ground": 1,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 1,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R_FALL_START",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state in {WALK_LEFT, WALK_RIGHT} and ground=0",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 3,
      "spec_quote": "when ground=0, the Lemming will fall and say \"\"aaah!\"\"",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 0,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 0,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 1,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 1,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R_FALL_CONTINUE",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state in {FALL_LEFT, FALL_RIGHT} and ground=0",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 3,
      "spec_quote": "Being bumped while falling does not affect the walking direction",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 0,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 1,
            "bump_right": 1,
            "ground": 0,
            "dig": 1
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 0,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 1,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 1,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 1,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R_FALL_LAND",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state in {FALL_LEFT, FALL_RIGHT} and ground=1 and fall_count<=20",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 3,
      "spec_quote": "When the ground reappears (ground=1), the Lemming will resume walking in the same direction as before the fall",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 0,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 1,
            "digging": 0
          },
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R_SPLAT",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state in {FALL_LEFT, FALL_RIGHT} and ground=1 and fall_count>20",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 2,
      "spec_quote": "if a Lemming falls for more than 20 clock cycles then hits the ground, it will splatter",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 0,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 1,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R_SPLAT_HOLD",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state=SPLAT",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 1,
      "spec_quote": "it will splatter and cease walking, falling, or digging (all 4 outputs become 0), forever",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 1,
            "bump_right": 1,
            "ground": 1,
            "dig": 1
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          }
        ]
      }
    },
    {
      "id": "R_DIG_START",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state in {WALK_LEFT, WALK_RIGHT} and ground=1 and dig=1",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 4,
      "spec_quote": "it starts digging when dig=1",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 1
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 1
          }
        ],
        "expected": [
          {
            "walk_left": 1,
            "walk_right": 0,
            "aaah": 0,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 1
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 1
          }
        ]
      }
    },
    {
      "id": "R_DIG_CONTINUE",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state in {DIG_LEFT, DIG_RIGHT} and ground=1",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 4,
      "spec_quote": "will continue digging until it reaches the other side (ground=0)",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 1
          },
          {
            "areset": 0,
            "bump_left": 1,
            "bump_right": 1,
            "ground": 1,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 1
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 1
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 1
          }
        ]
      }
    },
    {
      "id": "R_DIG_TO_FALL",
      "outputs": [
        "walk_left",
        "walk_right",
        "aaah",
        "digging"
      ],
      "condition": "state in {DIG_LEFT, DIG_RIGHT} and ground=0",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 3,
      "spec_quote": "At that point, since there is no ground, it will fall (aaah!)",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 1,
            "dig": 1
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 0,
            "dig": 0
          },
          {
            "areset": 0,
            "bump_left": 0,
            "bump_right": 0,
            "ground": 0,
            "dig": 0
          }
        ],
        "expected": [
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 0,
            "digging": 1
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 1,
            "digging": 0
          },
          {
            "walk_left": 0,
            "walk_right": 0,
            "aaah": 1,
            "digging": 0
          }
        ]
      }
    }
  ],
  "reset": {
    "kind": "async",
    "name": "areset",
    "active": "high",
    "values": {
      "walk_left": 1,
      "walk_right": 0,
      "aaah": 0,
      "digging": 0
    },
    "first_released_cycle": "first posedge clk after areset deasserts"
  },
  "mid": "Optional mid input changes occur AFTER sampling, before the other edge, and are carried to the start of the next row.",
  "uncertain": []
}
