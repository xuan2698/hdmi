              {
                "q": 4
              },
              {
                "q": 4
              }
            ]
          }
        },
        {
          "id": "increment_when_a_low",
          "outputs": [
            "q"
          ],
          "condition": "a == 0 and not (previous cycle a == 1 and q == 4)",
          "edge": "posedge",
          "visible": "next_cycle",
          "priority": 2,
          "spec_quote": "55ns            1               0               5",
          "uncertain": false,
          "example": {
            "vectors": [
              {
                "a": 0
              },
              {
                "a": 0
              },
              {
                "a": 0
              }
            ],
            "expected": [
              {
                "q": 5
              },
              {
                "q": 6
              },
              {
                "q": 0
              }
            ]
          }
        }
      ],
      "reset": {
        "kind": "none",
        "name": null,
        "active": "none",
        "values": {
          "q": null
        },
        "first_released_cycle": "0ns"
      },
      "mid": "none",
      "uncertain": [
        {
          "rule_id": "global",
          "note": "q is x before the first posedge; at 5ns with a=1 q becomes 4. Contract has no reset, so initial q is unspecified.",
          "candidates": [
            "q initializes to 4 at the first posedge regardless of a, then holds when a=1 and increments when a=0",
            "q is x until first posedge; first posedge with a=1 sets q=4 (initialization), subsequent a=1 holds",
            "q initializes to 4 at time 0, so a=1 at first posedge holds 4"
