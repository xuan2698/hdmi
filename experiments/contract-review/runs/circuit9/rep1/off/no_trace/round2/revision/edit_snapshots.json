        },
        "clock": "clk"
      },
      "states": [
        {
          "name": "count",
          "meaning": "3-bit counter value stored in q; increments by 1 on each posedge when a=0, holds when a=1",
          "update_time": "posedge",
          "update_during_reset": false
        }
      ],
      "rules": [
        {
          "id": "hold_when_a_high",
          "outputs": [
            "q"
          ],
          "condition": "a == 1",
          "edge": "posedge",
          "visible": "next_cycle",
          "priority": 1,
          "spec_quote": "// 15ns            1               1               4",
