{
  "ports": {
    "inputs": {
      "a": 1
    },
    "outputs": {
      "q": 3
    },
    "clock": "clk"
  },
  "states": [
    {
      "name": "count",
      "meaning": "3-bit counter value stored in q; q is x before first posedge (no physical reset); first posedge with a=1 loads 4; holds when a=1; on a=0 posedge, the first such edge after a=1 holds at 4, subsequent a=0 posedges increment by 1 (wrapping mod 8)",
      "update_time": "posedge",
      "update_during_reset": false
    }
  ],
  "rules": [
    {
      "id": "hold_when_a_high",
      "outputs": [
        "q"
      ],
      "condition": "a == 1",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 1,
      "spec_quote": "// 5ns             1               1               4",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "a": 1
          },
          {
            "a": 1
          },
          {
            "a": 1
          }
        ],
        "expected": [
          {
            "q": 4
          },
          {
            "q": 4
          },
          {
            "q": 4
          }
        ]
      }
    },
    {
      "id": "increment_when_a_low",
      "outputs": [
        "q"
      ],
      "condition": "a == 0 and not (previous a == 1)",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 1,
      "spec_quote": "// 55ns            1               0               5",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "a": 0
          },
          {
            "a": 0
          },
          {
            "a": 0
          }
        ],
        "expected": [
          {
            "q": 4
          },
          {
            "q": 5
          },
          {
            "q": 6
          }
        ]
      }
    },
    {
      "id": "first_low_after_high_holds",
      "outputs": [
        "q"
      ],
      "condition": "a == 0 and previous a == 1",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 2,
      "spec_quote": "// 45ns            1               0               4",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "a": 1
          },
          {
            "a": 0
          },
          {
            "a": 0
          }
        ],
        "expected": [
          {
            "q": 4
          },
          {
            "q": 4
          },
          {
            "q": 5
          }
        ]
      }
    }
  ],
  "reset": {
    "kind": "none",
    "name": null,
    "active": "none",
    "values": {
      "q": null
    },
    "first_released_cycle": "0ns"
  },
  "mid": "Optional mid input changes occur AFTER sampling, before the other edge, and are carried to the start of the next row.",
  "uncertain": []
}
