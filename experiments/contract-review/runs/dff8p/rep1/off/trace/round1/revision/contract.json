      "uncertain": true,
      "example": {
        "vectors": [
          {
            "d": 0,
            "reset": 1
          },
          {
            "d": 255,
            "reset": 1
          },
          {
            "d": 0,
            "reset": 0
          }
        ],
        "expected": [
          {
            "q": 52
          },
          {
            "q": 52
          },
          {
            "q": 0
          }
        ]
      }
    },
    {
      "id": "R2",
      "outputs": [
        "q"
      ],
      "condition": "reset == 0",
      "edge": "negedge",
      "visible": "same_cycle",
      "priority": 2,
      "spec_quote": "All DFFs should be triggered by the negative edge of clk.",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "d": 18,
            "reset": 0
          },
          {
            "d": 200,
            "reset": 0
          },
          {
            "d": 7,
            "reset": 0
          }
        ],
        "expected": [
          {
            "q": 18
          },
          {
            "q": 200
          },
          {
            "q": 7
          }
        ]
      }
    }
  ],
  "reset": {
    "kind": "sync",
    "name": "reset",
