{
  "ports": {
    "inputs": {
      "d": 8,
      "reset": 1
    },
    "outputs": {
      "q": 8
    },
    "clock": "clk"
  },
  "states": [
    {
      "name": "q",
      "meaning": "8-bit D flip-flop output state",
      "update_time": "negedge of clk",
      "update_during_reset": true
    }
  ],
  "rules": [
    {
      "id": "sync_reset_high",
      "outputs": [
        "q"
      ],
      "condition": "clk negedge sampled with reset == 1",
      "edge": "negedge",
      "visible": "same_cycle",
      "priority": 2,
      "spec_quote": "active high synchronous reset. The flip-flops must be reset to 0x34",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "d": 0,
            "reset": 1
          },
          {
            "d": 255,
            "reset": 1
          }
        ],
        "expected": [
          {
            "q": 52
          },
          {
            "q": 52
          }
        ]
      }
    },
    {
      "id": "d_load_no_reset",
      "outputs": [
        "q"
      ],
      "condition": "clk negedge sampled with reset == 0",
      "edge": "negedge",
      "visible": "same_cycle",
      "priority": 1,
      "spec_quote": "Create 8 D flip-flops",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "d": 170,
            "reset": 0
          },
          {
            "d": 85,
            "reset": 0
          }
        ],
        "expected": [
          {
            "q": 170
          },
          {
            "q": 85
          }
        ]
      }
    }
  ],
  "reset": {
    "kind": "sync",
    "name": "reset",
    "active": "high",
    "values": {
      "q": 52
    },
    "first_released_cycle": "the first negedge after reset becomes 0, when q may load d"
  },
  "mid": "mid input changes occur after sampling, before the other edge, and are carried to the start of the next row",
  "uncertain": []
}
