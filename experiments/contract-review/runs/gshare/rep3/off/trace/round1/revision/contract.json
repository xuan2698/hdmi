          },
          {
            "predict_taken": 0,
            "predict_history": 0
          },
          {
            "predict_taken": 0,
            "predict_history": 0
          }
        ]
      }
    }
  ],
  "reset": {
    "kind": "async",
    "name": "areset",
    "active": "high",
    "values": {
      "predict_taken": 0,
      "predict_history": 0
    },
    "first_released_cycle": "cycle after areset deasserts"
  },
  "mid": "Optional mid input changes occur AFTER sampling, before the other edge, and are carried to the start of the next row.",
  "uncertain": [
    {
      "rule_id": "R6_predict_sees_pre_train_pht",
      "note": "Spec does not state whether predict_history reflects GHR before or after same-cycle training GHR recovery when both occur.",
      "candidates": [
        "predict_history reflects pre-train GHR",
        "predict_history reflects post-train GHR after same-cycle recovery"
      ]
    }
  ]
