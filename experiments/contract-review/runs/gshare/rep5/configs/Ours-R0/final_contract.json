    "outputs": {
      "predict_taken": 1,
      "predict_history": 7
    },
    "clock": "clk"
  },
  "states": [
    {
      "name": "pht",
      "meaning": "128-entry pattern history table of 2-bit saturating counters, indexed by xor of 7-bit pc and 7-bit global history",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "ghr",
      "meaning": "7-bit global branch history register",
      "update_time": "posedge",
      "update_during_reset": false
    }
  ],
  "rules": [
    {
      "id": "R1_predict_outputs",
      "outputs": [
        "predict_taken",
        "predict_history"
      ],
      "condition": "predict_valid == 1",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 1,
      "spec_quote": "When a branch prediction is requested (predict_valid = 1) for a given pc, the branch predictor produces the predicted branch direction and state of the branch history register used to make the prediction.",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "predict_valid": 1,
            "predict_pc": 5,
            "train_valid": 0,
            "train_taken": 0,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
