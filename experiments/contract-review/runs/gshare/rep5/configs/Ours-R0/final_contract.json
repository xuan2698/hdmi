{
  "ports": {
    "inputs": {
      "areset": 1,
      "predict_valid": 1,
      "predict_pc": 7,
      "train_valid": 1,
      "train_taken": 1,
      "train_mispredicted": 1,
      "train_history": 7,
      "train_pc": 7
