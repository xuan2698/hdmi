{
  "ports": {
    "inputs": {
      "areset": 1,
      "predict_valid": 1,
      "predict_pc": 7,
      "train_valid": 1,
      "train_taken": 1,
      "train_mispredicted": 1,
      "train_history": 7,
      "train_pc": 7
    },
    "outputs": {
      "predict_taken": 1,
      "predict_history": 7
    },
    "clock": "clk"
  },
  "states": [
    {
      "name": "pht",
      "meaning": "128-entry pattern history table of 2-bit saturating counters, indexed by (pc[6:0] xor history[6:0])",
      "update_time": "posedge",
      "update_during_reset": false
    },
    {
      "name": "ghr",
      "meaning": "7-bit global branch history register",
      "update_time": "posedge",
      "update_during_reset": false
    }
  ],
  "rules": [
    {
      "id": "R1_predict_outputs",
      "outputs": [
        "predict_taken",
        "predict_history"
      ],
      "condition": "predict_valid == 1 (combinational read of PHT and GHR before any edge update)",
      "edge": "combinational",
      "visible": "same_cycle",
      "priority": 1,
      "spec_quote": "When a branch prediction is requested (predict_valid = 1) for a given pc, the branch predictor produces the predicted branch direction and state of the branch history register used to make the prediction.",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "predict_valid": 1,
            "predict_pc": 5,
            "train_valid": 0,
            "train_taken": 0,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
          },
          {
            "areset": 0,
            "predict_valid": 1,
            "predict_pc": 5,
            "train_valid": 0,
            "train_taken": 0,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
          },
          {
            "areset": 0,
            "predict_valid": 0,
            "predict_pc": 0,
            "train_valid": 0,
            "train_taken": 0,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
          }
        ],
        "expected": [
          {
            "predict_taken": 0,
            "predict_history": 0
          },
          {
            "predict_taken": 0,
            "predict_history": 0
          },
          {
            "predict_taken": 0,
            "predict_history": 0
          }
        ]
      }
    },
    {
      "id": "R2_predict_ghr_update",
      "outputs": [
        "predict_history"
      ],
      "condition": "predict_valid == 1 and train_valid == 0: GHR updated at posedge for the predicted branch (shift-in direction/value not specified by spec)",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 3,
      "spec_quote": "The branch history register is then updated (at the next positive clock edge) for the predicted branch.",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "predict_valid": 1,
            "predict_pc": 3,
            "train_valid": 0,
            "train_taken": 0,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
          },
          {
            "areset": 0,
            "predict_valid": 0,
            "predict_pc": 0,
            "train_valid": 0,
            "train_taken": 0,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
          },
          {
            "areset": 0,
            "predict_valid": 0,
            "predict_pc": 0,
            "train_valid": 0,
            "train_taken": 0,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
          }
        ],
        "expected": [
          {
            "predict_taken": 0,
            "predict_history": 0
          },
          {
            "predict_taken": 0,
            "predict_history": 0
          },
          {
            "predict_taken": 0,
            "predict_history": 0
          }
        ]
      }
    },
    {
      "id": "R3_train_pht_update",
      "outputs": [
        "predict_taken"
      ],
      "condition": "train_valid == 1: PHT entry at (train_pc xor train_history) updated at posedge toward train_taken (2-bit saturating counter per public spec)",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 2,
      "spec_quote": "Update the pattern history table (PHT) to train the branch predictor to predict this branch more accurately next time.",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "predict_valid": 0,
            "predict_pc": 0,
            "train_valid": 1,
            "train_taken": 1,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
          },
          {
            "areset": 0,
            "predict_valid": 1,
            "predict_pc": 0,
            "train_valid": 0,
            "train_taken": 0,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
          },
          {
            "areset": 0,
            "predict_valid": 0,
            "predict_pc": 0,
            "train_valid": 0,
            "train_taken": 0,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
          }
        ],
        "expected": [
          {
            "predict_taken": 0,
            "predict_history": 0
          },
          {
            "predict_taken": 0,
            "predict_history": 0
          },
          {
            "predict_taken": 0,
            "predict_history": 0
          }
        ]
      }
    },
    {
      "id": "R4_train_mispredict_ghr_recover",
      "outputs": [
        "predict_history"
      ],
      "condition": "train_valid == 1 and train_mispredicted == 1: GHR restored at posedge to state immediately after the mispredicting branch (train_history with train_taken appended per spec intent); takes precedence over prediction GHR update",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 1,
      "spec_quote": "if the branch being trained is mispredicted, also recover the branch history register to the state immediately after the mispredicting branch completes execution.",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "predict_valid": 0,
            "predict_pc": 0,
            "train_valid": 1,
            "train_taken": 1,
            "train_mispredicted": 1,
            "train_history": 2,
            "train_pc": 4
          },
          {
            "areset": 0,
            "predict_valid": 0,
            "predict_pc": 0,
            "train_valid": 0,
            "train_taken": 0,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
          },
          {
            "areset": 0,
            "predict_valid": 0,
            "predict_pc": 0,
            "train_valid": 0,
            "train_taken": 0,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
          }
        ],
        "expected": [
          {
            "predict_taken": 0,
            "predict_history": 0
          },
          {
            "predict_taken": 0,
            "predict_history": 0
          },
          {
            "predict_taken": 0,
            "predict_history": 0
          }
        ]
      }
    },
    {
      "id": "R5_train_precedence_over_predict",
      "outputs": [
        "predict_history"
      ],
      "condition": "train_valid == 1 and train_mispredicted == 1 and predict_valid == 1 in same cycle: training GHR recovery wins over prediction GHR shift",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 1,
      "spec_quote": "When this happens, training takes precedence, because the branch being predicted will be discarded anyway.",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "predict_valid": 1,
