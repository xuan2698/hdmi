            "predict_pc": 0,
            "train_valid": 0,
            "train_taken": 0,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
          }
        ],
        "expected": [
          {
            "predict_taken": 0,
            "predict_history": 0
          },
          {
            "predict_taken": 0,
            "predict_history": 0
          },
          {
            "predict_taken": 0,
            "predict_history": 0
          }
        ]
      }
    },
