{
  "ports": {
    "inputs": {
      "areset": 1,
      "predict_valid": 1,
      "predict_pc": 7,
      "train_valid": 1,
      "train_taken": 1,
      "train_mispredicted": 1,
      "train_history": 7,
      "train_pc": 7
    },
    "outputs": {
      "predict_taken": 1,
      "predict_history": 7
    },
    "clock": "clk"
  },
  "states": [
    {
      "name": "ghr",
      "meaning": "7-bit global branch history register; shifted left on each predicted branch, with the predicted direction inserted at the LSB",
      "update_time": "posedge",
      "update_during_reset": true
    },
    {
      "name": "pht",
      "meaning": "128-entry table of 2-bit saturating counters indexed by (pc[6:0] XOR ghr[6:0])",
      "update_time": "posedge",
      "update_during_reset": true
    }
  ],
  "rules": [
    {
      "id": "R1_reset",
      "outputs": [
        "predict_taken",
        "predict_history"
      ],
      "condition": "areset == 1",
      "edge": "asynchronous",
      "visible": "same_cycle",
      "priority": 0,
      "spec_quote": "Reset is asynchronous active-high.",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 1,
            "predict_valid": 0,
            "predict_pc": 0,
            "train_valid": 0,
            "train_taken": 0,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
          },
          {
            "areset": 0,
            "predict_valid": 0,
            "predict_pc": 0,
            "train_valid": 0,
            "train_taken": 0,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
          }
        ],
        "expected": [
          {
            "predict_taken": 0,
            "predict_history": 0
          },
          {
            "predict_taken": 0,
            "predict_history": 0
          }
        ]
      }
    },
    {
      "id": "R2_predict",
      "outputs": [
        "predict_taken",
        "predict_history"
      ],
      "condition": "predict_valid == 1 && areset == 0",
      "edge": "combinational",
      "visible": "same_cycle",
      "priority": 2,
      "spec_quote": "the branch predictor produces the predicted branch direction and state of the branch history register used to make the prediction",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "predict_valid": 1,
            "predict_pc": 5,
            "train_valid": 0,
            "train_taken": 0,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
          },
          {
            "areset": 0,
            "predict_valid": 1,
            "predict_pc": 5,
            "train_valid": 0,
            "train_taken": 0,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
          }
        ],
        "expected": [
          {
            "predict_taken": 0,
            "predict_history": 0
          },
          {
            "predict_taken": 0,
            "predict_history": 0
          }
        ]
      }
    },
    {
      "id": "R3_predict_no_valid",
      "outputs": [
        "predict_taken",
        "predict_history"
      ],
      "condition": "predict_valid == 0 && areset == 0",
      "edge": "combinational",
      "visible": "same_cycle",
      "priority": 3,
      "spec_quote": "When a branch prediction is requested (predict_valid = 1)",
      "uncertain": true,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "predict_valid": 0,
            "predict_pc": 5,
            "train_valid": 0,
            "train_taken": 0,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
          },
          {
            "areset": 0,
            "predict_valid": 0,
            "predict_pc": 5,
            "train_valid": 0,
            "train_taken": 0,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
          }
        ],
        "expected": [
          {
            "predict_taken": 0,
            "predict_history": 0
          },
          {
            "predict_taken": 0,
            "predict_history": 0
          }
        ]
      }
    },
    {
      "id": "R4_ghr_update_predict",
      "outputs": [
        "predict_taken",
        "predict_history"
      ],
      "condition": "predict_valid == 1 && train_valid == 0 && areset == 0",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 4,
      "spec_quote": "The branch history register is then updated (at the next positive clock edge) for the predicted branch.",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "predict_valid": 1,
            "predict_pc": 5,
            "train_valid": 0,
            "train_taken": 0,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
          },
          {
            "areset": 0,
            "predict_valid": 1,
            "predict_pc": 5,
            "train_valid": 0,
            "train_taken": 0,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
          }
        ],
        "expected": [
          {
            "predict_taken": 0,
            "predict_history": 0
          },
          {
            "predict_taken": 0,
            "predict_history": 0
          }
        ]
      }
    },
    {
      "id": "R5_ghr_update_train_mispredicted",
      "outputs": [
        "predict_taken",
        "predict_history"
      ],
      "condition": "train_valid == 1 && train_mispredicted == 1 && areset == 0",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 1,
      "spec_quote": "if the branch being trained is mispredicted, also recover the branch history register to the state immediately after the mispredicting branch completes execution",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "predict_valid": 0,
            "predict_pc": 0,
            "train_valid": 1,
            "train_taken": 1,
            "train_mispredicted": 1,
            "train_history": 3,
            "train_pc": 7
          },
          {
            "areset": 0,
            "predict_valid": 0,
            "predict_pc": 0,
            "train_valid": 0,
            "train_taken": 0,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
          }
        ],
        "expected": [
          {
            "predict_taken": 0,
            "predict_history": 0
          },
          {
            "predict_taken": 0,
            "predict_history": 0
          }
        ]
      }
    },
    {
      "id": "R6_pht_train",
      "outputs": [
        "predict_taken",
        "predict_history"
      ],
      "condition": "train_valid == 1 && areset == 0",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 5,
      "spec_quote": "Update the pattern history table (PHT) to train the branch predictor to predict this branch more accurately next time.",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "predict_valid": 0,
            "predict_pc": 0,
            "train_valid": 1,
            "train_taken": 1,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
          },
          {
            "areset": 0,
            "predict_valid": 1,
            "predict_pc": 0,
            "train_valid": 0,
            "train_taken": 0,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
          }
        ],
        "expected": [
          {
            "predict_taken": 0,
            "predict_history": 0
          },
          {
            "predict_taken": 0,
            "predict_history": 0
          }
        ]
      }
    },
    {
      "id": "R7_train_priority_over_predict",
      "outputs": [
        "predict_taken",
        "predict_history"
      ],
      "condition": "train_valid == 1 && train_mispredicted == 1 && predict_valid == 1 && areset == 0",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 1,
      "spec_quote": "When this happens, training takes precedence, because the branch being predicted will be discarded anyway.",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "areset": 0,
            "predict_valid": 1,
            "predict_pc": 9,
            "train_valid": 1,
            "train_taken": 0,
            "train_mispredicted": 1,
            "train_history": 2,
            "train_pc": 4
          },
          {
            "areset": 0,
            "predict_valid": 0,
            "predict_pc": 0,
            "train_valid": 0,
            "train_taken": 0,
            "train_mispredicted": 0,
            "train_history": 0,
            "train_pc": 0
          }
        ],
        "expected": [
          {
            "predict_taken": 0,
            "predict_history": 0
          },
          {
            "predict_taken": 0,
            "predict_history": 0
          }
        ]
      }
    }
  ],
  "reset": {
    "kind": "async",
    "name": "areset",
    "active": "high",
    "values": {
      "predict_taken": 0,
      "predict_history": 0
    },
    "first_released_cycle": "cycle after areset deasserts"
  },
  "mid": "Optional mid input changes occur AFTER sampling, before the other edge, and are carried to the start of the next row.",
  "uncertain": [
    {
      "rule_id": "R3_predict_no_valid",
      "note": "Spec does not state output values when predict_valid=0; assumed predict_taken=0 and predict_history=current ghr.",
      "candidates": [
        "predict_taken=0, predict_history=current ghr",
        "outputs undefined/hold previous values when predict_valid=0"
      ]
    }
  ]
}
