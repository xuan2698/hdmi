{
  "ports": {
    "inputs": {
      "reset": 1
    },
    "outputs": {
      "ena": 3,
      "q": 16
    },
    "clock": "clk"
  },
  "states": [
    {
      "name": "counter",
      "meaning": "16-bit BCD counter value; q[3:0]=ones, q[7:4]=tens, q[11:8]=hundreds, q[15:12]=thousands",
      "update_time": "posedge clk",
      "update_during_reset": false
    }
  ],
  "rules": [
    {
      "id": "R1_reset",
      "outputs": [
        "q",
        "ena"
      ],
      "condition": "reset == 1",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 1,
      "spec_quote": "Include a synchronous active-high reset.",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "reset": 1
          },
          {
            "reset": 1
          },
          {
            "reset": 0
          }
        ],
        "expected": [
          {
            "q": 0,
            "ena": 0
          },
          {
            "q": 0,
            "ena": 0
          },
          {
            "q": 0,
            "ena": 0
          }
        ]
      }
    },
    {
      "id": "R2_ones_increment",
      "outputs": [
        "q"
      ],
      "condition": "reset == 0",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 2,
      "spec_quote": "q[3:0] is the ones digit",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "reset": 0
          },
          {
            "reset": 0
          },
          {
            "reset": 0
          }
        ],
        "expected": [
          {
            "q": 1
          },
          {
            "q": 2
          },
          {
            "q": 3
          }
        ]
      }
    },
    {
      "id": "R3_ena_tens",
      "outputs": [
        "ena"
      ],
      "condition": "reset == 0 and q[3:0] == 9",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 3,
      "spec_quote": "For digits [3:1], also output an enable signal indicating when each of the upper three digits should be incremented.",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "reset": 0
          },
          {
            "reset": 0
          },
          {
            "reset": 0
          }
        ],
        "expected": [
          {
            "ena": 0
          },
          {
            "ena": 0
          },
          {
            "ena": 1
          }
        ]
      }
    },
    {
      "id": "R4_ena_hundreds",
      "outputs": [
        "ena"
      ],
      "condition": "reset == 0 and q[3:0] == 9 and q[7:4] == 9",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 4,
      "spec_quote": "For digits [3:1], also output an enable signal indicating when each of the upper three digits should be incremented.",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "reset": 0
          },
          {
            "reset": 0
          },
          {
            "reset": 0
          }
        ],
        "expected": [
          {
            "ena": 0
          },
          {
            "ena": 1
          },
          {
            "ena": 3
          }
        ]
      }
    },
    {
      "id": "R5_ena_thousands",
      "outputs": [
        "ena"
      ],
      "condition": "reset == 0 and q[3:0] == 9 and q[7:4] == 9 and q[11:8] == 9",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 5,
      "spec_quote": "For digits [3:1], also output an enable signal indicating when each of the upper three digits should be incremented.",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "reset": 0
          },
          {
            "reset": 0
          },
          {
            "reset": 0
          }
        ],
        "expected": [
          {
            "ena": 0
          },
          {
            "ena": 3
          },
          {
            "ena": 7
          }
        ]
      }
    },
    {
      "id": "R6_bcd_rollover",
      "outputs": [
        "q"
      ],
      "condition": "reset == 0 and q[3:0] == 9",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 6,
      "spec_quote": "Build a 4-digit BCD (binary-coded decimal) counter.",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "reset": 0
          },
          {
            "reset": 0
          },
          {
            "reset": 0
          }
        ],
        "expected": [
          {
            "q": 9
          },
          {
            "q": 16
          },
          {
            "q": 17
          }
        ]
      }
    }
  ],
  "reset": {
    "kind": "sync",
    "name": "reset",
    "active": "high",
    "values": {
      "q": 0,
      "ena": 0
    },
    "first_released_cycle": "cycle after reset deasserted at posedge"
  },
  "mid": "Optional mid input changes occur AFTER sampling, before the other edge, and are carried to the start of the next row.",
  "uncertain": [],
  "remaining_uncertain_fields": {},
  "selected_interpretations": []
}
