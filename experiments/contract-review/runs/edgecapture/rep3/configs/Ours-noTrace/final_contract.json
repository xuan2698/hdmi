{
  "ports": {
    "inputs": {
      "reset": 1,
      "in": 32
    },
    "outputs": {
      "out": 32
    },
    "clock": "clk"
  },
  "states": [
    {
      "name": "out_reg",
      "meaning": "32-bit register holding captured falling-edge (1->0) detections; each bit stays 1 until synchronous reset",
      "update_time": "posedge clk",
      "update_during_reset": true
    }
  ],
  "rules": [
    {
      "id": "R1_reset_clear",
      "outputs": [
        "out"
      ],
      "condition": "reset == 1",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 1,
      "spec_quote": "until the register is reset (active high synchronous reset)",
      "uncertain": true,
      "example": {
        "vectors": [
          {
            "reset": 1,
            "in": 4294967295
          },
          {
            "reset": 1,
            "in": 0
          },
          {
            "reset": 0,
            "in": 0
          }
        ],
        "expected": [
          {
            "out": 0
          },
          {
            "out": 0
          },
          {
            "out": 0
          }
        ]
      }
    },
    {
      "id": "R2_capture_falling",
      "outputs": [
        "out"
      ],
      "condition": "reset == 0 && prev_in_valid && (prev_in & ~in) != 0; out <= out | (prev_in & ~in); prev_in_valid is 0 on the first posedge clk with reset==0 and 1 thereafter",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 2,
      "spec_quote": "capture when the input signal changes from 1 in one clock cycle to 0 the next",
      "uncertain": true,
      "example": {
        "vectors": [
          {
            "reset": 0,
            "in": 4294967295
          },
          {
            "reset": 0,
            "in": 0
          },
          {
            "reset": 0,
            "in": 0
          },
          {
            "reset": 0,
            "in": 0
          }
        ],
        "expected": [
          {
            "out": 0
          },
          {
            "out": 4294967295
          },
          {
            "out": 4294967295
          },
          {
            "out": 4294967295
          }
        ]
      }
    },
    {
      "id": "R3_hold",
      "outputs": [
        "out"
      ],
      "condition": "reset == 0 && (prev_in & ~in) == 0; out <= out",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 3,
      "spec_quote": "the output will remain 1 until the register is reset",
      "uncertain": true,
      "example": {
        "vectors": [
          {
            "reset": 0,
            "in": 0
          },
          {
            "reset": 0,
            "in": 1
          },
          {
            "reset": 0,
            "in": 1
          },
          {
            "reset": 0,
            "in": 0
          }
        ],
        "expected": [
          {
            "out": 0
          },
          {
            "out": 0
          },
          {
            "out": 0
          },
          {
            "out": 1
          }
        ]
      }
    }
  ],
  "reset": {
    "kind": "sync",
    "name": "reset",
    "active": "high",
    "values": {
      "out": 0
    },
    "first_released_cycle": "first posedge clk with reset==0; on this cycle out is cleared to 0 and no falling-edge capture occurs"
  },
  "mid": "Optional mid input changes occur AFTER sampling, before the other edge, and are carried to the start of the next row.",
  "uncertain": [],
  "remaining_uncertain_fields": {
    "R2_capture_falling": [],
    "R3_hold": [],
    "R1_reset_clear": []
  },
  "selected_interpretations": []
}
