  {
    "issue_id": "I2",
    "before": {
      "ports": {
        "inputs": {
          "reset": 1,
          "in": 32
        },
        "outputs": {
          "out": 32
        },
        "clock": "clk"
      },
      "states": [
        {
          "name": "out_reg",
          "meaning": "Per-bit sticky flag: set to 1 when in bit transitions 1->0; held until synchronous reset",
          "update_time": "posedge clk",
          "update_during_reset": true
        }
      ],
      "rules": [
        {
          "id": "R1_reset_clear",
          "outputs": [
            "out"
          ],
          "condition": "reset == 1",
          "edge": "posedge",
          "visible": "same_cycle",
          "priority": 1,
          "spec_quote": "until the register is reset (active high synchronous reset)",
          "uncertain": false,
          "example": {
            "vectors": [
              {
                "reset": 1,
                "in": 0
              },
              {
                "reset": 0,
                "in": 0
              },
              {
                "reset": 0,
                "in": 0
              }
            ],
            "expected": [
              {
                "out": 0
              },
              {
                "out": 0
              },
              {
                "out": 0
              }
            ]
          }
        },
        {
          "id": "R2_capture_falling",
          "outputs": [
            "out"
          ],
          "condition": "reset == 0 && (in & ~in_prev) != 0  (bit was 1 previous cycle, 0 this cycle)",
          "edge": "posedge",
          "visible": "next_cycle",
          "priority": 2,
          "spec_quote": "capture when the input signal changes from 1 in one clock cycle to 0 the next",
          "uncertain": false,
          "example": {
            "vectors": [
              {
                "reset": 0,
                "in": 4294967295
              },
              {
                "reset": 0,
                "in": 0
              },
              {
                "reset": 0,
                "in": 0
              }
            ],
            "expected": [
              {
                "out": 0
              },
              {
                "out": 4294967295
              },
              {
                "out": 4294967295
              }
            ]
          }
        },
        {
          "id": "R3_hold",
          "outputs": [
            "out"
          ],
          "condition": "reset == 0 && no new 1->0 transition on a bit",
          "edge": "posedge",
          "visible": "next_cycle",
          "priority": 3,
          "spec_quote": "the output will remain 1 until the register is reset",
          "uncertain": false,
          "example": {
            "vectors": [
              {
                "reset": 0,
                "in": 1
              },
              {
                "reset": 0,
                "in": 1
              },
              {
                "reset": 0,
                "in": 0
              }
            ],
            "expected": [
              {
                "out": 0
              },
              {
                "out": 0
              },
              {
                "out": 1
              }
            ]
          }
        }
      ],
      "reset": {
        "kind": "sync",
        "name": "reset",
        "active": "high",
        "values": {
          "out": 0
        },
        "first_released_cycle": "cycle after reset deasserts at posedge"
      },
