{
  "ports": {
    "inputs": {
      "reset": 1,
      "in": 32
    },
    "outputs": {
      "out": 32
    },
    "clock": "clk"
  },
  "states": [
    {
      "name": "out_reg",
      "meaning": "Per-bit sticky flag; bit set to 1 when corresponding 'in' bit transitions 1->0 on a posedge, held until synchronous reset",
      "update_time": "posedge clk",
      "update_during_reset": true
    }
  ],
  "rules": [
    {
      "id": "R1_reset_clear",
      "outputs": [
        "out"
      ],
      "condition": "reset == 1",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 0,
      "spec_quote": "until the register is reset (active high synchronous reset)",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "reset": 0,
            "in": 1
          },
          {
            "reset": 0,
            "in": 0
          },
          {
            "reset": 1,
            "in": 0
          },
          {
            "reset": 0,
            "in": 0
          }
        ],
        "expected": [
          {
            "out": 0
          },
          {
            "out": 0
          },
          {
            "out": 0
          },
          {
            "out": 0
          }
        ]
      }
    },
    {
      "id": "R2_capture_falling",
      "outputs": [
        "out"
      ],
      "condition": "reset == 0 && (prev_in & ~in) != 0; set only bits where prev_in=1 and in=0",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 1,
      "spec_quote": "capture when the input signal changes from 1 in one clock cycle to 0 the next",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "reset": 0,
            "in": 4294967295
          },
          {
            "reset": 0,
            "in": 0
          },
          {
            "reset": 0,
            "in": 0
          },
          {
            "reset": 0,
            "in": 0
          }
        ],
        "expected": [
          {
            "out": 0
          },
          {
            "out": 0
          },
          {
            "out": 4294967295
          },
          {
            "out": 4294967295
          }
        ]
      }
    },
    {
      "id": "R3_hold",
      "outputs": [
        "out"
      ],
      "condition": "reset == 0 && (prev_in & ~in) == 0",
      "edge": "posedge",
      "visible": "next_cycle",
      "priority": 2,
      "spec_quote": "the output will remain 1 until the register is reset",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "reset": 0,
            "in": 1
          },
          {
            "reset": 0,
            "in": 0
          },
          {
            "reset": 0,
            "in": 0
          },
          {
            "reset": 0,
            "in": 0
          }
        ],
        "expected": [
          {
            "out": 0
          },
          {
            "out": 0
          },
          {
            "out": 1
          },
          {
            "out": 1
          }
        ]
      }
    }
  ],
  "reset": {
    "kind": "sync",
    "name": "reset",
    "active": "high",
    "values": {
      "out": 0
    },
    "first_released_cycle": "cycle after reset deasserts at posedge"
  },
  "mid": "Optional mid input changes occur AFTER sampling, before the other edge, and are carried to the start of the next row.",
  "uncertain": [
    {
      "rule_id": "global",
      "note": "Initial value of prev_in at time 0 is unspecified; affects whether a capture occurs on the first sampled edge.",
      "candidates": [
        "prev_in initialized to 0 at time 0",
        "prev_in initialized to all ones at time 0",
        "prev_in unknown at time 0"
      ]
    }
  ],
  "remaining_uncertain_fields": {
    "global": [
      "prev_in initialized to 0 at time 0",
      "prev_in initialized to all ones at time 0",
      "prev_in unknown at time 0",
      "Any falling bit sets all 32 output bits to 1 (global sticky flag)."
    ]
  },
  "selected_interpretations": []
}
