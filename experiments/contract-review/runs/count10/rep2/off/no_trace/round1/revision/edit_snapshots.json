        },
        "outputs": {
          "q": 4
        },
        "clock": "clk"
      },
      "states": [
        {
          "name": "COUNT",
          "meaning": "Counter holds current count value 0..9; increments by 1 on each posedge unless reset is high, in which case it loads 0.",
          "update_time": "posedge",
          "update_during_reset": true
        }
      ],
      "rules": [
        {
          "id": "R1_SYNC_RESET",
          "outputs": [
            "q"
          ],
          "condition": "reset == 1",
          "edge": "posedge",
          "visible": "same_cycle",
          "priority": 1,
          "spec_quote": "The reset input is active high synchronous, and should reset the counter to 0.",
          "uncertain": false,
          "example": {
            "vectors": [
              {
                "reset": 0
              },
              {
                "reset": 1
              },
              {
                "reset": 1
              },
              {
                "reset": 0
              }
            ],
            "expected": [
              {
                "q": 0
              },
              {
                "q": 0
              },
              {
                "q": 0
              },
              {
                "q": 0
              }
            ]
          }
        },
        {
          "id": "R2_COUNT_UP_WRAP",
          "outputs": [
            "q"
          ],
          "condition": "reset == 0",
          "edge": "posedge",
          "visible": "same_cycle",
          "priority": 2,
          "spec_quote": "counts from 0 through 9, inclusive, with a period of 10",
          "uncertain": false,
          "example": {
            "vectors": [
              {
                "reset": 0
              },
              {
                "reset": 0
              },
              {
                "reset": 0
              },
              {
                "reset": 0
              }
            ],
            "expected": [
              {
                "q": 1
              },
              {
                "q": 2
              },
              {
                "q": 3
              },
              {
                "q": 4
              }
            ]
          }
        }
      ],
      "reset": {
        "kind": "sync",
        "name": "reset",
        "active": "high",
        "values": {
          "q": 0
        },
        "first_released_cycle": "first posedge with reset == 0"
