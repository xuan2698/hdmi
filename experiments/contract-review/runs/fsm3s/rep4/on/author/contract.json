            "out": 0
          },
          {
            "out": 0
          },
          {
            "out": 0
          },
          {
            "out": 1
          }
        ]
      }
    }
  ],
  "reset": {
    "kind": "sync",
    "name": "reset",
    "active": "high",
    "values": {
      "out": 0
    },
    "first_released_cycle": "first posedge clk with reset=0 after release; state begins as A and follows the table from A"
  },
  "mid": "Mid-cycle input changes occur after sampling, before the other edge, are carried to the start of the next row, and affect only the next posedge.",
