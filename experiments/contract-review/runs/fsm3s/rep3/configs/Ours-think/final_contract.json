      "condition": "reset == 0 at posedge clk; next state follows the table: A: in=0 -> A, in=1 -> B; B: in=0 -> C, in=1 -> B; C: in=0 -> A, in=1 -> D; D: in=0 -> C, in=1 -> B",
      "edge": "posedge",
      "visible": "same_cycle",
