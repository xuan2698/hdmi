{
  "ports": {
    "inputs": {
      "in": 1,
      "reset": 1
    },
    "outputs": {
      "out": 1
    },
    "clock": "clk"
  },
  "states": [
    {
      "name": "A",
      "meaning": "Moore output 0. On posedge clk: if reset=1 then next state A; else in=0 -> A, in=1 -> B.",
      "update_time": "posedge clk",
      "update_during_reset": true
    },
    {
      "name": "B",
      "meaning": "Moore output 0. On posedge clk: if reset=1 then next state A; else in=0 -> C, in=1 -> B.",
      "update_time": "posedge clk",
      "update_during_reset": true
    },
    {
      "name": "C",
      "meaning": "Moore output 0. On posedge clk: if reset=1 then next state A; else in=0 -> A, in=1 -> D.",
      "update_time": "posedge clk",
      "update_during_reset": true
    },
    {
      "name": "D",
      "meaning": "Moore output 1. On posedge clk: if reset=1 then next state A; else in=0 -> C, in=1 -> B.",
      "update_time": "posedge clk",
      "update_during_reset": true
    }
  ],
  "rules": [
    {
      "id": "R_RESET",
      "outputs": [
        "out"
      ],
      "condition": "reset == 1 at posedge clk; state becomes A, so out == 0 after the edge settles",
      "edge": "posedge",
      "visible": "same_cycle",
      "priority": 100,
      "spec_quote": "synchronous active high reset that resets the FSM to state A",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "reset": 1,
            "in": 0
          },
          {
            "reset": 0,
            "in": 1
          },
          {
            "reset": 0,
            "in": 0
          },
          {
            "reset": 1,
            "in": 1
          }
        ],
        "expected": [
          {
            "out": 0
          },
          {
            "out": 0
          },
          {
            "out": 0
          },
          {
            "out": 0
          }
        ]
      }
    },
    {
      "id": "R_OUT_A",
      "outputs": [
        "out"
      ],
      "condition": "state == A after the posedge settles",
      "edge": "combinational",
      "visible": "same_cycle",
      "priority": 10,
      "spec_quote": "A | A, B | 0",
      "uncertain": false,
      "example": {
        "vectors": [
          {
            "reset": 1,
            "in": 0
          },
          {
            "reset": 0,
            "in": 0
          },
          {
            "reset": 0,
            "in": 0
          }
        ],
        "expected": [
          {
            "out": 0
          },
          {
            "out": 0
          },
          {
            "out": 0
          }
        ]
      }
    },
    {
      "id": "R_OUT_B",
      "outputs": [
        "out"
      ],
      "condition": "state == B after the posedge settles",
      "edge": "combinational",
      "visible": "same_cycle",
      "priority": 10,
      "spec_quote": "B | C, B | 0",
      "uncertain": false,
      "example": {
        "vectors": [
          {
