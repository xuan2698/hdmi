"def reference(vectors):\n    q = 0\n    reset = 0\n    res = []\n    for row in vectors:\n        if 'reset' in row:\n            reset = row['reset']\n        if reset:\n            q = 0\n        else:\n            ones = q & 0xF\n            tens = (q >> 4) & 0xF\n            hud = (q >> 8) & 0xF\n            tho = (q >> 12) & 0xF\n            ones += 1\n            if ones == 10:\n                ones = 0\n                tens += 1\n                if tens == 10:\n                    tens = 0\n                    hud += 1\n                    if hud == 10:\n                        hud = 0\n                        tho += 1\n                        if tho == 10:\n                            tho = 0\n            q = ones | (tens << 4) | (hud << 8) | (tho << 12)\n        ena = 0\n        o = q & 0xF\n        t = (q >> 4) & 0xF\n        h = (q >> 8) & 0xF\n        if o == 9:\n            ena |= 1\n            if t == 9:\n                ena |= 2\n                if h == 9:\n                    ena |= 4\n        res.append({'q': q, 'ena': ena})\n        if 'mid' in row:\n            for k, v in row['mid'].items():\n                if k == 'reset':\n                    reset = v\n    return res\n"
