  "RM": "def reference(vectors):\n    q = 0\n    out = []\n    for row in vectors:\n        reset = row.get('reset', 0)\n        if reset:\n            q = 0\n        else:\n            ones = q & 0xF\n            tens = (q >> 4) & 0xF\n            hundreds = (q >> 8) & 0xF\n            thousands = (q >> 12) & 0xF\n\n            ones += 1\n            if ones == 10:\n                ones = 0\n                tens += 1\n                if tens == 10:\n                    tens = 0\n                    hundreds += 1\n                    if hundreds == 10:\n                        hundreds = 0\n                        thousands += 1\n                        if thousands == 10:\n                            thousands = 0\n\n            q = (thousands << 12) | (hundreds << 8) | (tens << 4) | ones\n\n        ones = q & 0xF\n        tens = (q >> 4) & 0xF\n        hundreds = (q >> 8) & 0xF\n\n        ena0 = 1 if ones == 9 else 0\n        ena1 = 1 if ones == 9 and tens == 9 else 0\n        ena2 = 1 if ones == 9 and tens == 9 and hundreds == 9 else 0\n        ena = ena0 | (ena1 << 1) | (ena2 << 2)\n\n        out.append({'q': q, 'ena': ena})\n\n    return out\n",
