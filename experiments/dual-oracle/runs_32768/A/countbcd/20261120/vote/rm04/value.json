"def reference(vectors):\n    q = 0\n    out = []\n    for row in vectors:\n        reset = row['reset'] if isinstance(row, dict) else row[0]\n        if reset:\n            q = 0\n        else:\n            ones = q & 0xF\n            tens = (q >> 4) & 0xF\n            hundreds = (q >> 8) & 0xF\n            thousands = (q >> 12) & 0xF\n            if ones < 9:\n                ones += 1\n            else:\n                ones = 0\n                if tens < 9:\n                    tens += 1\n                else:\n                    tens = 0\n                    if hundreds < 9:\n                        hundreds += 1\n                    else:\n                        hundreds = 0\n                        if thousands < 9:\n                            thousands += 1\n                        else:\n                            thousands = 0\n            q = ones | (tens << 4) | (hundreds << 8) | (thousands << 12)\n        \n        ones = q & 0xF\n        tens = (q >> 4) & 0xF\n        hundreds = (q >> 8) & 0xF\n        ena = (1 if ones == 9 else 0) | \\\n              ((1 if (ones == 9 and tens == 9) else 0) << 1) | \\\n              ((1 if (ones == 9 and tens == 9 and hundreds == 9) else 0) << 2)\n        out.append({'ena': ena, 'q': q})\n    return out\n"
