"def reference(vectors):\n    q = 0\n    out = []\n    for row in vectors:\n        reset = row.get(\"reset\", 0)\n        if reset:\n            q = 0\n        else:\n            o = q & 0xF\n            t = (q >> 4) & 0xF\n            h = (q >> 8) & 0xF\n            th = (q >> 12) & 0xF\n\n            o += 1\n            if o == 10:\n                o = 0\n                t += 1\n                if t == 10:\n                    t = 0\n                    h += 1\n                    if h == 10:\n                        h = 0\n                        th += 1\n                        if th == 10:\n                            th = 0\n\n            q = (th << 12) | (h << 8) | (t << 4) | o\n\n        o = q & 0xF\n        t = (q >> 4) & 0xF\n        h = (q >> 8) & 0xF\n\n        e0 = 1 if o == 9 else 0\n        e1 = 1 if (o == 9 and t == 9) else 0\n        e2 = 1 if (o == 9 and t == 9 and h == 9) else 0\n\n        out.append({\"q\": q, \"ena\": e0 | (e1 << 1) | (e2 << 2)})\n\n    return out\n"
