"def reference(vectors):\n    q = 0\n    out = []\n    for row in vectors:\n        reset = row['reset'] if isinstance(row, dict) else row[0]\n        if reset:\n            q = 0\n        else:\n            d0 = q & 15\n            d1 = (q >> 4) & 15\n            d2 = (q >> 8) & 15\n            d3 = (q >> 12) & 15\n            if d0 != 9:\n                d0 += 1\n            else:\n                d0 = 0\n                if d1 != 9:\n                    d1 += 1\n                else:\n                    d1 = 0\n                    if d2 != 9:\n                        d2 += 1\n                    else:\n                        d2 = 0\n                        if d3 != 9:\n                            d3 += 1\n                        else:\n                            d3 = 0\n            q = d0 | (d1 << 4) | (d2 << 8) | (d3 << 12)\n\n        d0 = q & 15\n        d1 = (q >> 4) & 15\n        d2 = (q >> 8) & 15\n        ena = 0\n        if d0 == 9:\n            ena = 1\n            if d1 == 9:\n                ena |= 2\n                if d2 == 9:\n                    ena |= 4\n        out.append({'ena': ena, 'q': q})\n    return out\n"
