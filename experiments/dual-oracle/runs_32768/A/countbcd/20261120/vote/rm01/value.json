"def reference(vectors):\n    q = 0\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            reset = row.get('reset', 0)\n        elif isinstance(row, (list, tuple)):\n            reset = row[0] if row else 0\n        else:\n            reset = row\n        reset = int(reset) & 1\n\n        if reset:\n            q = 0\n        else:\n            ones = q & 0xF\n            tens = (q >> 4) & 0xF\n            hund = (q >> 8) & 0xF\n            thou = (q >> 12) & 0xF\n            ones += 1\n            if ones == 10:\n                ones = 0\n                tens += 1\n                if tens == 10:\n                    tens = 0\n                    hund += 1\n                    if hund == 10:\n                        hund = 0\n                        thou += 1\n                        if thou == 10:\n                            thou = 0\n            q = (thou << 12) | (hund << 8) | (tens << 4) | ones\n\n        ones = q & 0xF\n        tens = (q >> 4) & 0xF\n        hund = (q >> 8) & 0xF\n        ena = 0\n        if ones == 9:\n            ena |= 1\n            if tens == 9:\n                ena |= 2\n                if hund == 9:\n                    ena |= 4\n\n        out.append({'ena': ena, 'q': q})\n    return out\n"
