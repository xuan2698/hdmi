"def reference(vectors):\n    q=0\n    reset=0\n    out=[]\n    for row in vectors:\n        for k,v in row.items():\n            if k!='mid' and k=='reset':\n                reset=v\n        if reset:\n            q=0\n        else:\n            d=[(q>>(4*i))&15 for i in range(4)]\n            nd=[0,0,0,0]\n            carry=1\n            for i in range(4):\n                if carry and d[i]==9:\n                    nd[i]=0\n                elif carry:\n                    nd[i]=d[i]+1\n                    carry=0\n                else:\n                    nd[i]=d[i]\n            q=sum(nd[i]<<(4*i) for i in range(4))\n        d=[(q>>(4*i))&15 for i in range(4)]\n        e=0\n        p=1\n        for i in range(3):\n            p=p and d[i]==9\n            if p:\n                e=e|(1<<i)\n        out.append({'ena':e&7,'q':q&65535})\n        for k,v in row.get('mid',{}).items():\n            if k=='reset':\n                reset=v\n    return out\n"
