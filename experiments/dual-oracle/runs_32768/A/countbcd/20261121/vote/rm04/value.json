"def reference(vectors):\n    q = 0\n    result = []\n    for row in vectors:\n        reset = row['reset'] if isinstance(row, dict) else row\n        if reset:\n            q = 0\n        else:\n            ones = q & 0xF\n            tens = (q >> 4) & 0xF\n            hundreds = (q >> 8) & 0xF\n            thousands = (q >> 12) & 0xF\n            ones += 1\n            carry = 0\n            if ones == 10:\n                ones = 0\n                carry = 1\n            if carry:\n                tens += 1\n                carry = 0\n                if tens == 10:\n                    tens = 0\n                    carry = 1\n            if carry:\n                hundreds += 1\n                carry = 0\n                if hundreds == 10:\n                    hundreds = 0\n                    carry = 1\n            if carry:\n                thousands += 1\n                if thousands == 10:\n                    thousands = 0\n            q = (thousands << 12) | (hundreds << 8) | (tens << 4) | ones\n        ones = q & 0xF\n        tens = (q >> 4) & 0xF\n        hundreds = (q >> 8) & 0xF\n        e0 = 1 if ones == 9 else 0\n        e1 = 1 if (ones == 9 and tens == 9) else 0\n        e2 = 1 if (ones == 9 and tens == 9 and hundreds == 9) else 0\n        ena = e0 | (e1 << 1) | (e2 << 2)\n        result.append({'ena': ena, 'q': q})\n    return result\n"
