"def reference(vectors):\n    q = 0\n    out = []\n    for row in vectors:\n        reset = row.get('reset', 0) if isinstance(row, dict) else row[0]\n        if reset:\n            q = 0\n        else:\n            ones = q & 0xF\n            tens = (q >> 4) & 0xF\n            hundreds = (q >> 8) & 0xF\n            thousands = (q >> 12) & 0xF\n            ones += 1\n            if ones == 10:\n                ones = 0\n                tens += 1\n                if tens == 10:\n                    tens = 0\n                    hundreds += 1\n                    if hundreds == 10:\n                        hundreds = 0\n                        thousands += 1\n                        if thousands == 10:\n                            thousands = 0\n            q = (thousands << 12) | (hundreds << 8) | (tens << 4) | ones\n        ones = q & 0xF\n        tens = (q >> 4) & 0xF\n        hundreds = (q >> 8) & 0xF\n        ena = 0\n        if ones == 9:\n            ena |= 1\n            if tens == 9:\n                ena |= 2\n                if hundreds == 9:\n                    ena |= 4\n        out.append({'ena': ena, 'q': q})\n    return out\n"
