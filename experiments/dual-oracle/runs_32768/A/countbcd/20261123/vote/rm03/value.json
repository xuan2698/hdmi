"def reference(vectors):\n    q = 0\n    out = []\n    for row in vectors:\n        r = row['reset'] if isinstance(row, dict) else row[0]\n        if r:\n            q = 0\n        else:\n            dec = (q & 15) + ((q >> 4) & 15) * 10 + ((q >> 8) & 15) * 100 + ((q >> 12) & 15) * 1000\n            dec = (dec + 1) % 10000\n            d0 = dec % 10\n            d1 = (dec // 10) % 10\n            d2 = (dec // 100) % 10\n            d3 = (dec // 1000) % 10\n            q = d0 | (d1 << 4) | (d2 << 8) | (d3 << 12)\n        d0 = q & 15\n        d1 = (q >> 4) & 15\n        d2 = (q >> 8) & 15\n        e1 = 1 if d0 == 9 else 0\n        e2 = 1 if d0 == 9 and d1 == 9 else 0\n        e3 = 1 if d0 == 9 and d1 == 9 and d2 == 9 else 0\n        ena = e1 | (e2 << 1) | (e3 << 2)\n        out.append({'ena': ena, 'q': q})\n    return out\n"
