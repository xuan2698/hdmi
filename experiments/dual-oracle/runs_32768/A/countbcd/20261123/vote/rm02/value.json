"def reference(vectors):\n    q = 0\n    out = []\n    for row in vectors:\n        reset = row.get('reset', 0) if isinstance(row, dict) else row[0]\n        if reset:\n            q = 0\n        else:\n            n = (((q >> 12) & 0xF) * 1000 +\n                 ((q >> 8) & 0xF) * 100 +\n                 ((q >> 4) & 0xF) * 10 +\n                 (q & 0xF))\n            n = (n + 1) % 10000\n            th = n // 1000\n            hu = (n // 100) % 10\n            te = (n // 10) % 10\n            on = n % 10\n            q = (th << 12) | (hu << 8) | (te << 4) | on\n\n        on = q & 0xF\n        te = (q >> 4) & 0xF\n        hu = (q >> 8) & 0xF\n        e1 = 1 if on == 9 else 0\n        e2 = 1 if (te == 9 and on == 9) else 0\n        e3 = 1 if (hu == 9 and te == 9 and on == 9) else 0\n        ena = e1 | (e2 << 1) | (e3 << 2)\n        out.append({'ena': ena, 'q': q})\n    return out\n"
