"def reference(vectors):\n    q = 0\n    out = []\n    for v in vectors:\n        if v[\"reset\"]:\n            q = 0\n        else:\n            d0 = q & 0xF\n            d1 = (q >> 4) & 0xF\n            d2 = (q >> 8) & 0xF\n            d3 = (q >> 12) & 0xF\n            d0 += 1\n            if d0 == 10:\n                d0 = 0\n                d1 += 1\n                if d1 == 10:\n                    d1 = 0\n                    d2 += 1\n                    if d2 == 10:\n                        d2 = 0\n                        d3 = (d3 + 1) % 10\n            q = (d3 << 12) | (d2 << 8) | (d1 << 4) | d0\n\n        d0 = q & 0xF\n        d1 = (q >> 4) & 0xF\n        d2 = (q >> 8) & 0xF\n        ena = 0\n        if d0 == 9:\n            ena |= 1\n        if d0 == 9 and d1 == 9:\n            ena |= 2\n        if d0 == 9 and d1 == 9 and d2 == 9:\n            ena |= 4\n\n        out.append({\"ena\": ena, \"q\": q})\n    return out\n"
