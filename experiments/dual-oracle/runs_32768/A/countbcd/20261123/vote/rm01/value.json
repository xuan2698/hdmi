"def reference(vectors):\n    q = 0\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            reset = row.get('reset', 0)\n        elif isinstance(row, (list, tuple)):\n            reset = row[0] if row else 0\n        else:\n            reset = row\n\n        if reset & 1:\n            q = 0\n        else:\n            d0 = q & 15\n            d1 = (q >> 4) & 15\n            d2 = (q >> 8) & 15\n            d3 = (q >> 12) & 15\n            d0 += 1\n            if d0 == 10:\n                d0 = 0\n                d1 += 1\n                if d1 == 10:\n                    d1 = 0\n                    d2 += 1\n                    if d2 == 10:\n                        d2 = 0\n                        d3 += 1\n                        if d3 == 10:\n                            d3 = 0\n            q = (d3 << 12) | (d2 << 8) | (d1 << 4) | d0\n\n        d0 = q & 15\n        d1 = (q >> 4) & 15\n        d2 = (q >> 8) & 15\n        ena = 0\n        if d0 == 9:\n            ena |= 1\n            if d1 == 9:\n                ena |= 2\n                if d2 == 9:\n                    ena |= 4\n\n        out.append({'ena': ena, 'q': q})\n\n    return out\n"
