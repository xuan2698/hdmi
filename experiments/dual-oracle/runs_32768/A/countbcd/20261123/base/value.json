"def reference(vectors):\n    q=0\n    cur=0\n    out=[]\n    for row in vectors:\n        if 'reset' in row:\n            cur=row['reset']\n        if cur:\n            q=0\n        else:\n            d=[q&15,(q>>4)&15,(q>>8)&15,(q>>12)&15]\n            i=0\n            while i<4:\n                if d[i]==9:\n                    d[i]=0\n                    i+=1\n                else:\n                    d[i]+=1\n                    break\n            q=d[0]|(d[1]<<4)|(d[2]<<8)|(d[3]<<12)\n        ones=q&15\n        tens=(q>>4)&15\n        hun=(q>>8)&15\n        e1=1 if ones==9 else 0\n        e2=1 if (e1 and tens==9) else 0\n        e3=1 if (e2 and hun==9) else 0\n        ena=e1|(e2<<1)|(e3<<2)\n        out.append({'ena':ena,'q':q})\n        if 'mid' in row:\n            mid=row['mid']\n            if 'reset' in mid:\n                cur=mid['reset']\n    return out\n"
