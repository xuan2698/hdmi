"def reference(vectors):\n    q = 0\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            reset = int(row.get('reset', 0)) & 1\n        else:\n            reset = int(row) & 1\n        d0 = q & 0xF\n        d1 = (q >> 4) & 0xF\n        d2 = (q >> 8) & 0xF\n        d3 = (q >> 12) & 0xF\n        if reset:\n            d0 = d1 = d2 = d3 = 0\n        else:\n            d0 += 1\n            if d0 == 10:\n                d0 = 0\n                d1 += 1\n                if d1 == 10:\n                    d1 = 0\n                    d2 += 1\n                    if d2 == 10:\n                        d2 = 0\n                        d3 += 1\n                        if d3 == 10:\n                            d3 = 0\n        q = (d3 << 12) | (d2 << 8) | (d1 << 4) | d0\n        e1 = 1 if d0 == 9 else 0\n        e2 = 1 if (d0 == 9 and d1 == 9) else 0\n        e3 = 1 if (d0 == 9 and d1 == 9 and d2 == 9) else 0\n        ena = e1 | (e2 << 1) | (e3 << 2)\n        out.append({'ena': ena, 'q': q})\n    return out\n"
