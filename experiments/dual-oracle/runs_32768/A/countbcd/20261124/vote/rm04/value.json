"def reference(vectors):\n    q = 0\n    out = []\n    for v in vectors:\n        reset = v['reset'] if isinstance(v, dict) else v\n        if reset:\n            q = 0\n        else:\n            d0 = q & 0xF\n            d1 = (q >> 4) & 0xF\n            d2 = (q >> 8) & 0xF\n            d3 = (q >> 12) & 0xF\n            if d0 == 9:\n                d0 = 0\n                if d1 == 9:\n                    d1 = 0\n                    if d2 == 9:\n                        d2 = 0\n                        if d3 == 9:\n                            d3 = 0\n                        else:\n                            d3 += 1\n                    else:\n                        d2 += 1\n                else:\n                    d1 += 1\n            else:\n                d0 += 1\n            q = (d3 << 12) | (d2 << 8) | (d1 << 4) | d0\n        ones = q & 0xF\n        tens = (q >> 4) & 0xF\n        hundreds = (q >> 8) & 0xF\n        ena = 0\n        if ones == 9:\n            ena |= 1\n            if tens == 9:\n                ena |= 2\n                if hundreds == 9:\n                    ena |= 4\n        out.append({'q': q, 'ena': ena})\n    return out\n"
