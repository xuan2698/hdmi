"def reference(vectors):\n    d0 = d1 = d2 = d3 = 0\n    out = []\n    for row in vectors:\n        r = row['reset'] if isinstance(row, dict) else row\n        if r:\n            d0 = d1 = d2 = d3 = 0\n        else:\n            d0 += 1\n            if d0 == 10:\n                d0 = 0\n                d1 += 1\n                if d1 == 10:\n                    d1 = 0\n                    d2 += 1\n                    if d2 == 10:\n                        d2 = 0\n                        d3 += 1\n                        if d3 == 10:\n                            d3 = 0\n        ena = (1 if d0 == 9 else 0) | (2 if d0 == 9 and d1 == 9 else 0) | (4 if d0 == 9 and d1 == 9 and d2 == 9 else 0)\n        q = (d3 << 12) | (d2 << 8) | (d1 << 4) | d0\n        out.append({'ena': ena, 'q': q})\n    return out\n"
