"def reference(vectors):\n    q=0\n    res=0\n    out=[]\n    for row in vectors:\n        if 'reset' in row:\n            res=row['reset']&1\n        if res:\n            q=0\n        else:\n            d0=q&15\n            d1=(q>>4)&15\n            d2=(q>>8)&15\n            d3=(q>>12)&15\n            d0+=1\n            if d0==10:\n                d0=0\n                d1+=1\n                if d1==10:\n                    d1=0\n                    d2+=1\n                    if d2==10:\n                        d2=0\n                        d3+=1\n                        if d3==10:\n                            d3=0\n            q=(d3<<12)|(d2<<8)|(d1<<4)|d0\n        o=q&15\n        t=(q>>4)&15\n        h=(q>>8)&15\n        e0=1 if o==9 else 0\n        e1=1 if o==9 and t==9 else 0\n        e2=1 if o==9 and t==9 and h==9 else 0\n        ena=e0|(e1<<1)|(e2<<2)\n        out.append({'q':q&65535,'ena':ena&7})\n        if 'mid' in row:\n            mid=row['mid']\n            if 'reset' in mid:\n                res=mid['reset']&1\n    return out\n"
