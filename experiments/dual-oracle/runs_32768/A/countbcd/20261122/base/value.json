"def reference(vectors):\n    q = 0\n    cur = {'reset': 0}\n    out = []\n    for row in vectors:\n        for k, v in row.items():\n            if k != 'mid':\n                cur[k] = v\n        r = cur.get('reset', 0)\n        if r:\n            q = 0\n        else:\n            d0 = q & 15\n            d1 = (q >> 4) & 15\n            d2 = (q >> 8) & 15\n            d3 = (q >> 12) & 15\n            if d0 == 9:\n                d0 = 0\n                c1 = 1\n            else:\n                d0 += 1\n                c1 = 0\n            if c1:\n                if d1 == 9:\n                    d1 = 0\n                    c2 = 1\n                else:\n                    d1 += 1\n                    c2 = 0\n            else:\n                c2 = 0\n            if c2:\n                if d2 == 9:\n                    d2 = 0\n                    c3 = 1\n                else:\n                    d2 += 1\n                    c3 = 0\n            else:\n                c3 = 0\n            if c3:\n                if d3 == 9:\n                    d3 = 0\n                else:\n                    d3 += 1\n            q = d0 | (d1 << 4) | (d2 << 8) | (d3 << 12)\n        e1 = 1 if (q & 15) == 9 else 0\n        e2 = 1 if (q & 255) == 0x99 else 0\n        e3 = 1 if (q & 4095) == 0x999 else 0\n        out.append({'ena': e1 | (e2 << 1) | (e3 << 2), 'q': q & 0xFFFF})\n        if 'mid' in row:\n            for k, v in row['mid'].items():\n                cur[k] = v\n    return out\n"
