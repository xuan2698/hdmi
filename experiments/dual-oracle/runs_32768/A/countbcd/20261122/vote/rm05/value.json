"def reference(vectors):\n    q = 0\n    out = []\n    for v in vectors:\n        if v.get('reset', 0):\n            q = 0\n        else:\n            d0 = q & 15\n            d1 = (q >> 4) & 15\n            d2 = (q >> 8) & 15\n            d3 = (q >> 12) & 15\n            d0 += 1\n            if d0 == 10:\n                d0 = 0\n                d1 += 1\n                if d1 == 10:\n                    d1 = 0\n                    d2 += 1\n                    if d2 == 10:\n                        d2 = 0\n                        d3 += 1\n                        if d3 == 10:\n                            d3 = 0\n            q = d0 | (d1 << 4) | (d2 << 8) | (d3 << 12)\n        d0 = q & 15\n        d1 = (q >> 4) & 15\n        d2 = (q >> 8) & 15\n        ena = 0\n        if d0 == 9:\n            ena |= 1\n            if d1 == 9:\n                ena |= 2\n                if d2 == 9:\n                    ena |= 4\n        out.append({'ena': ena, 'q': q})\n    return out\n"
