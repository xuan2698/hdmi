"def reference(vectors):\n    q = 0\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            reset = row.get('reset', 0)\n        elif isinstance(row, (list, tuple)):\n            reset = row[0] if row else 0\n        else:\n            reset = row\n\n        if reset:\n            q = 0\n        else:\n            o = q & 15\n            t = (q >> 4) & 15\n            h = (q >> 8) & 15\n            th = (q >> 12) & 15\n\n            o += 1\n            if o == 10:\n                o = 0\n                t += 1\n                if t == 10:\n                    t = 0\n                    h += 1\n                    if h == 10:\n                        h = 0\n                        th += 1\n                        if th == 10:\n                            th = 0\n\n            q = o | (t << 4) | (h << 8) | (th << 12)\n\n        ena = 0\n        if (q & 15) == 9:\n            ena |= 1\n        if (q & 255) == 0x99:\n            ena |= 2\n        if (q & 4095) == 0x999:\n            ena |= 4\n\n        out.append({'q': q, 'ena': ena})\n\n    return out\n"
