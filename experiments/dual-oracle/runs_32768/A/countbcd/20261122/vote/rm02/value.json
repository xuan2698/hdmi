"def reference(vectors):\n    q = 0\n    out = []\n    for row in vectors:\n        r = row.get('reset', 0) if isinstance(row, dict) else row[0]\n        if r:\n            q = 0\n        else:\n            o = q & 15\n            t = (q >> 4) & 15\n            h = (q >> 8) & 15\n            th = (q >> 12) & 15\n            o += 1\n            if o == 10:\n                o = 0\n                t += 1\n                if t == 10:\n                    t = 0\n                    h += 1\n                    if h == 10:\n                        h = 0\n                        th = (th + 1) % 10\n            q = (th << 12) | (h << 8) | (t << 4) | o\n        o = q & 15\n        t = (q >> 4) & 15\n        h = (q >> 8) & 15\n        e1 = 1 if o == 9 else 0\n        e2 = 1 if (o == 9 and t == 9) else 0\n        e3 = 1 if (o == 9 and t == 9 and h == 9) else 0\n        out.append({'ena': e1 | (e2 << 1) | (e3 << 2), 'q': q})\n    return out\n"
