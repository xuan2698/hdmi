  "RM": "def reference(vectors):\n    q = 0\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            reset = row.get('reset', 0)\n        else:\n            reset = row[0] if isinstance(row, (list, tuple)) else row\n        if reset:\n            q = 0\n        else:\n            ones = q & 0xF\n            tens = (q >> 4) & 0xF\n            hundreds = (q >> 8) & 0xF\n            thousands = (q >> 12) & 0xF\n            if ones < 9:\n                ones += 1\n            else:\n                ones = 0\n                if tens < 9:\n                    tens += 1\n                else:\n                    tens = 0\n                    if hundreds < 9:\n                        hundreds += 1\n                    else:\n                        hundreds = 0\n                        if thousands < 9:\n                            thousands += 1\n                        else:\n                            thousands = 0\n            q = (thousands << 12) | (hundreds << 8) | (tens << 4) | ones\n\n        ones = q & 0xF\n        tens = (q >> 4) & 0xF\n        hundreds = (q >> 8) & 0xF\n        ena = (1 if ones == 9 else 0)\n        ena |= (1 if (tens == 9 and ones == 9) else 0) << 1\n        ena |= (1 if (hundreds == 9 and tens == 9 and ones == 9) else 0) << 2\n        out.append({'q': q, 'ena': ena})\n    return out\n",
