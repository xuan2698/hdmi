"def reference(vectors):\n    if isinstance(vectors, dict):\n        keys = list(vectors.keys())\n        rows = [{k: vectors[k][i] for k in keys} for i in range(len(vectors[keys[0]]) if keys else 0)]\n    else:\n        rows = vectors\n    out = []\n    for row in rows:\n        L = row['L']\n        q_in = row['q_in']\n        r_in = row['r_in']\n        out.append({'Q': (r_in if L else q_in) & 1})\n    return out\n"
