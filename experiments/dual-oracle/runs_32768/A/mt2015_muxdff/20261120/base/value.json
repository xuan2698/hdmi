"def reference(vectors):\n    Q=0\n    s={'L':0,'q_in':0,'r_in':0}\n    o=[]\n    for v in vectors:\n        for k in s:\n            if k in v:\n                s[k]=v[k]&1\n        Q=(s['r_in'] if s['L'] else s['q_in'])&1\n        o.append({'Q':Q})\n        for k,x in v.get('mid',{}).items():\n            if k in s:\n                s[k]=x&1\n    return o\n"
