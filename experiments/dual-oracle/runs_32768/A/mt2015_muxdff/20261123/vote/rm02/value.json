"def reference(vectors):\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            L = row.get('L', 0)\n            q_in = row.get('q_in', 0)\n            r_in = row.get('r_in', 0)\n        else:\n            try:\n                L = row['L']\n                q_in = row['q_in']\n                r_in = row['r_in']\n            except (TypeError, KeyError):\n                vals = list(row)\n                L = vals[0] if len(vals) > 0 else 0\n                q_in = vals[1] if len(vals) > 1 else 0\n                r_in = vals[2] if len(vals) > 2 else 0\n        L = int(L) & 1\n        q_in = int(q_in) & 1\n        r_in = int(r_in) & 1\n        Q = r_in if L else q_in\n        out.append({'Q': Q})\n    return out\n"
