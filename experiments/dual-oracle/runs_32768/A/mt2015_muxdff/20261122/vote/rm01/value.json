"def reference(vectors):\n    Q = 0\n    result = []\n    for row in vectors:\n        if isinstance(row, dict):\n            L = row.get('L', 0)\n            q_in = row.get('q_in', 0)\n            r_in = row.get('r_in', 0)\n        else:\n            L = row[0]\n            q_in = row[1]\n            r_in = row[2]\n        Q = (r_in if L else q_in) & 1\n        result.append({'Q': Q})\n    return result\n"
