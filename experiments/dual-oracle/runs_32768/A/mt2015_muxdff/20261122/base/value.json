"def reference(vectors):\n    q = 0\n    cur = {'L': 0, 'q_in': 0, 'r_in': 0}\n    out = []\n    for row in vectors:\n        for k in ('L', 'q_in', 'r_in'):\n            if k in row:\n                cur[k] = int(row[k]) & 1\n        L = cur['L']\n        qi = cur['q_in']\n        ri = cur['r_in']\n        q = ri if L else qi\n        out.append({'Q': q & 1})\n        if 'mid' in row:\n            m = row['mid']\n            for k in ('L', 'q_in', 'r_in'):\n                if k in m:\n                    cur[k] = int(m[k]) & 1\n    return out\n"
