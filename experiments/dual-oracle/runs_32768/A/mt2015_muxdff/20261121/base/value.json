"def reference(vectors):\n    s={'L':0,'q_in':0,'r_in':0}\n    o=[]\n    for row in vectors:\n        for k in ('L','q_in','r_in'):\n            if k in row:\n                s[k]=row[k]&1\n        q=(s['r_in'] if (s['L']&1) else s['q_in'])&1\n        o.append({'Q':q})\n        m=row.get('mid')\n        if isinstance(m,dict):\n            for k,v in m.items():\n                if k in s:\n                    s[k]=v&1\n    return o\n"
