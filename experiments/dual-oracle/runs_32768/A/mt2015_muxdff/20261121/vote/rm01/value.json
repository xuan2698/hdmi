"def reference(vectors):\n    Q = 0\n    out = []\n    for v in vectors:\n        if isinstance(v, dict):\n            L = v['L']\n            q_in = v['q_in']\n            r_in = v['r_in']\n        else:\n            L, q_in, r_in = v\n        Q = r_in if L else q_in\n        out.append({'Q': Q & 1})\n    return out\n"
