"def reference(vectors):\n    Q = 0\n    cur = {'L': 0, 'q_in': 0, 'r_in': 0}\n    out = []\n    for row in vectors:\n        for k in ('L', 'q_in', 'r_in'):\n            if k in row:\n                cur[k] = int(row[k]) & 1\n        L = cur['L']\n        q_in = cur['q_in']\n        r_in = cur['r_in']\n        Q = (r_in if L else q_in) & 1\n        out.append({'Q': Q})\n        mid = row.get('mid')\n        if mid:\n            for k, v in mid.items():\n                if k in cur:\n                    cur[k] = int(v) & 1\n    return out\n"
