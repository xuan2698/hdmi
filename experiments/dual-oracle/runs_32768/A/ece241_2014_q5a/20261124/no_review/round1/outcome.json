      "id": "s5/4/z",
      "label": "RM",
      "spec_quote": "The conversion begins when Reset is released and stops when Reset is asserted."
    },
    {
      "id": "s5/5/z",
      "label": "RM",
      "spec_quote": "The conversion begins when Reset is released and stops when Reset is asserted."
    }
  ],
  "RM": "def reference(vectors):\n    state = 0\n    out = []\n    for row in vectors:\n        if int(row['areset']):\n            state = 0\n            z = 0\n        else:\n            x = int(row['x'])\n            if state == 0:\n                if x:\n                    state = 1\n                else:\n                    state = 0\n            else:\n                if x:\n                    state = 2\n                else:\n                    state = 1\n            z = 1 if state == 1 else 0\n        out.append({'z': z})\n        mid = row.get('mid')\n        if mid is not None:\n            if 'areset' in mid and int(mid['areset']):\n                state = 0\n    return out\n",
