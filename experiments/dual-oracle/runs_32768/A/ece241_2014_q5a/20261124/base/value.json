"def reference(vectors):\n    s=0\n    x=0\n    a=0\n    zs=[0,1,0]\n    tr=[[0,1],[1,2],[1,2]]\n    r=[]\n    for v in vectors:\n        if 'x' in v:x=v['x']\n        if 'areset' in v:a=v['areset']\n        if a:s=0\n        else:s=tr[s][x]\n        r.append({'z':zs[s]})\n        m=v.get('mid')\n        if m:\n            if 'x' in m:x=m['x']\n            if 'areset' in m:\n                a=m['areset']\n                if a:s=0\n    return r\n"
