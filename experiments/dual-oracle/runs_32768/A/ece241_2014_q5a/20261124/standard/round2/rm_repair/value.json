"def reference(vectors):\n    s = 0\n    out = []\n    for row in vectors:\n        if int(row['areset']):\n            s = 0\n        else:\n            x = int(row['x'])\n            if s == 0:\n                if x:\n                    s = 1\n            else:\n                s = 2 if x else 1\n        out.append({'z': 1 if s == 1 else 0})\n        mid = row.get('mid')\n        if mid and int(mid.get('areset', 0)):\n            s = 0\n    return out\n"
