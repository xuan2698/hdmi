"def reference(vectors):\n    copy = 1\n    out = []\n    for row in vectors:\n        if row.get('areset', 0):\n            copy = 1\n            z = 0\n        else:\n            x = row.get('x', 0) & 1\n            if copy:\n                z = x\n                if x:\n                    copy = 0\n            else:\n                z = 1 - x\n        out.append({'z': z})\n    return out\n"
