"def reference(vectors):\n    state = 0\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            areset = row[\"areset\"]\n            x = row[\"x\"]\n        else:\n            areset = row[0]\n            x = row[1]\n        if areset:\n            state = 0\n        elif state == 0:\n            if x:\n                state = 1\n        elif state == 1:\n            if x:\n                state = 2\n        else:\n            if not x:\n                state = 1\n        out.append({\"z\": 0 if state in (0, 2) else 1})\n    return out\n"
