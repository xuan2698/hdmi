"def reference(vectors):\n    state = 0  # 0: no 1 seen, z=0; 1: seen, z=1; 2: seen, z=0\n    out = []\n    for row in vectors:\n        areset = row['areset']\n        x = row['x']\n        if areset:\n            state = 0\n        else:\n            if state == 0:\n                state = 1 if x else 0\n            elif state == 1:\n                state = 2 if x else 1\n            else:\n                state = 2 if x else 1\n        z = 0 if state in (0, 2) else 1\n        out.append({'z': z})\n    return out\n"
