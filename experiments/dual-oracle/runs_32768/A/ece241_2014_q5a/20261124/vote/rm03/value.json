"def reference(vectors):\n    seen = False\n    out = []\n    for row in vectors:\n        areset = row.get('areset', 0)\n        x = row.get('x', 0)\n        if areset:\n            seen = False\n            z = 0\n        else:\n            if not seen:\n                if x:\n                    z = 1\n                    seen = True\n                else:\n                    z = 0\n            else:\n                z = 1 - x\n        out.append({'z': z})\n    return out\n"
