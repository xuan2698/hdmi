"def reference(vectors):\n    if isinstance(vectors, dict):\n        keys = list(vectors)\n        n = len(vectors[keys[0]]) if keys else 0\n        rows = ({k: vectors[k][i] for k in keys} for i in range(n))\n    else:\n        rows = vectors\n    s = 0\n    out = []\n    for row in rows:\n        areset = row.get('areset', 0)\n        x = row.get('x', 0)\n        if areset:\n            s = 0\n        else:\n            if s == 0:\n                s = 1 if x else 0\n            else:\n                s = 3 if x else 2\n        z = 1 if s == 1 or s == 2 else 0\n        out.append({'z': z})\n    return out\n"
