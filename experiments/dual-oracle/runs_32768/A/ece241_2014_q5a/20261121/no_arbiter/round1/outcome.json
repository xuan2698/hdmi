  "RM": "def reference(vectors):\n    state = 0\n    outs = []\n    zmap = (0, 1, 1, 0)\n    for v in vectors:\n        if v.get('areset', 0):\n            state = 0\n        else:\n            x = v.get('x', 0) & 1\n            if state == 0:\n                state = 1 if x else 0\n            else:\n                state = 2 if x == 0 else 3\n        outs.append({'z': zmap[state]})\n    return outs\n",
