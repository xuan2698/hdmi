"def reference(vectors):\n    carry = 1\n    result = []\n    for v in vectors:\n        areset = int(v.get('areset', 0)) & 1\n        x = int(v.get('x', 0)) & 1\n        if areset:\n            carry = 1\n            z = 0\n        else:\n            z = ((x ^ 1) ^ carry) & 1\n            carry = ((x ^ 1) & carry) & 1\n        result.append({'z': z})\n    return result\n"
