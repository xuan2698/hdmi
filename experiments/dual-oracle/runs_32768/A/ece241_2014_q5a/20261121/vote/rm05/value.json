"def reference(vectors):\n    state = 0  # 0: no 1 yet, 1: seen and z=1, 2: seen and z=0\n    result = []\n    for row in vectors:\n        areset = row.get('areset', 0)\n        x = row.get('x', 0)\n        if areset:\n            state = 0\n            z = 0\n        else:\n            if state == 0:\n                if x:\n                    state = 1\n                    z = 1\n                else:\n                    state = 0\n                    z = 0\n            else:\n                if x:\n                    state = 2\n                    z = 0\n                else:\n                    state = 1\n                    z = 1\n        result.append({'z': z})\n    return result\n"
