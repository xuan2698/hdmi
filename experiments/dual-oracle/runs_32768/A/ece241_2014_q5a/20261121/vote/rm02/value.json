"def reference(vectors):\n    state = 'A'\n    result = []\n    for row in vectors:\n        if row['areset']:\n            state = 'A'\n        else:\n            x = row['x']\n            if state == 'A':\n                state = 'B' if x else 'A'\n            elif state == 'B':\n                state = 'C' if x else 'B'\n            else:  # state == 'C'\n                state = 'C' if x else 'B'\n        result.append({'z': 1 if state == 'B' else 0})\n    return result\n"
