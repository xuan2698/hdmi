"def reference(vectors):\n    s = 0\n    z = 0\n    c = {'areset': 0, 'x': 0}\n    r = []\n    for v in vectors:\n        for k in ('areset', 'x'):\n            if k in v:\n                c[k] = v[k]\n        if c['areset']:\n            s = 0\n            z = 0\n        else:\n            x = c['x'] & 1\n            if s:\n                z = 1 - x\n            else:\n                z = x\n                s = x\n        r.append({'z': z})\n        if 'mid' in v:\n            for k in ('areset', 'x'):\n                if k in v['mid']:\n                    c[k] = v['mid'][k]\n            if c['areset']:\n                s = 0\n                z = 0\n    return r\n"
