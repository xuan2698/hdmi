  "RM": "def reference(vectors):\n    s = 0\n    out = []\n    for r in vectors:\n        a = r.get('areset', 0)\n        x = r.get('x', 0)\n        if a:\n            s = 0\n            z = 0\n        else:\n            if s == 0:\n                if x:\n                    s = 1\n                    z = 1\n                else:\n                    z = 0\n            elif s == 1:\n                if x:\n                    s = 2\n                    z = 0\n                else:\n                    z = 1\n            else:\n                if x:\n                    z = 0\n                else:\n                    s = 1\n                    z = 1\n        out.append({'z': z})\n    return out\n",
