"def reference(vectors):\n    seen=0\n    z=0\n    a=0\n    x=0\n    out=[]\n    for row in vectors:\n        if 'areset' in row:\n            a=row['areset']\n        if 'x' in row:\n            x=row['x']&1\n        if a:\n            seen=0\n            z=0\n        else:\n            z=(x^seen)&1\n            seen=(seen|x)&1\n        out.append({'z':z&1})\n        mid=row.get('mid')\n        if mid:\n            if 'areset' in mid:\n                a=mid['areset']\n                if a:\n                    seen=0\n                    z=0\n            if 'x' in mid:\n                x=mid['x']&1\n    return out\n"
