"def reference(vectors):\n    state = 0  # 0: no 1 seen, last 0; 1: no 1 seen, last 1; 2: 1 seen, last 0; 3: 1 seen, last 1\n    result = []\n    for row in vectors:\n        areset = row.get('areset', 0) & 1\n        x = row.get('x', 0) & 1\n        if areset:\n            state = 0\n        else:\n            if state == 0:\n                state = 1 if x else 0\n            else:\n                state = 3 if x else 2\n        z = 1 if (state == 1 or state == 2) else 0\n        result.append({'z': z})\n    return result\n"
