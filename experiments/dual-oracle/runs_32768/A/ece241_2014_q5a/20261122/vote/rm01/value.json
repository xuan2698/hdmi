"def reference(vectors):\n    seen = False\n    out = []\n    for row in vectors:\n        if row.get('areset', 0):\n            seen = False\n            z = 0\n        else:\n            x = int(row.get('x', 0)) & 1\n            if not seen:\n                z = x\n                if x:\n                    seen = True\n            else:\n                z = 1 - x\n        out.append({'z': z})\n    return out\n"
