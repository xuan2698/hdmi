"def reference(vectors):\n    state = 0  # 0: no first 1 yet; 1: after first 1, output 1; 2: after first 1, output 0\n    result = []\n    for row in vectors:\n        if row.get('areset', 0):\n            state = 0\n        else:\n            x = row.get('x', 0)\n            if state == 0:\n                if x:\n                    state = 1\n            elif state == 1:\n                if x:\n                    state = 2\n            else:\n                if not x:\n                    state = 1\n        result.append({'z': 1 if state == 1 else 0})\n        mid = row.get('mid')\n        if isinstance(mid, dict) and mid.get('areset', 0):\n            state = 0\n    return result\n"
