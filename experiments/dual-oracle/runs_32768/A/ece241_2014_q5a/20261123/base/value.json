"def reference(vectors):\n    st=0\n    cur={'areset':0,'x':0}\n    out=[]\n    for row in vectors:\n        for k,v in row.items():\n            if k!='mid':\n                cur[k]=v\n        if cur.get('areset',0):\n            st=0\n        else:\n            x=cur.get('x',0)\n            if st==0:\n                st=1 if x else 0\n            else:\n                st=2 if x else 1\n        out.append({'z':1 if st==1 else 0})\n        if 'mid' in row:\n            cur.update(row['mid'])\n            if cur.get('areset',0):\n                st=0\n    return out\n"
