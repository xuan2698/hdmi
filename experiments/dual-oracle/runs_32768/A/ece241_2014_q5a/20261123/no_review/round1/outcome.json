{
  "decisions": [
    {
      "id": "s5/4/z",
      "label": "TB",
      "spec_quote": "The conversion begins when Reset is released"
    }
  ],
  "RM": "def reference(vectors):\n    state = 0  # 0: no 1 seen, 1: carry with z=1, 2: carry with z=0\n    result = []\n    for row in vectors:\n        if row.get('areset', 0):\n            state = 0\n        else:\n            x = row.get('x', 0)\n            if state == 0:\n                if x:\n                    state = 1\n            elif state == 1:\n                if x:\n                    state = 2\n            else:\n                if not x:\n                    state = 1\n        result.append({'z': 1 if state == 1 else 0})\n    return result\n",
  "TB": [
    {
      "id": "s1",
      "spec_quote": "positive edge triggered asynchronous reset",
      "covers": [
        "behavior",
        "priority",
        "reset"
      ],
