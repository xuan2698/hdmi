"def reference(vectors):\n    seen = 0\n    out = []\n    for row in vectors:\n        areset = row.get('areset', 0) & 1\n        x = row.get('x', 0) & 1\n        if areset:\n            seen = 0\n            z = 0\n        else:\n            z = (1 - x) if seen else x\n            if x:\n                seen = 1\n        out.append({'z': z & 1})\n    return out\n"
