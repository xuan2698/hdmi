"def reference(vectors):\n    state = 0  # 0: before first 1; 1: after first 1, last output 1; 2: after first 1, last output 0\n    out = []\n    for row in vectors:\n        if row.get('areset', 0):\n            state = 0\n            z = 0\n        else:\n            x = row['x']\n            if state == 0:\n                if x:\n                    state = 1\n                    z = 1\n                else:\n                    state = 0\n                    z = 0\n            else:\n                if x:\n                    state = 2\n                    z = 0\n                else:\n                    state = 1\n                    z = 1\n        out.append({'z': z})\n    return out\n"
