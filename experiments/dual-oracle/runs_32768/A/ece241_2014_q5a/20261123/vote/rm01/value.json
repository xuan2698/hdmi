"def reference(vectors):\n    state = 0\n    result = []\n    for row in vectors:\n        areset = row.get('areset', 0)\n        x = row.get('x', 0)\n        if areset:\n            state = 0\n            z = 0\n        else:\n            if state == 0:\n                state = 1 if x else 0\n            else:\n                state = 2 if x else 1\n            z = 1 if state == 1 else 0\n        result.append({'z': z})\n    return result\n"
