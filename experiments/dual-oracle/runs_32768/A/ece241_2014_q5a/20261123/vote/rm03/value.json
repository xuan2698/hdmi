"def reference(vectors):\n    out = []\n    state = 0\n    for row in vectors:\n        if row.get('areset', 0):\n            state = 0\n        else:\n            x = row.get('x', 0) & 1\n            if state == 0:\n                if x:\n                    state = 1\n            elif state == 1:\n                if x:\n                    state = 2\n            else:\n                if not x:\n                    state = 1\n        out.append({'z': 1 if state == 1 else 0})\n    return out\n"
