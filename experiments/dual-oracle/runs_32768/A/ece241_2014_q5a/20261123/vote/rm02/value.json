"def reference(vectors):\n    state = 0  # 0: no first 1 seen, z=0; 1: after first 1, z=1; 2: after first 1, z=0\n    out = []\n    for row in vectors:\n        if row['areset']:\n            state = 0\n            z = 0\n        else:\n            x = row['x']\n            if state == 0:\n                if x == 0:\n                    state = 0\n                    z = 0\n                else:\n                    state = 1\n                    z = 1\n            elif state == 1:\n                if x == 0:\n                    state = 1\n                    z = 1\n                else:\n                    state = 2\n                    z = 0\n            else:\n                if x == 0:\n                    state = 1\n                    z = 1\n                else:\n                    state = 2\n                    z = 0\n        out.append({'z': z})\n    return out\n"
