"def reference(vectors):\n    st=0\n    cur={'areset':0,'x':0}\n    res=[]\n    for row in vectors:\n        for k in ('areset','x'):\n            if k in row:\n                cur[k]=int(row[k])\n        if cur['areset']:\n            st=0\n        else:\n            x=cur['x']\n            if st==0:\n                st=1 if x else 0\n            elif st==1:\n                st=2 if x else 1\n            else:\n                st=2 if x else 1\n        res.append({'z':1 if st==1 else 0})\n        mid=row.get('mid')\n        if mid:\n            for k,v in mid.items():\n                if k in ('areset','x'):\n                    cur[k]=int(v)\n                    if k=='areset' and cur[k]:\n                        st=0\n    return res\n"
