"def reference(vectors):\n    seen = 0\n    out = []\n    for row in vectors:\n        a = row.get('areset', 0)\n        x = row.get('x', 0) & 1\n        if a:\n            seen = 0\n            z = 0\n        else:\n            z = x if seen == 0 else (1 ^ x)\n            if x:\n                seen = 1\n        out.append({'z': z & 1})\n    return out\n"
