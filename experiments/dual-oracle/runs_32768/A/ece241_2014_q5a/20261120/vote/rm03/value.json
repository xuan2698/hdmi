"def reference(vectors):\n    state = 0\n    result = []\n    for row in vectors:\n        areset = row.get('areset', 0) if isinstance(row, dict) else row[0]\n        x = row.get('x', 0) if isinstance(row, dict) else row[1]\n        if areset:\n            state = 0\n        else:\n            if state == 0:\n                state = 1 if x else 0\n            elif state == 1:\n                state = 2 if x else 1\n            else:\n                state = 2 if x else 1\n        result.append({'z': 1 if state == 1 else 0})\n    return result\n"
