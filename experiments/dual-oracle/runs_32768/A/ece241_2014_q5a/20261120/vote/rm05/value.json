"def reference(vectors):\n    seen = 0\n    z = 0\n    result = []\n    for row in vectors:\n        areset = int(row.get('areset', 0)) & 1\n        x = int(row.get('x', 0)) & 1\n        if areset:\n            seen = 0\n            z = 0\n        else:\n            if seen:\n                z = 1 - x\n            else:\n                z = x\n                if x:\n                    seen = 1\n        result.append({'z': z})\n    return result\n"
