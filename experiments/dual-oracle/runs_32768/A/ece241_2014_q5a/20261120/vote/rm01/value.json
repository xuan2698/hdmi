"def reference(vectors):\n    st = 0\n    out = []\n    for v in vectors:\n        a = v.get('areset', 0)\n        x = v.get('x', 0)\n        if a:\n            st = 0\n        else:\n            if st == 0:\n                st = 1 if x else 0\n            elif st == 1:\n                st = 2 if x else 1\n            else:\n                st = 2 if x else 1\n        out.append({'z': 1 if st == 1 else 0})\n    return out\n"
