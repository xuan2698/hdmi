"def reference(vectors):\n    q=0\n    r=0\n    out=[]\n    for v in vectors:\n        if 'reset' in v:\n            r=v['reset']\n        if r:\n            q=0\n        else:\n            q=0 if q==9 else q+1\n        out.append({'q':q})\n        if 'mid' in v:\n            m=v['mid']\n            if 'reset' in m:\n                r=m['reset']\n    return out\n"
