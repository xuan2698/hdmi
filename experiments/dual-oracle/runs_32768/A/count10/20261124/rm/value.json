"def reference(vectors):\n    s = 0\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            r = row.get('reset', 0)\n        else:\n            r = row[0] if len(row) else 0\n        if r:\n            s = 0\n        else:\n            s = 0 if s >= 9 else s + 1\n        out.append({'q': s})\n    return out\n"
