"def reference(vectors):\n    q = 0\n    prev_clk = 0\n    out = []\n    for v in vectors:\n        if 'clk' in v:\n            clk = v['clk']\n            if clk == 1 and prev_clk == 0:\n                if v['reset'] == 1:\n                    q = 0\n                else:\n                    q = (q + 1) % 10\n            prev_clk = clk\n        else:\n            if v['reset'] == 1:\n                q = 0\n            else:\n                q = (q + 1) % 10\n        out.append({'q': q})\n    return out\n"
