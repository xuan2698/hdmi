"def reference(vectors):\n    q=0\n    inp={'reset':0}\n    res=[]\n    for row in vectors:\n        for k,v in row.items():\n            if k!='mid':\n                inp[k]=v\n        if inp.get('reset',0):\n            q=0\n        else:\n            q=0 if q==9 else q+1\n        res.append({'q':q})\n        if 'mid' in row:\n            for k,v in row['mid'].items():\n                inp[k]=v\n    return res\n"
