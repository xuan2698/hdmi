"def reference(vectors):\n    q = 0\n    result = []\n    for row in vectors:\n        if isinstance(row, dict):\n            reset = row.get(\"reset\", 0)\n        else:\n            reset = row[0] if isinstance(row, (list, tuple)) else row\n        if reset:\n            q = 0\n        else:\n            q = (q + 1) % 10\n        result.append({\"q\": q})\n    return result\n"
