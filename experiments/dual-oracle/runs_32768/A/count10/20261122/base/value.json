"def reference(vectors):\n    q=0\n    inp={}\n    out=[]\n    for row in vectors:\n        for k,v in row.items():\n            if k!='mid':\n                inp[k]=v\n        if inp.get('reset',0):\n            q=0\n        else:\n            q=(q+1)%10\n        out.append({'q':q})\n        mid=row.get('mid')\n        if isinstance(mid,dict):\n            for k,v in mid.items():\n                inp[k]=v\n    return out\n"
