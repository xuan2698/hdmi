"def reference(vectors):\n    q = 0\n    reset = 0\n    out = []\n    for row in vectors:\n        for k, v in row.items():\n            if k == 'reset':\n                reset = int(v)\n        if reset:\n            q = 0\n        else:\n            q = (q + 1) % 10\n        out.append({'q': q})\n        if 'mid' in row:\n            for k, v in row['mid'].items():\n                if k == 'reset':\n                    reset = int(v)\n    return out\n"
