"def reference(vectors):\n    q = 0\n    prev_clk = 0\n    out = []\n    for row in vectors:\n        if 'clk' in row:\n            clk = int(row['clk']) & 1\n            posedge = prev_clk == 0 and clk == 1\n            prev_clk = clk\n        else:\n            posedge = True\n\n        if posedge:\n            reset = int(row.get('reset', 0)) & 1\n            if reset:\n                q = 0\n            else:\n                q = (q + 1) % 10\n\n        out.append({'q': q})\n\n    return out\n"
