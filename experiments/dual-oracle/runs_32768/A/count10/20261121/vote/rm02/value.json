"def reference(vectors):\n    q = 0\n    result = []\n    for row in vectors:\n        if isinstance(row, dict):\n            reset = row.get(\"reset\", 0)\n        elif isinstance(row, (list, tuple)):\n            reset = row[0] if row else 0\n        else:\n            reset = row\n        if reset:\n            q = 0\n        else:\n            q += 1\n            if q == 10:\n                q = 0\n        result.append({\"q\": q})\n    return result\n"
