"def reference(vectors):\n    q=0\n    r=0\n    o=[]\n    for v in vectors:\n        if 'reset' in v:\n            r=v['reset']\n        if r:\n            q=0\n        else:\n            q=0 if q==9 else q+1\n        o.append({'q':q&15})\n        m=v.get('mid')\n        if m and 'reset' in m:\n            r=m['reset']\n    return o\n"
