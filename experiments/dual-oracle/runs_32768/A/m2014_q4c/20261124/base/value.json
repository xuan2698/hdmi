"def reference(vectors):\n    d = r = q = 0\n    out = []\n    for v in vectors:\n        if 'd' in v: d = v['d'] & 1\n        if 'r' in v: r = v['r'] & 1\n        q = 0 if (r & 1) else (d & 1)\n        out.append({'q': q})\n        if 'mid' in v:\n            m = v['mid']\n            if 'd' in m: d = m['d'] & 1\n            if 'r' in m: r = m['r'] & 1\n    return out\n"
