"def reference(vectors):\n    q = 0\n    d = 0\n    r = 0\n    out = []\n    for row in vectors:\n        for k, v in row.items():\n            if k == 'mid':\n                continue\n            if k == 'd':\n                d = v\n            elif k == 'r':\n                r = v\n        q = 0 if r else d\n        out.append({'q': q & 1})\n        mid = row.get('mid')\n        if isinstance(mid, dict):\n            for k, v in mid.items():\n                if k == 'd':\n                    d = v\n                elif k == 'r':\n                    r = v\n    return out\n"
