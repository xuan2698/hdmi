"def reference(vectors):\n    q = 0\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            d = row.get('d', 0)\n            r = row.get('r', 0)\n        else:\n            d = row[0]\n            r = row[1]\n        q = 0 if r else (d & 1)\n        out.append({'q': q})\n    return out\n"
