"def reference(vectors):\n    result = []\n    for row in vectors:\n        if isinstance(row, dict):\n            d = int(row['d'])\n            r = int(row['r'])\n        else:\n            d = int(row[0])\n            r = int(row[1])\n        q = 0 if (r & 1) else (d & 1)\n        result.append({'q': q & 1})\n    return result\n"
