"def reference(vectors):\n    q=0\n    d=0\n    r=0\n    out=[]\n    for row in vectors:\n        if 'd' in row: d=row['d']\n        if 'r' in row: r=row['r']\n        q=0 if r else d\n        out.append({'q':q})\n        mid=row.get('mid')\n        if isinstance(mid,dict):\n            if 'd' in mid: d=mid['d']\n            if 'r' in mid: r=mid['r']\n    return out\n"
