"def reference(vectors):\n    q=0\n    d=0\n    r=0\n    res=[]\n    for row in vectors:\n        d=row.get('d', d)&1\n        r=row.get('r', r)&1\n        if r: q=0\n        else: q=d\n        res.append({'q':q&1})\n        mid=row.get('mid', {})\n        if 'd' in mid: d=mid['d']&1\n        if 'r' in mid: r=mid['r']&1\n    return res\n"
