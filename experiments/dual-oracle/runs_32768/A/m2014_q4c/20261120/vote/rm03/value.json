"def reference(vectors):\n    q = 0\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            d = row['d']\n            r = row['r']\n        else:\n            d = row[0]\n            r = row[1]\n        if r:\n            q = 0\n        else:\n            q = d & 1\n        out.append({'q': q})\n    return out\n"
