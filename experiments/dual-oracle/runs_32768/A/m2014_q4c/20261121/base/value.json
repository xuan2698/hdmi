"def reference(vectors):\n    q = 0\n    cur = {'d': 0, 'r': 0}\n    out = []\n    for row in vectors:\n        for k in ('d', 'r'):\n            if k in row:\n                cur[k] = row[k]\n        q = 0 if cur.get('r', 0) else (cur.get('d', 0) & 1)\n        out.append({'q': q})\n        mid = row.get('mid')\n        if isinstance(mid, dict):\n            for k, v in mid.items():\n                if k in ('d', 'r'):\n                    cur[k] = v\n    return out\n"
