"def reference(vectors):\n    q=0\n    d=0\n    reset=0\n    out=[]\n    for row in vectors:\n        if 'd' in row:\n            d=row['d']\n        if 'reset' in row:\n            reset=row['reset']\n        if reset:\n            q=0x34\n        else:\n            q=d & 0xFF\n        out.append({'q': q & 0xFF})\n        if 'mid' in row:\n            m=row['mid']\n            if 'd' in m:\n                d=m['d']\n            if 'reset' in m:\n                reset=m['reset']\n    return out\n"
