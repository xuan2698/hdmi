"def reference(vectors):\n    q = 0\n    prev_clk = None\n    out = []\n    for row in vectors:\n        clk = row.get('clk', 0)\n        d = row.get('d', 0) & 255\n        reset = row.get('reset', 0)\n        if prev_clk == 1 and clk == 0:\n            q = 0x34 if reset else d\n        out.append({'q': q & 255})\n        prev_clk = clk\n    return out\n"
