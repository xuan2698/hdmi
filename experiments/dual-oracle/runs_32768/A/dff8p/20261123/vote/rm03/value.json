"def reference(vectors):\n    q = 0x34\n    prev_clk = 1\n    out = []\n    for r in vectors:\n        if 'clk' in r:\n            clk = r['clk']\n            if prev_clk == 1 and clk == 0:\n                if r.get('reset', 0):\n                    q = 0x34\n                else:\n                    q = r.get('d', 0) & 0xFF\n            prev_clk = clk\n        else:\n            if r.get('reset', 0):\n                q = 0x34\n            else:\n                q = r.get('d', 0) & 0xFF\n        out.append({'q': q & 0xFF})\n    return out\n"
