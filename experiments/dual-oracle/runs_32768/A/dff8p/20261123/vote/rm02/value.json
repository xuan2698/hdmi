"def reference(vectors):\n    out = []\n    for v in vectors:\n        if isinstance(v, dict):\n            r = v.get('reset', 0)\n            d = v.get('d', 0)\n        else:\n            d = v[0] if len(v) > 0 else 0\n            r = v[1] if len(v) > 1 else 0\n        q = 0x34 if r else (d & 0xFF)\n        out.append({'q': q})\n    return out\n"
