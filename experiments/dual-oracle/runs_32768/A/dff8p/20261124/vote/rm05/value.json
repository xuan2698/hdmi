"def reference(vectors):\n    q = 0\n    prev_clk = 0\n    out = []\n    for row in vectors:\n        if 'clk' in row:\n            clk = row['clk']\n            if prev_clk == 1 and clk == 0:\n                q = 0x34 if row['reset'] else row['d']\n            prev_clk = clk\n        else:\n            q = 0x34 if row['reset'] else row['d']\n        out.append({'q': q})\n    return out\n"
