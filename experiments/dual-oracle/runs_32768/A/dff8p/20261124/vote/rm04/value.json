"def reference(vectors):\n    q = 0\n    out = []\n    prev_clk = 1\n    for v in vectors:\n        if 'clk' in v:\n            c = v['clk']\n            if prev_clk == 1 and c == 0:\n                q = 0x34 if v.get('reset', 0) else (v.get('d', 0) & 0xFF)\n            prev_clk = c\n        else:\n            q = 0x34 if v.get('reset', 0) else (v.get('d', 0) & 0xFF)\n        out.append({'q': q})\n    return out\n"
