"def reference(vectors):\n    q=0\n    d=0\n    reset=0\n    out=[]\n    for row in vectors:\n        if 'd' in row: d=row['d']\n        if 'reset' in row: reset=row['reset']\n        q=0x34 if reset else d&0xFF\n        out.append({'q':q&0xFF})\n        if 'mid' in row:\n            mid=row['mid']\n            if 'd' in mid: d=mid['d']\n            if 'reset' in mid: reset=mid['reset']\n    return out\n"
