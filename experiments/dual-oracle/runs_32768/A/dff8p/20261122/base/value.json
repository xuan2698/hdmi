"def reference(vectors):\n    q=0\n    d=0\n    reset=0\n    out=[]\n    for row in vectors:\n        if 'd' in row: d=row['d']&0xff\n        if 'reset' in row: reset=row['reset']&1\n        if reset: q=0x34\n        else: q=d&0xff\n        out.append({'q':q})\n        mid=row.get('mid')\n        if mid:\n            if 'd' in mid: d=mid['d']&0xff\n            if 'reset' in mid: reset=mid['reset']&1\n    return out\n"
