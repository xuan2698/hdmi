"def reference(vectors):\n    s={'d':0,'reset':0}; out=[]\n    for r in vectors:\n        for k in ('d','reset'):\n            if k in r: s[k]=r[k]\n        out.append({'q': 0x34 if s['reset'] else (s['d'] & 0xFF)})\n        if 'mid' in r:\n            for k in ('d','reset'):\n                if k in r['mid']: s[k]=r['mid'][k]\n    return out\n"
