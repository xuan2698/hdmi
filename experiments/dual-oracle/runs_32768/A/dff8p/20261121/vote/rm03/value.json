"def reference(vectors):\n    q = 0\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            d = row['d']\n            rst = row['reset']\n        else:\n            d = row[0]\n            rst = row[1]\n        if rst:\n            q = 0x34\n        else:\n            q = d & 0xFF\n        out.append({'q': q})\n    return out\n"
