"def reference(vectors):\n    q = 0x34\n    prev = None\n    out = []\n    for v in vectors:\n        if isinstance(v, dict):\n            d = v.get('d', 0)\n            r = v.get('reset', 0)\n            has_clk = 'clk' in v\n            c = v.get('clk', 0)\n        else:\n            d = v[0] if len(v) > 0 else 0\n            r = v[1] if len(v) > 1 else 0\n            has_clk = len(v) > 2\n            c = v[2] if has_clk else 0\n        if has_clk:\n            edge = (c == 0) if prev is None else (prev == 1 and c == 0)\n            if edge:\n                q = 0x34 if r else (d & 0xFF)\n            prev = c\n        else:\n            q = 0x34 if r else (d & 0xFF)\n        out.append({'q': q & 0xFF})\n    return out\n"
