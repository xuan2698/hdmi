"def reference(vectors):\n    q = 0\n    d = 0\n    reset = 0\n    out = []\n    for row in vectors:\n        if 'd' in row:\n            d = row['d'] & 0xFF\n        if 'reset' in row:\n            reset = row['reset'] & 1\n        if reset:\n            q = 0x34\n        else:\n            q = d\n        out.append({'q': q & 0xFF})\n        mid = row.get('mid')\n        if isinstance(mid, dict):\n            if 'd' in mid:\n                d = mid['d'] & 0xFF\n            if 'reset' in mid:\n                reset = mid['reset'] & 1\n    return out\n"
