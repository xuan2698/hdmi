"def reference(vectors):\n    q = 0\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            d = row.get('d', 0)\n            reset = row.get('reset', 0)\n        else:\n            d = row[0]\n            reset = row[1]\n        if reset & 1:\n            q = 0x34\n        else:\n            q = d & 0xFF\n        out.append({'q': q})\n    return out\n"
