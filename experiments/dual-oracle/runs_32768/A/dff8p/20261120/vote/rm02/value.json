"def reference(vectors):\n    out = []\n    for v in vectors:\n        if isinstance(v, dict):\n            d = v['d']\n            rst = v['reset']\n        else:\n            d = v[0]\n            rst = v[1]\n        q = 0x34 if rst else (d & 0xFF)\n        out.append({'q': q})\n    return out\n"
