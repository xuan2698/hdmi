  "RM": "def reference(vectors):\n    q = 0x34\n    out = []\n    for v in vectors:\n        reset = v.get('reset', 0) & 1\n        d = v.get('d', 0) & 0xFF\n        if reset:\n            q = 0x34\n        else:\n            q = d\n        out.append({'q': q & 0xFF})\n    return out\n",
  "TB": [
    {
      "id": "s1",
      "spec_quote": "active high synchronous reset",
      "covers": [
        "behavior",
        "priority",
        "reset"
      ],
      "vectors": [
        {
          "d": 0,
          "reset": 1
        },
        {
          "d": 255,
          "reset": 1
        },
        {
          "d": 18,
          "reset": 0
        },
        {
          "d": 126,
          "reset": 0
        },
        {
          "d": 0,
          "reset": 1
        }
      ],
      "expected": [
        {
          "q": 52
        },
        {
          "q": 52
        },
        {
          "q": 18
        },
        {
          "q": 126
        },
        {
          "q": 52
        }
      ]
    },
