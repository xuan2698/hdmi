"def reference(vectors):\n    state = 0\n    out = []\n    has_clk = bool(vectors) and (\"clk\" in vectors[0])\n    if has_clk:\n        prev_clk = 0\n        prev_a = 0\n        prev_b = 0\n        have_prev = False\n        for v in vectors:\n            clk = int(v[\"clk\"])\n            a = int(v[\"a\"])\n            b = int(v[\"b\"])\n            if clk == 1 and prev_clk == 0:\n                sa = prev_a if have_prev else a\n                sb = prev_b if have_prev else b\n                state = (sa & sb) | (state & (sa | sb))\n            q = state ^ a ^ b\n            out.append({\"q\": q, \"state\": state})\n            prev_clk = clk\n            prev_a = a\n            prev_b = b\n            have_prev = True\n    else:\n        for v in vectors:\n            a = int(v[\"a\"])\n            b = int(v[\"b\"])\n            state = (a & b) | (state & (a | b))\n            q = state ^ a ^ b\n            out.append({\"q\": q, \"state\": state})\n    return out\n"
