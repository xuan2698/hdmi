"def reference(vectors):\n    state = 0\n    outputs = []\n    for row in vectors:\n        a = int(row['a']) & 1\n        b = int(row['b']) & 1\n        nxt = int((a & b) | (state & (a ^ b)))\n        q = int(a ^ b ^ nxt)\n        outputs.append({'q': q, 'state': nxt})\n        state = nxt\n    return outputs\n"
