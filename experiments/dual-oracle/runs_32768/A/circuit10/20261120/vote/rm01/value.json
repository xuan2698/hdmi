"def reference(vectors):\n    state = 0\n    prev_clk = 0\n    prev_a = 0\n    prev_b = 0\n    have_prev = False\n    out = []\n    for row in vectors:\n        a = int(row.get('a', 0)) & 1\n        b = int(row.get('b', 0)) & 1\n        if 'clk' in row:\n            clk = int(row.get('clk', 0)) & 1\n        elif 'CLK' in row:\n            clk = int(row.get('CLK', 0)) & 1\n        else:\n            clk = None\n        if clk is None:\n            state = (a & b) | (state & (a | b))\n        else:\n            if clk == 1 and prev_clk == 0:\n                if have_prev:\n                    sa = prev_a\n                    sb = prev_b\n                else:\n                    sa = a\n                    sb = b\n                state = (sa & sb) | (state & (sa | sb))\n            prev_clk = clk\n        q = (a ^ b ^ state) & 1\n        out.append({'q': q, 'state': state})\n        prev_a = a\n        prev_b = b\n        have_prev = True\n    return out\n"
