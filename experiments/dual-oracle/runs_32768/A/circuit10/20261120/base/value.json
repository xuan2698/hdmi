"def reference(vectors):\n    state = 0\n    a = 0\n    b = 0\n    out = []\n    for row in vectors:\n        if 'a' in row:\n            a = row['a']\n        if 'b' in row:\n            b = row['b']\n        new_state = (a & b) | (a & state) | (b & state)\n        state = new_state\n        q = state ^ a ^ b\n        out.append({'q': q, 'state': state})\n        mid = row.get('mid', {})\n        if 'a' in mid:\n            a = mid['a']\n        if 'b' in mid:\n            b = mid['b']\n    return out\n"
