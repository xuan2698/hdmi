    }
  ],
  "RM": "def reference(vectors):\n    s = 0\n    prev_clk = 0\n    out = []\n    for row in vectors:\n        clk = row.get('clk', 0)\n        a = row.get('a', 0)\n        b = row.get('b', 0)\n        q = (a ^ b ^ s) & 1\n        out.append({'q': q, 'state': s})\n        if prev_clk == 1 and clk == 0:\n            s = ((a & b) | (a & s) | (b & s)) & 1\n        prev_clk = clk\n    return out\n",
