"def reference(vectors):\n    state = 0\n    prev_clk = 0\n    out = []\n    for row in vectors:\n        clk = row.get('clk', 0)\n        a = row.get('a', 0)\n        b = row.get('b', 0)\n        q = a ^ b ^ state\n        out.append({'q': q, 'state': state})\n        if prev_clk == 1 and clk == 0:\n            state = (a & b) | (a & state) | (b & state)\n        prev_clk = clk\n    return out\n"
