"def reference(vectors):\n    state = 0\n    prev_clk = None\n    prev_a = 0\n    prev_b = 0\n    out = []\n    for v in vectors:\n        clk = v.get('clk', 0)\n        a = v.get('a', 0)\n        b = v.get('b', 0)\n        if prev_clk == 0 and clk == 1:\n            if state == 0:\n                state = prev_a & prev_b\n            else:\n                state = prev_a | prev_b\n        q = a ^ b ^ state\n        out.append({'q': q, 'state': state})\n        prev_clk = clk\n        prev_a = a\n        prev_b = b\n    return out\n"
