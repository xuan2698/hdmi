"def reference(vectors):\n    state = 0\n    prev_clk = 0\n    last_a = 0\n    last_b = 0\n    result = []\n    for row in vectors:\n        if isinstance(row, dict):\n            clk = row.get('clk', 0)\n            a = row.get('a', 0)\n            b = row.get('b', 0)\n        else:\n            if len(row) >= 3:\n                clk, a, b = row[0], row[1], row[2]\n            else:\n                clk = 0\n                a, b = row[0], row[1]\n\n        if clk == 1 and prev_clk == 0:\n            if state:\n                state = last_a | last_b\n            else:\n                state = last_a & last_b\n\n        q = a ^ b ^ state\n        result.append({'q': q, 'state': state})\n        last_a = a\n        last_b = b\n        prev_clk = clk\n\n    return result\n"
