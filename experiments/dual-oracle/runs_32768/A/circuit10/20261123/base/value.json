"def reference(vectors):\n    state = 0\n    cur = {'a': 0, 'b': 0}\n    out = []\n    for v in vectors:\n        for k in ('a', 'b'):\n            if k in v:\n                cur[k] = v[k]\n        a, b = cur['a'], cur['b']\n        state = (a & b) | (a & state) | (b & state)\n        out.append({'q': a ^ b ^ state, 'state': state})\n        m = v.get('mid', {})\n        for k in ('a', 'b'):\n            if k in m:\n                cur[k] = m[k]\n    return out\n"
