  "RM": "def reference(vectors):\n    state = 0\n    result = []\n    for row in vectors:\n        a = row['a']\n        b = row['b']\n        q = a ^ b ^ state\n        result.append({'q': q, 'state': state})\n        state = (a & b) | (a & state) | (b & state)\n    return result\n",
  "TB": [
