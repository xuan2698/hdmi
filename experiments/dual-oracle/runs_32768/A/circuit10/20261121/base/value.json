"def reference(vectors):\n    state = 0\n    prev_clk = 0\n    a = 0\n    b = 0\n    result = []\n    for row in vectors:\n        clk = row.get('clk', prev_clk)\n        a = row.get('a', a)\n        b = row.get('b', b)\n        if clk == 1 and prev_clk == 0:\n            state = (a & b) | (a & state) | (b & state)\n        q = a ^ b ^ state\n        result.append({'q': int(q), 'state': int(state)})\n        if 'mid' in row:\n            mid = row['mid']\n            a = mid.get('a', a)\n            b = mid.get('b', b)\n            clk = mid.get('clk', clk)\n        prev_clk = clk\n    return result\n"
