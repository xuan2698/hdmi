    }
  ],
  "RM": "def reference(vectors):\n    state = 0\n    out = []\n    for v in vectors:\n        a = v.get('a', 0) & 1\n        b = v.get('b', 0) & 1\n        state = (a & b) | (state & (a | b))\n        q = (a ^ b ^ state) & 1\n        out.append({'q': q, 'state': state & 1})\n    return out\n",
