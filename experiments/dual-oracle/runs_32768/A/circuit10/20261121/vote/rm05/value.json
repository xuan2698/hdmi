"def reference(vectors):\n    state = 0\n    result = []\n    for row in vectors:\n        a = row['a']\n        b = row['b']\n        next_state = (state & (a | b)) | (a & b)\n        state = next_state\n        q = state ^ a ^ b\n        result.append({'q': q, 'state': state})\n    return result\n"
