"def reference(vectors):\n    state = 0\n    prev_a = 0\n    prev_b = 0\n    prev_clk = 0\n    out = []\n    for v in vectors:\n        a = v.get('a', 0)\n        b = v.get('b', 0)\n        if 'clk' in v:\n            clk = v['clk']\n            if clk == 1 and prev_clk == 0:\n                state = (prev_a & prev_b) if state == 0 else (prev_a | prev_b)\n            prev_clk = clk\n        else:\n            state = (prev_a & prev_b) if state == 0 else (prev_a | prev_b)\n        q = a ^ b ^ state\n        out.append({'q': q, 'state': state})\n        prev_a = a\n        prev_b = b\n    return out\n"
