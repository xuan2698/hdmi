"def reference(vectors):\n    state = 0\n    result = []\n    for v in vectors:\n        if isinstance(v, dict):\n            a = v.get('a', 0)\n            b = v.get('b', 0)\n        else:\n            a = v[0]\n            b = v[1]\n        a &= 1\n        b &= 1\n        nxt = (a & b) | (a & state) | (b & state)\n        state = nxt & 1\n        q = (a ^ b ^ state) & 1\n        result.append({'q': q, 'state': state})\n    return result\n"
