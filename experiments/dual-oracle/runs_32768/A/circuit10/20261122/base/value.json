"def reference(vectors):\n    state = 0\n    a = 0\n    b = 0\n    out = []\n    for v in vectors:\n        a = v.get('a', a)\n        b = v.get('b', b)\n        ns = (a & b) | (state & (a | b))\n        q = ns ^ a ^ b\n        out.append({'q': q & 1, 'state': ns & 1})\n        state = ns\n        if 'mid' in v:\n            m = v['mid']\n            a = m.get('a', a)\n            b = m.get('b', b)\n    return out\n"
