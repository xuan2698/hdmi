"def reference(vectors):\n    st = 0\n    out = []\n    pc = 0\n    pa = 0\n    pb = 0\n    has_clk = bool(vectors) and ('clk' in vectors[0])\n    for r in vectors:\n        a = int(r.get('a', 0)) & 1\n        b = int(r.get('b', 0)) & 1\n        if has_clk:\n            c = int(r.get('clk', 0)) & 1\n            if c == 1 and pc == 0:\n                st = 1 if (pa + pb + st) >= 2 else 0\n            pc = c\n            pa = a\n            pb = b\n        else:\n            st = 1 if (a + b + st) >= 2 else 0\n        q = (a ^ b ^ st) & 1\n        out.append({'q': q, 'state': st})\n    return out\n"
