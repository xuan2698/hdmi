"def reference(vectors):\n    state = 0\n    out = []\n    prev_clk = 0\n    prev_a = 0\n    prev_b = 0\n    first = True\n    for v in vectors:\n        if 'clk' in v:\n            clk = int(v['clk']) & 1\n            a = int(v['a']) & 1\n            b = int(v['b']) & 1\n            if clk and not prev_clk:\n                if first:\n                    if a == b:\n                        state = a\n                else:\n                    if prev_a == prev_b:\n                        state = prev_a\n            q = state ^ a ^ b\n            out.append({'q': q & 1, 'state': state & 1})\n            prev_clk = clk\n            prev_a = a\n            prev_b = b\n            first = False\n        else:\n            a = int(v['a']) & 1\n            b = int(v['b']) & 1\n            if a == b:\n                state = a\n            q = state ^ a ^ b\n            out.append({'q': q & 1, 'state': state & 1})\n            first = False\n    return out\n"
