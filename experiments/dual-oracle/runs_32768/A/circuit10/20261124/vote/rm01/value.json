"def reference(vectors):\n    state = 0\n    result = []\n    for row in vectors:\n        if isinstance(row, dict):\n            a = row['a']\n            b = row['b']\n        else:\n            a, b = row[0], row[1]\n        state = (a & b) | (a & state) | (b & state)\n        q = a ^ b ^ state\n        result.append({'q': q, 'state': state})\n    return result\n"
