"def reference(vectors):\n    state=0\n    inp={'reset':0,'data':0}\n    out=[]\n    for row in vectors:\n        for k in ('reset','data'):\n            if k in row:\n                inp[k]=row[k]\n        if inp.get('reset',0):\n            state=0\n        elif state!=4:\n            d=inp.get('data',0)\n            if state==0:\n                state=1 if d else 0\n            elif state==1:\n                state=2 if d else 0\n            elif state==2:\n                state=3 if d==0 else 2\n            elif state==3:\n                state=4 if d else 0\n        out.append({'start_shifting':1 if state==4 else 0})\n        if 'mid' in row:\n            for k,v in row['mid'].items():\n                inp[k]=v\n    return out\n"
