"def reference(vectors):\n    state = 0\n    start = 0\n    outputs = []\n    for row in vectors:\n        if isinstance(row, dict):\n            reset = row.get('reset', 0)\n            data = row.get('data', 0)\n        else:\n            reset = row[0]\n            data = row[1]\n\n        if reset:\n            state = 0\n            start = 0\n        elif not start:\n            if state == 0:\n                state = 1 if data else 0\n            elif state == 1:\n                state = 2 if data else 0\n            elif state == 2:\n                state = 2 if data else 3\n            else:\n                if data:\n                    start = 1\n                    state = 0\n                else:\n                    state = 0\n\n        outputs.append({'start_shifting': start})\n    return outputs\n"
