"def reference(vectors):\n    st = 0\n    out = []\n    for row in vectors:\n        reset = row[\"reset\"]\n        data = row[\"data\"]\n        if reset:\n            st = 0\n        else:\n            if st == 0:\n                if data:\n                    st = 1\n            elif st == 1:\n                st = 2 if data else 0\n            elif st == 2:\n                st = 2 if data else 3\n            elif st == 3:\n                st = 4 if data else 0\n            elif st == 4:\n                st = 4\n        out.append({\"start_shifting\": 1 if st == 4 else 0})\n    return out\n"
