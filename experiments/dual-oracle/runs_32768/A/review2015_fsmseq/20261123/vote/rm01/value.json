"def reference(vectors):\n    st = 0\n    start = 0\n    out = []\n    for row in vectors:\n        rst = row.get('reset', 0) if isinstance(row, dict) else row[0]\n        d = row.get('data', 0) if isinstance(row, dict) else row[1]\n        if rst:\n            st = 0\n            start = 0\n        elif not start:\n            if st == 0:\n                st = 1 if d else 0\n            elif st == 1:\n                st = 2 if d else 0\n            elif st == 2:\n                st = 2 if d else 3\n            else:\n                if d:\n                    start = 1\n                st = 0\n        out.append({'start_shifting': start})\n    return out\n"
