"def reference(vectors):\n    state = 0\n    result = []\n    for row in vectors:\n        if isinstance(row, dict):\n            reset = row.get('reset', 0)\n            data = row.get('data', 0)\n        else:\n            reset = row[0]\n            data = row[1]\n\n        if reset:\n            state = 0\n        else:\n            if state == 0:\n                if data:\n                    state = 1\n            elif state == 1:\n                if data:\n                    state = 2\n                else:\n                    state = 0\n            elif state == 2:\n                if data:\n                    state = 2\n                else:\n                    state = 3\n            elif state == 3:\n                if data:\n                    state = 4\n                else:\n                    state = 0\n            elif state == 4:\n                state = 4\n\n        result.append({'start_shifting': 1 if state == 4 else 0})\n\n    return result\n"
