"def reference(vectors):\n    state = 0\n    out = 0\n    result = []\n    for row in vectors:\n        if isinstance(row, dict):\n            reset = row.get(\"reset\", 0)\n            data = row.get(\"data\", 0)\n        else:\n            reset = row[0]\n            data = row[1]\n\n        if reset:\n            state = 0\n            out = 0\n        elif not out:\n            if data == 1:\n                if state == 0:\n                    state = 1\n                elif state == 1:\n                    state = 2\n                elif state == 2:\n                    state = 2\n                elif state == 3:\n                    state = 4\n                    out = 1\n            else:\n                if state == 0:\n                    state = 0\n                elif state == 1:\n                    state = 0\n                elif state == 2:\n                    state = 3\n                elif state == 3:\n                    state = 0\n\n        result.append({\"start_shifting\": out})\n\n    return result\n"
