"def reference(vectors):\n    state = 0  # 0=start, 1=seen 1, 2=seen 11, 3=seen 110, 4=found\n    outputs = []\n\n    for row in vectors:\n        reset = int(row[\"reset\"])\n        data = int(row[\"data\"])\n\n        if reset:\n            state = 0\n        elif state != 4:\n            if state == 0:\n                state = 1 if data == 1 else 0\n            elif state == 1:\n                state = 2 if data == 1 else 0\n            elif state == 2:\n                state = 3 if data == 0 else 2\n            elif state == 3:\n                state = 4 if data == 1 else 0\n\n        outputs.append({\"start_shifting\": int(state == 4)})\n\n    return outputs\n"
