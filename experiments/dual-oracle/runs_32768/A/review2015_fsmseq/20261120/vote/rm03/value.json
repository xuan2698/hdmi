"def reference(vectors):\n    s0, s1, s11, s110, found = 0, 1, 2, 3, 4\n    state = s0\n    start_shifting = 0\n    out = []\n\n    for row in vectors:\n        reset = row['reset']\n        data = row['data']\n\n        if reset:\n            state = s0\n            start_shifting = 0\n        else:\n            if state == found:\n                state = found\n            elif state == s0:\n                state = s1 if data else s0\n            elif state == s1:\n                state = s11 if data else s0\n            elif state == s11:\n                state = s11 if data else s110\n            elif state == s110:\n                if data:\n                    state = found\n                    start_shifting = 1\n                else:\n                    state = s0\n\n        out.append({'start_shifting': start_shifting})\n\n    return out\n"
