  "RM": "def reference(vectors):\n    state = 'S0'\n    out = []\n    for row in vectors:\n        if row['reset']:\n            state = 'S0'\n        else:\n            data = row['data'] & 1\n            if state == 'S0':\n                if data:\n                    state = 'S1'\n            elif state == 'S1':\n                if data:\n                    state = 'S2'\n                else:\n                    state = 'S0'\n            elif state == 'S2':\n                if data:\n                    state = 'S2'\n                else:\n                    state = 'S3'\n            elif state == 'S3':\n                if data:\n                    state = 'DONE'\n                else:\n                    state = 'S0'\n        out.append({'start_shifting': 1 if state == 'DONE' else 0})\n    return out\n",
