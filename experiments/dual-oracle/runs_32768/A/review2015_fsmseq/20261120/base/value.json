"def reference(vectors):\n    r=[]; s=0; o=0; reset=0; data=0\n    for row in vectors:\n        reset=row.get('reset',reset)\n        data=row.get('data',data)\n        if reset:\n            s=0; o=0\n        elif not o:\n            if s==0:\n                s=1 if data else 0\n            elif s==1:\n                s=2 if data else 0\n            elif s==2:\n                s=2 if data else 3\n            else:\n                if data: o=1\n                s=0\n        r.append({'start_shifting':o})\n        mid=row.get('mid',{})\n        reset=mid.get('reset',reset)\n        data=mid.get('data',data)\n    return r\n"
