"def reference(vectors):\n    state = 0\n    out = []\n    for row in vectors:\n        reset = row['reset']\n        data = row['data']\n        if reset:\n            state = 0\n        elif state != 4:\n            if state == 0:\n                state = 1 if data else 0\n            elif state == 1:\n                state = 2 if data else 0\n            elif state == 2:\n                state = 3 if data == 0 else 2\n            elif state == 3:\n                state = 4 if data else 0\n        out.append({'start_shifting': 1 if state == 4 else 0})\n    return out\n"
