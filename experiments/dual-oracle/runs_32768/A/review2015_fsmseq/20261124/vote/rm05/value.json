"def reference(vectors):\n    st = 0\n    out = []\n    for row in vectors:\n        r = row[\"reset\"]\n        d = row[\"data\"]\n        if r:\n            st = 0\n            y = 0\n        else:\n            if st == 0:\n                st = 1 if d else 0\n            elif st == 1:\n                st = 2 if d else 0\n            elif st == 2:\n                st = 3 if d == 0 else 2\n            elif st == 3:\n                st = 4 if d else 0\n            elif st == 4:\n                st = 4\n            y = 1 if st == 4 else 0\n        out.append({\"start_shifting\": y})\n    return out\n"
