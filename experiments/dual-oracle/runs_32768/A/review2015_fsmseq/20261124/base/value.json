"def reference(vectors):\n    s=0\n    start=0\n    reset=0\n    data=0\n    out=[]\n    for row in vectors:\n        if 'reset' in row: reset=row['reset']\n        if 'data' in row: data=row['data']\n        if reset:\n            s=0\n            start=0\n        elif not start:\n            if s==0:\n                s=1 if data else 0\n            elif s==1:\n                if data: s=2\n                else: s=0\n            elif s==2:\n                if data: s=2\n                else: s=3\n            else:\n                if data:\n                    start=1\n                    s=0\n                else:\n                    s=0\n        out.append({'start_shifting':start})\n        mid=row.get('mid')\n        if mid:\n            if 'reset' in mid: reset=mid['reset']\n            if 'data' in mid: data=mid['data']\n    return out\n"
