"def reference(vectors):\n    state = 0\n    result = []\n    for v in vectors:\n        reset = v[\"reset\"]\n        data = v[\"data\"]\n        if reset:\n            state = 0\n        else:\n            if state == 0:\n                if data == 1:\n                    state = 1\n            elif state == 1:\n                if data == 1:\n                    state = 2\n                else:\n                    state = 0\n            elif state == 2:\n                if data == 0:\n                    state = 3\n                else:\n                    state = 2\n            elif state == 3:\n                if data == 1:\n                    state = 4\n                else:\n                    state = 0\n        result.append({\"start_shifting\": 1 if state == 4 else 0})\n    return result\n"
