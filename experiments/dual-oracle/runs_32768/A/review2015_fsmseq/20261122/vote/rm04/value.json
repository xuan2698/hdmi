"def reference(vectors):\n    state = 0\n    out = 0\n    result = []\n    for row in vectors:\n        reset = row.get('reset', 0)\n        data = row.get('data', 0)\n        if reset:\n            state = 0\n            out = 0\n        elif not out:\n            if state == 0:\n                state = 1 if data else 0\n            elif state == 1:\n                state = 2 if data else 0\n            elif state == 2:\n                state = 2 if data else 3\n            else:\n                if data:\n                    out = 1\n                    state = 0\n                else:\n                    state = 0\n        result.append({'start_shifting': out})\n    return result\n"
