"def reference(vectors):\n    state = \"S0\"\n    start_shifting = 0\n    result = []\n    for row in vectors:\n        reset = row[\"reset\"] & 1\n        data = row[\"data\"] & 1\n        if reset:\n            state = \"S0\"\n            start_shifting = 0\n        elif not start_shifting:\n            if state == \"S0\":\n                state = \"S1\" if data else \"S0\"\n            elif state == \"S1\":\n                state = \"S2\" if data else \"S0\"\n            elif state == \"S2\":\n                if data:\n                    state = \"S2\"\n                else:\n                    state = \"S3\"\n            elif state == \"S3\":\n                if data:\n                    state = \"DONE\"\n                    start_shifting = 1\n                else:\n                    state = \"S0\"\n        result.append({\"start_shifting\": start_shifting})\n    return result\n"
