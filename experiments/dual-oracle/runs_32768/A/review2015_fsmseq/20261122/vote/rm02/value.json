"def reference(vectors):\n    state = 0\n    result = []\n    for row in vectors:\n        reset = row.get('reset', 0)\n        data = row.get('data', 0)\n\n        if reset:\n            state = 0\n        else:\n            if state == 0:\n                state = 1 if data else 0\n            elif state == 1:\n                state = 2 if data else 0\n            elif state == 2:\n                state = 2 if data else 3\n            elif state == 3:\n                state = 4 if data else 0\n            elif state == 4:\n                state = 4\n\n        result.append({'start_shifting': 1 if state == 4 else 0})\n\n    return result\n"
