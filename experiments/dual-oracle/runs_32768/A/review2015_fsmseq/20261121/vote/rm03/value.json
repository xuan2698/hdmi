"def reference(vectors):\n    state = 0\n    result = []\n    for row in vectors:\n        reset = int(row[\"reset\"])\n        data = int(row[\"data\"])\n        if reset:\n            state = 0\n            start_shifting = 0\n        elif state == 4:\n            start_shifting = 1\n        else:\n            start_shifting = 0\n            if state == 0:\n                state = 1 if data else 0\n            elif state == 1:\n                state = 2 if data else 0\n            elif state == 2:\n                state = 2 if data else 3\n            elif state == 3:\n                if data:\n                    state = 4\n                    start_shifting = 1\n                else:\n                    state = 0\n        result.append({\"start_shifting\": start_shifting})\n    return result\n"
