"def reference(vectors):\n    state = 0\n    out = 0\n    result = []\n    for row in vectors:\n        reset = row['reset']\n        data = row['data']\n        if reset:\n            state = 0\n            out = 0\n        elif out == 0:\n            if state == 0:\n                if data == 1:\n                    state = 1\n            elif state == 1:\n                if data == 1:\n                    state = 2\n                else:\n                    state = 0\n            elif state == 2:\n                if data == 0:\n                    state = 3\n                else:\n                    state = 2\n            elif state == 3:\n                if data == 1:\n                    state = 4\n                    out = 1\n                else:\n                    state = 0\n        result.append({'start_shifting': out})\n    return result\n"
