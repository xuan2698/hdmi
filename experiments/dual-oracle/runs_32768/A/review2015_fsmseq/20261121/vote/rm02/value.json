"def reference(vectors):\n    state = 0\n    outputs = []\n    for row in vectors:\n        reset = row[\"reset\"]\n        data = row[\"data\"]\n        if reset:\n            state = 0\n            start_shifting = 0\n        else:\n            if state == 0:\n                if data == 1:\n                    state = 1\n            elif state == 1:\n                state = 2 if data == 1 else 0\n            elif state == 2:\n                state = 3 if data == 0 else 2\n            elif state == 3:\n                if data == 1:\n                    state = 4\n                else:\n                    state = 0\n            start_shifting = 1 if state == 4 else 0\n        outputs.append({\"start_shifting\": start_shifting})\n    return outputs\n"
