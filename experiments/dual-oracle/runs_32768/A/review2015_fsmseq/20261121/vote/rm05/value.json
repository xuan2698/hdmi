"def reference(vectors):\n    s = 0\n    out = 0\n    ans = []\n    for row in vectors:\n        r = row[\"reset\"] & 1\n        d = row[\"data\"] & 1\n        if r:\n            s = 0\n            out = 0\n        elif out:\n            out = 1\n        else:\n            if s == 0:\n                if d:\n                    s = 1\n                else:\n                    s = 0\n            elif s == 1:\n                if d:\n                    s = 2\n                else:\n                    s = 0\n            elif s == 2:\n                if d:\n                    s = 2\n                else:\n                    s = 3\n            else:\n                if d:\n                    out = 1\n                s = 0\n        ans.append({\"start_shifting\": out})\n    return ans\n"
