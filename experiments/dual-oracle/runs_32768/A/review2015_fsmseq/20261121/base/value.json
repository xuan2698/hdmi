"def reference(vectors):\n    state = 0\n    cur = {'reset': 0, 'data': 0}\n    out = []\n    for row in vectors:\n        for k in ('reset', 'data'):\n            if k in row:\n                cur[k] = row[k]\n        if cur['reset']:\n            state = 0\n        else:\n            d = cur['data']\n            if state == 0:\n                state = 1 if d else 0\n            elif state == 1:\n                state = 2 if d else 0\n            elif state == 2:\n                state = 2 if d else 3\n            elif state == 3:\n                state = 4 if d else 0\n        out.append({'start_shifting': 1 if state == 4 else 0})\n        if 'mid' in row:\n            for k, v in row['mid'].items():\n                if k in ('reset', 'data'):\n                    cur[k] = v\n    return out\n"
