"def reference(vectors):\n    out = []\n    for v in vectors:\n        x = int(v['x']) & 1\n        y = int(v['y']) & 7\n        y2 = (y >> 2) & 1\n        y1 = (y >> 1) & 1\n        y0 = y & 1\n\n        if x == 0:\n            Y0 = y2 | y0\n        else:\n            Y0 = 1 if (y2 == 0 and y0 == 0) else 0\n\n        z = 1 if (y2 == 1 or (y1 == 1 and y0 == 1)) else 0\n\n        out.append({'Y0': Y0, 'z': z})\n    return out\n"
