"def reference(vectors):\n    out = []\n    for v in vectors:\n        x = v[\"x\"]\n        y = v[\"y\"]\n        y0 = y & 1\n        y1 = (y >> 1) & 1\n        y2 = (y >> 2) & 1\n        Y0 = ((y0 | y2) ^ x) & 1\n        z = (y2 | (y1 & y0)) & 1\n        out.append({\"Y0\": Y0, \"z\": z})\n    return out\n"
