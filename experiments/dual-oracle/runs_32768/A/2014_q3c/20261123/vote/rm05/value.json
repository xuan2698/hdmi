"def reference(vectors):\n    table = {\n        0: (0, 1, 0),\n        1: (1, 0, 0),\n        2: (0, 1, 0),\n        3: (1, 0, 1),\n        4: (1, 0, 1),\n    }\n    result = []\n    for row in vectors:\n        x = int(row[\"x\"]) & 1\n        y = int(row[\"y\"]) & 7\n        if y in table:\n            y0_x0, y0_x1, z = table[y]\n            y0 = y0_x1 if x else y0_x0\n        else:\n            y0 = 0\n            z = 0\n        result.append({\"Y0\": y0, \"z\": z})\n    return result\n"
