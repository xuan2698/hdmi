"def reference(vectors):\n    out = []\n    for v in vectors:\n        x = v['x']\n        y = v['y']\n        y2 = (y >> 2) & 1\n        y1 = (y >> 1) & 1\n        y0 = y & 1\n        out.append({\n            'Y0': ((y0 | y2) & (1 - x)) | ((1 - y2) & (1 - y0) & x),\n            'z': y2 | (y1 & y0)\n        })\n    return out\n"
