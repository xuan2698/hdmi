"def reference(vectors):\n    result = []\n    for row in vectors:\n        if isinstance(row, dict):\n            x = row['x'] & 1\n            y = row['y'] & 7\n        else:\n            x = row[0] & 1\n            y = row[1] & 7\n        a = (y >> 2) & 1\n        b = (y >> 1) & 1\n        c = y & 1\n        Y0 = ((a | c) ^ x) & 1\n        z = (a | (b & c)) & 1\n        result.append({'Y0': Y0, 'z': z})\n    return result\n"
