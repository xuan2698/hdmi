"def reference(vectors):\n    x = 0\n    y = 0\n    out = []\n    for v in vectors:\n        if 'x' in v:\n            x = v['x']\n        if 'y' in v:\n            y = v['y']\n        y0 = y & 1\n        y1 = (y >> 1) & 1\n        y2 = (y >> 2) & 1\n        Y0 = ((1 - x) & y0) | ((1 - x) & y2) | (x & (1 - y2) & (1 - y0))\n        z = y2 | (y1 & y0)\n        out.append({'Y0': Y0, 'z': z})\n        if 'mid' in v:\n            m = v['mid']\n            if 'x' in m:\n                x = m['x']\n            if 'y' in m:\n                y = m['y']\n    return out\n"
