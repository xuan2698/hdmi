"def reference(vectors):\n    out = []\n    for row in vectors:\n        x = row['x'] & 1\n        y = row['y'] & 7\n        y2 = (y >> 2) & 1\n        y1 = (y >> 1) & 1\n        y0 = y & 1\n        Y0 = x ^ (y2 | y0)\n        z = y2 | (y1 & y0)\n        out.append({'Y0': Y0, 'z': z})\n    return out\n"
