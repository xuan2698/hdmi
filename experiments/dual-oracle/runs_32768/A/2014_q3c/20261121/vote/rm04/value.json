"def reference(vectors):\n    next_y0 = {\n        (0, 0): 0, (0, 1): 1, (0, 2): 0, (0, 3): 1, (0, 4): 1,\n        (1, 0): 1, (1, 1): 0, (1, 2): 1, (1, 3): 0, (1, 4): 0,\n    }\n    zmap = {0: 0, 1: 0, 2: 0, 3: 1, 4: 1}\n    result = []\n    for row in vectors:\n        x = int(row['x']) & 1\n        y = int(row['y']) & 7\n        result.append({\n            'Y0': next_y0.get((x, y), 0),\n            'z': zmap.get(y, 0),\n        })\n    return result\n"
