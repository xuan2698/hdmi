"def reference(vectors):\n    out = []\n    for v in vectors:\n        if isinstance(v, dict):\n            x = v.get('x', 0)\n            y = v.get('y', 0)\n        elif hasattr(v, 'x') and hasattr(v, 'y'):\n            x = v.x\n            y = v.y\n        else:\n            x = v[0]\n            y = v[1]\n        x = int(x) & 1\n        y = int(y) & 7\n        if y == 0:\n            Y0 = x\n            z = 0\n        elif y == 1:\n            Y0 = 0 if x else 1\n            z = 0\n        elif y == 2:\n            Y0 = x\n            z = 0\n        elif y == 3:\n            Y0 = 0 if x else 1\n            z = 1\n        elif y == 4:\n            Y0 = 0 if x else 1\n            z = 1\n        else:\n            Y0 = 0\n            z = 0\n        out.append({'Y0': Y0, 'z': z})\n    return out\n"
