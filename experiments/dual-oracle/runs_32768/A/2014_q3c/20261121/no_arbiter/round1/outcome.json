  "RM": "def reference(vectors):\n    result = []\n    for row in vectors:\n        x = row['x'] & 1\n        y = row['y'] & 7\n        y0 = y & 1\n        y1 = (y >> 1) & 1\n        y2 = (y >> 2) & 1\n        Y0 = ((1 - x) & (y0 | y2)) | (x & (1 - y2) & (1 - y0))\n        z = y2 | (y1 & y0)\n        result.append({'Y0': Y0 & 1, 'z': z & 1})\n    return result\n",
