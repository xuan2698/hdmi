"def reference(vectors):\n    s={'x':0,'y':0}\n    out=[]\n    for row in vectors:\n        for k,v in row.items():\n            if k!='mid' and k in s:\n                s[k]=v\n        x=s['x']&1\n        y=s['y']&7\n        y2=(y>>2)&1\n        y1=(y>>1)&1\n        y0=y&1\n        out.append({'Y0':(x^(y2|y0))&1,'z':(y2|(y1&y0))&1})\n        if 'mid' in row:\n            for k,v in row['mid'].items():\n                if k in s:\n                    s[k]=v\n    return out\n"
