"def reference(vectors):\n    y0_tbl = ((0, 1), (1, 0), (0, 1), (1, 0), (1, 0), (0, 0), (0, 0), (0, 0))\n    z_tbl = (0, 0, 0, 1, 1, 0, 0, 0)\n    result = []\n    for row in vectors:\n        y = row['y']\n        x = row['x']\n        result.append({'Y0': y0_tbl[y][x], 'z': z_tbl[y]})\n    return result\n"
