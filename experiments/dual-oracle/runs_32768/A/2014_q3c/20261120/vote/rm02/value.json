"def reference(vectors):\n    result = []\n    for row in vectors:\n        x = int(row['x']) & 1\n        y = int(row['y']) & 7\n        a = (y >> 2) & 1\n        b = (y >> 1) & 1\n        c = y & 1\n        Y0 = x ^ (a | c)\n        z = a | (b & c)\n        result.append({'Y0': Y0 & 1, 'z': z & 1})\n    return result\n"
