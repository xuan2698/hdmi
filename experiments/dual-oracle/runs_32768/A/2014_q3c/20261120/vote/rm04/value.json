"def reference(vectors):\n    result = []\n    for v in vectors:\n        x = v['x'] & 1\n        y = v['y'] & 7\n        if y == 0 or y == 2:\n            Y0 = x\n        elif y == 1 or y == 3 or y == 4:\n            Y0 = 1 - x\n        else:\n            Y0 = 0\n        z = 1 if y == 3 or y == 4 else 0\n        result.append({'Y0': Y0, 'z': z})\n    return result\n"
