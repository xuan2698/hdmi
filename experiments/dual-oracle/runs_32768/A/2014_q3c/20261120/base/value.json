"def reference(vectors):\n    x=y=0;r=[]\n    for v in vectors:\n        if'x'in v:x=v['x']&1\n        if'y'in v:y=v['y']&7\n        a=(y>>2)&1;b=(y>>1)&1;c=y&1\n        Y0=((x&(1-a)&(1-c))|((1-x)&(a|c)))&1\n        z=(a|(b&c))&1\n        r.append({'Y0':Y0,'z':z})\n        if'mid'in v:\n            m=v['mid']\n            if'x'in m:x=m['x']&1\n            if'y'in m:y=m['y']&7\n    return r\n"
