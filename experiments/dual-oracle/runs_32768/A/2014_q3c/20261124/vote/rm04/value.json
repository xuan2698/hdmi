"def reference(vectors):\n    table = {\n        0: (0, 1, 0),\n        1: (1, 0, 0),\n        2: (0, 1, 0),\n        3: (1, 0, 1),\n        4: (1, 0, 1),\n    }\n    out = []\n    for v in vectors:\n        x = v['x']\n        y = v['y']\n        n0, n1, z = table.get(y, (0, 0, 0))\n        out.append({'Y0': n1 if x else n0, 'z': z})\n    return out\n"
