"def reference(vectors):\n    result = []\n    for row in vectors:\n        x = int(row['x']) & 1\n        y = int(row['y']) & 7\n\n        if y == 0:\n            Y0 = x\n            z = 0\n        elif y == 1:\n            Y0 = 1 - x\n            z = 0\n        elif y == 2:\n            Y0 = x\n            z = 0\n        elif y == 3:\n            Y0 = 1 - x\n            z = 1\n        elif y == 4:\n            Y0 = 1 - x\n            z = 1\n        else:\n            Y0 = 0\n            z = 0\n\n        result.append({'Y0': Y0, 'z': z})\n\n    return result\n"
