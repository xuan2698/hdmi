"def reference(vectors):\n    out = []\n    for v in vectors:\n        x = v['x'] & 1\n        y = v['y'] & 7\n        y2 = (y >> 2) & 1\n        y1 = (y >> 1) & 1\n        y0 = y & 1\n\n        Y0 = ((y2 | y0) & (1 - x)) | ((1 - y2) & (1 - y0) & x)\n        z = y2 | (y1 & y0)\n\n        out.append({'Y0': Y0, 'z': z})\n    return out\n"
