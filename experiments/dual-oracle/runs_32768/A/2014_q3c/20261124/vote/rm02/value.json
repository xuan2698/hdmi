"def reference(vectors):\n    out = []\n    for row in vectors:\n        x = int(row[\"x\"]) & 1\n        y = int(row[\"y\"]) & 7\n        a = (y >> 2) & 1\n        b = (y >> 1) & 1\n        c = y & 1\n        y0 = ((1 - x) & (a | c)) | (x & (1 - a) & (1 - c))\n        z = a | (b & c)\n        out.append({\"Y0\": y0 & 1, \"z\": z & 1})\n    return out\n"
