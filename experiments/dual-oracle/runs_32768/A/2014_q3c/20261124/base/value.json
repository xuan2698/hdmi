"def reference(vectors):\n    x = 0\n    y = 0\n    res = []\n    for row in vectors:\n        if 'x' in row:\n            x = row['x'] & 1\n        if 'y' in row:\n            y = row['y'] & 7\n        y0 = y & 1\n        y1 = (y >> 1) & 1\n        y2 = (y >> 2) & 1\n        Y0 = (x ^ y0 ^ y2) & 1\n        z = (y1 & y0) | ((1 ^ y1) & y2)\n        z = z & 1\n        res.append({'Y0': Y0, 'z': z})\n        if 'mid' in row:\n            mid = row['mid']\n            if 'x' in mid:\n                x = mid['x'] & 1\n            if 'y' in mid:\n                y = mid['y'] & 7\n    return res\n"
