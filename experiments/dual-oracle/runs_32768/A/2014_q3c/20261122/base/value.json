"def reference(vectors):\n    cur={'x':0,'y':0}\n    out=[]\n    for r in vectors:\n        for k in ('x','y'):\n            if k in r: cur[k]=r[k]\n        x=cur['x']&1\n        y=cur['y']&7\n        a=(y>>2)&1\n        b=(y>>1)&1\n        c=y&1\n        Y0=(((a^1)&(c^x))|(a&(x^1)))&1\n        z=(a|(b&c))&1\n        out.append({'Y0':Y0,'z':z})\n        if 'mid' in r:\n            for k,v in r['mid'].items():\n                if k in cur: cur[k]=v\n    return out\n"
