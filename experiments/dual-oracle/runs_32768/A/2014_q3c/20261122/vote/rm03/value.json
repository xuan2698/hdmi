"def reference(vectors):\n    out = []\n    for row in vectors:\n        x = row['x']\n        y = row['y']\n        y2 = (y >> 2) & 1\n        y1 = (y >> 1) & 1\n        y0 = y & 1\n        Y0 = (x ^ y0) if y2 == 0 else (1 - x)\n        z = y2 | (y1 & y0)\n        out.append({'Y0': int(Y0) & 1, 'z': int(z) & 1})\n    return out\n"
