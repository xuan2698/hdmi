"def reference(vectors):\n    out = []\n    for row in vectors:\n        x = row['x'] & 1\n        y = row['y'] & 7\n        if y == 0:\n            Y0 = x\n            z = 0\n        elif y == 1:\n            Y0 = 1 if x == 0 else 0\n            z = 0\n        elif y == 2:\n            Y0 = x\n            z = 0\n        elif y == 3:\n            Y0 = 1 if x == 0 else 0\n            z = 1\n        elif y == 4:\n            Y0 = 1 if x == 0 else 0\n            z = 1\n        else:\n            Y0 = 0\n            z = 0\n        out.append({'Y0': Y0, 'z': z})\n    return out\n"
