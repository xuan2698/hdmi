"def reference(vectors):\n    result = []\n    for row in vectors:\n        x = row['x'] & 1\n        y = row['y'] & 7\n        a = (y >> 2) & 1\n        b = (y >> 1) & 1\n        c = y & 1\n        xp = 1 - x\n        Y0 = (a & xp) | (c & xp) | ((1 - a) & (1 - c) & x)\n        z = a | (b & c)\n        result.append({'Y0': Y0, 'z': z})\n    return result\n"
