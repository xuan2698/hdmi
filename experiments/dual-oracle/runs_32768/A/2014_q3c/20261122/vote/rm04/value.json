"def reference(vectors):\n    out = []\n    for row in vectors:\n        x = row['x'] & 1\n        y = row['y'] & 7\n        if y == 0:\n            y0 = x\n        elif y == 1:\n            y0 = 1 ^ x\n        elif y == 2:\n            y0 = x\n        elif y == 3:\n            y0 = 1 ^ x\n        elif y == 4:\n            y0 = 1 ^ x\n        else:\n            y0 = 0\n        z = 1 if y == 3 or y == 4 else 0\n        out.append({'Y0': y0 & 1, 'z': z})\n    return out\n"
