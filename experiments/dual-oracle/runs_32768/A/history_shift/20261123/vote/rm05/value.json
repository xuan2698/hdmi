"def reference(vectors):\n    h = 0\n    M = (1 << 32) - 1\n    out = []\n    for v in vectors:\n        if v.get('areset', 0):\n            h = 0\n        elif v.get('train_mispredicted', 0):\n            h = ((int(v.get('train_history', 0)) << 1) | int(v.get('train_taken', 0))) & M\n        elif v.get('predict_valid', 0):\n            h = ((h << 1) | int(v.get('predict_taken', 0))) & M\n        out.append({'predict_history': h & M})\n    return out\n"
