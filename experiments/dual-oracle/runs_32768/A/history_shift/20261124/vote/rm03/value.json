"def reference(vectors):\n    history = 0\n    mask = 0xFFFFFFFF\n    outputs = []\n    for row in vectors:\n        if row['areset']:\n            history = 0\n        elif row['train_mispredicted']:\n            history = ((row['train_history'] << 1) | row['train_taken']) & mask\n        elif row['predict_valid']:\n            history = ((history << 1) | row['predict_taken']) & mask\n        outputs.append({'predict_history': history})\n    return outputs\n"
