"def reference(vectors):\n    h = 0\n    mask = (1 << 32) - 1\n    out = []\n    for v in vectors:\n        if v.get('areset', 0):\n            h = 0\n        elif v.get('train_mispredicted', 0):\n            h = ((v.get('train_history', 0) << 1) | v.get('train_taken', 0)) & mask\n        elif v.get('predict_valid', 0):\n            h = ((h << 1) | v.get('predict_taken', 0)) & mask\n        out.append({'predict_history': h})\n    return out\n"
