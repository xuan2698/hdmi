"def reference(vectors):\n    mask = (1 << 32) - 1\n    hist = 0\n    result = []\n    for row in vectors:\n        if row['areset']:\n            hist = 0\n        elif row['train_mispredicted']:\n            hist = (((row['train_history'] & mask) << 1) | (row['train_taken'] & 1)) & mask\n        elif row['predict_valid']:\n            hist = ((hist << 1) | (row['predict_taken'] & 1)) & mask\n        result.append({'predict_history': hist & mask})\n    return result\n"
