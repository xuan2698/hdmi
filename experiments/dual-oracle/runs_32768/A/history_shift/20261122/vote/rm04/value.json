"def reference(vectors):\n    hist = 0\n    mask = (1 << 32) - 1\n    out = []\n    for row in vectors:\n        if row['areset']:\n            hist = 0\n        elif row['train_mispredicted']:\n            hist = ((row['train_history'] << 1) | row['train_taken']) & mask\n        elif row['predict_valid']:\n            hist = ((hist << 1) | row['predict_taken']) & mask\n        out.append({'predict_history': hist & mask})\n    return out\n"
