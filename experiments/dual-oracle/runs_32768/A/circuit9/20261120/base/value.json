"def reference(vectors):\n    q = 0\n    current_a = 0\n    prev_clk = 0\n    res = []\n    for row in vectors:\n        clk = row.get('clk', prev_clk)\n        a = row.get('a', current_a)\n        if prev_clk == 0 and clk == 1:\n            if a == 1:\n                q = 4\n            else:\n                q = (q + 1) % 7\n        res.append({'q': q})\n        current_a = a\n        if 'mid' in row:\n            mid = row['mid']\n            if 'a' in mid:\n                current_a = mid['a']\n        prev_clk = clk\n    return res\n"
