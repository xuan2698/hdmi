"def reference(vectors):\n    q = 0\n    pa = 0\n    pc = 0\n    res = []\n    for v in vectors:\n        a = v.get('a', 0)\n        c = v.get('clk', None)\n        if c is None:\n            pos = True\n        else:\n            pos = (c == 1 and pc == 0)\n            pc = c\n        if pos:\n            if a == 1:\n                q = 4\n            elif pa == 0:\n                q = (q + 1) % 7\n            pa = a\n        res.append({'q': q})\n    return res\n"
