"def reference(vectors):\n    q = 0\n    out = []\n    for v in vectors:\n        if isinstance(v, dict):\n            a = v.get('a', 0)\n        elif isinstance(v, (list, tuple)):\n            a = v[0]\n        else:\n            a = v\n        if a:\n            q = 4\n        else:\n            q = 0 if q == 6 else q + 1\n        out.append({'q': q})\n    return out\n"
