"def reference(vectors):\n    q = 0\n    prev_clk = 0\n    out = []\n    for row in vectors:\n        clk = row.get('clk', 0)\n        a = row.get('a', 0)\n        if clk == 1 and prev_clk == 0:\n            if a == 1:\n                q = 4\n            else:\n                if q == 6:\n                    q = 0\n                else:\n                    q = q + 1\n        prev_clk = clk\n        out.append({'q': q})\n    return out\n"
