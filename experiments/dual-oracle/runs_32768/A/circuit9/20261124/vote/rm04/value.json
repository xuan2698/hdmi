"def reference(vectors):\n    q = 0\n    outputs = []\n    for row in vectors:\n        a = row['a'] & 1\n        if a:\n            q = 4\n        else:\n            if q == 6:\n                q = 0\n            else:\n                q = (q + 1) & 7\n        outputs.append({'q': q})\n    return outputs\n"
