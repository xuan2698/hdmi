"def reference(vectors):\n    q=0\n    prev=0\n    cur={}\n    res=[]\n    for v in vectors:\n        for k,x in v.items():\n            if k!='mid':\n                cur[k]=x\n        clk=cur.get('clk',0)\n        if prev==0 and clk==1:\n            a=cur.get('a',0)\n            if a:\n                q=4\n            else:\n                q=(q+1)%7\n        res.append({'q':q&7})\n        if 'mid' in v:\n            for k,x in v['mid'].items():\n                cur[k]=x\n        prev=clk\n    return res\n"
