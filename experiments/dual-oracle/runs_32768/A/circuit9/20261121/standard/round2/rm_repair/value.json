"def reference(vectors):\n    q = 4\n    pa = 1\n    out = []\n    for v in vectors:\n        a = v[\"a\"]\n        if a:\n            q = 4\n        elif pa == 0:\n            q = 0 if q == 6 else q + 1\n        else:\n            q = 4\n        out.append({\"q\": q})\n        pa = a\n    return out\n"
