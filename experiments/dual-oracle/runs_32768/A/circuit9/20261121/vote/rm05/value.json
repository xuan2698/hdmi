"def reference(vectors):\n    q = 0\n    pc = 0\n    out = []\n    for v in vectors:\n        c = v.get('clk', 0)\n        a = v.get('a', 0)\n        if c == 1 and pc == 0:\n            if a:\n                q = 4\n            else:\n                q = 0 if q == 6 else (q + 1) & 7\n        out.append({'q': q})\n        pc = c\n    return out\n"
