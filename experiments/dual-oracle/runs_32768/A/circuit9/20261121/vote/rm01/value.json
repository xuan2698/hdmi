"def reference(vectors):\n    q = 4\n    prev_a = 1\n    result = []\n    for v in vectors:\n        a = v['a']\n        if a == 1:\n            q = 4\n        else:\n            if prev_a == 1:\n                q = 4\n            else:\n                q = (q + 1) % 7\n        prev_a = a\n        result.append({'q': q})\n    return result\n"
