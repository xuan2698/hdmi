"def reference(vectors):\n    q=0\n    prev_a=0\n    clk=0\n    a=0\n    out=[]\n    for v in vectors:\n        nc=v.get('clk',clk)\n        na=v.get('a',a)\n        if clk==0 and nc==1:\n            if na==1:\n                q=4\n            elif prev_a==0:\n                q=(q+1)%7\n            prev_a=na\n        out.append({'q':q&7})\n        a=na\n        if 'mid' in v and 'a' in v['mid']:\n            a=v['mid']['a']\n        clk=nc\n    return out\n"
