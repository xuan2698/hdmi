"def reference(vectors):\n    q = 0\n    cur = {'clk': 0, 'a': 0}\n    prev = 0\n    out = []\n    for v in vectors:\n        for k, val in v.items():\n            if k != 'mid':\n                cur[k] = val\n        clk = cur.get('clk', 0)\n        a = cur.get('a', 0)\n        if prev == 0 and clk == 1:\n            if a:\n                q = 4\n            else:\n                q = 0 if q == 6 else q + 1\n        out.append({'q': q})\n        if 'mid' in v:\n            for k, val in v['mid'].items():\n                cur[k] = val\n        prev = clk\n    return out\n"
