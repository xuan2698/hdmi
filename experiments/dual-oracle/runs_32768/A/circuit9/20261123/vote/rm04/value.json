"def reference(vectors):\n    q = 4\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            a = row['a']\n        elif isinstance(row, (list, tuple)):\n            a = row[0]\n        else:\n            a = row\n        if a:\n            q = 4\n        else:\n            q = 0 if q == 6 else q + 1\n        out.append({'q': q})\n    return out\n"
