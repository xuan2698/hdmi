"def reference(vectors):\n    q=0\n    pa=0\n    pc=0\n    cur={}\n    out=[]\n    for r in vectors:\n        for k,v in r.items():\n            if k!='mid':\n                cur[k]=v\n        c=cur.get('clk',0)\n        a=cur.get('a',0)\n        if pc==0 and c==1:\n            if a==1:\n                q=4\n            elif pa==0:\n                q=(q+1)%7\n            pa=a\n        out.append({'q':q})\n        m=r.get('mid')\n        if m:\n            for k,v in m.items():\n                cur[k]=v\n        pc=c\n    return out\n"
