"def reference(vectors):\n    q = 4\n    res = []\n    for v in vectors:\n        if isinstance(v, dict):\n            a = v['a']\n        else:\n            a = v if isinstance(v, int) else v[0]\n        if a:\n            q = 4\n        else:\n            q = (q + 1) % 7\n        res.append({'q': q})\n    return res\n"
