"def reference(vectors):\n    q = 0\n    pa = 0\n    out = []\n    for v in vectors:\n        a = v.get('a', 0)\n        clk = v.get('clk', 1)\n        if clk == 1:\n            if a == 1:\n                q = 4\n            elif pa == 0:\n                q = (q + 1) % 7\n            pa = a\n        out.append({'q': q})\n    return out\n"
