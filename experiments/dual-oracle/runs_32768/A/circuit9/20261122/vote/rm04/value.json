"def reference(vectors):\n    q = 0\n    out = []\n    has_clk = any(isinstance(r, dict) and 'clk' in r for r in vectors)\n    prev_clk = 0\n\n    for row in vectors:\n        if isinstance(row, dict):\n            a = row.get('a', 0)\n            clk = row.get('clk', None)\n        else:\n            if has_clk:\n                clk, a = row[0], row[1]\n            else:\n                a = row[0]\n                clk = None\n\n        if has_clk:\n            if clk is None:\n                clk = 0\n            if prev_clk == 0 and clk == 1:\n                if a:\n                    q = 4\n                else:\n                    q = (q + 1) % 7\n            prev_clk = clk\n        else:\n            if a:\n                q = 4\n            else:\n                q = (q + 1) % 7\n\n        out.append({'q': q})\n\n    return out\n"
