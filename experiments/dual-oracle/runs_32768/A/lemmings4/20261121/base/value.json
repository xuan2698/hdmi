"def reference(vectors):\n    mode=0; d=0; c=0\n    cur={'areset':0,'bump_left':0,'bump_right':0,'ground':1,'dig':0}\n    out=[]\n    for row in vectors:\n        mid=row.get('mid',{}) or {}\n        for k,v in row.items():\n            if k!='mid':\n                cur[k]=v\n        if cur.get('areset',0):\n            mode=0; d=0; c=0\n        else:\n            g=cur.get('ground',1); bl=cur.get('bump_left',0); br=cur.get('bump_right',0); dg=cur.get('dig',0)\n            if mode==0:\n                if not g:\n                    mode=1; c=1\n                else:\n                    if dg:\n                        mode=2\n                    elif d==0:\n                        if bl: d=1\n                    else:\n                        if br: d=0\n            elif mode==2:\n                if not g:\n                    mode=1; c=1\n            elif mode==1:\n                if not g:\n                    c+=1\n                else:\n                    if c>20:\n                        mode=3; c=0\n                    else:\n                        mode=0; c=0\n        o={'walk_left':0,'walk_right':0,'aaah':0,'digging':0}\n        if mode==0:\n            o['walk_left']=int(d==0); o['walk_right']=int(d==1)\n        elif mode==1:\n            o['aaah']=1\n        elif mode==2:\n            o['digging']=1\n        out.append(o)\n        old=cur.get('areset',0)\n        for k,v in mid.items():\n            cur[k]=v\n        if cur.get('areset',0)==1 and old==0:\n            mode=0; d=0; c=0\n    return out\n"
