{
  "decisions": [],
  "RM": "def reference(vectors):\n    mode = 0       # 0=walk, 1=fall, 2=dig, 3=splat\n    direction = 0  # 0=left, 1=right\n    fall_count = 0\n    out = []\n\n    for row in vectors:\n        if isinstance(row, dict):\n            areset = int(row.get('areset', 0))\n            bump_left = int(row.get('bump_left', 0))\n            bump_right = int(row.get('bump_right', 0))\n            ground = int(row.get('ground', 0))\n            dig = int(row.get('dig', 0))\n        else:\n            areset, bump_left, bump_right, ground, dig = [int(x) for x in row]\n\n        if areset:\n            mode = 0\n            direction = 0\n            fall_count = 0\n        elif mode == 3:\n            pass\n        elif mode == 1:\n            fall_count += 1\n            if ground == 1:\n                if fall_count > 20:\n                    mode = 3\n                else:\n                    mode = 0\n                fall_count = 0\n        elif mode == 0:\n            if ground == 0:\n                mode = 1\n                fall_count = 0\n            elif dig == 1:\n                mode = 2\n            elif direction == 0:\n                if bump_left == 1:\n                    direction = 1\n            else:\n                if bump_right == 1:\n                    direction = 0\n        elif mode == 2:\n            if ground == 0:\n                mode = 1\n                fall_count = 0\n\n        walk_left = 0\n        walk_right = 0\n        aaah = 0\n        digging = 0\n\n        if mode == 1:\n            aaah = 1\n        elif mode == 2:\n            digging = 1\n        elif mode == 0:\n            if direction == 0:\n                walk_left = 1\n            else:\n                walk_right = 1\n\n        out.append({\n            'walk_left': walk_left,\n            'walk_right': walk_right,\n            'aaah': aaah,\n            'digging': digging\n        })\n\n    return out\n",
