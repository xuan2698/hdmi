"def reference(vectors):\n    s = 0\n    c = 0\n    out = []\n    for r in vectors:\n        a = r['areset']\n        bl = r['bump_left']\n        br = r['bump_right']\n        g = r['ground']\n        d = r['dig']\n        if a:\n            s = 0\n            c = 0\n        elif s == 0:\n            if g == 0:\n                s = 2\n                c = 1\n            elif d == 1:\n                s = 4\n                c = 0\n            elif bl == 1:\n                s = 1\n                c = 0\n        elif s == 1:\n            if g == 0:\n                s = 3\n                c = 1\n            elif d == 1:\n                s = 5\n                c = 0\n            elif br == 1:\n                s = 0\n                c = 0\n        elif s == 2:\n            if g == 1:\n                if c > 20:\n                    s = 6\n                    c = 0\n                else:\n                    s = 0\n                    c = 0\n            else:\n                c += 1\n        elif s == 3:\n            if g == 1:\n                if c > 20:\n                    s = 6\n                    c = 0\n                else:\n                    s = 1\n                    c = 0\n            else:\n                c += 1\n        elif s == 4:\n            if g == 0:\n                s = 2\n                c = 1\n        elif s == 5:\n            if g == 0:\n                s = 3\n                c = 1\n\n        o = {\n            'walk_left': 0,\n            'walk_right': 0,\n            'aaah': 0,\n            'digging': 0\n        }\n        if s == 0:\n            o['walk_left'] = 1\n        elif s == 1:\n            o['walk_right'] = 1\n        elif s == 2 or s == 3:\n            o['aaah'] = 1\n        elif s == 4 or s == 5:\n            o['digging'] = 1\n        out.append(o)\n    return out\n"
