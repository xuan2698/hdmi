"def reference(vectors):\n    def output(st):\n        return {\n            'walk_left': 1 if st == 'WL' else 0,\n            'walk_right': 1 if st == 'WR' else 0,\n            'aaah': 1 if st == 'FL' or st == 'FR' else 0,\n            'digging': 1 if st == 'DL' or st == 'DR' else 0,\n        }\n\n    st = 'WL'\n    fall_count = 0\n    result = []\n\n    for r in vectors:\n        if r['areset']:\n            st = 'WL'\n            fall_count = 0\n        else:\n            ground = r['ground']\n            dig = r['dig']\n            bump_left = r['bump_left']\n            bump_right = r['bump_right']\n\n            if st == 'SP':\n                pass\n            elif st == 'WL' or st == 'WR':\n                if ground == 0:\n                    st = 'FL' if st == 'WL' else 'FR'\n                    fall_count = 1\n                elif dig == 1:\n                    st = 'DL' if st == 'WL' else 'DR'\n                    fall_count = 0\n                else:\n                    if st == 'WL':\n                        if bump_left:\n                            st = 'WR'\n                    else:\n                        if bump_right:\n                            st = 'WL'\n            elif st == 'FL' or st == 'FR':\n                if ground == 1:\n                    if fall_count > 20:\n                        st = 'SP'\n                    else:\n                        st = 'WL' if st == 'FL' else 'WR'\n                    fall_count = 0\n                else:\n                    fall_count += 1\n            elif st == 'DL' or st == 'DR':\n                if ground == 0:\n                    st = 'FL' if st == 'DL' else 'FR'\n                    fall_count = 1\n\n        result.append(output(st))\n\n    return result\n"
