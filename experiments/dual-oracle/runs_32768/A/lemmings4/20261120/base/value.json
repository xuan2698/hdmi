"def reference(vectors):\n    ins=['areset','bump_left','bump_right','ground','dig']\n    cur={k:0 for k in ins}\n    st=0\n    cnt=0\n    out=[]\n    for row in vectors:\n        for k in ins:\n            if k in row:\n                cur[k]=row[k]\n        if cur['areset']:\n            st=0\n            cnt=0\n        elif st==6:\n            pass\n        elif st in (2,3):\n            if cur['ground']==0:\n                cnt+=1\n            else:\n                if cnt>=20:\n                    st=6\n                else:\n                    st=0 if st==2 else 1\n                cnt=0\n        elif st in (0,1):\n            if cur['ground']==0:\n                st=2 if st==0 else 3\n                cnt=0\n            elif cur['dig']==1:\n                st=4 if st==0 else 5\n                cnt=0\n            else:\n                bl=cur['bump_left']\n                br=cur['bump_right']\n                if bl and br:\n                    st=1 if st==0 else 0\n                elif bl:\n                    st=1\n                elif br:\n                    st=0\n        elif st in (4,5):\n            if cur['ground']==0:\n                st=2 if st==4 else 3\n                cnt=0\n        out.append({\n            'walk_left': int(st==0),\n            'walk_right': int(st==1),\n            'aaah': int(st in (2,3)),\n            'digging': int(st in (4,5))\n        })\n        mid=row.get('mid',{})\n        for k,v in mid.items():\n            if k in ins:\n                cur[k]=v\n        if mid.get('areset',0)==1:\n            st=0\n            cnt=0\n    return out\n"
