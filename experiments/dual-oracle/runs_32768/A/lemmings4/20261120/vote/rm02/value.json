"def reference(vectors):\n    s = 0\n    c = 0\n    result = []\n    for r in vectors:\n        if r[\"areset\"]:\n            s = 0\n            c = 0\n        else:\n            bL = r[\"bump_left\"]\n            bR = r[\"bump_right\"]\n            g = r[\"ground\"]\n            d = r[\"dig\"]\n\n            if s == 6:\n                pass\n            elif s == 4 or s == 5:\n                if g:\n                    if c > 20:\n                        s = 6\n                        c = 0\n                    else:\n                        s = 0 if s == 4 else 1\n                        c = 0\n                else:\n                    c += 1\n            elif s == 0:\n                if not g:\n                    s = 4\n                    c = 1\n                elif d:\n                    s = 2\n                elif bL:\n                    s = 1\n            elif s == 1:\n                if not g:\n                    s = 5\n                    c = 1\n                elif d:\n                    s = 3\n                elif bR:\n                    s = 0\n            elif s == 2:\n                if not g:\n                    s = 4\n                    c = 1\n            elif s == 3:\n                if not g:\n                    s = 5\n                    c = 1\n\n        result.append({\n            \"walk_left\": 1 if s == 0 else 0,\n            \"walk_right\": 1 if s == 1 else 0,\n            \"aaah\": 1 if (s == 4 or s == 5) else 0,\n            \"digging\": 1 if (s == 2 or s == 3) else 0\n        })\n    return result\n"
