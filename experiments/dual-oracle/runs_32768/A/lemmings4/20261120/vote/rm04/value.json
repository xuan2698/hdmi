"def reference(vectors):\n    state = 0\n    fall_count = 0\n    result = []\n    for row in vectors:\n        if isinstance(row, dict):\n            areset = row.get('areset', 0)\n            bump_left = row.get('bump_left', 0)\n            bump_right = row.get('bump_right', 0)\n            ground = row.get('ground', 0)\n            dig = row.get('dig', 0)\n        else:\n            areset, bump_left, bump_right, ground, dig = row[0], row[1], row[2], row[3], row[4]\n\n        if areset:\n            state = 0\n            fall_count = 0\n        else:\n            next_state = state\n            next_fall = 0\n\n            if state == 0:\n                if ground == 0:\n                    next_state = 2\n                    next_fall = 1\n                elif dig:\n                    next_state = 4\n                elif bump_left:\n                    next_state = 1\n                else:\n                    next_state = 0\n\n            elif state == 1:\n                if ground == 0:\n                    next_state = 3\n                    next_fall = 1\n                elif dig:\n                    next_state = 5\n                elif bump_right:\n                    next_state = 0\n                else:\n                    next_state = 1\n\n            elif state == 2:\n                if ground == 0:\n                    next_state = 2\n                    next_fall = fall_count + 1\n                elif fall_count > 20:\n                    next_state = 6\n                else:\n                    next_state = 0\n\n            elif state == 3:\n                if ground == 0:\n                    next_state = 3\n                    next_fall = fall_count + 1\n                elif fall_count > 20:\n                    next_state = 6\n                else:\n                    next_state = 1\n\n            elif state == 4:\n                if ground == 0:\n                    next_state = 2\n                    next_fall = 1\n                else:\n                    next_state = 4\n\n            elif state == 5:\n                if ground == 0:\n                    next_state = 3\n                    next_fall = 1\n                else:\n                    next_state = 5\n\n            else:\n                next_state = 6\n\n            state = next_state\n            fall_count = next_fall\n\n        result.append({\n            'walk_left': 1 if state == 0 else 0,\n            'walk_right': 1 if state == 1 else 0,\n            'aaah': 1 if state == 2 or state == 3 else 0,\n            'digging': 1 if state == 4 or state == 5 else 0\n        })\n\n    return result\n"
