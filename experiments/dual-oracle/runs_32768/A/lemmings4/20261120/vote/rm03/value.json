"def reference(vectors):\n    mode = 'walk'\n    direction = 'L'\n    fall_count = 0\n    result = []\n    for row in vectors:\n        if isinstance(row, dict):\n            areset = row.get('areset', 0)\n            bump_left = row.get('bump_left', 0)\n            bump_right = row.get('bump_right', 0)\n            ground = row.get('ground', 1)\n            dig = row.get('dig', 0)\n        else:\n            areset, bump_left, bump_right, ground, dig = row\n        if areset:\n            mode = 'walk'\n            direction = 'L'\n            fall_count = 0\n        else:\n            if mode == 'walk':\n                if ground == 0:\n                    mode = 'fall'\n                    fall_count = 1\n                elif dig == 1:\n                    mode = 'dig'\n                else:\n                    if (direction == 'L' and bump_left == 1) or (direction == 'R' and bump_right == 1):\n                        direction = 'R' if direction == 'L' else 'L'\n            elif mode == 'dig':\n                if ground == 0:\n                    mode = 'fall'\n                    fall_count = 1\n            elif mode == 'fall':\n                if ground == 0:\n                    fall_count += 1\n                else:\n                    if fall_count > 20:\n                        mode = 'splat'\n                    else:\n                        mode = 'walk'\n                    fall_count = 0\n            elif mode == 'splat':\n                pass\n        walk_left = walk_right = aaah = digging = 0\n        if mode == 'walk':\n            if direction == 'L':\n                walk_left = 1\n            else:\n                walk_right = 1\n        elif mode == 'fall':\n            aaah = 1\n        elif mode == 'dig':\n            digging = 1\n        result.append({'walk_left': walk_left, 'walk_right': walk_right, 'aaah': aaah, 'digging': digging})\n    return result\n"
