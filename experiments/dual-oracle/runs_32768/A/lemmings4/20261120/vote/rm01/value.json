"def reference(vectors):\n    WL, WR, FL, FR, DL, DR, SP = range(7)\n    state = WL\n    fall_count = 0\n    result = []\n\n    for row in vectors:\n        areset = row[\"areset\"]\n        bump_left = row[\"bump_left\"]\n        bump_right = row[\"bump_right\"]\n        ground = row[\"ground\"]\n        dig = row[\"dig\"]\n\n        if areset:\n            state = WL\n            fall_count = 0\n        else:\n            if state == WL:\n                if ground == 0:\n                    state = FL\n                    fall_count = 1\n                elif dig == 1:\n                    state = DL\n                elif bump_left == 1:\n                    state = WR\n                else:\n                    state = WL\n            elif state == WR:\n                if ground == 0:\n                    state = FR\n                    fall_count = 1\n                elif dig == 1:\n                    state = DR\n                elif bump_right == 1:\n                    state = WL\n                else:\n                    state = WR\n            elif state == DL:\n                if ground == 0:\n                    state = FL\n                    fall_count = 1\n                else:\n                    state = DL\n            elif state == DR:\n                if ground == 0:\n                    state = FR\n                    fall_count = 1\n                else:\n                    state = DR\n            elif state == FL:\n                if ground == 0:\n                    state = FL\n                    fall_count += 1\n                else:\n                    if fall_count > 20:\n                        state = SP\n                    else:\n                        state = WL\n                    fall_count = 0\n            elif state == FR:\n                if ground == 0:\n                    state = FR\n                    fall_count += 1\n                else:\n                    if fall_count > 20:\n                        state = SP\n                    else:\n                        state = WR\n                    fall_count = 0\n            elif state == SP:\n                state = SP\n\n        result.append({\n            \"walk_left\": 1 if state == WL else 0,\n            \"walk_right\": 1 if state == WR else 0,\n            \"aaah\": 1 if state == FL or state == FR else 0,\n            \"digging\": 1 if state == DL or state == DR else 0\n        })\n\n    return result\n"
