"def reference(vectors):\n    mode = 'WALK'\n    direction = 0\n    fall_count = 0\n    result = []\n    for row in vectors:\n        areset = row.get('areset', 0)\n        bump_left = row.get('bump_left', 0)\n        bump_right = row.get('bump_right', 0)\n        ground = row.get('ground', 1)\n        dig = row.get('dig', 0)\n        if areset:\n            mode = 'WALK'\n            direction = 0\n            fall_count = 0\n        else:\n            if mode == 'WALK':\n                if ground == 0:\n                    mode = 'FALL'\n                    fall_count = 1\n                else:\n                    if dig:\n                        mode = 'DIG'\n                    else:\n                        if bump_left and bump_right:\n                            direction = 1 - direction\n                        elif bump_left:\n                            direction = 1\n                        elif bump_right:\n                            direction = 0\n            elif mode == 'FALL':\n                if ground == 1:\n                    if fall_count > 20:\n                        mode = 'SPLAT'\n                        fall_count = 0\n                    else:\n                        mode = 'WALK'\n                        fall_count = 0\n                else:\n                    fall_count += 1\n            elif mode == 'DIG':\n                if ground == 0:\n                    mode = 'FALL'\n                    fall_count = 1\n        out = {'walk_left': 0, 'walk_right': 0, 'aaah': 0, 'digging': 0}\n        if mode == 'WALK':\n            if direction == 0:\n                out['walk_left'] = 1\n            else:\n                out['walk_right'] = 1\n        elif mode == 'FALL':\n            out['aaah'] = 1\n        elif mode == 'DIG':\n            out['digging'] = 1\n        result.append(out)\n    return result\n"
