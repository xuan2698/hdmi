{
  "decisions": [],
  "RM": "def reference(vectors):\n    state = 0\n    cnt = 0\n    ans = []\n    for row in vectors:\n        if isinstance(row, dict):\n            areset = row.get('areset', 0)\n            bump_left = row.get('bump_left', 0)\n            bump_right = row.get('bump_right', 0)\n            ground = row.get('ground', 1)\n            dig = row.get('dig', 0)\n        else:\n            areset, bump_left, bump_right, ground, dig = row\n\n        if areset:\n            state = 0\n            cnt = 0\n        elif state == 0:\n            if ground == 0:\n                state = 2\n                cnt = 1\n            elif dig == 1:\n                state = 4\n            elif bump_left == 1:\n                state = 1\n        elif state == 1:\n            if ground == 0:\n                state = 3\n                cnt = 1\n            elif dig == 1:\n                state = 5\n            elif bump_right == 1:\n                state = 0\n        elif state == 2:\n            if ground == 1:\n                if cnt > 20:\n                    state = 6\n                else:\n                    state = 0\n                cnt = 0\n            else:\n                cnt += 1\n        elif state == 3:\n            if ground == 1:\n                if cnt > 20:\n                    state = 6\n                else:\n                    state = 1\n                cnt = 0\n            else:\n                cnt += 1\n        elif state == 4:\n            if ground == 0:\n                state = 2\n                cnt = 1\n        elif state == 5:\n            if ground == 0:\n                state = 3\n                cnt = 1\n\n        ans.append({\n            'walk_left': 1 if state == 0 else 0,\n            'walk_right': 1 if state == 1 else 0,\n            'aaah': 1 if state == 2 or state == 3 else 0,\n            'digging': 1 if state == 4 or state == 5 else 0\n        })\n    return ans\n",
