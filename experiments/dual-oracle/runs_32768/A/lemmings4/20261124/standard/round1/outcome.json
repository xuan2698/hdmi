  "RM": "def reference(vectors):\n    state = 0\n    fall_count = 0\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            a = int(row.get('areset', 0))\n            bl = int(row.get('bump_left', 0))\n            br = int(row.get('bump_right', 0))\n            g = int(row.get('ground', 0))\n            d = int(row.get('dig', 0))\n        else:\n            a = int(row[0])\n            bl = int(row[1])\n            br = int(row[2])\n            g = int(row[3])\n            d = int(row[4])\n\n        if a:\n            state = 0\n            fall_count = 0\n        else:\n            if state == 0:\n                if g == 0:\n                    state = 4\n                    fall_count = 1\n                elif d == 1:\n                    state = 2\n                    fall_count = 0\n                elif bl == 1:\n                    state = 1\n            elif state == 1:\n                if g == 0:\n                    state = 5\n                    fall_count = 1\n                elif d == 1:\n                    state = 3\n                    fall_count = 0\n                elif br == 1:\n                    state = 0\n            elif state == 2:\n                if g == 0:\n                    state = 4\n                    fall_count = 1\n            elif state == 3:\n                if g == 0:\n                    state = 5\n                    fall_count = 1\n            elif state == 4:\n                if g == 1:\n                    if fall_count > 20:\n                        state = 6\n                    else:\n                        state = 0\n                    fall_count = 0\n                else:\n                    fall_count += 1\n            elif state == 5:\n                if g == 1:\n                    if fall_count > 20:\n                        state = 6\n                    else:\n                        state = 1\n                    fall_count = 0\n                else:\n                    fall_count += 1\n            elif state == 6:\n                pass\n\n        if state == 0:\n            wl, wr, aa, dg = 1, 0, 0, 0\n        elif state == 1:\n            wl, wr, aa, dg = 0, 1, 0, 0\n        elif state == 2 or state == 3:\n            wl, wr, aa, dg = 0, 0, 0, 1\n        elif state == 4 or state == 5:\n            wl, wr, aa, dg = 0, 0, 1, 0\n        else:\n            wl, wr, aa, dg = 0, 0, 0, 0\n\n        out.append({'walk_left': wl, 'walk_right': wr, 'aaah': aa, 'digging': dg})\n    return out\n",
