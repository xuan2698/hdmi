"def reference(vectors):\n    st = 0\n    fc = 0\n    out = []\n    for v in vectors:\n        a = v['areset']\n        bl = v['bump_left']\n        br = v['bump_right']\n        g = v['ground']\n        d = v['dig']\n        if a:\n            st = 0\n            fc = 0\n        else:\n            if st == 0:\n                if g == 0:\n                    st = 2\n                    fc = 1\n                elif d:\n                    st = 4\n                    fc = 0\n                elif bl:\n                    st = 1\n                    fc = 0\n                else:\n                    fc = 0\n            elif st == 1:\n                if g == 0:\n                    st = 3\n                    fc = 1\n                elif d:\n                    st = 5\n                    fc = 0\n                elif br:\n                    st = 0\n                    fc = 0\n                else:\n                    fc = 0\n            elif st == 2:\n                if g:\n                    if fc > 20:\n                        st = 6\n                    else:\n                        st = 0\n                    fc = 0\n                else:\n                    fc += 1\n            elif st == 3:\n                if g:\n                    if fc > 20:\n                        st = 6\n                    else:\n                        st = 1\n                    fc = 0\n                else:\n                    fc += 1\n            elif st == 4:\n                if g == 0:\n                    st = 2\n                    fc = 1\n                else:\n                    fc = 0\n            elif st == 5:\n                if g == 0:\n                    st = 3\n                    fc = 1\n                else:\n                    fc = 0\n            else:\n                fc = 0\n        out.append({\n            'walk_left': 1 if st == 0 else 0,\n            'walk_right': 1 if st == 1 else 0,\n            'aaah': 1 if st == 2 or st == 3 else 0,\n            'digging': 1 if st == 4 or st == 5 else 0\n        })\n    return out\n"
