"def reference(vectors):\n    state = \"WL\"\n    fall_count = 0\n    outputs = []\n    for row in vectors:\n        areset = row.get(\"areset\", 0)\n        bump_left = row.get(\"bump_left\", 0)\n        bump_right = row.get(\"bump_right\", 0)\n        ground = row.get(\"ground\", 0)\n        dig = row.get(\"dig\", 0)\n\n        if areset:\n            state = \"WL\"\n            fall_count = 0\n        else:\n            if state == \"WL\":\n                if not ground:\n                    state = \"FL\"\n                    fall_count = 0\n                elif dig:\n                    state = \"DL\"\n                elif bump_left:\n                    state = \"WR\"\n            elif state == \"WR\":\n                if not ground:\n                    state = \"FR\"\n                    fall_count = 0\n                elif dig:\n                    state = \"DR\"\n                elif bump_right:\n                    state = \"WL\"\n            elif state == \"DL\":\n                if not ground:\n                    state = \"FL\"\n                    fall_count = 0\n            elif state == \"DR\":\n                if not ground:\n                    state = \"FR\"\n                    fall_count = 0\n            elif state == \"FL\":\n                if ground:\n                    if fall_count >= 20:\n                        state = \"DEAD\"\n                    else:\n                        state = \"WL\"\n                    fall_count = 0\n                else:\n                    fall_count += 1\n            elif state == \"FR\":\n                if ground:\n                    if fall_count >= 20:\n                        state = \"DEAD\"\n                    else:\n                        state = \"WR\"\n                    fall_count = 0\n                else:\n                    fall_count += 1\n            elif state == \"DEAD\":\n                fall_count = 0\n\n        if state == \"WL\":\n            wl, wr, aa, dg = 1, 0, 0, 0\n        elif state == \"WR\":\n            wl, wr, aa, dg = 0, 1, 0, 0\n        elif state == \"FL\" or state == \"FR\":\n            wl, wr, aa, dg = 0, 0, 1, 0\n        elif state == \"DL\" or state == \"DR\":\n            wl, wr, aa, dg = 0, 0, 0, 1\n        else:\n            wl, wr, aa, dg = 0, 0, 0, 0\n\n        outputs.append({\n            \"walk_left\": wl,\n            \"walk_right\": wr,\n            \"aaah\": aa,\n            \"digging\": dg\n        })\n\n    return outputs\n"
