"def reference(vectors):\n    state = 'L'\n    cnt = 0\n    out = []\n    for v in vectors:\n        areset = v['areset']\n        bump_left = v['bump_left']\n        bump_right = v['bump_right']\n        ground = v['ground']\n        dig = v['dig']\n\n        if areset:\n            state = 'L'\n            cnt = 0\n        else:\n            if state == 'L':\n                if not ground:\n                    state = 'FL'\n                    cnt = 0\n                elif dig:\n                    state = 'DL'\n                elif bump_left:\n                    state = 'R'\n            elif state == 'R':\n                if not ground:\n                    state = 'FR'\n                    cnt = 0\n                elif dig:\n                    state = 'DR'\n                elif bump_right:\n                    state = 'L'\n            elif state == 'FL':\n                if ground:\n                    if cnt >= 20:\n                        state = 'S'\n                        cnt = 0\n                    else:\n                        state = 'L'\n                        cnt = 0\n                elif cnt < 20:\n                    cnt += 1\n            elif state == 'FR':\n                if ground:\n                    if cnt >= 20:\n                        state = 'S'\n                        cnt = 0\n                    else:\n                        state = 'R'\n                        cnt = 0\n                elif cnt < 20:\n                    cnt += 1\n            elif state == 'DL':\n                if not ground:\n                    state = 'FL'\n                    cnt = 0\n            elif state == 'DR':\n                if not ground:\n                    state = 'FR'\n                    cnt = 0\n\n        o = {'walk_left': 0, 'walk_right': 0, 'aaah': 0, 'digging': 0}\n        if state == 'L':\n            o['walk_left'] = 1\n        elif state == 'R':\n            o['walk_right'] = 1\n        elif state == 'FL' or state == 'FR':\n            o['aaah'] = 1\n        elif state == 'DL' or state == 'DR':\n            o['digging'] = 1\n        out.append(o)\n    return out\n"
