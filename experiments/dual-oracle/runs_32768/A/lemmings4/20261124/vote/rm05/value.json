"def reference(vectors):\n    if isinstance(vectors, dict):\n        keys = ['areset', 'bump_left', 'bump_right', 'ground', 'dig']\n        n = 0\n        for k in keys:\n            if k in vectors and isinstance(vectors[k], (list, tuple)):\n                n = len(vectors[k])\n                break\n        rows = []\n        for i in range(n):\n            row = {}\n            for k in keys:\n                v = vectors.get(k, 0)\n                row[k] = v[i] if isinstance(v, (list, tuple)) else v\n            rows.append(row)\n        vectors = rows\n\n    state = 'WL'\n    fall_count = 0\n    result = []\n\n    for row in vectors:\n        if isinstance(row, dict):\n            areset = int(row.get('areset', 0)) & 1\n            bump_left = int(row.get('bump_left', 0)) & 1\n            bump_right = int(row.get('bump_right', 0)) & 1\n            ground = int(row.get('ground', 0)) & 1\n            dig = int(row.get('dig', 0)) & 1\n        else:\n            try:\n                areset = int(row[0]) & 1\n                bump_left = int(row[1]) & 1\n                bump_right = int(row[2]) & 1\n                ground = int(row[3]) & 1\n                dig = int(row[4]) & 1\n            except Exception:\n                areset = bump_left = bump_right = ground = dig = 0\n\n        if areset:\n            state = 'WL'\n            fall_count = 0\n        else:\n            if state in ('WL', 'WR'):\n                if ground == 0:\n                    state = 'FL' if state == 'WL' else 'FR'\n                    fall_count = 0\n                elif dig:\n                    state = 'DL' if state == 'WL' else 'DR'\n                    fall_count = 0\n                else:\n                    if bump_left and bump_right:\n                        state = 'WR' if state == 'WL' else 'WL'\n                    elif bump_left:\n                        state = 'WR'\n                    elif bump_right:\n                        state = 'WL'\n            elif state in ('FL', 'FR'):\n                if ground == 0:\n                    fall_count += 1\n                else:\n                    if fall_count >= 20:\n                        state = 'DEAD'\n                        fall_count = 0\n                    else:\n                        state = 'WL' if state == 'FL' else 'WR'\n                        fall_count = 0\n            elif state in ('DL', 'DR'):\n                if ground == 0:\n                    state = 'FL' if state == 'DL' else 'FR'\n                    fall_count = 0\n            elif state == 'DEAD':\n                pass\n\n        out = {'walk_left': 0, 'walk_right': 0, 'aaah': 0, 'digging': 0}\n        if state == 'WL':\n            out['walk_left'] = 1\n        elif state == 'WR':\n            out['walk_right'] = 1\n        elif state in ('FL', 'FR'):\n            out['aaah'] = 1\n        elif state in ('DL', 'DR'):\n            out['digging'] = 1\n\n        result.append(out)\n\n    return result\n"
