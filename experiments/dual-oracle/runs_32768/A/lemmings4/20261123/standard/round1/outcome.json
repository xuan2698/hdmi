{
  "decisions": [],
  "RM": "def reference(vectors):\n    mode = 0  # 0=walk, 1=fall, 2=dig, 3=splat\n    direction = 0  # 0=left, 1=right\n    fall_count = 0\n    result = []\n\n    for v in vectors:\n        areset = v.get('areset', 0)\n        bump_left = v.get('bump_left', 0)\n        bump_right = v.get('bump_right', 0)\n        ground = v.get('ground', 1)\n        dig = v.get('dig', 0)\n\n        if areset:\n            mode = 0\n            direction = 0\n            fall_count = 0\n        else:\n            if mode == 0:\n                if ground == 0:\n                    mode = 1\n                    fall_count = 1\n                elif dig:\n                    mode = 2\n                else:\n                    if direction == 0:\n                        if bump_left:\n                            direction = 1\n                    else:\n                        if bump_right:\n                            direction = 0\n            elif mode == 1:\n                if ground == 0:\n                    fall_count += 1\n                else:\n                    if fall_count > 20:\n                        mode = 3\n                    else:\n                        mode = 0\n                    fall_count = 0\n            elif mode == 2:\n                if ground == 0:\n                    mode = 1\n                    fall_count = 1\n\n        walk_left = 1 if mode == 0 and direction == 0 else 0\n        walk_right = 1 if mode == 0 and direction == 1 else 0\n        aaah = 1 if mode == 1 else 0\n        digging = 1 if mode == 2 else 0\n\n        result.append({\n            'walk_left': walk_left,\n            'walk_right': walk_right,\n            'aaah': aaah,\n            'digging': digging\n        })\n\n    return result\n",
