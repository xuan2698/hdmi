"def reference(vectors):\n    state=0\n    fc=0\n    i={'areset':0,'bump_left':0,'bump_right':0,'ground':1,'dig':0}\n    r=[]\n    for row in vectors:\n        for k in i:\n            if k in row:\n                i[k]=row[k]\n        if i['areset']:\n            state=0\n            fc=0\n        else:\n            g=i['ground']\n            d=i['dig']\n            bl=i['bump_left']\n            br=i['bump_right']\n            if state==0:\n                if not g:\n                    state=2\n                    fc=0\n                elif d:\n                    state=4\n                elif bl:\n                    state=1\n            elif state==1:\n                if not g:\n                    state=3\n                    fc=0\n                elif d:\n                    state=5\n                elif br:\n                    state=0\n            elif state==2:\n                if g:\n                    if fc>=20:\n                        state=6\n                    else:\n                        state=0\n                    fc=0\n                else:\n                    fc+=1\n            elif state==3:\n                if g:\n                    if fc>=20:\n                        state=6\n                    else:\n                        state=1\n                    fc=0\n                else:\n                    fc+=1\n            elif state==4:\n                if not g:\n                    state=2\n                    fc=0\n            elif state==5:\n                if not g:\n                    state=3\n                    fc=0\n        r.append({\n            'walk_left':1 if state==0 else 0,\n            'walk_right':1 if state==1 else 0,\n            'aaah':1 if state in (2,3) else 0,\n            'digging':1 if state in (4,5) else 0\n        })\n        if 'mid' in row and isinstance(row['mid'],dict):\n            for k,v in row['mid'].items():\n                if k in i:\n                    if k=='areset' and v==1 and i[k]==0:\n                        i[k]=v\n                        state=0\n                        fc=0\n                    else:\n                        i[k]=v\n    return r\n"
