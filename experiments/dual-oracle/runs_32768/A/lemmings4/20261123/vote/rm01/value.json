"def reference(vectors):\n    state = 0\n    fall = 0\n    result = []\n    for row in vectors:\n        if isinstance(row, dict):\n            areset = int(row.get('areset', 0))\n            bump_left = int(row.get('bump_left', 0))\n            bump_right = int(row.get('bump_right', 0))\n            ground = int(row.get('ground', 0))\n            dig = int(row.get('dig', 0))\n        else:\n            areset, bump_left, bump_right, ground, dig = [int(x) for x in row]\n\n        if areset:\n            state = 0\n            fall = 0\n        else:\n            if state == 0:\n                if not ground:\n                    state = 2\n                    fall = 1\n                elif dig:\n                    state = 4\n                elif bump_left:\n                    state = 1\n            elif state == 1:\n                if not ground:\n                    state = 3\n                    fall = 1\n                elif dig:\n                    state = 5\n                elif bump_right:\n                    state = 0\n            elif state == 4:\n                if not ground:\n                    state = 2\n                    fall = 1\n            elif state == 5:\n                if not ground:\n                    state = 3\n                    fall = 1\n            elif state == 2:\n                if ground:\n                    if fall > 20:\n                        state = 6\n                    else:\n                        state = 0\n                    fall = 0\n                else:\n                    fall += 1\n            elif state == 3:\n                if ground:\n                    if fall > 20:\n                        state = 6\n                    else:\n                        state = 1\n                    fall = 0\n                else:\n                    fall += 1\n\n        result.append({\n            'walk_left': 1 if state == 0 else 0,\n            'walk_right': 1 if state == 1 else 0,\n            'aaah': 1 if state in (2, 3) else 0,\n            'digging': 1 if state in (4, 5) else 0\n        })\n    return result\n"
