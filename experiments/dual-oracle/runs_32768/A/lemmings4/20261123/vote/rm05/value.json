"def reference(vectors):\n    def getv(row, key, idx):\n        if isinstance(row, dict):\n            return int(row.get(key, 0))\n        return int(row[idx])\n\n    if isinstance(vectors, dict):\n        keys = ['areset', 'bump_left', 'bump_right', 'ground', 'dig']\n        n = 0\n        for v in vectors.values():\n            if isinstance(v, (list, tuple)):\n                if len(v) > n:\n                    n = len(v)\n            else:\n                if n < 1:\n                    n = 1\n        rows = []\n        for i in range(n):\n            d = {}\n            for k in keys:\n                arr = vectors.get(k, [])\n                if isinstance(arr, (list, tuple)):\n                    d[k] = int(arr[i]) if i < len(arr) else 0\n                else:\n                    d[k] = int(arr) if i == 0 else 0\n            rows.append(d)\n        vectors = rows\n\n    state = 'L'\n    count = 0\n    out = []\n\n    for row in vectors:\n        areset = getv(row, 'areset', 0)\n        bump_left = getv(row, 'bump_left', 1)\n        bump_right = getv(row, 'bump_right', 2)\n        ground = getv(row, 'ground', 3)\n        dig = getv(row, 'dig', 4)\n\n        if areset:\n            state = 'L'\n            count = 0\n        else:\n            if state == 'L' or state == 'R':\n                if ground == 0:\n                    state = 'F' + state\n                    count = 1\n                elif dig:\n                    state = 'D' + state\n                    count = 0\n                else:\n                    if state == 'L':\n                        if bump_left:\n                            state = 'R'\n                    else:\n                        if bump_right:\n                            state = 'L'\n            elif state == 'FL' or state == 'FR':\n                if ground == 1:\n                    if count > 20:\n                        state = 'DEAD'\n                    else:\n                        if state == 'FL':\n                            state = 'L'\n                        else:\n                            state = 'R'\n                    count = 0\n                else:\n                    count += 1\n            elif state == 'DL' or state == 'DR':\n                if ground == 0:\n                    if state == 'DL':\n                        state = 'FL'\n                    else:\n                        state = 'FR'\n                    count = 1\n            elif state == 'DEAD':\n                pass\n\n        wl = 1 if state == 'L' else 0\n        wr = 1 if state == 'R' else 0\n        aaah = 1 if (state == 'FL' or state == 'FR') else 0\n        digging = 1 if (state == 'DL' or state == 'DR') else 0\n\n        out.append({\n            'walk_left': wl,\n            'walk_right': wr,\n            'aaah': aaah,\n            'digging': digging\n        })\n\n    return out\n"
