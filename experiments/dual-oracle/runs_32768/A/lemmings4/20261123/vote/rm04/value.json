"def reference(vectors):\n    mode = 0        # 0=walk, 1=fall, 2=dig, 3=dead\n    direction = 0   # 0=left, 1=right\n    fall_count = 0\n    result = []\n\n    for row in vectors:\n        if isinstance(row, dict):\n            areset = row.get('areset', 0)\n            bump_left = row.get('bump_left', 0)\n            bump_right = row.get('bump_right', 0)\n            ground = row.get('ground', 0)\n            dig = row.get('dig', 0)\n        else:\n            areset = row[0]\n            bump_left = row[1]\n            bump_right = row[2]\n            ground = row[3]\n            dig = row[4]\n\n        if areset:\n            mode = 0\n            direction = 0\n            fall_count = 0\n        else:\n            if mode == 3:\n                pass\n            elif mode == 0:\n                if ground == 0:\n                    mode = 1\n                    fall_count = 1\n                elif dig == 1:\n                    mode = 2\n                else:\n                    if direction == 0:\n                        if bump_left:\n                            direction = 1\n                    else:\n                        if bump_right:\n                            direction = 0\n            elif mode == 1:\n                if ground == 1:\n                    if fall_count > 20:\n                        mode = 3\n                    else:\n                        mode = 0\n                    fall_count = 0\n                else:\n                    fall_count += 1\n            elif mode == 2:\n                if ground == 0:\n                    mode = 1\n                    fall_count = 1\n\n        result.append({\n            'walk_left': 1 if mode == 0 and direction == 0 else 0,\n            'walk_right': 1 if mode == 0 and direction == 1 else 0,\n            'aaah': 1 if mode == 1 else 0,\n            'digging': 1 if mode == 2 else 0\n        })\n\n    return result\n"
