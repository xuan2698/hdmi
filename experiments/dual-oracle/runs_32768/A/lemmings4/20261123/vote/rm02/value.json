"def reference(vectors):\n    state = \"WL\"\n    fc = 0\n    result = []\n    for r in vectors:\n        if isinstance(r, dict):\n            areset = r.get(\"areset\", 0)\n            bump_left = r.get(\"bump_left\", 0)\n            bump_right = r.get(\"bump_right\", 0)\n            ground = r.get(\"ground\", 0)\n            dig = r.get(\"dig\", 0)\n        else:\n            areset = r[0] if len(r) > 0 else 0\n            bump_left = r[1] if len(r) > 1 else 0\n            bump_right = r[2] if len(r) > 2 else 0\n            ground = r[3] if len(r) > 3 else 0\n            dig = r[4] if len(r) > 4 else 0\n\n        if areset:\n            state = \"WL\"\n            fc = 0\n        else:\n            if state == \"WL\":\n                if ground == 0:\n                    state = \"FL\"\n                    fc = 1\n                elif dig:\n                    state = \"DL\"\n                elif bump_left:\n                    state = \"WR\"\n            elif state == \"WR\":\n                if ground == 0:\n                    state = \"FR\"\n                    fc = 1\n                elif dig:\n                    state = \"DR\"\n                elif bump_right:\n                    state = \"WL\"\n            elif state == \"DL\":\n                if ground == 0:\n                    state = \"FL\"\n                    fc = 1\n            elif state == \"DR\":\n                if ground == 0:\n                    state = \"FR\"\n                    fc = 1\n            elif state == \"FL\":\n                if ground == 0:\n                    fc += 1\n                else:\n                    if fc > 20:\n                        state = \"SPLAT\"\n                        fc = 0\n                    else:\n                        state = \"WL\"\n                        fc = 0\n            elif state == \"FR\":\n                if ground == 0:\n                    fc += 1\n                else:\n                    if fc > 20:\n                        state = \"SPLAT\"\n                        fc = 0\n                    else:\n                        state = \"WR\"\n                        fc = 0\n\n        out = {\"walk_left\": 0, \"walk_right\": 0, \"aaah\": 0, \"digging\": 0}\n        if state == \"WL\":\n            out[\"walk_left\"] = 1\n        elif state == \"WR\":\n            out[\"walk_right\"] = 1\n        elif state == \"FL\" or state == \"FR\":\n            out[\"aaah\"] = 1\n        elif state == \"DL\" or state == \"DR\":\n            out[\"digging\"] = 1\n        result.append(out)\n    return result\n"
