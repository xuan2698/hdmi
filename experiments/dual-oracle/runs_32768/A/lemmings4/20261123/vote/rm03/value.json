"def reference(vectors):\n    state = 0  # 0 WL, 1 WR, 2 FL, 3 FR, 4 DL, 5 DR, 6 DEAD\n    fall_count = 0\n    result = []\n\n    for row in vectors:\n        if isinstance(row, dict):\n            areset = row.get('areset', 0)\n            bump_left = row.get('bump_left', 0)\n            bump_right = row.get('bump_right', 0)\n            ground = row.get('ground', 0)\n            dig = row.get('dig', 0)\n        else:\n            areset, bump_left, bump_right, ground, dig = row[:5]\n\n        if areset:\n            state = 0\n            fall_count = 0\n        else:\n            if state == 0:  # walk left\n                if ground == 0:\n                    state = 2\n                    fall_count = 1\n                elif dig:\n                    state = 4\n                elif bump_left:\n                    state = 1\n            elif state == 1:  # walk right\n                if ground == 0:\n                    state = 3\n                    fall_count = 1\n                elif dig:\n                    state = 5\n                elif bump_right:\n                    state = 0\n            elif state == 2:  # fall left\n                if ground:\n                    if fall_count > 20:\n                        state = 6\n                    else:\n                        state = 0\n                    fall_count = 0\n                else:\n                    if fall_count < 21:\n                        fall_count += 1\n            elif state == 3:  # fall right\n                if ground:\n                    if fall_count > 20:\n                        state = 6\n                    else:\n                        state = 1\n                    fall_count = 0\n                else:\n                    if fall_count < 21:\n                        fall_count += 1\n            elif state == 4:  # dig left\n                if ground == 0:\n                    state = 2\n                    fall_count = 1\n            elif state == 5:  # dig right\n                if ground == 0:\n                    state = 3\n                    fall_count = 1\n            elif state == 6:  # dead\n                state = 6\n\n        walk_left = 1 if state == 0 else 0\n        walk_right = 1 if state == 1 else 0\n        aaah = 1 if state in (2, 3) else 0\n        digging = 1 if state in (4, 5) else 0\n\n        result.append({\n            'walk_left': walk_left,\n            'walk_right': walk_right,\n            'aaah': aaah,\n            'digging': digging\n        })\n\n    return result\n"
