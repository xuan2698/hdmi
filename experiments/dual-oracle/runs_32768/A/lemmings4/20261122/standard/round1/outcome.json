  "RM": "def reference(vectors):\n    mode = 'walk'  # walk, dig, fall, splat\n    direction = 0  # 0 = left, 1 = right\n    fall_count = 0\n\n    if isinstance(vectors, dict):\n        keys = ['areset', 'bump_left', 'bump_right', 'ground', 'dig']\n        n = 0\n        for k in keys:\n            if k in vectors:\n                n = len(vectors[k])\n                break\n        rows = []\n        for i in range(n):\n            rows.append({k: vectors.get(k, [0] * n)[i] for k in keys})\n        vectors = rows\n\n    result = []\n\n    for row in vectors:\n        if isinstance(row, dict):\n            areset = row.get('areset', 0)\n            bump_left = row.get('bump_left', 0)\n            bump_right = row.get('bump_right', 0)\n            ground = row.get('ground', 0)\n            dig = row.get('dig', 0)\n        else:\n            areset, bump_left, bump_right, ground, dig = row[0], row[1], row[2], row[3], row[4]\n\n        if areset:\n            mode = 'walk'\n            direction = 0\n            fall_count = 0\n        else:\n            if mode == 'walk':\n                if not ground:\n                    mode = 'fall'\n                    fall_count = 0\n                elif dig:\n                    mode = 'dig'\n                else:\n                    if direction == 0:\n                        if bump_left:\n                            direction = 1\n                    else:\n                        if bump_right:\n                            direction = 0\n\n            elif mode == 'dig':\n                if not ground:\n                    mode = 'fall'\n                    fall_count = 0\n\n            elif mode == 'fall':\n                if ground:\n                    if fall_count >= 20:\n                        mode = 'splat'\n                    else:\n                        mode = 'walk'\n                    fall_count = 0\n                else:\n                    fall_count += 1\n\n            elif mode == 'splat':\n                pass\n\n        walk_left = 1 if mode == 'walk' and direction == 0 else 0\n        walk_right = 1 if mode == 'walk' and direction == 1 else 0\n        aaah = 1 if mode == 'fall' else 0\n        digging = 1 if mode == 'dig' else 0\n\n        result.append({\n            'walk_left': walk_left,\n            'walk_right': walk_right,\n            'aaah': aaah,\n            'digging': digging\n        })\n\n    return result\n",
