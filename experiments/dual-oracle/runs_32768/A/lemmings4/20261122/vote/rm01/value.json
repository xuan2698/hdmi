"def reference(vectors):\n    st = 0\n    fall_count = 0\n    result = []\n\n    for row in vectors:\n        areset = row.get('areset', 0)\n        bump_left = row.get('bump_left', 0)\n        bump_right = row.get('bump_right', 0)\n        ground = row.get('ground', 1)\n        dig = row.get('dig', 0)\n\n        if areset:\n            st = 0\n            fall_count = 0\n        else:\n            if st == 0:          # walk left\n                if ground == 0:\n                    st = 4       # fall left\n                    fall_count = 1\n                elif dig:\n                    st = 2       # dig left\n                    fall_count = 0\n                else:\n                    if bump_left:\n                        st = 1   # walk right\n                    fall_count = 0\n            elif st == 1:        # walk right\n                if ground == 0:\n                    st = 5       # fall right\n                    fall_count = 1\n                elif dig:\n                    st = 3       # dig right\n                    fall_count = 0\n                else:\n                    if bump_right:\n                        st = 0   # walk left\n                    fall_count = 0\n            elif st == 2:        # dig left\n                if ground == 0:\n                    st = 4       # fall left\n                    fall_count = 1\n            elif st == 3:        # dig right\n                if ground == 0:\n                    st = 5       # fall right\n                    fall_count = 1\n            elif st == 4:        # fall left\n                if ground == 0:\n                    fall_count += 1\n                else:\n                    if fall_count > 20:\n                        st = 6   # splattered\n                    else:\n                        st = 0\n                        fall_count = 0\n            elif st == 5:        # fall right\n                if ground == 0:\n                    fall_count += 1\n                else:\n                    if fall_count > 20:\n                        st = 6   # splattered\n                    else:\n                        st = 1\n                        fall_count = 0\n            else:                # splattered\n                st = 6\n\n        if st == 0:\n            out = {'walk_left': 1, 'walk_right': 0, 'aaah': 0, 'digging': 0}\n        elif st == 1:\n            out = {'walk_left': 0, 'walk_right': 1, 'aaah': 0, 'digging': 0}\n        elif st == 2 or st == 3:\n            out = {'walk_left': 0, 'walk_right': 0, 'aaah': 0, 'digging': 1}\n        elif st == 4 or st == 5:\n            out = {'walk_left': 0, 'walk_right': 0, 'aaah': 1, 'digging': 0}\n        else:\n            out = {'walk_left': 0, 'walk_right': 0, 'aaah': 0, 'digging': 0}\n\n        result.append(out)\n\n    return result\n"
