"def reference(vectors):\n    WALK_L, WALK_R, FALL_L, FALL_R, DIG_L, DIG_R, DEAD = range(7)\n    st = WALK_L\n    cnt = 0\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            areset = row['areset']\n            bump_left = row['bump_left']\n            bump_right = row['bump_right']\n            ground = row['ground']\n            dig = row['dig']\n        else:\n            areset, bump_left, bump_right, ground, dig = row[:5]\n\n        if areset:\n            st = WALK_L\n            cnt = 0\n        else:\n            if st == WALK_L:\n                if ground == 0:\n                    st = FALL_L\n                    cnt = 0\n                elif dig == 1:\n                    st = DIG_L\n                elif bump_left == 1:\n                    st = WALK_R\n            elif st == WALK_R:\n                if ground == 0:\n                    st = FALL_R\n                    cnt = 0\n                elif dig == 1:\n                    st = DIG_R\n                elif bump_right == 1:\n                    st = WALK_L\n            elif st == FALL_L:\n                if ground == 1:\n                    if cnt >= 20:\n                        st = DEAD\n                    else:\n                        st = WALK_L\n                    cnt = 0\n                else:\n                    cnt += 1\n            elif st == FALL_R:\n                if ground == 1:\n                    if cnt >= 20:\n                        st = DEAD\n                    else:\n                        st = WALK_R\n                    cnt = 0\n                else:\n                    cnt += 1\n            elif st == DIG_L:\n                if ground == 0:\n                    st = FALL_L\n                    cnt = 0\n            elif st == DIG_R:\n                if ground == 0:\n                    st = FALL_R\n                    cnt = 0\n\n        out.append({\n            'walk_left': 1 if st == WALK_L else 0,\n            'walk_right': 1 if st == WALK_R else 0,\n            'aaah': 1 if st == FALL_L or st == FALL_R else 0,\n            'digging': 1 if st == DIG_L or st == DIG_R else 0,\n        })\n    return out\n"
