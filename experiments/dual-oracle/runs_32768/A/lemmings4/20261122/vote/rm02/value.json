"def reference(vectors):\n    state = 'L'\n    count = 0\n    result = []\n\n    for row in vectors:\n        if isinstance(row, dict):\n            areset = row.get('areset', 0)\n            bump_left = row.get('bump_left', 0)\n            bump_right = row.get('bump_right', 0)\n            ground = row.get('ground', 0)\n            dig = row.get('dig', 0)\n        else:\n            areset, bump_left, bump_right, ground, dig = row[:5]\n\n        if areset:\n            state = 'L'\n            count = 0\n\n        elif state == 'L':\n            if not ground:\n                state = 'FL'\n                count = 1\n            elif dig:\n                state = 'DL'\n                count = 0\n            elif bump_left:\n                state = 'R'\n\n        elif state == 'R':\n            if not ground:\n                state = 'FR'\n                count = 1\n            elif dig:\n                state = 'DR'\n                count = 0\n            elif bump_right:\n                state = 'L'\n\n        elif state == 'DL':\n            if not ground:\n                state = 'FL'\n                count = 1\n\n        elif state == 'DR':\n            if not ground:\n                state = 'FR'\n                count = 1\n\n        elif state == 'FL':\n            if ground:\n                if count > 20:\n                    state = 'S'\n                else:\n                    state = 'L'\n                count = 0\n            else:\n                count += 1\n\n        elif state == 'FR':\n            if ground:\n                if count > 20:\n                    state = 'S'\n                else:\n                    state = 'R'\n                count = 0\n            else:\n                count += 1\n\n        elif state == 'S':\n            state = 'S'\n\n        result.append({\n            'walk_left': 1 if state == 'L' else 0,\n            'walk_right': 1 if state == 'R' else 0,\n            'aaah': 1 if state in ('FL', 'FR') else 0,\n            'digging': 1 if state in ('DL', 'DR') else 0\n        })\n\n    return result\n"
