"def reference(vectors):\n    state = \"WL\"\n    fall_count = 0\n    result = []\n    for v in vectors:\n        if v[\"areset\"]:\n            state = \"WL\"\n            fall_count = 0\n        else:\n            ground = v[\"ground\"]\n            dig = v[\"dig\"]\n            bump_left = v[\"bump_left\"]\n            bump_right = v[\"bump_right\"]\n\n            if state == \"WL\":\n                if not ground:\n                    state = \"FL\"\n                    fall_count = 1\n                elif dig:\n                    state = \"DL\"\n                    fall_count = 0\n                else:\n                    state = \"WR\" if bump_left else \"WL\"\n                    fall_count = 0\n            elif state == \"WR\":\n                if not ground:\n                    state = \"FR\"\n                    fall_count = 1\n                elif dig:\n                    state = \"DR\"\n                    fall_count = 0\n                else:\n                    state = \"WL\" if bump_right else \"WR\"\n                    fall_count = 0\n            elif state == \"DL\":\n                if not ground:\n                    state = \"FL\"\n                    fall_count = 1\n                else:\n                    state = \"DL\"\n                    fall_count = 0\n            elif state == \"DR\":\n                if not ground:\n                    state = \"FR\"\n                    fall_count = 1\n                else:\n                    state = \"DR\"\n                    fall_count = 0\n            elif state == \"FL\":\n                if ground:\n                    if fall_count > 20:\n                        state = \"DEAD\"\n                    else:\n                        state = \"WL\"\n                    fall_count = 0\n                else:\n                    fall_count += 1\n                    state = \"FL\"\n            elif state == \"FR\":\n                if ground:\n                    if fall_count > 20:\n                        state = \"DEAD\"\n                    else:\n                        state = \"WR\"\n                    fall_count = 0\n                else:\n                    fall_count += 1\n                    state = \"FR\"\n            else:\n                state = \"DEAD\"\n                fall_count = 0\n\n        if state == \"WL\":\n            result.append({\"walk_left\": 1, \"walk_right\": 0, \"aaah\": 0, \"digging\": 0})\n        elif state == \"WR\":\n            result.append({\"walk_left\": 0, \"walk_right\": 1, \"aaah\": 0, \"digging\": 0})\n        elif state == \"FL\" or state == \"FR\":\n            result.append({\"walk_left\": 0, \"walk_right\": 0, \"aaah\": 1, \"digging\": 0})\n        elif state == \"DL\" or state == \"DR\":\n            result.append({\"walk_left\": 0, \"walk_right\": 0, \"aaah\": 0, \"digging\": 1})\n        else:\n            result.append({\"walk_left\": 0, \"walk_right\": 0, \"aaah\": 0, \"digging\": 0})\n    return result\n"
