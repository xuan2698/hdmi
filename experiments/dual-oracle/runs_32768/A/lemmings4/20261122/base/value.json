"def reference(vectors):\n    state=0\n    c=0\n    inp={'areset':0,'bump_left':0,'bump_right':0,'ground':1,'dig':0}\n    res=[]\n    for r in vectors:\n        for k in ('areset','bump_left','bump_right','ground','dig'):\n            if k in r:\n                inp[k]=r[k]\n        if inp['areset']:\n            state=0\n            c=0\n        else:\n            g=inp['ground']\n            bl=inp['bump_left']\n            br=inp['bump_right']\n            d=inp['dig']\n            if state==0:\n                if not g:\n                    state=4\n                    c=1\n                elif d:\n                    state=2\n                elif bl:\n                    state=1\n            elif state==1:\n                if not g:\n                    state=5\n                    c=1\n                elif d:\n                    state=3\n                elif br:\n                    state=0\n            elif state==2:\n                if not g:\n                    state=4\n                    c=1\n            elif state==3:\n                if not g:\n                    state=5\n                    c=1\n            elif state==4:\n                if g:\n                    if c>20:\n                        state=6\n                        c=0\n                    else:\n                        state=0\n                        c=0\n                else:\n                    c+=1\n            elif state==5:\n                if g:\n                    if c>20:\n                        state=6\n                        c=0\n                    else:\n                        state=1\n                        c=0\n                else:\n                    c+=1\n        o={'walk_left':0,'walk_right':0,'aaah':0,'digging':0}\n        if state==0:\n            o['walk_left']=1\n        elif state==1:\n            o['walk_right']=1\n        elif state==2 or state==3:\n            o['digging']=1\n        elif state==4 or state==5:\n            o['aaah']=1\n        res.append(o)\n        m=r.get('mid')\n        if m:\n            for k,v in m.items():\n                inp[k]=v\n                if k=='areset' and v==1:\n                    state=0\n                    c=0\n    return res\n"
