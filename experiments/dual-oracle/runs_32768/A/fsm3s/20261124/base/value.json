"def reference(vectors):\n    trans = {\n        'A': {'0': 'A', '1': 'B'},\n        'B': {'0': 'C', '1': 'B'},\n        'C': {'0': 'A', '1': 'D'},\n        'D': {'0': 'C', '1': 'B'}\n    }\n    out = {'A': 0, 'B': 0, 'C': 0, 'D': 1}\n    state = 'A'\n    cur = {'in': 0, 'reset': 0}\n    result = []\n    for row in vectors:\n        for k in cur:\n            if k in row:\n                cur[k] = int(row[k])\n        if cur['reset']:\n            state = 'A'\n        else:\n            state = trans[state][str(cur['in'])]\n        result.append({'out': out[state]})\n        mid = row.get('mid')\n        if mid:\n            for k in cur:\n                if k in mid:\n                    cur[k] = int(mid[k])\n    return result\n"
