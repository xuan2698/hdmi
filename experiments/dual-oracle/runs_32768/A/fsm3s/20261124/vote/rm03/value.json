"def reference(vectors):\n    state = 0\n    out_rows = []\n    nxt = ((0, 1), (2, 1), (0, 3), (2, 1))\n    for row in vectors:\n        if isinstance(row, dict):\n            rst = row.get('reset', 0)\n            inp = row.get('in', 0)\n        else:\n            inp = row[0]\n            rst = row[1] if len(row) > 1 else 0\n        if rst:\n            state = 0\n        else:\n            state = nxt[state][inp & 1]\n        out_rows.append({'out': 1 if state == 3 else 0})\n    return out_rows\n"
