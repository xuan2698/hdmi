"def reference(vectors):\n    s = 0\n    result = []\n    for v in vectors:\n        if v.get('reset', 0):\n            s = 0\n        elif s == 0:\n            if v.get('in', 0):\n                s = 1\n        elif s == 1:\n            s = 1 if v.get('in', 0) else 2\n        elif s == 2:\n            s = 3 if v.get('in', 0) else 0\n        else:\n            s = 1 if v.get('in', 0) else 2\n        result.append({'out': 1 if s == 3 else 0})\n    return result\n"
