"def reference(vectors):\n    state = 0  # A=0, B=1, C=2, D=3\n    result = []\n    for row in vectors:\n        reset = row.get('reset', 0)\n        inp = row.get('in', 0)\n        if reset:\n            state = 0\n        else:\n            if state == 0:\n                state = 1 if inp else 0\n            elif state == 1:\n                state = 1 if inp else 2\n            elif state == 2:\n                state = 3 if inp else 0\n            else:\n                state = 1 if inp else 2\n        result.append({'out': 1 if state == 3 else 0})\n    return result\n"
