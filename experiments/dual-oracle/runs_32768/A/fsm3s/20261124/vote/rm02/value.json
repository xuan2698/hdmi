"def reference(vectors):\n    state = 0  # A\n    results = []\n    for row in vectors:\n        if isinstance(row, dict):\n            rst = int(row.get('reset', 0))\n            inp = int(row.get('in', 0))\n        else:\n            rst = int(row[0])\n            inp = int(row[1])\n        if rst:\n            state = 0\n        else:\n            if state == 0:\n                state = 1 if inp else 0\n            elif state == 1:\n                state = 1 if inp else 2\n            elif state == 2:\n                state = 3 if inp else 0\n            else:\n                state = 1 if inp else 2\n        results.append({'out': 1 if state == 3 else 0})\n    return results\n"
