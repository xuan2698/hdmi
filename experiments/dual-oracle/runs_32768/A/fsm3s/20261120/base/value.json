"def reference(vectors):\n    nxt=((0,1),(2,1),(0,3),(2,1))\n    out=(0,0,0,1)\n    state=0\n    inp={'in':0,'reset':0}\n    res=[]\n    for row in vectors:\n        for k in ('in','reset'):\n            if k in row:\n                inp[k]=row[k]\n        if inp['reset']:\n            state=0\n        else:\n            state=nxt[state][inp['in']]\n        res.append({'out':out[state]})\n        m=row.get('mid')\n        if isinstance(m,dict):\n            for k in ('in','reset'):\n                if k in m:\n                    inp[k]=m[k]\n    return res\n"
