"def reference(vectors):\n    A, B, C, D = 0, 1, 2, 3\n    state = A\n    result = []\n    for row in vectors:\n        reset = int(row.get(\"reset\", 0))\n        inp = int(row.get(\"in\", 0))\n        if reset:\n            state = A\n        else:\n            if state == A:\n                state = B if inp else A\n            elif state == B:\n                state = B if inp else C\n            elif state == C:\n                state = D if inp else A\n            else:\n                state = B if inp else C\n        result.append({\"out\": 1 if state == D else 0})\n    return result\n"
