"def reference(vectors):\n    state = 0  # A=0, B=1, C=2, D=3\n    prev_clk = 0\n    result = []\n    for row in vectors:\n        if 'clk' in row:\n            clk = row['clk'] & 1\n            edge = (prev_clk == 0 and clk == 1)\n            prev_clk = clk\n        else:\n            edge = True\n\n        if edge:\n            if row.get('reset', 0):\n                state = 0\n            else:\n                inp = row.get('in', 0) & 1\n                if state == 0:\n                    state = 1 if inp else 0\n                elif state == 1:\n                    state = 2 if not inp else 1\n                elif state == 2:\n                    state = 3 if inp else 0\n                else:\n                    state = 1 if inp else 2\n\n        result.append({'out': 1 if state == 3 else 0})\n    return result\n"
