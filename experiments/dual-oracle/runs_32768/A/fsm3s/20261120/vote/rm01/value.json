"def reference(vectors):\n    state = 0  # A=0, B=1, C=2, D=3\n    result = []\n    for row in vectors:\n        vin = row['in'] & 1\n        reset = row['reset'] & 1\n        if reset:\n            nxt = 0\n        elif state == 0:      # A\n            nxt = 0 if vin == 0 else 1\n        elif state == 1:      # B\n            nxt = 2 if vin == 0 else 1\n        elif state == 2:      # C\n            nxt = 0 if vin == 0 else 3\n        else:                 # D\n            nxt = 2 if vin == 0 else 1\n        state = nxt\n        result.append({'out': 1 if state == 3 else 0})\n    return result\n"
