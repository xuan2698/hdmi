"def reference(vectors):\n    s = 0\n    prev_clk = 0\n    use_clk = any('clk' in r for r in vectors)\n    result = []\n    for r in vectors:\n        edge = True\n        if use_clk:\n            clk = r.get('clk', 0) & 1\n            edge = (prev_clk == 0 and clk == 1)\n            prev_clk = clk\n        if edge:\n            if r.get('reset', 0) & 1:\n                s = 0\n            else:\n                x = r.get('in', 0) & 1\n                if s == 0:\n                    s = 1 if x else 0\n                elif s == 1:\n                    s = 1 if x else 2\n                elif s == 2:\n                    s = 3 if x else 0\n                else:\n                    s = 1 if x else 2\n        result.append({'out': 1 if s == 3 else 0})\n    return result\n"
