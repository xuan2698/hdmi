"def reference(vectors):\n    vectors = list(vectors)\n    state = 'A'\n    trans = {'A': ('A', 'B'), 'B': ('C', 'B'), 'C': ('A', 'D'), 'D': ('C', 'B')}\n    out = {'A': 0, 'B': 0, 'C': 0, 'D': 1}\n    use_clk = any(isinstance(r, dict) and 'clk' in r for r in vectors)\n    all_high = True\n    if use_clk:\n        for r in vectors:\n            if isinstance(r, dict) and r.get('clk', 1) == 0:\n                all_high = False\n                break\n    prev_clk = None\n    result = []\n    for r in vectors:\n        if isinstance(r, dict):\n            reset = r.get('reset', 0)\n            inp = r.get('in', 0)\n            clk = r.get('clk', 1 if not use_clk else 0)\n        else:\n            if len(r) == 3:\n                clk, reset, inp = r\n            else:\n                reset, inp = r\n                clk = 1\n        if use_clk and not all_high:\n            edge = (prev_clk is None and clk == 1) or (prev_clk == 0 and clk == 1)\n            if edge:\n                if reset:\n                    state = 'A'\n                else:\n                    state = trans[state][inp & 1]\n            prev_clk = clk\n        else:\n            if reset:\n                state = 'A'\n            else:\n                state = trans[state][inp & 1]\n            if use_clk:\n                prev_clk = clk\n        result.append({'out': out[state]})\n    return result\n"
