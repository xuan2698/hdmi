"def reference(vectors):\n    state = 0\n    prev_clk = 0\n    result = []\n    for row in vectors:\n        clk = row.get('clk', None)\n        if clk is None:\n            posedge = True\n        else:\n            posedge = (clk == 1 and prev_clk == 0)\n            prev_clk = clk\n        if posedge:\n            reset = row.get('reset', 0)\n            if reset:\n                state = 0\n            else:\n                inp = row.get('in', 0)\n                if state == 0:\n                    state = 0 if inp == 0 else 1\n                elif state == 1:\n                    state = 2 if inp == 0 else 1\n                elif state == 2:\n                    state = 0 if inp == 0 else 3\n                else:\n                    state = 2 if inp == 0 else 1\n        result.append({'out': 1 if state == 3 else 0})\n    return result\n"
