"def reference(vectors):\n    A, B, C, D = 0, 1, 2, 3\n    state = A\n    result = []\n\n    for row in vectors:\n        reset = row['reset']\n        inp = row['in']\n\n        if reset:\n            state = A\n        elif state == A:\n            state = B if inp else A\n        elif state == B:\n            state = B if inp else C\n        elif state == C:\n            state = D if inp else A\n        else:  # state == D\n            state = B if inp else C\n\n        result.append({'out': 1 if state == D else 0})\n\n    return result\n"
