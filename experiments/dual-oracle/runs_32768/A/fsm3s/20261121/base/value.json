"def reference(vectors):\n    s=0\n    o=[0,0,0,1]\n    t=[[0,1],[2,1],[0,3],[2,1]]\n    i={'in':0,'reset':0}\n    r=[]\n    for row in vectors:\n        for k in ('in','reset'):\n            if k in row:i[k]=row[k]\n        if i['reset']:\n            s=0\n        else:\n            s=t[s][i['in']]\n        r.append({'out':o[s]})\n        if 'mid' in row:\n            for k in ('in','reset'):\n                if k in row['mid']:\n                    i[k]=row['mid'][k]\n    return r\n"
