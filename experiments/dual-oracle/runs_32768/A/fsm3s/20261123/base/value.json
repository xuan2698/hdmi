"def reference(vectors):\n    s = 0\n    cur = {}\n    ans = []\n    trans = {0: {0: 0, 1: 1}, 1: {0: 2, 1: 1}, 2: {0: 0, 1: 3}, 3: {0: 2, 1: 1}}\n    for row in vectors:\n        for k, v in row.items():\n            if k != 'mid':\n                cur[k] = v\n        r = cur.get('reset', 0)\n        i = cur.get('in', 0)\n        if r:\n            s = 0\n        else:\n            s = trans[s][i]\n        ans.append({'out': 1 if s == 3 else 0})\n        if 'mid' in row:\n            for k, v in row['mid'].items():\n                cur[k] = v\n    return ans\n"
