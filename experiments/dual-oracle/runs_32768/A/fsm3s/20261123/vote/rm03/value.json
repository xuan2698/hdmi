"def reference(vectors):\n    s = 0\n    out = []\n    for row in vectors:\n        r = row.get('reset', 0)\n        i = row.get('in', 0)\n        if r:\n            s = 0\n        else:\n            if s == 0:\n                s = 1 if i else 0\n            elif s == 1:\n                s = 1 if i else 2\n            elif s == 2:\n                s = 3 if i else 0\n            elif s == 3:\n                s = 1 if i else 2\n        out.append({'out': 1 if s == 3 else 0})\n    return out\n"
