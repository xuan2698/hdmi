"def reference(vectors):\n    state = 0  # A\n    result = []\n    for v in vectors:\n        if v.get('reset', 0):\n            state = 0\n        elif state == 0:  # A\n            state = 0 if v.get('in', 0) == 0 else 1\n        elif state == 1:  # B\n            state = 2 if v.get('in', 0) == 0 else 1\n        elif state == 2:  # C\n            state = 0 if v.get('in', 0) == 0 else 3\n        else:  # D\n            state = 2 if v.get('in', 0) == 0 else 1\n        result.append({'out': 1 if state == 3 else 0})\n    return result\n"
