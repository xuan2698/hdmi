"def reference(vectors):\n    state = 0\n    nxt = ((0, 1), (2, 1), (0, 3), (2, 1))\n    outv = (0, 0, 0, 1)\n    result = []\n    for row in vectors:\n        if isinstance(row, dict):\n            reset = row.get('reset', 0)\n            inp = row.get('in', 0)\n        else:\n            inp = row[0] if len(row) > 0 else 0\n            reset = row[1] if len(row) > 1 else 0\n        if reset:\n            state = 0\n        else:\n            state = nxt[state][1 if inp else 0]\n        result.append({'out': outv[state]})\n    return result\n"
