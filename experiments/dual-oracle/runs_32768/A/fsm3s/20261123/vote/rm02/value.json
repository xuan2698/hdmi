"def reference(vectors):\n    state = 'A'\n    transitions = {\n        'A': ('A', 'B'),\n        'B': ('C', 'B'),\n        'C': ('A', 'D'),\n        'D': ('C', 'B'),\n    }\n    result = []\n    for row in vectors:\n        if row.get('reset', 0):\n            state = 'A'\n        else:\n            state = transitions[state][row['in']]\n        result.append({'out': 1 if state == 'D' else 0})\n    return result\n"
