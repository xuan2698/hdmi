"def reference(vectors):\n    state=0\n    inputs={'in':0,'reset':0}\n    t=[[0,1],[2,1],[0,3],[2,1]]\n    out=[]\n    for row in vectors:\n        for k in ('in','reset'):\n            if k in row:\n                inputs[k]=row[k]\n        if inputs['reset']:\n            state=0\n        else:\n            state=t[state][inputs['in']]\n        out.append({'out':1 if state==3 else 0})\n        if 'mid' in row:\n            for k,v in row['mid'].items():\n                inputs[k]=v\n    return out\n"
