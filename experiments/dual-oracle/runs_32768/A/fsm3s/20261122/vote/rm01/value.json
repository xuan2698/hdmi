"def reference(vectors):\n    state = 0\n    outputs = []\n    for v in vectors:\n        if v['reset']:\n            state = 0\n        else:\n            i = v['in']\n            if state == 0:\n                state = 1 if i else 0\n            elif state == 1:\n                state = 1 if i else 2\n            elif state == 2:\n                state = 3 if i else 0\n            else:\n                state = 1 if i else 2\n        outputs.append({'out': 1 if state == 3 else 0})\n    return outputs\n"
