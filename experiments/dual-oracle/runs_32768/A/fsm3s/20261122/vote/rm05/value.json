"def reference(vectors):\n    s = 'A'\n    r = []\n    for v in vectors:\n        if v.get('reset', 0):\n            s = 'A'\n        else:\n            i = v.get('in', 0)\n            if s == 'A':\n                if i:\n                    s = 'B'\n            elif s == 'B':\n                if not i:\n                    s = 'C'\n            elif s == 'C':\n                if i:\n                    s = 'D'\n                else:\n                    s = 'A'\n            else:\n                if i:\n                    s = 'B'\n                else:\n                    s = 'C'\n        r.append({'out': 1 if s == 'D' else 0})\n    return r\n"
