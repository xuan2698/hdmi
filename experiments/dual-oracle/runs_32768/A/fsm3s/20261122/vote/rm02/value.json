"def reference(vectors):\n    state = 0\n    result = []\n    for row in vectors:\n        if isinstance(row, dict):\n            inp = row.get('in', 0)\n            rst = row.get('reset', 0)\n        else:\n            inp = row[0]\n            rst = row[1]\n\n        if rst:\n            state = 0\n        else:\n            if state == 0:\n                state = 1 if inp else 0\n            elif state == 1:\n                state = 2 if inp == 0 else 1\n            elif state == 2:\n                state = 0 if inp == 0 else 3\n            else:\n                state = 2 if inp == 0 else 1\n\n        result.append({'out': 1 if state == 3 else 0})\n    return result\n"
