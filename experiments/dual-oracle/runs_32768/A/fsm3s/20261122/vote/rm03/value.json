"def reference(vectors):\n    state = 0  # A=0, B=1, C=2, D=3\n    out = []\n    for row in vectors:\n        reset = row[\"reset\"]\n        inp = row[\"in\"]\n        if reset:\n            state = 0\n        else:\n            if state == 0:\n                state = 1 if inp else 0\n            elif state == 1:\n                state = 2 if not inp else 1\n            elif state == 2:\n                state = 3 if inp else 0\n            else:\n                state = 2 if not inp else 1\n        out.append({\"out\": 1 if state == 3 else 0})\n    return out\n"
