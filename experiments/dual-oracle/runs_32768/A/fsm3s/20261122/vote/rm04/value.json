"def reference(vectors):\n    state = 0\n    prev_clk = 0\n    result = []\n    for v in vectors:\n        do_edge = True\n        if \"clk\" in v:\n            clk = v[\"clk\"] & 1\n            do_edge = (prev_clk == 0 and clk == 1)\n            prev_clk = clk\n        if do_edge:\n            if v.get(\"reset\", 0) & 1:\n                state = 0\n            else:\n                i = v.get(\"in\", 0) & 1\n                if state == 0:\n                    state = 1 if i else 0\n                elif state == 1:\n                    state = 1 if i else 2\n                elif state == 2:\n                    state = 3 if i else 0\n                else:\n                    state = 1 if i else 2\n        result.append({\"out\": 1 if state == 3 else 0})\n    return result\n"
