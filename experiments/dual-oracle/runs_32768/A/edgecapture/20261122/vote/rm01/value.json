"def reference(vectors):\n    mask = 0xFFFFFFFF\n    out = 0\n    prev = 0\n    result = []\n    for row in vectors:\n        reset = row['reset'] & 1\n        inp = row['in'] & mask\n        if reset:\n            out = 0\n        else:\n            out = (out | (prev & (mask ^ inp))) & mask\n        prev = inp\n        result.append({'out': out})\n    return result\n"
