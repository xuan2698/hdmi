"def reference(vectors):\n    m = 0xFFFFFFFF\n    prev = 0\n    out = 0\n    result = []\n    for row in vectors:\n        reset = row[\"reset\"] & 1\n        inp = row[\"in\"] & m\n        if reset:\n            out = 0\n        else:\n            out = (out | (prev & (~inp & m))) & m\n        prev = inp\n        result.append({\"out\": out})\n    return result\n"
