"def reference(vectors):\n    o = 0\n    p = 0\n    m = 0xFFFFFFFF\n    res = []\n    for v in vectors:\n        rst = v.get('reset', 0)\n        x = v.get('in', 0) & m\n        if rst & 1:\n            o = 0\n        else:\n            o = (o | (p & (x ^ m))) & m\n        p = x\n        res.append({'out': o})\n    return res\n"
