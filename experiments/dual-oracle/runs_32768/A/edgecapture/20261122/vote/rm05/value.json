"def reference(vectors):\n    out = 0\n    prev = 0\n    res = []\n    for row in vectors:\n        r = int(row.get('reset', 0)) & 1\n        iv = int(row.get('in', 0)) & 0xFFFFFFFF\n        if r:\n            out = 0\n            prev = 0\n        else:\n            out = (out | (prev & ((~iv) & 0xFFFFFFFF))) & 0xFFFFFFFF\n            prev = iv\n        res.append({'out': out})\n    return res\n"
