"def reference(vectors):\n    out = 0\n    prev = 0\n    result = []\n    for row in vectors:\n        if isinstance(row, dict):\n            rst = row.get('reset', 0)\n            cur = row.get('in', 0)\n        else:\n            if len(row) >= 2:\n                rst, cur = row[0], row[1]\n            else:\n                rst, cur = 0, row[0]\n        rst = int(rst) & 1\n        cur = int(cur) & 0xFFFFFFFF\n        if rst:\n            out = 0\n        else:\n            out = (out | (prev & (~cur & 0xFFFFFFFF))) & 0xFFFFFFFF\n        prev = cur\n        result.append({'out': out})\n    return result\n"
