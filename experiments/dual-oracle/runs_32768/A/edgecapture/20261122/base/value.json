"def reference(vectors):\n    out = 0\n    prev = 0\n    cur = {'reset': 0, 'in': 0}\n    mask = (1 << 32) - 1\n    result = []\n    for row in vectors:\n        for k, v in row.items():\n            if k != 'mid':\n                cur[k] = v\n        reset = cur.get('reset', 0) & 1\n        inval = cur.get('in', 0) & mask\n        if reset:\n            out = 0\n        else:\n            out = (out | (prev & (inval ^ mask))) & mask\n        prev = inval\n        result.append({'out': out})\n        mid = row.get('mid')\n        if isinstance(mid, dict):\n            for k, v in mid.items():\n                cur[k] = v\n    return result\n"
