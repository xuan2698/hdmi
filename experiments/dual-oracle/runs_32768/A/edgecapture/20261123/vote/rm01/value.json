"def reference(vectors):\n    out = 0\n    prev = 0\n    result = []\n    for row in vectors:\n        reset = int(row.get('reset', 0)) & 1\n        inp = int(row.get('in', 0)) & 0xFFFFFFFF\n        if reset:\n            out = 0\n        else:\n            out = (out | (prev & (~inp))) & 0xFFFFFFFF\n        prev = inp\n        result.append({'out': out})\n    return result\n"
