"def reference(vectors):\n    out = 0\n    prev = 0\n    mask = (1 << 32) - 1\n    result = []\n    for row in vectors:\n        if isinstance(row, dict):\n            rst = row.get('reset', 0)\n            inv = row.get('in', 0)\n        else:\n            rst = row[0]\n            inv = row[1]\n        rst = 1 if (rst & 1) else 0\n        inv = inv & mask\n        if rst:\n            out = 0\n        else:\n            out = (out | (prev & (mask ^ inv))) & mask\n        prev = inv\n        result.append({'out': out & mask})\n    return result\n"
