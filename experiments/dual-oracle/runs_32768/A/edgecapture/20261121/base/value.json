"def reference(vectors):\n    out = 0\n    prev = 0\n    reset = 0\n    inp = 0\n    res = []\n    for row in vectors:\n        if 'reset' in row:\n            reset = row['reset'] & 1\n        if 'in' in row:\n            inp = row['in'] & 0xFFFFFFFF\n        if reset:\n            out = 0\n        else:\n            out = (out | (prev & (~inp))) & 0xFFFFFFFF\n        prev = inp\n        res.append({'out': out})\n        if 'mid' in row and row['mid']:\n            mid = row['mid']\n            if 'reset' in mid:\n                reset = mid['reset'] & 1\n            if 'in' in mid:\n                inp = mid['in'] & 0xFFFFFFFF\n    return res\n"
