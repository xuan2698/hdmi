"def reference(vectors):\n    out = 0\n    prev = 0\n    mask = 0xFFFFFFFF\n    result = []\n    for row in vectors:\n        reset = row['reset'] & 1\n        inp = row['in'] & mask\n        if reset:\n            out = 0\n        else:\n            out = (out | (prev & (~inp & mask))) & mask\n        prev = inp\n        result.append({'out': out & mask})\n    return result\n"
