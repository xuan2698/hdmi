"def reference(vectors):\n    out = 0\n    prev = 0\n    result = []\n    for row in vectors:\n        reset = row['reset'] & 1\n        inp = row['in'] & 0xFFFFFFFF\n        if reset:\n            out = 0\n        else:\n            out = (out | (prev & (~inp & 0xFFFFFFFF))) & 0xFFFFFFFF\n        prev = inp\n        result.append({'out': out})\n    return result\n"
