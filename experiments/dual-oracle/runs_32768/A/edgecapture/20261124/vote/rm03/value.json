"def reference(vectors):\n    M = 0xFFFFFFFF\n    prev = 0\n    out = 0\n    result = []\n    for row in vectors:\n        reset = int(row.get(\"reset\", 0)) & 1\n        inp = int(row[\"in\"]) & M\n        if reset:\n            out = 0\n        else:\n            out = (out | (prev & (~inp) & M)) & M\n        prev = inp\n        result.append({\"out\": out})\n    return result\n"
