"def reference(vectors):\n    out=0\n    prev=0\n    cur={'reset':0,'in':0}\n    r=[]\n    for row in vectors:\n        if 'reset' in row: cur['reset']=row['reset']\n        if 'in' in row: cur['in']=row['in']\n        rst=cur['reset']&1\n        inv=cur['in']&0xffffffff\n        if rst:\n            out=0\n        else:\n            out=(out|(prev&(~inv)&0xffffffff))&0xffffffff\n        prev=inv\n        r.append({'out':out&0xffffffff})\n        m=row.get('mid')\n        if isinstance(m,dict):\n            for k,v in m.items():\n                if k in cur: cur[k]=v\n    return r\n"
