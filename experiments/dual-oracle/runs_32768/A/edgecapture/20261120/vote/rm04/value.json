"def reference(vectors):\n    out = 0\n    prev = 0\n    result = []\n    for row in vectors:\n        reset = row.get('reset', 0) & 1\n        value = row.get('in', 0) & 0xFFFFFFFF\n        if reset:\n            out = 0\n        else:\n            out = (out | (prev & ~value)) & 0xFFFFFFFF\n        prev = value\n        result.append({'out': out})\n    return result\n"
