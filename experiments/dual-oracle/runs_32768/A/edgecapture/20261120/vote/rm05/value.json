"def reference(vectors):\n    out = 0\n    prev = 0\n    prev_clk = 0\n    result = []\n    for row in vectors:\n        if 'clk' in row:\n            clk = int(row['clk']) & 1\n            posedge = (prev_clk == 0 and clk == 1)\n            prev_clk = clk\n        else:\n            posedge = True\n        if posedge:\n            if int(row.get('reset', 0)) & 1:\n                out = 0\n                prev = 0\n            else:\n                x = int(row.get('in', 0)) & 0xFFFFFFFF\n                out = (out | (prev & (~x & 0xFFFFFFFF))) & 0xFFFFFFFF\n                prev = x\n        result.append({'out': out & 0xFFFFFFFF})\n    return result\n"
