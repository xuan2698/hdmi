"def reference(vectors):\n    M=(1<<32)-1\n    out=0\n    prev=0\n    reset=0\n    inp=0\n    ans=[]\n    for row in vectors:\n        if 'reset' in row:\n            reset=row['reset']&1\n        if 'in' in row:\n            inp=row['in']&M\n        if reset:\n            out=0\n        else:\n            out=(out|(prev&~inp))&M\n        prev=inp\n        ans.append({'out':out})\n        if 'mid' in row:\n            mid=row['mid']\n            if 'reset' in mid:\n                reset=mid['reset']&1\n            if 'in' in mid:\n                inp=mid['in']&M\n    return ans\n"
