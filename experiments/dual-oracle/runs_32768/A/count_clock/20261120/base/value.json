"def reference(vectors):\n    def bcd(n):\n        return (n//10)*16+n%10\n    t=0\n    pm=0\n    cur={'reset':0,'ena':0}\n    out=[]\n    for r in vectors:\n        for k,v in r.items():\n            if k!='mid':\n                cur[k]=v\n        if cur.get('reset',0):\n            t=0\n            pm=0\n        elif cur.get('ena',0):\n            if t==43199:\n                t=0\n                pm^=1\n            else:\n                t+=1\n        h=t//3600\n        if h==0:\n            h=12\n        m=(t%3600)//60\n        s=t%60\n        out.append({'pm':pm,'hh':bcd(h),'mm':bcd(m),'ss':bcd(s)})\n        if 'mid' in r:\n            for k,v in r['mid'].items():\n                cur[k]=v\n    return out\n"
