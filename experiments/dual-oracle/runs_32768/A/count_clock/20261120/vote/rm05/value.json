"def reference(vectors):\n    hh = 0x12\n    mm = 0x00\n    ss = 0x00\n    pm = 0\n    out = []\n\n    for row in vectors:\n        reset = row['reset']\n        ena = row['ena']\n\n        if reset:\n            hh = 0x12\n            mm = 0x00\n            ss = 0x00\n            pm = 0\n        elif ena:\n            if ss == 0x59:\n                ss = 0x00\n                if mm == 0x59:\n                    mm = 0x00\n                    if hh == 0x12:\n                        hh = 0x01\n                    elif hh == 0x11:\n                        hh = 0x12\n                        pm ^= 1\n                    elif (hh & 0x0F) == 0x09:\n                        hh = ((hh >> 4) + 1) << 4\n                    else:\n                        hh += 1\n                else:\n                    if (mm & 0x0F) == 0x09:\n                        mm = ((mm >> 4) + 1) << 4\n                    else:\n                        mm += 1\n            else:\n                if (ss & 0x0F) == 0x09:\n                    ss = ((ss >> 4) + 1) << 4\n                else:\n                    ss += 1\n\n        out.append({'pm': pm, 'hh': hh, 'mm': mm, 'ss': ss})\n\n    return out\n"
