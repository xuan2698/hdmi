"def reference(vectors):\n    hh, mm, ss, pm = 0x12, 0x00, 0x00, 0\n    out = []\n    for v in vectors:\n        reset = v.get('reset', 0)\n        ena = v.get('ena', 0)\n\n        if reset:\n            hh, mm, ss, pm = 0x12, 0x00, 0x00, 0\n        elif ena:\n            ss += 1\n            if (ss & 0x0F) == 0x0A:\n                ss += 0x06\n            if ss >= 0x60:\n                ss = 0x00\n                mm += 1\n                if (mm & 0x0F) == 0x0A:\n                    mm += 0x06\n                if mm >= 0x60:\n                    mm = 0x00\n                    if hh == 0x12:\n                        hh = 0x01\n                    else:\n                        if hh == 0x11:\n                            pm ^= 1\n                        hh += 1\n                        if (hh & 0x0F) == 0x0A:\n                            hh += 0x06\n\n        out.append({'pm': pm, 'hh': hh, 'mm': mm, 'ss': ss})\n    return out\n"
