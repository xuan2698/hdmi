"def reference(vectors):\n    pm = 0\n    h = 12\n    m = 0\n    s = 0\n    prev_clk = 0\n    out = []\n\n    def bcd(x):\n        return ((x // 10) << 4) | (x % 10)\n\n    for row in vectors:\n        if 'clk' in row:\n            clk = int(row.get('clk', 0))\n            edge = (clk == 1 and prev_clk == 0)\n            prev_clk = clk\n        else:\n            edge = True\n\n        reset = int(row.get('reset', 0))\n        ena = int(row.get('ena', 0))\n\n        if edge:\n            if reset:\n                pm = 0\n                h = 12\n                m = 0\n                s = 0\n            elif ena:\n                s += 1\n                if s == 60:\n                    s = 0\n                    m += 1\n                    if m == 60:\n                        m = 0\n                        if h == 11:\n                            pm ^= 1\n                            h = 12\n                        elif h == 12:\n                            h = 1\n                        else:\n                            h += 1\n\n        out.append({\n            'pm': pm,\n            'hh': bcd(h),\n            'mm': bcd(m),\n            'ss': bcd(s)\n        })\n\n    return out\n"
