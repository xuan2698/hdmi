"def reference(vectors):\n    hh, mm, ss, pm = 0x12, 0, 0, 0\n\n    def inc(x):\n        return ((x >> 4) + 1) << 4 if (x & 15) == 9 else x + 1\n\n    out = []\n    for v in vectors:\n        r = v['reset'] if isinstance(v, dict) else v[0]\n        e = v['ena'] if isinstance(v, dict) else v[1]\n\n        if r:\n            hh, mm, ss, pm = 0x12, 0, 0, 0\n        elif e:\n            if ss == 0x59:\n                ss = 0\n                if mm == 0x59:\n                    mm = 0\n                    if hh == 0x12:\n                        hh = 0x01\n                    elif hh == 0x11:\n                        hh = 0x12\n                        pm ^= 1\n                    else:\n                        hh = inc(hh)\n                else:\n                    mm = inc(mm)\n            else:\n                ss = inc(ss)\n\n        out.append({'pm': pm, 'hh': hh, 'mm': mm, 'ss': ss})\n\n    return out\n"
