"def reference(vectors):\n    hour = 12\n    minute = 0\n    second = 0\n    pm = 0\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            reset = row.get('reset', 0)\n            ena = row.get('ena', 0)\n        else:\n            reset = row[0] if len(row) > 0 else 0\n            ena = row[1] if len(row) > 1 else 0\n        reset = int(reset) & 1\n        ena = int(ena) & 1\n        if reset:\n            hour = 12\n            minute = 0\n            second = 0\n            pm = 0\n        elif ena:\n            second += 1\n            if second == 60:\n                second = 0\n                minute += 1\n                if minute == 60:\n                    minute = 0\n                    hour += 1\n                    if hour == 12:\n                        pm ^= 1\n                    elif hour == 13:\n                        hour = 1\n        out.append({\n            'pm': pm,\n            'hh': (hour // 10) * 16 + (hour % 10),\n            'mm': (minute // 10) * 16 + (minute % 10),\n            'ss': (second // 10) * 16 + (second % 10)\n        })\n    return out\n"
