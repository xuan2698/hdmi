"def reference(vectors):\n    h = 12\n    m = 0\n    s = 0\n    pm = 0\n    outputs = []\n\n    for row in vectors:\n        reset = int(row.get('reset', 0))\n        ena = int(row.get('ena', 0))\n\n        if reset:\n            h = 12\n            m = 0\n            s = 0\n            pm = 0\n        elif ena:\n            s += 1\n            if s == 60:\n                s = 0\n                m += 1\n                if m == 60:\n                    m = 0\n                    if h == 12:\n                        h = 1\n                    else:\n                        h += 1\n                        if h == 12:\n                            pm ^= 1\n\n        hh = ((h // 10) << 4) | (h % 10)\n        mm = ((m // 10) << 4) | (m % 10)\n        ss = ((s // 10) << 4) | (s % 10)\n\n        outputs.append({\n            'pm': pm,\n            'hh': hh,\n            'mm': mm,\n            'ss': ss\n        })\n\n    return outputs\n"
