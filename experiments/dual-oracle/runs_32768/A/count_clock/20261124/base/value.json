"def reference(vectors):\n    hour=12\n    minute=0\n    second=0\n    pm=0\n    reset=0\n    ena=0\n    out=[]\n    for row in vectors:\n        if 'reset' in row:\n            reset=row['reset']\n        if 'ena' in row:\n            ena=row['ena']\n        if reset:\n            hour=12\n            minute=0\n            second=0\n            pm=0\n        elif ena:\n            second+=1\n            if second==60:\n                second=0\n                minute+=1\n                if minute==60:\n                    minute=0\n                    if hour==12:\n                        hour=1\n                    else:\n                        hour+=1\n                        if hour==12:\n                            pm^=1\n        out.append({\n            'pm': pm&1,\n            'hh': (((hour//10)<<4)|(hour%10))&0xff,\n            'mm': (((minute//10)<<4)|(minute%10))&0xff,\n            'ss': (((second//10)<<4)|(second%10))&0xff\n        })\n        for k,v in row.get('mid', {}).items():\n            if k=='reset':\n                reset=v\n            elif k=='ena':\n                ena=v\n    return out\n"
