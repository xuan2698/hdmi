"def reference(vectors):\n    h, m, s, pm = 12, 0, 0, 0\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            reset = row.get(\"reset\", 0)\n            ena = row.get(\"ena\", 0)\n        else:\n            reset = row[0]\n            ena = row[1]\n        reset = 1 if reset else 0\n        ena = 1 if ena else 0\n        if reset:\n            h, m, s, pm = 12, 0, 0, 0\n        elif ena:\n            s += 1\n            if s == 60:\n                s = 0\n                m += 1\n                if m == 60:\n                    m = 0\n                    if h == 11:\n                        h = 12\n                        pm ^= 1\n                    elif h == 12:\n                        h = 1\n                    else:\n                        h += 1\n        hh = ((h // 10) << 4) | (h % 10)\n        mm = ((m // 10) << 4) | (m % 10)\n        ss = ((s // 10) << 4) | (s % 10)\n        out.append({\"pm\": pm, \"hh\": hh, \"mm\": mm, \"ss\": ss})\n    return out\n"
