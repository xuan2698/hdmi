"def reference(vectors):\n    hh = 0x12\n    mm = 0\n    ss = 0\n    pm = 0\n    out = []\n    for r in vectors:\n        if r.get(\"reset\", 0):\n            hh = 0x12\n            mm = 0\n            ss = 0\n            pm = 0\n        elif r.get(\"ena\", 0):\n            if ss == 0x59:\n                ss = 0\n                if mm == 0x59:\n                    mm = 0\n                    if hh == 0x11:\n                        hh = 0x12\n                        pm = 1 - pm\n                    elif hh == 0x12:\n                        hh = 0x01\n                    else:\n                        lo = hh & 0x0f\n                        if lo == 9:\n                            hh = ((hh >> 4) + 1) << 4\n                        else:\n                            hh = (hh & 0xf0) | (lo + 1)\n                else:\n                    lo = mm & 0x0f\n                    if lo == 9:\n                        mm = ((mm >> 4) + 1) << 4\n                    else:\n                        mm = (mm & 0xf0) | (lo + 1)\n            else:\n                lo = ss & 0x0f\n                if lo == 9:\n                    ss = ((ss >> 4) + 1) << 4\n                else:\n                    ss = (ss & 0xf0) | (lo + 1)\n        out.append({\"pm\": pm, \"hh\": hh, \"mm\": mm, \"ss\": ss})\n    return out\n"
