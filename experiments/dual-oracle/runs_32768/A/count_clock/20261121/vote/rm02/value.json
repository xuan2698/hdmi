"def reference(vectors):\n    ss_t, ss_o = 0, 0\n    mm_t, mm_o = 0, 0\n    hh_t, hh_o = 1, 2\n    pm = 0\n    out = []\n    for v in vectors:\n        if isinstance(v, dict):\n            reset = v.get('reset', 0)\n            ena = v.get('ena', 0)\n        else:\n            reset = v[0]\n            ena = v[1]\n        if reset:\n            ss_t = ss_o = mm_t = mm_o = 0\n            hh_t, hh_o = 1, 2\n            pm = 0\n        elif ena:\n            if ss_o < 9:\n                ss_o += 1\n            else:\n                ss_o = 0\n                if ss_t < 5:\n                    ss_t += 1\n                else:\n                    ss_t = 0\n                    if mm_o < 9:\n                        mm_o += 1\n                    else:\n                        mm_o = 0\n                        if mm_t < 5:\n                            mm_t += 1\n                        else:\n                            mm_t = 0\n                            h = hh_t * 10 + hh_o\n                            if h == 12:\n                                hh_t, hh_o = 0, 1\n                            elif h == 11:\n                                hh_t, hh_o = 1, 2\n                                pm ^= 1\n                            else:\n                                h += 1\n                                hh_t, hh_o = h // 10, h % 10\n        out.append({\n            'pm': pm,\n            'hh': (hh_t << 4) | hh_o,\n            'mm': (mm_t << 4) | mm_o,\n            'ss': (ss_t << 4) | ss_o\n        })\n    return out\n"
