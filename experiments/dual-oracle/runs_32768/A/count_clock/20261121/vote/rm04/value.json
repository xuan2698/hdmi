"def reference(vectors):\n    h = 12\n    m = 0\n    s = 0\n    pm = 0\n    out = []\n    for r in vectors:\n        if isinstance(r, dict):\n            rst = r.get('reset', 0)\n            ena = r.get('ena', 0)\n        elif isinstance(r, int):\n            rst = (r >> 1) & 1\n            ena = r & 1\n        else:\n            rst = r[0]\n            ena = r[1] if len(r) > 1 else 0\n        if rst:\n            h, m, s, pm = 12, 0, 0, 0\n        elif ena:\n            s += 1\n            if s == 60:\n                s = 0\n                m += 1\n                if m == 60:\n                    m = 0\n                    if h == 11:\n                        h = 12\n                        pm ^= 1\n                    elif h == 12:\n                        h = 1\n                    else:\n                        h += 1\n        out.append({\n            'pm': pm,\n            'hh': ((h // 10) << 4) | (h % 10),\n            'mm': ((m // 10) << 4) | (m % 10),\n            'ss': ((s // 10) << 4) | (s % 10)\n        })\n    return out\n"
