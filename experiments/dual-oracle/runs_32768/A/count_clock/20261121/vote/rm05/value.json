"def reference(vectors):\n    idx = 0      # minute index within 12-hour cycle: 0=12:00, 60=01:00, ..., 660=11:00\n    sec = 0      # seconds 0..59\n    pm = 0       # 0=AM, 1=PM\n    result = []\n\n    for row in vectors:\n        if isinstance(row, dict):\n            reset = row.get('reset', 0)\n            ena = row.get('ena', 0)\n        else:\n            reset = row[0]\n            ena = row[1]\n\n        if reset:\n            idx = 0\n            sec = 0\n            pm = 0\n        elif ena:\n            sec += 1\n            if sec == 60:\n                sec = 0\n                idx += 1\n                if idx == 720:\n                    idx = 0\n                    pm ^= 1\n\n        hour = idx // 60\n        if hour == 0:\n            hour = 12\n        minute = idx % 60\n\n        hh = ((hour // 10) << 4) | (hour % 10)\n        mm = ((minute // 10) << 4) | (minute % 10)\n        ss = ((sec // 10) << 4) | (sec % 10)\n\n        result.append({'pm': pm, 'hh': hh, 'mm': mm, 'ss': ss})\n\n    return result\n"
