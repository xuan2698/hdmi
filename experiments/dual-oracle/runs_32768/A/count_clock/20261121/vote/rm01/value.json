"def reference(vectors):\n    hh = 0x12\n    mm = 0\n    ss = 0\n    pm = 0\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            reset = row.get('reset', 0)\n            ena = row.get('ena', 0)\n        else:\n            reset = row[0]\n            ena = row[1]\n\n        if reset:\n            hh = 0x12\n            mm = 0\n            ss = 0\n            pm = 0\n        elif ena:\n            if ss != 0x59:\n                sv = (ss >> 4) * 10 + (ss & 0xF) + 1\n                ss = ((sv // 10) << 4) | (sv % 10)\n            else:\n                ss = 0\n                if mm != 0x59:\n                    mv = (mm >> 4) * 10 + (mm & 0xF) + 1\n                    mm = ((mv // 10) << 4) | (mv % 10)\n                else:\n                    mm = 0\n                    hv = (hh >> 4) * 10 + (hh & 0xF)\n                    if hv == 12:\n                        hv = 1\n                    elif hv == 11:\n                        hv = 12\n                        pm ^= 1\n                    else:\n                        hv += 1\n                    hh = ((hv // 10) << 4) | (hv % 10)\n\n        out.append({'pm': pm, 'hh': hh, 'mm': mm, 'ss': ss})\n    return out\n"
