"def reference(vectors):\n    hh = 12\n    mm = 0\n    ss = 0\n    pm = 0\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            reset = row.get('reset', 0)\n            ena = row.get('ena', 0)\n        else:\n            reset = row[0]\n            ena = row[1]\n        if reset:\n            hh, mm, ss, pm = 12, 0, 0, 0\n        elif ena:\n            ss += 1\n            if ss == 60:\n                ss = 0\n                mm += 1\n                if mm == 60:\n                    mm = 0\n                    if hh == 11:\n                        hh = 12\n                        pm ^= 1\n                    elif hh == 12:\n                        hh = 1\n                    else:\n                        hh += 1\n        out.append({\n            'pm': pm,\n            'hh': ((hh // 10) << 4) | (hh % 10),\n            'mm': ((mm // 10) << 4) | (mm % 10),\n            'ss': ((ss // 10) << 4) | (ss % 10)\n        })\n    return out\n"
