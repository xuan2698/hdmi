"def reference(vectors):\n    total = 0\n    result = []\n    for row in vectors:\n        if isinstance(row, dict):\n            reset = row.get('reset', 0)\n            ena = row.get('ena', 0)\n        else:\n            reset = row[0]\n            ena = row[1]\n\n        if reset:\n            total = 0\n        elif ena:\n            total = (total + 1) % 86400\n\n        h24 = total // 3600\n        pm = 1 if h24 >= 12 else 0\n\n        hour = h24 % 12\n        if hour == 0:\n            hour = 12\n\n        minute = (total // 60) % 60\n        second = total % 60\n\n        hh = ((hour // 10) << 4) | (hour % 10)\n        mm = ((minute // 10) << 4) | (minute % 10)\n        ss = ((second // 10) << 4) | (second % 10)\n\n        result.append({'pm': pm, 'hh': hh, 'mm': mm, 'ss': ss})\n\n    return result\n"
