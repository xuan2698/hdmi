"def reference(vectors):\n    hour = 12\n    minute = 0\n    second = 0\n    pm = 0\n    result = []\n\n    for row in vectors:\n        if isinstance(row, dict):\n            rst = row.get(\"reset\", 0)\n            ena = row.get(\"ena\", 0)\n        else:\n            rst = row[0]\n            ena = row[1]\n\n        if rst:\n            hour = 12\n            minute = 0\n            second = 0\n            pm = 0\n        elif ena:\n            second += 1\n            if second == 60:\n                second = 0\n                minute += 1\n                if minute == 60:\n                    minute = 0\n                    if hour == 11:\n                        hour = 12\n                        pm ^= 1\n                    elif hour == 12:\n                        hour = 1\n                    else:\n                        hour += 1\n\n        hh = ((hour // 10) << 4) | (hour % 10)\n        mm = ((minute // 10) << 4) | (minute % 10)\n        ss = ((second // 10) << 4) | (second % 10)\n\n        result.append({\"pm\": pm, \"hh\": hh, \"mm\": mm, \"ss\": ss})\n\n    return result\n"
