"def reference(vectors):\n    total = 0\n    pm = 0\n    out = []\n    for row in vectors:\n        reset = row.get('reset', 0) if isinstance(row, dict) else row[0]\n        ena = row.get('ena', 0) if isinstance(row, dict) else row[1]\n        if reset:\n            total = 0\n            pm = 0\n        elif ena:\n            total += 1\n            if total == 43200:\n                total = 0\n                pm ^= 1\n        h = (total // 3600) % 12\n        if h == 0:\n            h = 12\n        m = (total // 60) % 60\n        s = total % 60\n        hh = ((h // 10) << 4) | (h % 10)\n        mm = ((m // 10) << 4) | (m % 10)\n        ss = ((s // 10) << 4) | (s % 10)\n        out.append({'pm': pm, 'hh': hh, 'mm': mm, 'ss': ss})\n    return out\n"
