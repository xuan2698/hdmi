"def reference(vectors):\n    t = 0\n    out = []\n    for v in vectors:\n        if isinstance(v, dict):\n            reset = v['reset']\n            ena = v['ena']\n        else:\n            reset, ena = v[0], v[1]\n\n        if reset:\n            t = 0\n        elif ena:\n            t = (t + 1) % 86400\n\n        h = (t // 3600) % 12\n        if h == 0:\n            h = 12\n        m = (t // 60) % 60\n        s = t % 60\n\n        def bcd(x):\n            return ((x // 10) << 4) | (x % 10)\n\n        out.append({\n            'pm': 1 if t >= 43200 else 0,\n            'hh': bcd(h),\n            'mm': bcd(m),\n            'ss': bcd(s)\n        })\n    return out\n"
