"def reference(vectors):\n    h, m, s, pm = 12, 0, 0, 0\n    cur = {'reset': 0, 'ena': 0}\n    out = []\n    for row in vectors:\n        for k, v in row.items():\n            if k != 'mid' and k in cur:\n                cur[k] = v\n        if cur['reset']:\n            h, m, s, pm = 12, 0, 0, 0\n        elif cur['ena']:\n            s += 1\n            if s == 60:\n                s = 0\n                m += 1\n                if m == 60:\n                    m = 0\n                    if h == 12:\n                        h = 1\n                    elif h == 11:\n                        h = 12\n                        pm ^= 1\n                    else:\n                        h += 1\n        hh = ((h // 10) << 4) | (h % 10)\n        mm = ((m // 10) << 4) | (m % 10)\n        ss = ((s // 10) << 4) | (s % 10)\n        out.append({'pm': pm & 1, 'hh': hh & 255, 'mm': mm & 255, 'ss': ss & 255})\n        if isinstance(row.get('mid'), dict):\n            for k, v in row['mid'].items():\n                if k in cur:\n                    cur[k] = v\n    return out\n"
