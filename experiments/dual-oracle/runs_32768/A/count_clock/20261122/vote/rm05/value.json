"def reference(vectors):\n    h, m, s, pm = 12, 0, 0, 0\n    out = []\n    for v in vectors:\n        if isinstance(v, dict):\n            reset = v.get('reset', 0)\n            ena = v.get('ena', 0)\n        else:\n            reset = v[0] if len(v) > 0 else 0\n            ena = v[1] if len(v) > 1 else 0\n        reset = 1 if reset else 0\n        ena = 1 if ena else 0\n\n        if reset:\n            h, m, s, pm = 12, 0, 0, 0\n        elif ena:\n            s += 1\n            if s == 60:\n                s = 0\n                m += 1\n                if m == 60:\n                    m = 0\n                    if h == 11:\n                        h = 12\n                        pm = 1 - pm\n                    elif h == 12:\n                        h = 1\n                    else:\n                        h += 1\n\n        out.append({\n            'pm': pm,\n            'hh': (h // 10) * 16 + (h % 10),\n            'mm': (m // 10) * 16 + (m % 10),\n            'ss': (s // 10) * 16 + (s % 10)\n        })\n    return out\n"
