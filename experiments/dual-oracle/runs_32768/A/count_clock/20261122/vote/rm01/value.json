"def reference(vectors):\n    h = 12\n    m = 0\n    s = 0\n    p = 0\n    out = []\n    for v in vectors:\n        if isinstance(v, dict):\n            rst = v.get('reset', 0)\n            en = v.get('ena', 0)\n        else:\n            rst = v[0] if len(v) > 0 else 0\n            en = v[1] if len(v) > 1 else 0\n\n        if rst:\n            h, m, s, p = 12, 0, 0, 0\n        elif en:\n            s += 1\n            if s == 60:\n                s = 0\n                m += 1\n                if m == 60:\n                    m = 0\n                    if h == 11:\n                        h = 12\n                        p = 1 - p\n                    elif h == 12:\n                        h = 1\n                    else:\n                        h += 1\n\n        hh = (h // 10) * 16 + (h % 10)\n        mm = (m // 10) * 16 + (m % 10)\n        ss = (s // 10) * 16 + (s % 10)\n        out.append({'pm': p, 'hh': hh, 'mm': mm, 'ss': ss})\n\n    return out\n"
