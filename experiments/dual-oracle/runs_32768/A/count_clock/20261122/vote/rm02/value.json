"def reference(vectors):\n    t = 0\n    out = []\n    for v in vectors:\n        if isinstance(v, dict):\n            reset = v.get('reset', 0)\n            ena = v.get('ena', 0)\n        else:\n            reset = v[0]\n            ena = v[1]\n        if reset:\n            t = 0\n        elif ena:\n            t = (t + 1) % 86400\n        x = t % 43200\n        h = x // 3600\n        if h == 0:\n            h = 12\n        m = (x % 3600) // 60\n        s = x % 60\n        hh = ((h // 10) << 4) | (h % 10)\n        mm = ((m // 10) << 4) | (m % 10)\n        ss = ((s // 10) << 4) | (s % 10)\n        pm = 1 if t >= 43200 else 0\n        out.append({'pm': pm, 'hh': hh, 'mm': mm, 'ss': ss})\n    return out\n"
