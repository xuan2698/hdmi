"def reference(vectors):\n    pm = 0\n    h, m, s = 12, 0, 0\n    out = []\n    for v in vectors:\n        if isinstance(v, dict):\n            rst = v.get('reset', 0)\n            ena = v.get('ena', 0)\n        else:\n            rst, ena = v[0], v[1]\n\n        if rst:\n            pm, h, m, s = 0, 12, 0, 0\n        elif ena:\n            s += 1\n            if s == 60:\n                s = 0\n                m += 1\n                if m == 60:\n                    m = 0\n                    old_h = h\n                    h = 1 if h == 12 else h + 1\n                    if old_h == 11:\n                        pm ^= 1\n\n        out.append({\n            'pm': pm,\n            'hh': (h // 10) * 16 + (h % 10),\n            'mm': (m // 10) * 16 + (m % 10),\n            'ss': (s // 10) * 16 + (s % 10)\n        })\n    return out\n"
