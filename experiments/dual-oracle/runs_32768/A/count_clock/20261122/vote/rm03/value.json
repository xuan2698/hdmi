"def reference(vectors):\n    h = 12\n    m = 0\n    s = 0\n    pm = 0\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            r = row.get('reset', 0)\n            e = row.get('ena', 0)\n        else:\n            r = row[0]\n            e = row[1] if len(row) > 1 else 0\n\n        if r:\n            h = 12\n            m = 0\n            s = 0\n            pm = 0\n        elif e:\n            s += 1\n            if s == 60:\n                s = 0\n                m += 1\n                if m == 60:\n                    m = 0\n                    h += 1\n                    if h == 12:\n                        pm ^= 1\n                    elif h == 13:\n                        h = 1\n\n        out.append({\n            \"pm\": pm,\n            \"hh\": ((h // 10) << 4) | (h % 10),\n            \"mm\": ((m // 10) << 4) | (m % 10),\n            \"ss\": ((s // 10) << 4) | (s % 10),\n        })\n    return out\n"
