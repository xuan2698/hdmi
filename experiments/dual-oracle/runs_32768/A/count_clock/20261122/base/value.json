"def reference(vectors):\n    h,m,s,pm=12,0,0,0\n    inp={'reset':0,'ena':0}\n    out=[]\n    for row in vectors:\n        for k in ('reset','ena'):\n            if k in row:\n                inp[k]=row[k]\n        if inp['reset']:\n            h,m,s,pm=12,0,0,0\n        elif inp['ena']:\n            s+=1\n            if s==60:\n                s=0\n                m+=1\n                if m==60:\n                    m=0\n                    if h==11:\n                        h=12\n                        pm^=1\n                    elif h==12:\n                        h=1\n                    else:\n                        h+=1\n        out.append({'pm':pm,'hh':((h//10)<<4)|(h%10),'mm':((m//10)<<4)|(m%10),'ss':((s//10)<<4)|(s%10)})\n        if 'mid' in row:\n            for k,v in row['mid'].items():\n                if k in inp:\n                    inp[k]=v\n    return out\n"
