"def reference(vectors):\n    pht=[0]*128\n    ghr=0\n    pt=0\n    ph=0\n    out=[]\n    for row in vectors:\n        if row.get('areset',0):\n            pht=[0]*128\n            ghr=0\n            pt=0\n            ph=0\n        else:\n            pv=row.get('predict_valid',0)\n            ppc=row.get('predict_pc',0)&127\n            idx=(ppc^ghr)&127\n            pred=(pht[idx]>>1)&1\n            old=ghr\n            if pv:\n                pt=pred\n                ph=old\n            nghr=ghr\n            if pv:\n                nghr=((ghr<<1)|pred)&127\n            if row.get('train_valid',0):\n                tt=row.get('train_taken',0)\n                th=row.get('train_history',0)&127\n                tpc=row.get('train_pc',0)&127\n                if row.get('train_mispredicted',0):\n                    nghr=((th<<1)|tt)&127\n                ti=(tpc^th)&127\n                c=pht[ti]\n                if tt:\n                    c=min(3,c+1)\n                else:\n                    c=max(0,c-1)\n                pht[ti]=c\n            ghr=nghr\n        out.append({'predict_taken':pt,'predict_history':ph})\n        m=row.get('mid')\n        if m and m.get('areset',0):\n            pht=[0]*128\n            ghr=0\n            pt=0\n            ph=0\n    return out\n"
