"def reference(vectors):\n    history = 0\n    pht = [0] * 128\n    pred_taken_out = 0\n    pred_history_out = 0\n    results = []\n\n    for row in vectors:\n        areset = row.get('areset', 0)\n        if areset:\n            history = 0\n            pht = [0] * 128\n            pred_taken_out = 0\n            pred_history_out = 0\n            results.append({'predict_taken': 0, 'predict_history': 0})\n            continue\n\n        predict_valid = row.get('predict_valid', 0)\n        predict_pc = row.get('predict_pc', 0) & 0x7F\n        train_valid = row.get('train_valid', 0)\n        train_taken = row.get('train_taken', 0) & 1\n        train_mispredicted = row.get('train_mispredicted', 0) & 1\n        train_history = row.get('train_history', 0) & 0x7F\n        train_pc = row.get('train_pc', 0) & 0x7F\n\n        pred_taken = 0\n        if predict_valid:\n            pred_index = (predict_pc ^ history) & 0x7F\n            pred_counter = pht[pred_index]\n            pred_taken = (pred_counter >> 1) & 1\n            pred_taken_out = pred_taken\n            pred_history_out = history\n\n        if train_valid:\n            train_index = (train_pc ^ train_history) & 0x7F\n            cnt = pht[train_index]\n            if train_taken:\n                if cnt < 3:\n                    cnt += 1\n            else:\n                if cnt > 0:\n                    cnt -= 1\n            pht[train_index] = cnt\n\n        if train_valid and train_mispredicted:\n            history = ((train_history << 1) | train_taken) & 0x7F\n        elif predict_valid:\n            history = ((history << 1) | pred_taken) & 0x7F\n\n        results.append({'predict_taken': pred_taken_out, 'predict_history': pred_history_out})\n\n    return results\n"
