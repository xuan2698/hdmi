"def reference(vectors):\n    pht = [0] * 128\n    hist = 0\n    result = []\n\n    for row in vectors:\n        areset = row.get('areset', 0)\n        if areset:\n            pht = [0] * 128\n            hist = 0\n            pc = row.get('predict_pc', 0) & 0x7f\n            idx = (pc ^ hist) & 0x7f\n            taken = (pht[idx] >> 1) & 1\n            result.append({\n                'predict_taken': taken,\n                'predict_history': hist\n            })\n            continue\n\n        pv = row.get('predict_valid', 0)\n        ppc = row.get('predict_pc', 0) & 0x7f\n        tv = row.get('train_valid', 0)\n        tt = row.get('train_taken', 0) & 1\n        tm = row.get('train_mispredicted', 0) & 1\n        th = row.get('train_history', 0) & 0x7f\n        tpc = row.get('train_pc', 0) & 0x7f\n\n        idx = (ppc ^ hist) & 0x7f\n        taken = (pht[idx] >> 1) & 1\n        pred_hist = hist\n\n        next_hist = hist\n        if tv and tm:\n            next_hist = ((th << 1) & 0x7f) | tt\n        elif pv:\n            next_hist = ((hist << 1) & 0x7f) | taken\n\n        if tv:\n            tidx = (tpc ^ th) & 0x7f\n            c = pht[tidx]\n            if tt:\n                if c < 3:\n                    c += 1\n            else:\n                if c > 0:\n                    c -= 1\n            pht[tidx] = c\n\n        hist = next_hist\n        result.append({\n            'predict_taken': taken,\n            'predict_history': pred_hist\n        })\n\n    return result\n"
