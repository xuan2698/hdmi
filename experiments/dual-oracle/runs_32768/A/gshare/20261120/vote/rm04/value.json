"def reference(vectors):\n    pht = [0] * 128\n    ghr = 0\n    outputs = []\n\n    for vin in vectors:\n        areset = vin.get('areset', 0)\n        predict_valid = vin.get('predict_valid', 0)\n        predict_pc = vin.get('predict_pc', 0)\n        train_valid = vin.get('train_valid', 0)\n        train_taken = vin.get('train_taken', 0)\n        train_mispredicted = vin.get('train_mispredicted', 0)\n        train_history = vin.get('train_history', 0)\n        train_pc = vin.get('train_pc', 0)\n\n        if areset:\n            pht = [0] * 128\n            ghr = 0\n\n        idx_pred = (predict_pc ^ ghr) & 0x7f\n        pred_taken = (pht[idx_pred] >> 1) & 1\n        pred_history = ghr\n\n        outputs.append({\n            'predict_taken': pred_taken,\n            'predict_history': pred_history\n        })\n\n        if not areset:\n            next_ghr = ghr\n\n            if train_valid:\n                idx_train = (train_pc ^ train_history) & 0x7f\n                cnt = pht[idx_train]\n                if train_taken:\n                    if cnt < 3:\n                        cnt += 1\n                else:\n                    if cnt > 0:\n                        cnt -= 1\n                pht[idx_train] = cnt\n\n            if train_valid and train_mispredicted:\n                next_ghr = ((train_history << 1) | (train_taken & 1)) & 0x7f\n            elif predict_valid:\n                next_ghr = ((ghr << 1) | pred_taken) & 0x7f\n\n            ghr = next_ghr\n\n    return outputs\n"
