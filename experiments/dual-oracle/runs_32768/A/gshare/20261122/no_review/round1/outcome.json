{
  "decisions": [
    {
      "id": "s5/3/predict_history",
      "label": "RM",
      "spec_quote": "if the branch being trained is mispredicted, also recover the branch history register to the state immediately after the mispredicting branch completes execution."
    },
    {
      "id": "s5/4/predict_history",
      "label": "RM",
      "spec_quote": "if the branch being trained is mispredicted, also recover the branch history register to the state immediately after the mispredicting branch completes execution."
    },
    {
      "id": "s6/4/predict_taken",
      "label": "RM",
      "spec_quote": "Update the pattern history table (PHT) to train the branch predictor to predict this branch more accurately next time."
    },
    {
      "id": "s6/5/predict_taken",
      "label": "RM",
      "spec_quote": "Update the pattern history table (PHT) to train the branch predictor to predict this branch more accurately next time."
    },
    {
      "id": "s6/7/predict_history",
      "label": "RM",
      "spec_quote": "The branch history register is then updated (at the next positive clock edge) for the predicted branch."
    }
  ],
  "RM": "def reference(vectors):\n    bhr = 0\n    pht = [0] * 128\n    result = []\n    for row in vectors:\n        if row['areset'] & 1:\n            bhr = 0\n            pht = [0] * 128\n            result.append({'predict_taken': 0, 'predict_history': 0})\n            continue\n\n        pc = row['predict_pc'] & 0x7F\n        idx = (pc ^ bhr) & 0x7F\n        predict_taken = 1 if pht[idx] >= 2 else 0\n        predict_history = bhr & 0x7F\n        result.append({'predict_taken': predict_taken, 'predict_history': predict_history})\n\n        train_valid = row['train_valid'] & 1\n        train_taken = row['train_taken'] & 1\n        train_mispredicted = row['train_mispredicted'] & 1\n        train_history = row['train_history'] & 0x7F\n        train_pc = row['train_pc'] & 0x7F\n\n        if train_valid:\n            tidx = (train_pc ^ train_history) & 0x7F\n            c = pht[tidx]\n            if train_taken:\n                if c < 3:\n                    c += 1\n            else:\n                if c > 0:\n                    c -= 1\n            pht[tidx] = c\n\n        if train_valid and train_mispredicted:\n            bhr = ((train_history << 1) | train_taken) & 0x7F\n        elif row['predict_valid'] & 1:\n            bhr = ((bhr << 1) | predict_taken) & 0x7F\n\n    return result\n",
