"def reference(vectors):\n    bhr = 0\n    pht = [0] * 128\n    result = []\n    for row in vectors:\n        areset = row['areset'] & 1\n        if areset:\n            bhr = 0\n            pht = [0] * 128\n            result.append({'predict_taken': 0, 'predict_history': 0})\n            continue\n\n        predict_pc = row['predict_pc'] & 0x7F\n        idx_pred = (predict_pc ^ bhr) & 0x7F\n        predict_taken = 1 if pht[idx_pred] >= 2 else 0\n        predict_history = bhr & 0x7F\n        result.append({\n            'predict_taken': predict_taken,\n            'predict_history': predict_history\n        })\n\n        train_valid = row['train_valid'] & 1\n        train_taken = row['train_taken'] & 1\n        train_mispredicted = row['train_mispredicted'] & 1\n        train_history = row['train_history'] & 0x7F\n        train_pc = row['train_pc'] & 0x7F\n\n        if train_valid:\n            idx_train = (train_pc ^ train_history) & 0x7F\n            c = pht[idx_train]\n            if train_taken:\n                c = c + 1 if c < 3 else 3\n            else:\n                c = c - 1 if c > 0 else 0\n            pht[idx_train] = c\n\n        predict_valid = row['predict_valid'] & 1\n        if train_valid and train_mispredicted:\n            bhr = ((train_history << 1) | train_taken) & 0x7F\n        elif predict_valid:\n            bhr = ((bhr << 1) | predict_taken) & 0x7F\n\n    return result\n"
