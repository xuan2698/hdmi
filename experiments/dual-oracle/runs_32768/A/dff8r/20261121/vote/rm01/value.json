"def reference(vectors):\n    q = 0\n    pc = 0\n    out = []\n    for r in vectors:\n        c = r.get('clk', 0)\n        if c == 1 and pc == 0:\n            if r.get('reset', 0):\n                q = 0\n            else:\n                q = r.get('d', 0) & 0xff\n        pc = c\n        out.append({'q': q & 0xff})\n    return out\n"
