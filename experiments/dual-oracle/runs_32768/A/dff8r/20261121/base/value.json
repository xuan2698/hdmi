"def reference(vectors):\n    q = 0\n    inp = {'d': 0, 'reset': 0}\n    out = []\n    for row in vectors:\n        for k in ('d', 'reset'):\n            if k in row:\n                inp[k] = row[k]\n        if inp.get('reset', 0):\n            q = 0\n        else:\n            q = inp.get('d', 0) & 0xFF\n        out.append({'q': q})\n        mid = row.get('mid')\n        if isinstance(mid, dict):\n            for k, v in mid.items():\n                if k in ('d', 'reset'):\n                    inp[k] = v\n    return out\n"
