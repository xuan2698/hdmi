"def reference(vectors):\n    d = 0\n    r = 0\n    q = 0\n    out = []\n    for row in vectors:\n        if 'd' in row:\n            d = row['d'] & 255\n        if 'reset' in row:\n            r = row['reset'] & 1\n        q = 0 if r else (d & 255)\n        out.append({'q': q})\n        if 'mid' in row and isinstance(row['mid'], dict):\n            m = row['mid']\n            if 'd' in m:\n                d = m['d'] & 255\n            if 'reset' in m:\n                r = m['reset'] & 1\n    return out\n"
