"def reference(vectors):\n    q = 0\n    d = 0\n    reset = 0\n    out = []\n    for row in vectors:\n        if 'd' in row:\n            d = row['d']\n        if 'reset' in row:\n            reset = row['reset']\n        if reset & 1:\n            q = 0\n        else:\n            q = d & 0xFF\n        out.append({'q': q})\n        mid = row.get('mid', {})\n        if 'd' in mid:\n            d = mid['d']\n        if 'reset' in mid:\n            reset = mid['reset']\n    return out\n"
