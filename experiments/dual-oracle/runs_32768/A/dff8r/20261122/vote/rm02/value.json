"def reference(vectors):\n    q = 0\n    prev_clk = 0\n    out = []\n    for row in vectors:\n        clk = row.get('clk', 0)\n        if prev_clk == 0 and clk == 1:\n            if row.get('reset', 0):\n                q = 0\n            else:\n                q = row.get('d', 0) & 255\n        out.append({'q': q & 255})\n        prev_clk = clk\n    return out\n"
