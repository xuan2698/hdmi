"def reference(vectors):\n    q = 0\n    cur = {'d': 0, 'reset': 0}\n    out = []\n    for row in vectors:\n        for k in ('d', 'reset'):\n            if k in row:\n                cur[k] = row[k]\n        q = 0 if cur['reset'] else (cur['d'] & 255)\n        out.append({'q': q})\n        if 'mid' in row:\n            for k in ('d', 'reset'):\n                if k in row['mid']:\n                    cur[k] = row['mid'][k]\n    return out\n"
