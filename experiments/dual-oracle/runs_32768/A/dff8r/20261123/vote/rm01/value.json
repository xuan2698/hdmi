"def reference(vectors):\n    q = 0\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            d = row.get('d', 0)\n            reset = row.get('reset', 0)\n        else:\n            d = row[0] if len(row) > 0 else 0\n            reset = row[1] if len(row) > 1 else 0\n        q = 0 if (int(reset) & 1) else (int(d) & 0xff)\n        out.append({'q': q})\n    return out\n"
