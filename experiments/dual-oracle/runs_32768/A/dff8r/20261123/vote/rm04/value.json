"def reference(vectors):\n    q = 0\n    prev = 0\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            has_clk = 'clk' in row\n            clk = row.get('clk', 0)\n            d = row.get('d', 0)\n            reset = row.get('reset', 0)\n        else:\n            if len(row) == 3:\n                has_clk = True\n                clk, d, reset = row\n            else:\n                has_clk = False\n                d, reset = row\n        if has_clk:\n            if clk == 1 and prev == 0:\n                q = 0 if reset else (d & 255)\n            prev = clk & 1\n        else:\n            q = 0 if reset else (d & 255)\n        out.append({'q': q})\n    return out\n"
