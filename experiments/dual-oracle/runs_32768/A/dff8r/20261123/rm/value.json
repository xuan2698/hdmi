"def reference(vectors):\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            d = row.get('d', 0)\n            reset = row.get('reset', 0)\n        else:\n            d = row[0] if len(row) > 0 else 0\n            reset = row[1] if len(row) > 1 else 0\n        out.append({'q': 0 if reset else (d & 0xFF)})\n    return out\n"
