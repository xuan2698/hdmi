"def reference(vectors):\n    q = 0\n    s = {'d': 0, 'reset': 0}\n    out = []\n    for r in vectors:\n        for k in ('d', 'reset'):\n            if k in r:\n                s[k] = r[k]\n        d = s['d'] & 255\n        reset = s['reset'] & 1\n        if reset:\n            q = 0\n        else:\n            q = d\n        out.append({'q': q & 255})\n        if 'mid' in r:\n            for k, v in r['mid'].items():\n                if k in s:\n                    s[k] = v\n    return out\n"
