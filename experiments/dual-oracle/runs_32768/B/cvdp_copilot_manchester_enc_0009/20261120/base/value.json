"def reference(vectors):\n    ev = ed = dv = dd = 0\n    out = []\n    for i, row in enumerate(vectors):\n        if isinstance(row, dict):\n            rst = int(row.get('rst_in', 0)) & 1\n            evi = int(row.get('enc_valid_in', 0)) & 1\n            edi = int(row.get('enc_data_in', 0)) & 255\n            dvi = int(row.get('dec_valid_in', 0)) & 1\n            ddi = int(row.get('dec_data_in', 0)) & 65535\n            e = row.get('edge', None)\n            if e is None:\n                e = row.get('clk_in', None)\n        else:\n            e = None\n            rst = evi = edi = dvi = ddi = 0\n            if isinstance(row, (list, tuple)):\n                if len(row) >= 6:\n                    e = row[0]\n                    rst = int(row[1]) & 1\n                    evi = int(row[2]) & 1\n                    edi = int(row[3]) & 255\n                    dvi = int(row[4]) & 1\n                    ddi = int(row[5]) & 65535\n                elif len(row) == 5:\n                    rst = int(row[0]) & 1\n                    evi = int(row[1]) & 1\n                    edi = int(row[2]) & 255\n                    dvi = int(row[3]) & 1\n                    ddi = int(row[4]) & 65535\n        if e is None:\n            pos = (i % 2 == 0)\n        elif isinstance(e, str):\n            s = e.lower()\n            pos = s.startswith('p') or s == '1'\n        else:\n            pos = bool(e)\n        if rst:\n            ev = ed = dv = dd = 0\n        out.append({\n            'enc_valid_out': ev & 1,\n            'enc_data_out': ed & 0xFFFF,\n            'dec_valid_out': dv & 1,\n            'dec_data_out': dd & 0xFF\n        })\n        if pos and not rst:\n            ev = evi\n            dv = dvi\n            enc = 0\n            for j in range(8):\n                bit = (edi >> j) & 1\n                pair = 1 if bit else 2\n                enc |= pair << (2 * j)\n            ed = enc & 0xFFFF\n            dec = 0\n            for j in range(8):\n                pair = (ddi >> (2 * j)) & 3\n                if pair == 1:\n                    dec |= 1 << j\n            dd = dec & 0xFF\n    return out\n"
