  "RM": "def reference(vectors):\n    ev = ed = dv = dd = 0\n    out = []\n    for r in vectors:\n        rst = r.get(\"rst_in\", 0)\n        if rst:\n            ev = ed = dv = dd = 0\n        out.append({\n            \"enc_valid_out\": ev & 1,\n            \"enc_data_out\": ed & 0xFFFF,\n            \"dec_valid_out\": dv & 1,\n            \"dec_data_out\": dd & 0xFF\n        })\n        e = r.get(\"edge\", r.get(\"clk_in\", 0))\n        pos = (e == \"posedge\" or e == 1 or e == \"1\" or e == True)\n        if pos and not rst:\n            ev = r.get(\"enc_valid_in\", 0) & 1\n            x = r.get(\"enc_data_in\", 0) & 0xFF\n            y = 0\n            for i in range(8):\n                if (x >> i) & 1:\n                    y |= 1 << (2 * i)\n                else:\n                    y |= 2 << (2 * i)\n            ed = y & 0xFFFF\n            dv = r.get(\"dec_valid_in\", 0) & 1\n            z = r.get(\"dec_data_in\", 0) & 0xFFFF\n            w = 0\n            for i in range(8):\n                p = (z >> (2 * i)) & 3\n                if p == 1:\n                    w |= 1 << i\n            dd = w & 0xFF\n    return out\n",
