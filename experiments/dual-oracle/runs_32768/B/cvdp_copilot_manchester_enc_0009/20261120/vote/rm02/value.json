"def reference(vectors):\n    N = 8\n    enc_data_out = 0\n    enc_valid_out = 0\n    dec_data_out = 0\n    dec_valid_out = 0\n    prev_clk = 0\n    results = []\n    for idx, row in enumerate(vectors):\n        rst = row.get('rst_in', 0) & 1\n        enc_valid_in = row.get('enc_valid_in', 0) & 1\n        enc_data_in = row.get('enc_data_in', 0) & 0xFF\n        dec_valid_in = row.get('dec_valid_in', 0) & 1\n        dec_data_in = row.get('dec_data_in', 0) & 0xFFFF\n\n        if rst:\n            enc_data_out = 0\n            enc_valid_out = 0\n            dec_data_out = 0\n            dec_valid_out = 0\n\n        is_posedge = False\n        if 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                is_posedge = ('pos' in e.lower()) or (e == '1')\n            else:\n                is_posedge = bool(e)\n        else:\n            clk = None\n            for k in ('clk_in', 'clk', 'clock'):\n                if k in row:\n                    clk = row[k]\n                    break\n            if clk is not None:\n                clk_val = clk & 1\n                is_posedge = (clk_val == 1 and prev_clk == 0)\n                prev_clk = clk_val\n            else:\n                is_posedge = (idx % 2 == 0)\n\n        results.append({\n            'enc_valid_out': int(enc_valid_out),\n            'enc_data_out': int(enc_data_out),\n            'dec_valid_out': int(dec_valid_out),\n            'dec_data_out': int(dec_data_out)\n        })\n\n        if is_posedge:\n            if rst:\n                enc_data_out = 0\n                enc_valid_out = 0\n                dec_data_out = 0\n                dec_valid_out = 0\n            else:\n                encoded = 0\n                for i in range(N):\n                    bit = (enc_data_in >> i) & 1\n                    pair = 1 if bit else 2\n                    encoded |= (pair << (2 * i))\n                enc_data_out = encoded & 0xFFFF\n                enc_valid_out = enc_valid_in\n\n                decoded = 0\n                for i in range(N):\n                    pair = (dec_data_in >> (2 * i)) & 3\n                    if pair == 1:\n                        decoded |= (1 << i)\n                dec_data_out = decoded & 0xFF\n                dec_valid_out = dec_valid_in\n\n    return results\n"
