"def reference(vectors):\n    ev = ed = dv = dd = 0\n    prev_clk = 0\n    out = []\n    for r in vectors:\n        if r.get('rst_in', 0):\n            ev = ed = dv = dd = 0\n        pos = False\n        if 'edge' in r:\n            e = r['edge']\n            if isinstance(e, str):\n                s = e.strip().lower()\n                pos = s.startswith('pos') or s in ('p', '1')\n            else:\n                pos = (e == 1)\n        elif 'clk_in' in r:\n            c = r['clk_in']\n            pos = (c == 1 and prev_clk == 0)\n        elif 'clk' in r:\n            c = r['clk']\n            pos = (c == 1 and prev_clk == 0)\n        out.append({\n            'enc_valid_out': ev & 1,\n            'enc_data_out': ed & 0xffff,\n            'dec_valid_out': dv & 1,\n            'dec_data_out': dd & 0xff\n        })\n        if pos:\n            if r.get('rst_in', 0):\n                ev = ed = dv = dd = 0\n            else:\n                ein = r.get('enc_valid_in', 0) & 1\n                din = r.get('dec_valid_in', 0) & 1\n                ev = ein\n                dv = din\n                if ein:\n                    edi = r.get('enc_data_in', 0) & 0xff\n                    ed = 0\n                    for i in range(8):\n                        ed |= (1 if ((edi >> i) & 1) else 2) << (2 * i)\n                if din:\n                    ddi = r.get('dec_data_in', 0) & 0xffff\n                    dd = 0\n                    for i in range(8):\n                        dd |= (1 if (((ddi >> (2 * i)) & 3) == 1) else 0) << i\n        if 'clk_in' in r:\n            prev_clk = r['clk_in']\n        elif 'clk' in r:\n            prev_clk = r['clk']\n    return out\n"
