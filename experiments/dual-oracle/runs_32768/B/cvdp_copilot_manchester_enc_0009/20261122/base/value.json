"def reference(vectors):\n    N = 8\n    enc_v = enc_d = dec_v = dec_d = 0\n    out = []\n    for idx, row in enumerate(vectors):\n        if isinstance(row, dict):\n            rst = row.get('rst_in', 0)\n            ev = row.get('enc_valid_in', 0)\n            ed = row.get('enc_data_in', 0)\n            dv = row.get('dec_valid_in', 0)\n            dd = row.get('dec_data_in', 0)\n            if 'edge' in row:\n                e = row['edge']\n                if isinstance(e, str):\n                    s = e.lower()\n                    pos = ('pos' in s or 'rise' in s or s in ('1', 'p'))\n                else:\n                    pos = bool(e)\n            elif 'clk_in' in row:\n                pos = (row['clk_in'] == 1)\n            else:\n                pos = (idx % 2 == 0)\n        else:\n            L = len(row)\n            if L >= 6:\n                e = row[0]\n                if isinstance(e, str):\n                    s = e.lower()\n                    pos = ('pos' in s or 'rise' in s or s in ('1', 'p'))\n                else:\n                    pos = bool(e)\n                rst = row[1]\n                ev = row[2]\n                ed = row[3]\n                dv = row[4]\n                dd = row[5]\n            else:\n                pos = (idx % 2 == 0)\n                rst = row[0] if L > 0 else 0\n                ev = row[1] if L > 1 else 0\n                ed = row[2] if L > 2 else 0\n                dv = row[3] if L > 3 else 0\n                dd = row[4] if L > 4 else 0\n        rst = int(rst) & 1\n        ev = int(ev) & 1\n        ed = int(ed) & ((1 << N) - 1)\n        dv = int(dv) & 1\n        dd = int(dd) & ((1 << (2 * N)) - 1)\n        if rst:\n            enc_v = enc_d = dec_v = dec_d = 0\n        out.append({\n            'enc_valid_out': enc_v & 1,\n            'enc_data_out': enc_d & ((1 << (2 * N)) - 1),\n            'dec_valid_out': dec_v & 1,\n            'dec_data_out': dec_d & ((1 << N) - 1)\n        })\n        if pos and not rst:\n            e = 0\n            for i in range(N):\n                bit = (ed >> i) & 1\n                pair = 1 if bit else 2\n                e |= pair << (2 * i)\n            enc_d = e\n            enc_v = ev\n            d = 0\n            for i in range(N):\n                pair = (dd >> (2 * i)) & 3\n                if pair == 1:\n                    d |= 1 << i\n            dec_d = d\n            dec_v = dv\n    return out\n"
