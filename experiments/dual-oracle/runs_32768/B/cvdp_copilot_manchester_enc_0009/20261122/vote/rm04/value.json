"def reference(vectors):\n    ev = ed = dv = dd = 0\n    out = []\n    for idx, row in enumerate(vectors):\n        if 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                is_pos = 'pos' in e.lower()\n            else:\n                is_pos = bool(e)\n        elif 'clk_in' in row:\n            c = row['clk_in']\n            if isinstance(c, str):\n                is_pos = ('pos' in c.lower()) or (c.strip() == '1')\n            else:\n                is_pos = (c == 1)\n        else:\n            is_pos = (idx % 2 == 0)\n\n        rst = row.get('rst_in', 0)\n        if rst == 1:\n            ev = ed = dv = dd = 0\n\n        out.append({\n            'enc_valid_out': ev & 1,\n            'enc_data_out': ed & 0xFFFF,\n            'dec_valid_out': dv & 1,\n            'dec_data_out': dd & 0xFF\n        })\n\n        if is_pos and rst == 0:\n            ev = row.get('enc_valid_in', 0) & 1\n            data = row.get('enc_data_in', 0) & 0xFF\n            enc = 0\n            for i in range(8):\n                bit = (data >> i) & 1\n                pair = 1 if bit else 2\n                enc |= pair << (2 * i)\n            ed = enc & 0xFFFF\n\n            dv = row.get('dec_valid_in', 0) & 1\n            din = row.get('dec_data_in', 0) & 0xFFFF\n            dec = 0\n            for i in range(8):\n                pair = (din >> (2 * i)) & 3\n                bit = 1 if pair == 1 else 0\n                dec |= bit << i\n            dd = dec & 0xFF\n\n    return out\n"
