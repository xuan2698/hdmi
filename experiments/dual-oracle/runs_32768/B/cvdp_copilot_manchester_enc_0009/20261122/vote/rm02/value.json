"def reference(vectors):\n    N = 8\n    enc_data_out = 0\n    enc_valid_out = 0\n    dec_data_out = 0\n    dec_valid_out = 0\n    result = []\n\n    def encode(v):\n        r = 0\n        for i in range(N):\n            b = (v >> i) & 1\n            p = 1 if b else 2\n            r |= p << (2 * i)\n        return r & 0xFFFF\n\n    def decode(v):\n        r = 0\n        for i in range(N):\n            p = (v >> (2 * i)) & 3\n            if p == 1:\n                r |= 1 << i\n        return r & 0xFF\n\n    for row in vectors:\n        rst = int(row.get('rst_in', 0))\n        if rst:\n            enc_data_out = 0\n            enc_valid_out = 0\n            dec_data_out = 0\n            dec_valid_out = 0\n\n        result.append({\n            'enc_valid_out': enc_valid_out,\n            'enc_data_out': enc_data_out,\n            'dec_valid_out': dec_valid_out,\n            'dec_data_out': dec_data_out\n        })\n\n        e = row.get('edge', row.get('clk_edge', ''))\n        pos = False\n        if e is True or e == 1:\n            pos = True\n        elif isinstance(e, str) and 'pos' in e.lower():\n            pos = True\n\n        if pos and rst == 0:\n            if int(row.get('enc_valid_in', 0)):\n                enc_data_out = encode(int(row.get('enc_data_in', 0)))\n                enc_valid_out = 1\n            else:\n                enc_valid_out = 0\n\n            if int(row.get('dec_valid_in', 0)):\n                dec_data_out = decode(int(row.get('dec_data_in', 0)))\n                dec_valid_out = 1\n            else:\n                dec_valid_out = 0\n\n    return result\n"
