"def reference(vectors):\n    N = 8\n    M = 16\n    enc_valid_out = 0\n    enc_data_out = 0\n    dec_valid_out = 0\n    dec_data_out = 0\n    results = []\n\n    for row in vectors:\n        edge = row.get('edge', row.get('clk_in', 0))\n        rst = int(row.get('rst_in', 0)) & 1\n        e_v = int(row.get('enc_valid_in', 0)) & 1\n        e_d = int(row.get('enc_data_in', 0)) & ((1 << N) - 1)\n        d_v = int(row.get('dec_valid_in', 0)) & 1\n        d_d = int(row.get('dec_data_in', 0)) & ((1 << (2 * N)) - 1)\n\n        is_pos = False\n        is_neg = False\n        if isinstance(edge, str):\n            el = edge.lower()\n            if el.startswith('pos') or el in ('1', 'true'):\n                is_pos = True\n            elif el.startswith('neg') or el in ('0', 'false'):\n                is_neg = True\n        else:\n            if edge == 1 or edge is True:\n                is_pos = True\n            elif edge == 0 or edge is False:\n                is_neg = True\n\n        if is_pos:\n            if rst:\n                enc_valid_out = 0\n                enc_data_out = 0\n                dec_valid_out = 0\n                dec_data_out = 0\n\n            results.append({\n                'enc_valid_out': enc_valid_out,\n                'enc_data_out': enc_data_out,\n                'dec_valid_out': dec_valid_out,\n                'dec_data_out': dec_data_out,\n            })\n\n            if not rst:\n                n_e_v = e_v\n                n_e_d = enc_data_out\n                if e_v:\n                    val = 0\n                    for i in range(N):\n                        bit = (e_d >> i) & 1\n                        pair = 1 if bit else 2\n                        val |= pair << (2 * i)\n                    n_e_d = val & ((1 << M) - 1)\n\n                n_d_v = d_v\n                n_d_d = dec_data_out\n                if d_v:\n                    val = 0\n                    for i in range(N):\n                        pair = (d_d >> (2 * i)) & 3\n                        bit = 1 if pair == 1 else 0\n                        val |= bit << i\n                    n_d_d = val & ((1 << N) - 1)\n\n                enc_valid_out = n_e_v\n                enc_data_out = n_e_d\n                dec_valid_out = n_d_v\n                dec_data_out = n_d_d\n\n        elif is_neg:\n            results.append({\n                'enc_valid_out': enc_valid_out,\n                'enc_data_out': enc_data_out,\n                'dec_valid_out': dec_valid_out,\n                'dec_data_out': dec_data_out,\n            })\n\n            if rst:\n                enc_valid_out = 0\n                enc_data_out = 0\n                dec_valid_out = 0\n                dec_data_out = 0\n\n        else:\n            results.append({\n                'enc_valid_out': enc_valid_out,\n                'enc_data_out': enc_data_out,\n                'dec_valid_out': dec_valid_out,\n                'dec_data_out': dec_data_out,\n            })\n\n    return results\n"
