"def reference(vectors):\n    N = 8\n    e_v = e_d = d_v = d_d = 0\n    res = []\n    for i, row in enumerate(vectors):\n        rst = row.get('rst_in', 0)\n        if rst:\n            e_v = e_d = d_v = d_d = 0\n            res.append({'enc_valid_out': 0, 'enc_data_out': 0, 'dec_valid_out': 0, 'dec_data_out': 0})\n            continue\n\n        if 'clk_in' in row:\n            is_pos = (row['clk_in'] == 1)\n        elif 'edge' in row:\n            val = row['edge']\n            if isinstance(val, str):\n                is_pos = 'pos' in val.lower()\n            else:\n                is_pos = bool(val)\n        else:\n            is_pos = (i % 2 == 0)\n\n        res.append({\n            'enc_valid_out': e_v,\n            'enc_data_out': e_d,\n            'dec_valid_out': d_v,\n            'dec_data_out': d_d\n        })\n\n        if is_pos:\n            ev_in = row.get('enc_valid_in', 0) & 1\n            ed_in = row.get('enc_data_in', 0) & 0xFF\n            enc_out = 0\n            for b in range(N):\n                bit = (ed_in >> b) & 1\n                pair = 1 if bit else 2\n                enc_out |= pair << (2 * b)\n            e_v = ev_in\n            e_d = enc_out & 0xFFFF\n\n            dv_in = row.get('dec_valid_in', 0) & 1\n            dd_in = row.get('dec_data_in', 0) & 0xFFFF\n            dec_out = 0\n            for b in range(N):\n                pair = (dd_in >> (2 * b)) & 3\n                if pair == 1:\n                    dec_out |= 1 << b\n            d_v = dv_in\n            d_d = dec_out & 0xFF\n\n    return res\n"
