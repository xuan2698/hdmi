{
  "decisions": [],
  "RM": "def reference(vectors):\n    enc_data = 0\n    enc_valid = 0\n    dec_data = 0\n    dec_valid = 0\n    out = []\n    for idx, row in enumerate(vectors):\n        rst = row.get('rst_in', 0)\n        enc_valid_in = row.get('enc_valid_in', 0)\n        enc_data_in = row.get('enc_data_in', 0)\n        dec_valid_in = row.get('dec_valid_in', 0)\n        dec_data_in = row.get('dec_data_in', 0)\n        if rst:\n            enc_data = 0\n            enc_valid = 0\n            dec_data = 0\n            dec_valid = 0\n        out.append({\n            'enc_valid_out': enc_valid,\n            'enc_data_out': enc_data,\n            'dec_valid_out': dec_valid,\n            'dec_data_out': dec_data\n        })\n        clk = row.get('clk_in') if isinstance(row, dict) else None\n        if clk is not None:\n            is_posedge = (clk == 1)\n        else:\n            is_posedge = (idx % 2 == 0)\n        if is_posedge and not rst:\n            enc_valid = enc_valid_in\n            enc_val = 0\n            for i in range(8):\n                bit = (enc_data_in >> i) & 1\n                pair = 1 if bit else 2\n                enc_val |= pair << (2 * i)\n            enc_data = enc_val\n\n            dec_valid = dec_valid_in\n            dec_val = 0\n            for i in range(8):\n                pair = (dec_data_in >> (2 * i)) & 3\n                if pair == 1:\n                    dec_val |= 1 << i\n            dec_data = dec_val\n    return out\n",
