"def reference(vectors):\n    eo = ev = do = dv = 0\n    out = []\n    for idx, row in enumerate(vectors):\n        if 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                pos = 'pos' in e.lower()\n            else:\n                pos = (e == 1 or e is True)\n        elif 'clk_in' in row:\n            pos = (row['clk_in'] == 1)\n        else:\n            pos = (idx % 2 == 0)\n\n        rst = row.get('rst_in', 0)\n        if rst:\n            eo = ev = do = dv = 0\n\n        out.append({\n            'enc_valid_out': ev & 1,\n            'enc_data_out': eo & 0xFFFF,\n            'dec_valid_out': dv & 1,\n            'dec_data_out': do & 0xFF\n        })\n\n        if pos and not rst:\n            vi = row.get('enc_valid_in', 0) & 1\n            din = row.get('enc_data_in', 0)\n            y = 0\n            for i in range(8):\n                if (din >> i) & 1:\n                    y |= 1 << (2 * i)\n                else:\n                    y |= 2 << (2 * i)\n\n            dvi = row.get('dec_valid_in', 0) & 1\n            ddin = row.get('dec_data_in', 0)\n            dy = 0\n            for i in range(8):\n                if ((ddin >> (2 * i)) & 3) == 1:\n                    dy |= 1 << i\n\n            ev = vi\n            eo = y & 0xFFFF\n            dv = dvi\n            do = dy & 0xFF\n\n    return out\n"
