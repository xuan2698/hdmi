"def reference(vectors):\n    enc_data_reg = 0\n    enc_valid_reg = 0\n    dec_data_reg = 0\n    dec_valid_reg = 0\n    out = []\n    prev_clk = None\n\n    for idx, row in enumerate(vectors):\n        rst = int(row.get('rst_in', 0)) & 1\n        enc_v = int(row.get('enc_valid_in', 0)) & 1\n        enc_d = int(row.get('enc_data_in', 0)) & 0xFF\n        dec_v = int(row.get('dec_valid_in', 0)) & 1\n        dec_d = int(row.get('dec_data_in', 0)) & 0xFFFF\n\n        if 'edge' in row:\n            edge = row['edge']\n            if isinstance(edge, str):\n                posedge = ('pos' in edge.lower())\n            else:\n                posedge = bool(edge)\n        elif 'clk_in' in row:\n            clk = row['clk_in']\n            if prev_clk is None:\n                posedge = bool(clk)\n            else:\n                posedge = (prev_clk == 0 and clk == 1)\n            prev_clk = clk\n        else:\n            posedge = (idx % 2 == 0)\n\n        if rst:\n            out.append({\n                'enc_valid_out': 0,\n                'enc_data_out': 0,\n                'dec_valid_out': 0,\n                'dec_data_out': 0\n            })\n            enc_data_reg = 0\n            enc_valid_reg = 0\n            dec_data_reg = 0\n            dec_valid_reg = 0\n        else:\n            out.append({\n                'enc_valid_out': enc_valid_reg,\n                'enc_data_out': enc_data_reg,\n                'dec_valid_out': dec_valid_reg,\n                'dec_data_out': dec_data_reg\n            })\n\n            if posedge:\n                next_enc_data = 0\n                for i in range(8):\n                    bit = (enc_d >> i) & 1\n                    next_enc_data |= (1 if bit else 2) << (2 * i)\n\n                next_dec_data = 0\n                for i in range(8):\n                    pair = (dec_d >> (2 * i)) & 3\n                    if pair == 1:\n                        next_dec_data |= 1 << i\n\n                enc_data_reg = next_enc_data & 0xFFFF\n                enc_valid_reg = enc_v\n                dec_data_reg = next_dec_data & 0xFF\n                dec_valid_reg = dec_v\n\n    return out\n"
