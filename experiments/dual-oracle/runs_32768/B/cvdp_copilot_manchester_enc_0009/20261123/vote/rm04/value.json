"def reference(vectors):\n    N = 8\n    enc_data = 0\n    enc_valid = 0\n    dec_data = 0\n    dec_valid = 0\n    out = []\n\n    for idx, r in enumerate(vectors):\n        rst = r.get('rst_in', 0) if isinstance(r, dict) else 0\n\n        if rst:\n            enc_data = 0\n            enc_valid = 0\n            dec_data = 0\n            dec_valid = 0\n\n        out.append({\n            'enc_valid_out': enc_valid,\n            'enc_data_out': enc_data,\n            'dec_valid_out': dec_valid,\n            'dec_data_out': dec_data\n        })\n\n        if idx % 2 == 0:  # posedge\n            if not rst:\n                ev = r.get('enc_valid_in', 0) & 1\n                ed = r.get('enc_data_in', 0) & ((1 << N) - 1)\n                dv = r.get('dec_valid_in', 0) & 1\n                dd = r.get('dec_data_in', 0) & ((1 << (2 * N)) - 1)\n\n                enc = 0\n                for i in range(N):\n                    bit = (ed >> i) & 1\n                    pair = 1 if bit else 2\n                    enc |= pair << (2 * i)\n\n                dec = 0\n                for i in range(N):\n                    pair = (dd >> (2 * i)) & 3\n                    if pair == 1:\n                        dec |= 1 << i\n\n                enc_data = enc\n                enc_valid = ev\n                dec_data = dec\n                dec_valid = dv\n\n    return out\n"
