"def reference(vectors):\n    N = 8\n    eo = 0\n    ev = 0\n    do = 0\n    dv = 0\n\n    if isinstance(vectors, dict):\n        vals = list(vectors.values())\n        if vals and isinstance(vals[0], (list, tuple)):\n            m = len(vals[0])\n            rows = []\n            for i in range(m):\n                d = {}\n                for k, v in vectors.items():\n                    d[k] = v[i]\n                rows.append(d)\n            vectors = rows\n        else:\n            vectors = [vectors]\n\n    res = []\n    for idx, row in enumerate(vectors):\n        if not isinstance(row, dict):\n            row = {}\n\n        rst = int(row.get('rst_in', 0))\n        if rst:\n            eo = 0\n            ev = 0\n            do = 0\n            dv = 0\n\n        e = None\n        if 'edge' in row:\n            x = row['edge']\n            if isinstance(x, str):\n                y = x.lower()\n                if y.startswith('pos') or y in ('1', 'p', 'rise', 'rising', 'true'):\n                    e = 1\n                elif y.startswith('neg') or y in ('0', 'n', 'fall', 'falling', 'false'):\n                    e = 0\n                else:\n                    try:\n                        e = 1 if int(x) else 0\n                    except:\n                        e = None\n            else:\n                e = 1 if int(x) else 0\n        elif 'clk_in' in row:\n            e = 1 if int(row['clk_in']) else 0\n        elif 'clk' in row:\n            e = 1 if int(row['clk']) else 0\n\n        if e is None:\n            e = 1 if (idx % 2 == 0) else 0\n\n        res.append({\n            'enc_valid_out': ev & 1,\n            'enc_data_out': eo & 0xffff,\n            'dec_valid_out': dv & 1,\n            'dec_data_out': do & 0xff\n        })\n\n        if e == 1 and rst == 0:\n            enc_v = int(row.get('enc_valid_in', 0)) & 1\n            dec_v = int(row.get('dec_valid_in', 0)) & 1\n            enc_i = int(row.get('enc_data_in', 0)) & 0xff\n            dec_i = int(row.get('dec_data_in', 0)) & 0xffff\n\n            if enc_v:\n                ne = 0\n                for i in range(N):\n                    pair = 1 if ((enc_i >> i) & 1) else 2\n                    ne |= pair << (2 * i)\n                eo = ne\n\n            if dec_v:\n                nd = 0\n                for i in range(N):\n                    pair = (dec_i >> (2 * i)) & 3\n                    if pair == 1:\n                        nd |= 1 << i\n                do = nd\n\n            ev = enc_v\n            dv = dec_v\n\n    return res\n"
