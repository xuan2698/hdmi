"def reference(vectors):\n    N = 8\n    e_d = 0\n    e_v = 0\n    d_d = 0\n    d_v = 0\n    outs = []\n\n    for i, row in enumerate(vectors):\n        rst = int(row.get('rst_in', 0))\n\n        if rst:\n            e_d = e_v = d_d = d_v = 0\n\n        outs.append({\n            'enc_valid_out': e_v & 1,\n            'enc_data_out': e_d & 0xFFFF,\n            'dec_valid_out': d_v & 1,\n            'dec_data_out': d_d & 0xFF\n        })\n\n        if i % 2 == 0:  # posedge\n            if rst:\n                e_d = e_v = d_d = d_v = 0\n            else:\n                ed_in = int(row.get('enc_data_in', 0))\n                ev_in = int(row.get('enc_valid_in', 0))\n                dd_in = int(row.get('dec_data_in', 0))\n                dv_in = int(row.get('dec_valid_in', 0))\n\n                e_next = 0\n                for b in range(N):\n                    bit = (ed_in >> b) & 1\n                    pair = 1 if bit else 2  # 1 -> 01, 0 -> 10\n                    e_next |= pair << (2 * b)\n\n                d_next = 0\n                for b in range(N):\n                    pair = (dd_in >> (2 * b)) & 3\n                    if pair == 1:  # 01 -> 1, everything else -> 0\n                        d_next |= (1 << b)\n\n                e_d = e_next & 0xFFFF\n                e_v = ev_in & 1\n                d_d = d_next & 0xFF\n                d_v = dv_in & 1\n\n    return outs\n"
