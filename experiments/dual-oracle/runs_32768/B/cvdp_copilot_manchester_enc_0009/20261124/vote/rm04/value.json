"def reference(vectors):\n    enc_valid_out = 0\n    enc_data_out = 0\n    dec_valid_out = 0\n    dec_data_out = 0\n    prev_clk = 0\n    results = []\n    for idx, row in enumerate(vectors):\n        rst = row.get('rst_in', 0)\n        if rst:\n            enc_valid_out = 0\n            enc_data_out = 0\n            dec_valid_out = 0\n            dec_data_out = 0\n        results.append({\n            'enc_valid_out': enc_valid_out,\n            'enc_data_out': enc_data_out,\n            'dec_valid_out': dec_valid_out,\n            'dec_data_out': dec_data_out\n        })\n        if 'clk_in' in row:\n            clk = row['clk_in']\n            is_pos = (clk == 1 and prev_clk == 0)\n            prev_clk = clk\n        else:\n            is_pos = (idx % 2 == 0)\n        if is_pos and not rst:\n            enc_valid_in = row.get('enc_valid_in', 0)\n            dec_valid_in = row.get('dec_valid_in', 0)\n            enc_valid_out = 1 if enc_valid_in else 0\n            dec_valid_out = 1 if dec_valid_in else 0\n            val = row.get('enc_data_in', 0)\n            encoded = 0\n            for i in range(8):\n                bit = (val >> i) & 1\n                pair = 1 if bit else 2\n                encoded |= pair << (2 * i)\n            enc_data_out = encoded & 0xFFFF\n            val = row.get('dec_data_in', 0)\n            decoded = 0\n            for i in range(8):\n                pair = (val >> (2 * i)) & 3\n                if pair == 1:\n                    decoded |= (1 << i)\n            dec_data_out = decoded & 0xFF\n    return results\n"
