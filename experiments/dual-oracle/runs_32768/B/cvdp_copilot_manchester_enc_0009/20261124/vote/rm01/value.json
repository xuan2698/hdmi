"def reference(vectors):\n    enc_valid_out = 0\n    enc_data_out = 0\n    dec_valid_out = 0\n    dec_data_out = 0\n    result = []\n    for idx, row in enumerate(vectors):\n        rst = int(row.get('rst_in', 0)) & 1\n        if rst:\n            enc_valid_out = 0\n            enc_data_out = 0\n            dec_valid_out = 0\n            dec_data_out = 0\n        result.append({\n            'enc_valid_out': enc_valid_out,\n            'enc_data_out': enc_data_out,\n            'dec_valid_out': dec_valid_out,\n            'dec_data_out': dec_data_out\n        })\n        if idx % 2 == 0 and not rst:\n            enc_valid_in = int(row.get('enc_valid_in', 0)) & 1\n            enc_data_in = int(row.get('enc_data_in', 0)) & 0xFF\n            dec_valid_in = int(row.get('dec_valid_in', 0)) & 1\n            dec_data_in = int(row.get('dec_data_in', 0)) & 0xFFFF\n            enc_valid_out = enc_valid_in\n            dec_valid_out = dec_valid_in\n            ne = 0\n            for i in range(8):\n                if (enc_data_in >> i) & 1:\n                    ne |= 1 << (2 * i)\n                else:\n                    ne |= 2 << (2 * i)\n            enc_data_out = ne & 0xFFFF\n            nd = 0\n            for i in range(8):\n                pair = (dec_data_in >> (2 * i)) & 3\n                if pair == 1:\n                    nd |= 1 << i\n            dec_data_out = nd & 0xFF\n    return result\n"
