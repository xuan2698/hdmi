"def reference(vectors):\n    N = 8\n    state = [0, 0, 0, 0]\n    result = []\n    for idx, row in enumerate(vectors):\n        if row.get('rst_in', 0):\n            state = [0, 0, 0, 0]\n        if 'clk_in' in row:\n            posedge = bool(row.get('clk_in'))\n        elif 'edge' in row:\n            e = row.get('edge')\n            posedge = (e == 1 or e is True or (isinstance(e, str) and 'pos' in e.lower()))\n        else:\n            posedge = (idx % 2 == 0)\n        ev, ed, dv, dd = state\n        result.append({\n            'enc_valid_out': ev & 1,\n            'enc_data_out': ed & 0xFFFF,\n            'dec_valid_out': dv & 1,\n            'dec_data_out': dd & 0xFF\n        })\n        if posedge:\n            if row.get('rst_in', 0):\n                state = [0, 0, 0, 0]\n            else:\n                enc_v = row.get('enc_valid_in', 0) & 1\n                dec_v = row.get('dec_valid_in', 0) & 1\n                new_ev = enc_v\n                new_dv = dec_v\n                new_ed = state[1]\n                new_dd = state[3]\n                if enc_v:\n                    data = row.get('enc_data_in', 0) & 0xFF\n                    val = 0\n                    for i in range(N):\n                        if (data >> i) & 1:\n                            val |= 1 << (2 * i)\n                        else:\n                            val |= 2 << (2 * i)\n                    new_ed = val & 0xFFFF\n                if dec_v:\n                    data = row.get('dec_data_in', 0) & 0xFFFF\n                    val = 0\n                    for i in range(N):\n                        if ((data >> (2 * i)) & 3) == 1:\n                            val |= 1 << i\n                    new_dd = val & 0xFF\n                state = [new_ev, new_ed, new_dv, new_dd]\n    return result\n"
