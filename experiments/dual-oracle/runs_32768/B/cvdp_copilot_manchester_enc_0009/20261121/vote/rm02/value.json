"def reference(vectors):\n    enc_valid_out = 0\n    enc_data_out = 0\n    dec_valid_out = 0\n    dec_data_out = 0\n    result = []\n\n    for idx, row in enumerate(vectors):\n        rst = row.get('rst_in', 0) & 1\n\n        if rst:\n            enc_valid_out = 0\n            enc_data_out = 0\n            dec_valid_out = 0\n            dec_data_out = 0\n\n        result.append({\n            'enc_valid_out': enc_valid_out,\n            'enc_data_out': enc_data_out,\n            'dec_valid_out': dec_valid_out,\n            'dec_data_out': dec_data_out,\n        })\n\n        edge = row.get('edge', row.get('clk_in', None))\n        if isinstance(edge, str):\n            is_posedge = 'pos' in edge.lower() or edge.lower() in ('1', 'rising', 'up')\n        elif edge is None:\n            is_posedge = (idx % 2 == 0)\n        else:\n            is_posedge = (int(edge) == 1)\n\n        if is_posedge and not rst:\n            enc_in = row.get('enc_data_in', 0) & 0xff\n            dec_in = row.get('dec_data_in', 0) & 0xffff\n\n            enc = 0\n            for i in range(8):\n                bit = (enc_in >> i) & 1\n                pair = 1 if bit else 2\n                enc |= pair << (2 * i)\n\n            dec = 0\n            for i in range(8):\n                pair = (dec_in >> (2 * i)) & 3\n                if pair == 1:\n                    dec |= 1 << i\n\n            enc_data_out = enc & 0xffff\n            enc_valid_out = row.get('enc_valid_in', 0) & 1\n            dec_data_out = dec & 0xff\n            dec_valid_out = row.get('dec_valid_in', 0) & 1\n\n    return result\n"
