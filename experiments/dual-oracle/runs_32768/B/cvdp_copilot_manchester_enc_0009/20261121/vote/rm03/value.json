"def reference(vectors):\n    eo = ev = do = dv = 0\n    res = []\n    for i, row in enumerate(vectors):\n        rst = row.get('rst_in', 0) & 1\n        evi = row.get('enc_valid_in', 0) & 1\n        edi = row.get('enc_data_in', 0) & 255\n        dvi = row.get('dec_valid_in', 0) & 1\n        ddi = row.get('dec_data_in', 0) & 65535\n        if rst:\n            eo = ev = do = dv = 0\n        res.append({\n            'enc_valid_out': ev,\n            'enc_data_out': eo,\n            'dec_valid_out': dv,\n            'dec_data_out': do\n        })\n        if i % 2 == 0 and not rst:\n            e = 0\n            for b in range(8):\n                if (edi >> b) & 1:\n                    e |= 1 << (2 * b)\n                else:\n                    e |= 2 << (2 * b)\n            eo = e & 0xFFFF\n            ev = evi\n            d = 0\n            for b in range(8):\n                p = (ddi >> (2 * b)) & 3\n                if p == 1:\n                    d |= 1 << b\n            do = d & 0xFF\n            dv = dvi\n    return res\n"
