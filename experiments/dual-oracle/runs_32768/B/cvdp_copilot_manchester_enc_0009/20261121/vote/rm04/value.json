"def reference(vectors):\n    N = 8\n    M = (1 << (2 * N)) - 1\n    K = (1 << N) - 1\n    ev_q = 0\n    ed_q = 0\n    dv_q = 0\n    dd_q = 0\n    out = []\n    for idx, row in enumerate(vectors):\n        if isinstance(row, dict):\n            edge = row.get('edge', row.get('clk_edge', row.get('clk_in', None)))\n            rst = int(row.get('rst_in', 0)) & 1\n        else:\n            edge = None\n            rst = 0\n\n        if edge is None:\n            is_pos = (idx % 2 == 0)\n        elif isinstance(edge, str):\n            s = edge.lower()\n            is_pos = ('pos' in s) or (s == '1') or (s == 'true')\n        else:\n            is_pos = bool(edge)\n\n        if rst:\n            ev_q = 0\n            ed_q = 0\n            dv_q = 0\n            dd_q = 0\n\n        out.append({\n            'enc_valid_out': ev_q & 1,\n            'enc_data_out': ed_q & M,\n            'dec_valid_out': dv_q & 1,\n            'dec_data_out': dd_q & K\n        })\n\n        if is_pos and not rst:\n            if isinstance(row, dict):\n                ev_in = int(row.get('enc_valid_in', 0)) & 1\n                ed_in = int(row.get('enc_data_in', 0)) & K\n                dv_in = int(row.get('dec_valid_in', 0)) & 1\n                dd_in = int(row.get('dec_data_in', 0)) & M\n            else:\n                ev_in = 0\n                ed_in = 0\n                dv_in = 0\n                dd_in = 0\n\n            ev_q = ev_in\n            new_ed = 0\n            for i in range(N):\n                if (ed_in >> i) & 1:\n                    new_ed |= 1 << (2 * i)\n                else:\n                    new_ed |= 2 << (2 * i)\n            ed_q = new_ed & M\n\n            dv_q = dv_in\n            new_dd = 0\n            for i in range(N):\n                pair = (dd_in >> (2 * i)) & 3\n                if pair == 1:\n                    new_dd |= 1 << i\n            dd_q = new_dd & K\n\n    return out\n"
