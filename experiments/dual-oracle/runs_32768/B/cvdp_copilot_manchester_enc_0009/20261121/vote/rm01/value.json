"def reference(vectors):\n    def get_int(row, key, default=0, mask=None):\n        v = row.get(key, default)\n        if isinstance(v, str):\n            try:\n                v = int(v, 0)\n            except:\n                v = int(v)\n        else:\n            v = int(v)\n        if mask is not None:\n            v &= mask\n        return v\n\n    enc_data_out = 0\n    enc_valid_out = 0\n    dec_data_out = 0\n    dec_valid_out = 0\n    out_rows = []\n\n    for idx, row in enumerate(vectors):\n        rst = get_int(row, 'rst_in', 0, 1)\n        enc_v = get_int(row, 'enc_valid_in', 0, 1)\n        enc_d = get_int(row, 'enc_data_in', 0, 0xFF)\n        dec_v = get_int(row, 'dec_valid_in', 0, 1)\n        dec_d = get_int(row, 'dec_data_in', 0, 0xFFFF)\n\n        if rst:\n            enc_data_out = 0\n            enc_valid_out = 0\n            dec_data_out = 0\n            dec_valid_out = 0\n\n        is_pos = None\n        if 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                el = e.lower()\n                if 'pos' in el or 'rise' in el or el == '1':\n                    is_pos = True\n                elif 'neg' in el or 'fall' in el or el == '0':\n                    is_pos = False\n            else:\n                try:\n                    is_pos = bool(int(e) & 1)\n                except:\n                    is_pos = bool(e)\n\n        if is_pos is None:\n            if 'clk_in' in row:\n                is_pos = (get_int(row, 'clk_in', 0, 1) == 1)\n            else:\n                is_pos = (idx % 2 == 0)\n\n        out_rows.append({\n            'enc_valid_out': enc_valid_out,\n            'enc_data_out': enc_data_out,\n            'dec_valid_out': dec_valid_out,\n            'dec_data_out': dec_data_out\n        })\n\n        if is_pos and not rst:\n            new_enc_valid = enc_v\n            new_dec_valid = dec_v\n\n            if enc_v:\n                enc_next = 0\n                for i in range(8):\n                    b = (enc_d >> i) & 1\n                    pair = 1 if b == 1 else 2\n                    enc_next |= pair << (2 * i)\n                new_enc_data = enc_next & 0xFFFF\n            else:\n                new_enc_data = enc_data_out\n\n            if dec_v:\n                dec_next = 0\n                for i in range(8):\n                    pair = (dec_d >> (2 * i)) & 3\n                    b = 1 if pair == 1 else 0\n                    dec_next |= b << i\n                new_dec_data = dec_next & 0xFF\n            else:\n                new_dec_data = dec_data_out\n\n            enc_valid_out = new_enc_valid\n            enc_data_out = new_enc_data\n            dec_valid_out = new_dec_valid\n            dec_data_out = new_dec_data\n\n    return out_rows\n"
