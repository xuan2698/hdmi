"def reference(vectors):\n    ev = 0\n    ed = 0\n    dv = 0\n    dd = 0\n    out = []\n    for i, row in enumerate(vectors):\n        rst = int(row.get('rst_in', 0)) & 1 if isinstance(row, dict) else 0\n        if rst:\n            ev = ed = dv = dd = 0\n        if isinstance(row, dict):\n            e = row.get('edge', None)\n            if e is None:\n                e = row.get('Edge', None)\n            if e is not None:\n                if isinstance(e, str):\n                    s = e.lower()\n                    pos = ('pos' in s) or (s in ('1', 'rise', 'rising', 'true'))\n                else:\n                    pos = bool(e)\n            else:\n                pos = None\n                for k in ('clk_in', 'clk', 'clock'):\n                    if k in row:\n                        pos = bool(row[k])\n                        break\n                if pos is None:\n                    pos = (i % 2 == 0)\n        else:\n            pos = (i % 2 == 0)\n        out.append({\n            'enc_valid_out': ev & 1,\n            'enc_data_out': ed & 0xFFFF,\n            'dec_valid_out': dv & 1,\n            'dec_data_out': dd & 0xFF\n        })\n        if isinstance(row, dict) and pos and not rst:\n            eiv = int(row.get('enc_valid_in', 0)) & 1\n            edi = int(row.get('enc_data_in', 0)) & 0xFF\n            enc = 0\n            for b in range(8):\n                if (edi >> b) & 1:\n                    enc |= 1 << (2 * b)\n                else:\n                    enc |= 1 << (2 * b + 1)\n            if eiv:\n                ed = enc & 0xFFFF\n            ev = eiv\n            div = int(row.get('dec_valid_in', 0)) & 1\n            ddi = int(row.get('dec_data_in', 0)) & 0xFFFF\n            dec = 0\n            for b in range(8):\n                if ((ddi >> (2 * b)) & 3) == 1:\n                    dec |= 1 << b\n            if div:\n                dd = dec & 0xFF\n            dv = div\n    return out\n"
