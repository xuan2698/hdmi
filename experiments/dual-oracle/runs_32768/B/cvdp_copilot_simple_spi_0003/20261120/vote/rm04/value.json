"def reference(vectors):\n    state = 0\n    cs_b = 1\n    spi_clk = 0\n    spi_data = 0\n    bits_left = 16\n    done = 0\n    shift_reg = 0\n    prev_clk = 0\n    outputs = []\n    for row_idx, row in enumerate(vectors):\n        if isinstance(row, dict):\n            edge = row.get('edge', None)\n            i_clk = row.get('i_clk', None)\n            i_rst_b = row.get('i_rst_b', 1)\n            i_data_in = row.get('i_data_in', 0)\n            i_enable = row.get('i_enable', 0)\n            i_fault = row.get('i_fault', 0)\n            i_clear = row.get('i_clear', 0)\n        else:\n            edge = None\n            i_clk = None\n            i_rst_b = 1\n            i_data_in = 0\n            i_enable = 0\n            i_fault = 0\n            i_clear = 0\n            n = len(row)\n            if n > 0 and isinstance(row[0], str):\n                edge = row[0]\n                if n > 1: i_rst_b = row[1]\n                if n > 2: i_data_in = row[2]\n                if n > 3: i_enable = row[3]\n                if n > 4: i_fault = row[4]\n                if n > 5: i_clear = row[5]\n            elif n > 0 and isinstance(row[-1], str):\n                edge = row[-1]\n                if n > 0: i_rst_b = row[0]\n                if n > 1: i_data_in = row[1]\n                if n > 2: i_enable = row[2]\n                if n > 3: i_fault = row[3]\n                if n > 4: i_clear = row[4]\n            elif n == 5:\n                i_rst_b = row[0]\n                i_data_in = row[1]\n                i_enable = row[2]\n                i_fault = row[3]\n                i_clear = row[4]\n            elif n >= 6:\n                i_clk = row[0]\n                i_rst_b = row[1]\n                i_data_in = row[2]\n                i_enable = row[3]\n                i_fault = row[4]\n                i_clear = row[5]\n        if edge is not None:\n            if isinstance(edge, str):\n                posedge = edge.lower().startswith('pos')\n            else:\n                posedge = bool(edge)\n        elif i_clk is not None:\n            posedge = (prev_clk == 0 and i_clk == 1)\n            prev_clk = i_clk\n        else:\n            posedge = (row_idx % 2 == 0)\n        if i_rst_b == 0:\n            state = 0\n            cs_b = 1\n            spi_clk = 0\n            spi_data = 0\n            bits_left = 16\n            done = 0\n            shift_reg = 0\n        outputs.append({\n            'o_spi_cs_b': cs_b,\n            'o_spi_clk': spi_clk,\n            'o_spi_data': spi_data,\n            'o_bits_left': bits_left,\n            'o_done': done,\n            'o_fsm_state': state\n        })\n        if posedge and i_rst_b != 0:\n            n_state = state\n            n_cs_b = cs_b\n            n_spi_clk = spi_clk\n            n_spi_data = spi_data\n            n_bits_left = bits_left\n            n_done = done\n            n_shift_reg = shift_reg\n            if i_fault:\n                n_state = 3\n                n_cs_b = 1\n                n_spi_clk = 0\n                n_spi_data = 0\n                n_bits_left = 16\n                n_done = 0\n                n_shift_reg = 0\n            elif i_clear:\n                n_state = 0\n                n_cs_b = 1\n                n_spi_clk = 0\n                n_spi_data = 0\n                n_bits_left = 16\n                n_done = 0\n                n_shift_reg = 0\n            elif state != 3 and i_enable == 0:\n                n_state = 0\n                n_cs_b = 1\n                n_spi_clk = 0\n                n_spi_data = 0\n                n_bits_left = 16\n                n_done = 0\n                n_shift_reg = 0\n            else:\n                if state == 0:\n                    n_cs_b = 1\n                    n_spi_clk = 0\n                    n_spi_data = 0\n                    n_bits_left = 16\n                    n_done = 0\n                    if i_enable:\n                        n_state = 1\n                        n_shift_reg = i_data_in\n                    else:\n                        n_state = 0\n                elif state == 1:\n                    n_cs_b = 0\n                    n_spi_data = (shift_reg >> 15) & 1\n                    n_shift_reg = (shift_reg << 1) & 0xFFFF\n                    n_state = 2\n                elif state == 2:\n                    n_spi_clk = 1 - spi_clk\n                    if bits_left > 1:\n                        n_bits_left = bits_left - 1\n                        n_state = 1\n                    else:\n                        n_bits_left = 16\n                        n_done = 1\n                        n_state = 0\n                elif state == 3:\n                    n_cs_b = 1\n                    n_spi_clk = 0\n                    n_spi_data = 0\n                    n_bits_left = 16\n                    n_done = 0\n                    n_state = 3\n            state = n_state\n            cs_b = n_cs_b\n            spi_clk = n_spi_clk\n            spi_data = n_spi_data\n            bits_left = n_bits_left\n            done = n_done\n            shift_reg = n_shift_reg\n    return outputs\n"
