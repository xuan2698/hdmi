"def reference(vectors):\n    state = 0\n    cs = 1\n    clk = 0\n    data = 0\n    bits = 16\n    done = 0\n    data_reg = 0\n    prev_clk = None\n    out = []\n\n    for idx, row in enumerate(vectors):\n        def getv(key, default=0):\n            if isinstance(row, dict):\n                val = row.get(key, default)\n                try:\n                    return int(val)\n                except Exception:\n                    return default\n            return default\n\n        rst = getv('i_rst_b', 1)\n        fault = getv('i_fault', 0)\n        clear = getv('i_clear', 0)\n        enable = getv('i_enable', 0)\n        din = getv('i_data_in', 0) & 0xFFFF\n\n        current_clk = None\n        if isinstance(row, dict) and 'i_clk' in row:\n            try:\n                current_clk = int(row['i_clk'])\n            except Exception:\n                current_clk = None\n\n        is_pos = (idx % 2 == 0)\n        explicit_edge = False\n        if isinstance(row, dict):\n            for k in ('edge', 'EDGE', 'Edge'):\n                if k in row:\n                    e = row[k]\n                    explicit_edge = True\n                    if isinstance(e, str):\n                        el = e.lower()\n                        if el.startswith('pos') or el == '1':\n                            is_pos = True\n                        elif el.startswith('neg') or el == '0':\n                            is_pos = False\n                        else:\n                            try:\n                                is_pos = bool(int(e))\n                            except Exception:\n                                is_pos = True\n                    else:\n                        try:\n                            is_pos = bool(int(e))\n                        except Exception:\n                            is_pos = bool(e)\n                    break\n\n        if not explicit_edge and current_clk is not None and prev_clk is not None:\n            if current_clk == 1 and prev_clk == 0:\n                is_pos = True\n            elif current_clk == 0 and prev_clk == 1:\n                is_pos = False\n\n        if rst == 0:\n            state = 0\n            cs = 1\n            clk = 0\n            data = 0\n            bits = 16\n            done = 0\n            data_reg = 0\n\n        out.append({\n            'o_spi_cs_b': int(cs) & 1,\n            'o_spi_clk': int(clk) & 1,\n            'o_spi_data': int(data) & 1,\n            'o_bits_left': int(bits) & 0x1F,\n            'o_done': int(done) & 1,\n            'o_fsm_state': int(state) & 0x3\n        })\n\n        if is_pos:\n            if rst == 0:\n                state = 0\n                cs = 1\n                clk = 0\n                data = 0\n                bits = 16\n                done = 0\n                data_reg = 0\n            else:\n                n_state = state\n                n_cs = cs\n                n_clk = clk\n                n_data = data\n                n_bits = bits\n                n_done = 0\n                n_data_reg = data_reg\n\n                if fault:\n                    if state != 3:\n                        n_done = 1\n                    else:\n                        n_done = 0\n                    n_state = 3\n                    n_cs = 1\n                    n_clk = 0\n                    n_data = 0\n                    n_bits = 16\n                elif clear:\n                    n_state = 0\n                    n_cs = 1\n                    n_clk = 0\n                    n_data = 0\n                    n_bits = 16\n                    n_done = 0\n                elif state == 3:\n                    n_state = 3\n                    n_cs = 1\n                    n_clk = 0\n                    n_data = 0\n                    n_bits = 16\n                    n_done = 0\n                elif enable == 0:\n                    n_state = 0\n                    n_cs = 1\n                    n_clk = 0\n                    n_data = 0\n                    n_bits = 16\n                    n_done = 0\n                else:\n                    if state == 0:\n                        n_cs = 1\n                        n_clk = 0\n                        n_data = 0\n                        n_bits = 16\n                        n_data_reg = din\n                        n_cs = 0\n                        n_state = 1\n                    elif state == 1:\n                        n_cs = 0\n                        b = bits\n                        if b < 1:\n                            b = 1\n                        if b > 16:\n                            b = 16\n                        n_data = (data_reg >> (b - 1)) & 1\n                        n_state = 2\n                    elif state == 2:\n                        n_clk = 1 - clk\n                        if bits == 1:\n                            n_done = 1\n                            n_state = 0\n                            n_cs = 1\n                            n_clk = 0\n                            n_bits = 16\n                        else:\n                            n_bits = bits - 1\n                            n_state = 1\n                    else:\n                        n_state = 3\n                        n_cs = 1\n                        n_clk = 0\n                        n_data = 0\n                        n_bits = 16\n                        n_done = 0\n\n                state = n_state\n                cs = n_cs\n                clk = n_clk\n                data = n_data\n                bits = n_bits\n                done = n_done\n                data_reg = n_data_reg\n\n        if current_clk is not None:\n            prev_clk = current_clk\n\n    return out\n"
