"def reference(vectors):\n    state = 0\n    cs = 1\n    clk = 0\n    data = 0\n    bits_left = 16\n    done = 0\n    shift_reg = 0\n    prev_clk = 0\n    row_count = 0\n    out = []\n    for row in vectors:\n        i_rst_b = row.get('i_rst_b', 1)\n        i_data_in = row.get('i_data_in', 0) & 0xFFFF\n        i_enable = row.get('i_enable', 1)\n        i_fault = row.get('i_fault', 0)\n        i_clear = row.get('i_clear', 0)\n        edge = row.get('edge', None)\n        if edge is not None:\n            if isinstance(edge, str):\n                e = edge.lower()\n                is_pos = ('pos' in e) or (e == 'p') or (e == '1')\n            else:\n                is_pos = (edge == 1 or edge is True)\n        elif 'i_clk' in row:\n            cur_clk = row['i_clk']\n            is_pos = (cur_clk == 1 and prev_clk == 0)\n            prev_clk = cur_clk\n        else:\n            is_pos = (row_count % 2 == 0)\n        if i_rst_b == 0:\n            state = 0\n            cs = 1\n            clk = 0\n            data = 0\n            bits_left = 16\n            done = 0\n            shift_reg = 0\n        out.append({\n            'o_spi_cs_b': cs,\n            'o_spi_clk': clk,\n            'o_spi_data': data,\n            'o_bits_left': bits_left & 0x1F,\n            'o_done': done,\n            'o_fsm_state': state & 0x3\n        })\n        if is_pos and i_rst_b == 1:\n            if i_clear:\n                next_state = 0\n                next_cs = 1\n                next_clk = 0\n                next_data = 0\n                next_bits_left = 16\n                next_done = 0\n                next_shift_reg = shift_reg\n            elif state == 3:\n                next_state = 3\n                next_cs = 1\n                next_clk = 0\n                next_data = 0\n                next_bits_left = 16\n                next_done = 0\n                next_shift_reg = shift_reg\n            elif i_fault:\n                next_state = 3\n                next_cs = 1\n                next_clk = 0\n                next_data = 0\n                next_bits_left = 16\n                next_done = 0\n                next_shift_reg = shift_reg\n            elif i_enable == 0:\n                next_state = 0\n                next_cs = 1\n                next_clk = 0\n                next_data = 0\n                next_bits_left = 16\n                next_done = 0\n                next_shift_reg = shift_reg\n            else:\n                if state == 0:\n                    next_state = 1\n                    next_cs = 1\n                    next_clk = 0\n                    next_data = 0\n                    next_bits_left = 16\n                    next_done = 0\n                    next_shift_reg = i_data_in\n                elif state == 1:\n                    next_state = 2\n                    next_cs = 0\n                    next_clk = clk\n                    next_data = (shift_reg >> 15) & 1\n                    next_bits_left = bits_left\n                    next_done = 0\n                    next_shift_reg = (shift_reg << 1) & 0xFFFF\n                elif state == 2:\n                    next_clk = 1 - clk\n                    next_bits_left = (bits_left - 1) & 0x1F\n                    if bits_left == 1:\n                        next_state = 0\n                        next_done = 1\n                        next_cs = cs\n                        next_data = data\n                    else:\n                        next_state = 1\n                        next_done = 0\n                        next_cs = cs\n                        next_data = data\n                    next_shift_reg = shift_reg\n                else:\n                    next_state = 0\n                    next_cs = 1\n                    next_clk = 0\n                    next_data = 0\n                    next_bits_left = 16\n                    next_done = 0\n                    next_shift_reg = shift_reg\n            state = next_state\n            cs = next_cs\n            clk = next_clk\n            data = next_data\n            bits_left = next_bits_left\n            done = next_done\n            shift_reg = next_shift_reg\n        row_count += 1\n    return out\n"
