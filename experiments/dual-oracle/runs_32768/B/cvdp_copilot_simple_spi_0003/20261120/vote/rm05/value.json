"def reference(vectors):\n    def get_val(row, key, default=0):\n        if isinstance(row, dict):\n            return row.get(key, default)\n        if isinstance(row, (list, tuple)):\n            if len(row) == 5:\n                keys = ['i_rst_b', 'i_data_in', 'i_enable', 'i_fault', 'i_clear']\n            elif len(row) == 6:\n                keys = ['i_clk', 'i_rst_b', 'i_data_in', 'i_enable', 'i_fault', 'i_clear']\n            else:\n                return default\n            if key in keys:\n                return row[keys.index(key)]\n            return default\n        return default\n\n    state = 0\n    cs_b = 1\n    spi_clk = 0\n    spi_data = 0\n    bits_left = 16\n    done = 0\n    data_reg = 0\n\n    out = []\n    for idx, row in enumerate(vectors):\n        rst_b = get_val(row, 'i_rst_b', 1)\n        data_in = get_val(row, 'i_data_in', 0) & 0xFFFF\n        enable = get_val(row, 'i_enable', 0) & 1\n        fault = get_val(row, 'i_fault', 0) & 1\n        clear = get_val(row, 'i_clear', 0) & 1\n        is_posedge = (idx % 2 == 0)\n\n        if rst_b == 0:\n            state = 0\n            cs_b = 1\n            spi_clk = 0\n            spi_data = 0\n            bits_left = 16\n            done = 0\n            data_reg = 0\n\n        out.append({\n            'o_spi_cs_b': cs_b & 1,\n            'o_spi_clk': spi_clk & 1,\n            'o_spi_data': spi_data & 1,\n            'o_bits_left': bits_left & 0x1F,\n            'o_done': done & 1,\n            'o_fsm_state': state & 3\n        })\n\n        if is_posedge and rst_b != 0:\n            if clear:\n                state = 0\n                cs_b = 1\n                spi_clk = 0\n                spi_data = 0\n                bits_left = 16\n                done = 0\n                data_reg = 0\n            elif not enable:\n                state = 0\n                cs_b = 1\n                spi_clk = 0\n                spi_data = 0\n                bits_left = 16\n                done = 0\n                data_reg = 0\n            elif fault:\n                if state != 3:\n                    state = 3\n                    cs_b = 1\n                    spi_clk = 0\n                    spi_data = 0\n                    bits_left = 16\n                    done = 1\n                    data_reg = 0\n                else:\n                    state = 3\n                    cs_b = 1\n                    spi_clk = 0\n                    spi_data = 0\n                    bits_left = 16\n                    done = 0\n                    data_reg = 0\n            else:\n                if state == 0:\n                    cs_b = 1\n                    spi_clk = 0\n                    spi_data = 0\n                    bits_left = 16\n                    done = 0\n                    if enable:\n                        state = 1\n                        data_reg = data_in\n                elif state == 1:\n                    cs_b = 0\n                    spi_data = (data_reg >> 15) & 1\n                    state = 2\n                    done = 0\n                elif state == 2:\n                    spi_clk = 1 - spi_clk\n                    if bits_left == 1:\n                        done = 1\n                        bits_left = 16\n                        cs_b = 1\n                        spi_clk = 0\n                        spi_data = 0\n                        state = 0\n                        data_reg = 0\n                    else:\n                        bits_left = bits_left - 1\n                        data_reg = (data_reg << 1) & 0xFFFF\n                        state = 1\n                        done = 0\n                elif state == 3:\n                    cs_b = 1\n                    spi_clk = 0\n                    spi_data = 0\n                    bits_left = 16\n                    done = 0\n                    data_reg = 0\n                else:\n                    state = 0\n                    cs_b = 1\n                    spi_clk = 0\n                    spi_data = 0\n                    bits_left = 16\n                    done = 0\n                    data_reg = 0\n    return out\n"
