"def reference(vectors):\n    state = 0          # 00 Idle, 01 Transmit, 10 Clock Toggle, 11 Error\n    cs_b = 1\n    spi_clk = 0\n    spi_data = 0\n    bits_left = 16\n    done = 0\n    shift_reg = 0\n\n    result = []\n    prev_clk = None\n    auto_pos = True\n\n    for row in vectors:\n        rst_b = int(row.get('i_rst_b', 1)) & 1\n\n        if rst_b == 0:\n            state = 0\n            cs_b = 1\n            spi_clk = 0\n            spi_data = 0\n            bits_left = 16\n            done = 0\n            shift_reg = 0\n\n        edge = None\n\n        e = row.get('edge', None)\n        if e is None:\n            e = row.get('i_clk_edge', row.get('clk_edge', None))\n\n        if e is not None:\n            if isinstance(e, str):\n                s = e.lower()\n                if ('pos' in s) or ('rise' in s) or ('up' in s):\n                    edge = 1\n                elif ('neg' in s) or ('fall' in s) or ('down' in s):\n                    edge = 0\n            else:\n                edge = 1 if int(e) != 0 else 0\n\n        clk_val = row.get('i_clk', row.get('clk', None))\n\n        if edge is None:\n            if clk_val is not None:\n                cv = int(clk_val) & 1\n                if prev_clk is not None and cv != prev_clk:\n                    edge = 1 if cv == 1 else 0\n                else:\n                    edge = 1 if cv == 1 else 0\n            else:\n                edge = 1 if auto_pos else 0\n                auto_pos = not auto_pos\n\n        if clk_val is not None:\n            prev_clk = int(clk_val) & 1\n\n        result.append({\n            'o_spi_cs_b': int(cs_b) & 1,\n            'o_spi_clk': int(spi_clk) & 1,\n            'o_spi_data': int(spi_data) & 1,\n            'o_bits_left': int(bits_left) & 0x1F,\n            'o_done': int(done) & 1,\n            'o_fsm_state': int(state) & 0x3\n        })\n\n        if edge == 1 and rst_b == 1:\n            clear = int(row.get('i_clear', 0)) & 1\n            fault = int(row.get('i_fault', 0)) & 1\n            enable = int(row.get('i_enable', 0)) & 1\n            data_in = int(row.get('i_data_in', 0)) & 0xFFFF\n\n            if clear:\n                state = 0\n                cs_b = 1\n                spi_clk = 0\n                spi_data = 0\n                bits_left = 16\n                done = 0\n                shift_reg = 0\n\n            elif fault:\n                if state != 3:\n                    state = 3\n                    cs_b = 1\n                    spi_clk = 0\n                    spi_data = 0\n                    bits_left = 16\n                    done = 1\n                else:\n                    state = 3\n                    cs_b = 1\n                    spi_clk = 0\n                    spi_data = 0\n                    bits_left = 16\n                    done = 0\n\n            elif state == 3:\n                state = 3\n                cs_b = 1\n                spi_clk = 0\n                spi_data = 0\n                bits_left = 16\n                done = 0\n\n            elif enable == 0:\n                state = 0\n                cs_b = 1\n                spi_clk = 0\n                spi_data = 0\n                bits_left = 16\n                done = 0\n\n            else:\n                if state == 0:\n                    cs_b = 1\n                    spi_clk = 0\n                    spi_data = 0\n                    bits_left = 16\n                    done = 0\n                    state = 1\n                    shift_reg = data_in\n\n                elif state == 1:\n                    done = 0\n                    cs_b = 0\n                    spi_data = (shift_reg >> 15) & 1\n                    shift_reg = (shift_reg << 1) & 0xFFFF\n                    state = 2\n\n                elif state == 2:\n                    if bits_left == 1:\n                        cs_b = 1\n                        spi_clk = 0\n                        bits_left = 0\n                        done = 1\n                        state = 0\n                    else:\n                        spi_clk = spi_clk ^ 1\n                        bits_left = (bits_left - 1) & 0x1F\n                        done = 0\n                        state = 1\n\n    return result\n"
