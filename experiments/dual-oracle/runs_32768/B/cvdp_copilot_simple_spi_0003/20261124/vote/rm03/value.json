"def reference(vectors):\n    IDLE, TX, CLK, ERR = 0, 1, 2, 3\n    state = IDLE\n    cs = 1\n    clk = 0\n    dat = 0\n    bits = 16\n    done = 0\n    sh = 0\n    out = []\n    for row in vectors:\n        rst = row.get('i_rst_b', row.get('rst_b', 1))\n        data_in = row.get('i_data_in', row.get('data_in', 0))\n        enable = row.get('i_enable', row.get('enable', 0))\n        fault = row.get('i_fault', row.get('fault', 0))\n        clear = row.get('i_clear', row.get('clear', 0))\n        edge = row.get('edge', None)\n        if edge is None:\n            edge = row.get('i_clk', row.get('clk', 0))\n        if isinstance(edge, str):\n            s = edge.lower()\n            pos = ('pos' in s) or (s in ('p', '1', 'rise', 'rising'))\n        else:\n            pos = (edge == 1) or (edge is True)\n        rst = int(rst) & 1\n        data_in = int(data_in) & 0xFFFF\n        enable = int(enable) & 1\n        fault = int(fault) & 1\n        clear = int(clear) & 1\n        if rst == 0:\n            state = IDLE\n            cs = 1\n            clk = 0\n            dat = 0\n            bits = 16\n            done = 0\n            sh = 0\n        out.append({\n            'o_spi_cs_b': cs & 1,\n            'o_spi_clk': clk & 1,\n            'o_spi_data': dat & 1,\n            'o_bits_left': bits & 31,\n            'o_done': done & 1,\n            'o_fsm_state': state & 3\n        })\n        if pos and rst == 1:\n            if clear:\n                state = IDLE\n                cs = 1\n                clk = 0\n                dat = 0\n                bits = 16\n                done = 0\n                sh = 0\n            elif fault:\n                state = ERR\n                cs = 1\n                clk = 0\n                dat = 0\n                bits = 16\n                done = 0\n            elif state == ERR:\n                cs = 1\n                clk = 0\n                dat = 0\n                bits = 16\n                done = 0\n                state = ERR\n            elif enable == 0:\n                state = IDLE\n                cs = 1\n                clk = 0\n                dat = 0\n                bits = 16\n                done = 0\n                sh = 0\n            else:\n                if state == IDLE:\n                    cs = 1\n                    clk = 0\n                    dat = 0\n                    bits = 16\n                    done = 0\n                    state = TX\n                    sh = data_in\n                elif state == TX:\n                    cs = 0\n                    dat = (sh >> 15) & 1\n                    sh = (sh << 1) & 0xFFFF\n                    done = 0\n                    state = CLK\n                elif state == CLK:\n                    old_bits = bits\n                    clk = 1 - clk\n                    bits = (bits - 1) & 31\n                    if old_bits == 1:\n                        done = 1\n                        state = IDLE\n                    else:\n                        done = 0\n                        state = TX\n    return out\n"
