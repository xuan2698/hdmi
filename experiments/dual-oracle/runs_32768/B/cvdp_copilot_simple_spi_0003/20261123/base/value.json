"def reference(vectors):\n    state = 0\n    cs = 1\n    clk = 0\n    data = 0\n    bits_left = 16\n    done = 0\n    shift = 0\n    res = []\n\n    for row in vectors:\n        rst = row.get('i_rst_b', 1)\n        din = row.get('i_data_in', 0)\n        en = row.get('i_enable', 0)\n        flt = row.get('i_fault', 0)\n        clr = row.get('i_clear', 0)\n\n        edge = row.get('edge', None)\n        if edge is None:\n            edge = row.get('i_clk', None)\n\n        if isinstance(edge, str):\n            pos = edge.lower().startswith('p') or edge == '1'\n        else:\n            pos = edge == 1 or edge is True\n\n        if rst == 0:\n            state = 0\n            cs = 1\n            clk = 0\n            data = 0\n            bits_left = 16\n            done = 0\n            shift = 0\n\n        res.append({\n            'o_spi_cs_b': cs,\n            'o_spi_clk': clk,\n            'o_spi_data': data,\n            'o_bits_left': bits_left & 0x1F,\n            'o_done': done,\n            'o_fsm_state': state & 0x3\n        })\n\n        if pos and rst != 0:\n            old = state\n            n_state = state\n            n_cs = cs\n            n_clk = clk\n            n_data = data\n            n_bits = bits_left\n            n_done = done\n            n_shift = shift\n\n            if clr:\n                n_state = 0\n                n_cs = 1\n                n_clk = 0\n                n_data = 0\n                n_bits = 16\n                n_done = 0\n                n_shift = 0\n            elif old == 3:\n                n_state = 3\n                n_cs = 1\n                n_clk = 0\n                n_data = 0\n                n_bits = 16\n                n_done = 0\n                n_shift = 0\n            elif flt:\n                n_state = 3\n                n_cs = 1\n                n_clk = 0\n                n_data = 0\n                n_bits = 16\n                n_done = 1\n                n_shift = 0\n            elif not en:\n                n_state = 0\n                n_cs = 1\n                n_clk = 0\n                n_data = 0\n                n_bits = 16\n                n_done = 0\n                n_shift = 0\n            else:\n                if old == 0:\n                    n_state = 1\n                    n_cs = 1\n                    n_clk = 0\n                    n_data = 0\n                    n_bits = 16\n                    n_done = 0\n                    n_shift = din & 0xFFFF\n                elif old == 1:\n                    n_state = 2\n                    n_cs = 0\n                    n_data = (shift >> 15) & 1\n                    n_shift = (shift << 1) & 0xFFFF\n                elif old == 2:\n                    n_clk = clk ^ 1\n                    n_bits = (bits_left - 1) & 0x1F\n                    if bits_left == 1:\n                        n_state = 0\n                        n_cs = 1\n                        n_clk = 0\n                        n_data = 0\n                        n_done = 1\n                    else:\n                        n_state = 1\n                        n_done = 0\n\n            state = n_state\n            cs = n_cs\n            clk = n_clk\n            data = n_data\n            bits_left = n_bits\n            done = n_done\n            shift = n_shift\n\n    return res\n"
