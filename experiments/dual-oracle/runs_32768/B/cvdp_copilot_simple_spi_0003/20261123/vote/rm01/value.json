"def reference(vectors):\n    state = 0\n    cs_b = 1\n    clk = 0\n    data = 0\n    bits_left = 16\n    done = 0\n    shift_reg = 0\n    prev_clk = 0\n    outputs = []\n    for row in vectors:\n        if isinstance(row, dict):\n            if 'edge' in row:\n                e = row['edge']\n                if isinstance(e, str):\n                    e = e.lower()\n                    is_pos = e.startswith('p') or e == '1'\n                else:\n                    is_pos = (e == 1)\n                i_rst_b = row.get('i_rst_b', 1)\n                i_data_in = row.get('i_data_in', 0)\n                i_enable = row.get('i_enable', 0)\n                i_fault = row.get('i_fault', 0)\n                i_clear = row.get('i_clear', 0)\n            elif 'i_clk' in row:\n                cur_clk = row['i_clk']\n                is_pos = (cur_clk == 1 and prev_clk == 0)\n                prev_clk = cur_clk\n                i_rst_b = row.get('i_rst_b', 1)\n                i_data_in = row.get('i_data_in', 0)\n                i_enable = row.get('i_enable', 0)\n                i_fault = row.get('i_fault', 0)\n                i_clear = row.get('i_clear', 0)\n            else:\n                is_pos = True\n                i_rst_b = row.get('i_rst_b', 1)\n                i_data_in = row.get('i_data_in', 0)\n                i_enable = row.get('i_enable', 0)\n                i_fault = row.get('i_fault', 0)\n                i_clear = row.get('i_clear', 0)\n        else:\n            if len(row) >= 6:\n                e = row[0]\n                if isinstance(e, str):\n                    e = e.lower()\n                    is_pos = e.startswith('p') or e == '1'\n                else:\n                    is_pos = (e == 1)\n                i_rst_b, i_data_in, i_enable, i_fault, i_clear = row[1:6]\n            elif len(row) == 5:\n                is_pos = (len(outputs) % 2 == 0)\n                i_rst_b, i_data_in, i_enable, i_fault, i_clear = row\n            else:\n                is_pos = True\n                i_rst_b = row[0] if len(row)>0 else 1\n                i_data_in = row[1] if len(row)>1 else 0\n                i_enable = row[2] if len(row)>2 else 0\n                i_fault = row[3] if len(row)>3 else 0\n                i_clear = row[4] if len(row)>4 else 0\n        i_rst_b = int(i_rst_b) & 1\n        i_data_in = int(i_data_in) & 0xFFFF\n        i_enable = int(i_enable) & 1\n        i_fault = int(i_fault) & 1\n        i_clear = int(i_clear) & 1\n\n        if i_rst_b == 0:\n            state = 0\n            cs_b = 1\n            clk = 0\n            data = 0\n            bits_left = 16\n            done = 0\n            shift_reg = 0\n\n        outputs.append({\n            'o_spi_cs_b': cs_b,\n            'o_spi_clk': clk,\n            'o_spi_data': data,\n            'o_bits_left': bits_left,\n            'o_done': done,\n            'o_fsm_state': state\n        })\n\n        if is_pos and i_rst_b != 0:\n            n_state = state\n            n_cs_b = cs_b\n            n_clk = clk\n            n_data = data\n            n_bits_left = bits_left\n            n_done = done\n            n_shift_reg = shift_reg\n            if i_clear == 1:\n                n_state = 0\n                n_cs_b = 1\n                n_clk = 0\n                n_data = 0\n                n_bits_left = 16\n                n_done = 0\n                n_shift_reg = 0\n            elif i_fault == 1:\n                n_state = 3\n                n_cs_b = 1\n                n_clk = 0\n                n_data = 0\n                n_bits_left = 16\n                n_done = 0\n            elif state == 3:\n                n_state = 3\n                n_cs_b = 1\n                n_clk = 0\n                n_data = 0\n                n_bits_left = 16\n                n_done = 0\n            elif i_enable == 0:\n                n_state = 0\n                n_cs_b = 1\n                n_clk = 0\n                n_data = 0\n                n_bits_left = 16\n                n_done = 0\n                n_shift_reg = 0\n            else:\n                if state == 0:\n                    n_cs_b = 1\n                    n_clk = 0\n                    n_data = 0\n                    n_bits_left = 16\n                    n_done = 0\n                    if i_enable == 1:\n                        n_state = 1\n                        n_shift_reg = i_data_in\n                    else:\n                        n_state = 0\n                elif state == 1:\n                    n_cs_b = 0\n                    n_data = (shift_reg >> 15) & 1\n                    n_shift_reg = (shift_reg << 1) & 0xFFFF\n                    n_bits_left = bits_left\n                    n_done = 0\n                    n_state = 2\n                elif state == 2:\n                    n_clk = 1 - clk\n                    n_bits_left = bits_left - 1\n                    n_cs_b = cs_b\n                    n_data = data\n                    n_shift_reg = shift_reg\n                    if bits_left == 1:\n                        n_state = 0\n                        n_done = 1\n                        n_cs_b = 1\n                        n_clk = 0\n                        n_data = 0\n                        n_bits_left = 16\n                    else:\n                        n_state = 1\n                        n_done = 0\n                elif state == 3:\n                    n_state = 3\n                    n_cs_b = 1\n                    n_clk = 0\n                    n_data = 0\n                    n_bits_left = 16\n                    n_done = 0\n            state = n_state\n            cs_b = n_cs_b\n            clk = n_clk\n            data = n_data\n            bits_left = n_bits_left\n            done = n_done\n            shift_reg = n_shift_reg\n    return outputs\n"
