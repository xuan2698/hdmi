"def reference(vectors):\n    st = 0\n    cs = 1\n    clk = 0\n    data = 0\n    bits = 16\n    done = 0\n    shift = 0\n    prev_rst = 1\n    out = []\n    for idx, row in enumerate(vectors):\n        if isinstance(row, dict):\n            edge_raw = row.get('edge', row.get('i_clk', None))\n            i_rst_b = int(row.get('i_rst_b', 1))\n            i_data_in = int(row.get('i_data_in', 0)) & 0xFFFF\n            i_enable = int(row.get('i_enable', 0))\n            i_fault = int(row.get('i_fault', 0))\n            i_clear = int(row.get('i_clear', 0))\n        else:\n            if len(row) == 6:\n                edge_raw = row[0]\n                i_rst_b = int(row[1])\n                i_data_in = int(row[2]) & 0xFFFF\n                i_enable = int(row[3])\n                i_fault = int(row[4])\n                i_clear = int(row[5])\n            elif len(row) == 5:\n                edge_raw = 1 if idx % 2 == 0 else 0\n                i_rst_b = int(row[0])\n                i_data_in = int(row[1]) & 0xFFFF\n                i_enable = int(row[2])\n                i_fault = int(row[3])\n                i_clear = int(row[4])\n            elif len(row) == 7:\n                edge_raw = row[0]\n                i_rst_b = int(row[1])\n                i_data_in = int(row[2]) & 0xFFFF\n                i_enable = int(row[3])\n                i_fault = int(row[4])\n                i_clear = int(row[5])\n            else:\n                edge_raw = row[0]\n                vals = list(row[1:]) + [0, 0, 0, 0, 0]\n                i_rst_b = int(vals[0])\n                i_data_in = int(vals[1]) & 0xFFFF\n                i_enable = int(vals[2])\n                i_fault = int(vals[3])\n                i_clear = int(vals[4])\n        if isinstance(edge_raw, str):\n            et = 1 if edge_raw.lower().startswith('p') else 0\n        elif edge_raw is None:\n            et = 1 if idx % 2 == 0 else 0\n        else:\n            et = 1 if int(edge_raw) == 1 else 0\n        out.append({\n            'o_spi_cs_b': cs,\n            'o_spi_clk': clk,\n            'o_spi_data': data,\n            'o_bits_left': bits,\n            'o_done': done,\n            'o_fsm_state': st\n        })\n        if et == 0:\n            if i_rst_b == 0 and prev_rst != 0:\n                st = 0\n                cs = 1\n                clk = 0\n                data = 0\n                bits = 16\n                done = 0\n                shift = 0\n        else:\n            if i_rst_b == 0:\n                st = 0\n                cs = 1\n                clk = 0\n                data = 0\n                bits = 16\n                done = 0\n                shift = 0\n            else:\n                nst = st\n                ncs = cs\n                nclk = clk\n                ndata = data\n                nbits = bits\n                ndone = 0\n                nshift = shift\n                if i_clear:\n                    nst = 0\n                    ncs = 1\n                    nclk = 0\n                    ndata = 0\n                    nbits = 16\n                    ndone = 0\n                elif i_fault:\n                    ndone = 1 if st != 3 else 0\n                    nst = 3\n                    ncs = 1\n                    nclk = 0\n                    ndata = 0\n                    nbits = 16\n                elif (not i_enable) and st != 3:\n                    nst = 0\n                    ncs = 1\n                    nclk = 0\n                    ndata = 0\n                    nbits = 16\n                    ndone = 0\n                else:\n                    if st == 0:\n                        ncs = 1\n                        nclk = 0\n                        ndata = 0\n                        nbits = 16\n                        ndone = 0\n                        if i_enable:\n                            nshift = i_data_in\n                            nst = 1\n                        else:\n                            nst = 0\n                    elif st == 1:\n                        ncs = 0\n                        ndata = (nshift >> 15) & 1\n                        nshift = (nshift << 1) & 0xFFFF\n                        nst = 2\n                    elif st == 2:\n                        nclk = 1 - nclk\n                        nbits = nbits - 1\n                        if bits == 1:\n                            ndone = 1\n                            nst = 0\n                        else:\n                            ndone = 0\n                            nst = 1\n                    elif st == 3:\n                        ncs = 1\n                        nclk = 0\n                        ndata = 0\n                        nbits = 16\n                        ndone = 0\n                        nst = 3\n                st = nst\n                cs = ncs\n                clk = nclk\n                data = ndata\n                bits = nbits\n                done = ndone\n                shift = nshift\n        prev_rst = i_rst_b\n    return out\n"
