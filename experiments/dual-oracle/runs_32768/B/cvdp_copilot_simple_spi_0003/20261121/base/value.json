"def reference(vectors):\n    out = []\n    state = 0\n    cs = 1\n    clk = 0\n    data = 0\n    bits = 16\n    done = 0\n    shift = 0\n    for i, row in enumerate(vectors):\n        if isinstance(row, dict):\n            rst = row.get('i_rst_b', 1)\n            enable = row.get('i_enable', 0)\n            fault = row.get('i_fault', 0)\n            clear = row.get('i_clear', 0)\n            data_in = row.get('i_data_in', 0)\n        else:\n            if len(row) == 5:\n                rst, data_in, enable, fault, clear = row\n            elif len(row) == 6:\n                _, rst, data_in, enable, fault, clear = row\n            else:\n                rst = 1\n                data_in = 0\n                enable = 0\n                fault = 0\n                clear = 0\n        pos = (i % 2 == 0)\n        if rst == 0:\n            state = 0\n            cs = 1\n            clk = 0\n            data = 0\n            bits = 16\n            done = 0\n            shift = 0\n        out.append({\n            'o_spi_cs_b': cs,\n            'o_spi_clk': clk,\n            'o_spi_data': data,\n            'o_bits_left': bits,\n            'o_done': done,\n            'o_fsm_state': state\n        })\n        if pos and rst != 0:\n            if clear:\n                state = 0\n                cs = 1\n                clk = 0\n                data = 0\n                bits = 16\n                done = 0\n                shift = 0\n            elif state == 3:\n                cs = 1\n                clk = 0\n                data = 0\n                bits = 16\n                done = 0\n            elif fault:\n                state = 3\n                cs = 1\n                clk = 0\n                data = 0\n                bits = 16\n                done = 1\n                shift = 0\n            elif not enable:\n                state = 0\n                cs = 1\n                clk = 0\n                data = 0\n                bits = 16\n                done = 0\n                shift = 0\n            else:\n                if state == 0:\n                    cs = 1\n                    clk = 0\n                    data = 0\n                    bits = 16\n                    done = 0\n                    shift = data_in\n                    cs = 0\n                    state = 1\n                elif state == 1:\n                    data = (shift >> 15) & 1\n                    shift = (shift << 1) & 0xFFFF\n                    state = 2\n                elif state == 2:\n                    clk = 1 - clk\n                    bits = bits - 1\n                    if bits == 0:\n                        done = 1\n                        state = 0\n                    else:\n                        state = 1\n    return out\n"
