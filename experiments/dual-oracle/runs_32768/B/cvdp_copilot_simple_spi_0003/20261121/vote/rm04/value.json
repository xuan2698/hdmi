"def reference(vectors):\n    IDLE = 0\n    TRANSMIT = 1\n    CLOCK_TOGGLE = 2\n    ERROR = 3\n    \n    state = IDLE\n    shift_reg = 0\n    bits_left = 16\n    done = 0\n    prev_clk = 0\n    results = []\n    \n    for idx, row in enumerate(vectors):\n        rst_b = row.get('i_rst_b', 1)\n        data_in = row.get('i_data_in', 0)\n        enable = row.get('i_enable', 0)\n        fault = row.get('i_fault', 0)\n        clear = row.get('i_clear', 0)\n        \n        if rst_b == 0:\n            state = IDLE\n            shift_reg = 0\n            bits_left = 16\n            done = 0\n        \n        if 'i_clk' in row:\n            cur_clk = row['i_clk']\n            if cur_clk == 1 and prev_clk == 0:\n                is_pos = True\n            elif cur_clk == 0 and prev_clk == 1:\n                is_pos = False\n            else:\n                is_pos = False\n            prev_clk = cur_clk\n        elif 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                is_pos = 'pos' in e.lower()\n            else:\n                is_pos = bool(e)\n        else:\n            is_pos = (idx % 2 == 0)\n        \n        if state == IDLE or state == ERROR:\n            cs_b = 1\n            spi_clk = 0\n            spi_data = 0\n        else:\n            cs_b = 0\n            spi_clk = 1 if state == CLOCK_TOGGLE else 0\n            spi_data = (shift_reg >> 15) & 1\n        \n        results.append({\n            'o_spi_cs_b': cs_b,\n            'o_spi_clk': spi_clk,\n            'o_spi_data': spi_data,\n            'o_bits_left': bits_left,\n            'o_done': done,\n            'o_fsm_state': state\n        })\n        \n        if is_pos:\n            if rst_b == 0:\n                state = IDLE\n                shift_reg = 0\n                bits_left = 16\n                done = 0\n            elif clear == 1:\n                state = IDLE\n                shift_reg = 0\n                bits_left = 16\n                done = 0\n            elif state == ERROR:\n                state = ERROR\n                shift_reg = 0\n                bits_left = 16\n                done = 0\n            elif fault == 1:\n                state = ERROR\n                shift_reg = 0\n                bits_left = 16\n                done = 1\n            elif enable == 0:\n                state = IDLE\n                shift_reg = 0\n                bits_left = 16\n                done = 0\n            else:\n                if state == IDLE:\n                    state = TRANSMIT\n                    shift_reg = data_in & 0xFFFF\n                    bits_left = 16\n                    done = 0\n                elif state == TRANSMIT:\n                    state = CLOCK_TOGGLE\n                    done = 0\n                elif state == CLOCK_TOGGLE:\n                    if bits_left == 1:\n                        state = IDLE\n                        shift_reg = 0\n                        bits_left = 16\n                        done = 1\n                    else:\n                        shift_reg = (shift_reg << 1) & 0xFFFF\n                        bits_left -= 1\n                        state = TRANSMIT\n                        done = 0\n                else:\n                    state = IDLE\n                    shift_reg = 0\n                    bits_left = 16\n                    done = 0\n    \n    return results\n"
