"def reference(vectors):\n    state = 0\n    bits_left = 16\n    shift_reg = 0\n    cs_b = 1\n    spi_clk = 0\n    spi_data = 0\n    done = 0\n    prev_clk = 0\n    out = []\n    for idx, row in enumerate(vectors):\n        if isinstance(row, dict):\n            rst = row.get('i_rst_b', row.get('rst_b', 1))\n            data = row.get('i_data_in', row.get('data_in', 0))\n            en = row.get('i_enable', row.get('enable', 0))\n            fault = row.get('i_fault', row.get('fault', 0))\n            clear = row.get('i_clear', row.get('clear', 0))\n            clk = row.get('i_clk', row.get('clk', None))\n            if 'edge' in row:\n                e = row['edge']\n                if isinstance(e, str):\n                    pos = (e.lower() == 'posedge')\n                else:\n                    pos = (e == 1) if e in (0, 1) else (idx % 2 == 0)\n            elif clk is not None:\n                pos = (clk == 1 and prev_clk == 0)\n                prev_clk = clk\n            else:\n                pos = (idx % 2 == 0)\n        else:\n            if len(row) == 5:\n                rst, data, en, fault, clear = row\n                pos = (idx % 2 == 0)\n            elif len(row) == 6:\n                clk, rst, data, en, fault, clear = row\n                pos = (clk == 1 and prev_clk == 0)\n                prev_clk = clk\n            else:\n                rst = data = en = fault = clear = 0\n                pos = (idx % 2 == 0)\n        out.append({\n            'o_spi_cs_b': int(cs_b),\n            'o_spi_clk': int(spi_clk),\n            'o_spi_data': int(spi_data),\n            'o_bits_left': int(bits_left & 0x1F),\n            'o_done': int(done),\n            'o_fsm_state': int(state & 0x3)\n        })\n        if rst == 0:\n            state = 0\n            bits_left = 16\n            shift_reg = 0\n            cs_b = 1\n            spi_clk = 0\n            spi_data = 0\n            done = 0\n        elif pos:\n            if clear:\n                state = 0\n                bits_left = 16\n                shift_reg = 0\n                cs_b = 1\n                spi_clk = 0\n                spi_data = 0\n                done = 0\n            elif fault:\n                if state != 3:\n                    done = 1\n                else:\n                    done = 0\n                state = 3\n                bits_left = 16\n                shift_reg = 0\n                cs_b = 1\n                spi_clk = 0\n                spi_data = 0\n            elif en == 0:\n                state = 0\n                bits_left = 16\n                shift_reg = 0\n                cs_b = 1\n                spi_clk = 0\n                spi_data = 0\n                done = 0\n            else:\n                if state == 0:\n                    cs_b = 1\n                    spi_clk = 0\n                    spi_data = 0\n                    done = 0\n                    bits_left = 16\n                    state = 1\n                    cs_b = 0\n                    shift_reg = data & 0xFFFF\n                elif state == 1:\n                    cs_b = 0\n                    spi_data = (shift_reg >> 15) & 1\n                    state = 2\n                    done = 0\n                elif state == 2:\n                    spi_clk = 1 - spi_clk\n                    shift_reg = (shift_reg << 1) & 0xFFFF\n                    if bits_left == 1:\n                        bits_left = 0\n                        done = 1\n                        state = 0\n                        cs_b = 1\n                    else:\n                        bits_left = (bits_left - 1) & 0x1F\n                        done = 0\n                        state = 1\n                elif state == 3:\n                    cs_b = 1\n                    spi_clk = 0\n                    spi_data = 0\n                    done = 0\n                    bits_left = 16\n    return out\n"
