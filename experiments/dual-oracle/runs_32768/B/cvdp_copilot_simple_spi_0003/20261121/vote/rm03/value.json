"def reference(vectors):\n    state = 0\n    cs = 1\n    sclk = 0\n    data = 0\n    bits_left = 16\n    done = 0\n    shift = 0\n    prev_clk = 0\n    results = []\n\n    for idx, row in enumerate(vectors):\n        rst_b = row.get('i_rst_b', 1)\n        en = row.get('i_enable', 0)\n        fault = row.get('i_fault', 0)\n        clear = row.get('i_clear', 0)\n        din = row.get('i_data_in', 0) & 0xFFFF\n\n        if rst_b == 0:\n            state = 0\n            cs = 1\n            sclk = 0\n            data = 0\n            bits_left = 16\n            done = 0\n            shift = 0\n\n        if 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                posedge = ('pos' in e.lower())\n            else:\n                posedge = bool(e)\n        elif 'i_clk' in row:\n            c = row['i_clk']\n            posedge = (prev_clk == 0 and c == 1)\n            if idx == 0 and c == 1:\n                posedge = True\n            prev_clk = c\n        else:\n            posedge = (idx % 2 == 0)\n\n        results.append({\n            'o_spi_cs_b': cs & 1,\n            'o_spi_clk': sclk & 1,\n            'o_spi_data': data & 1,\n            'o_bits_left': bits_left & 0x1F,\n            'o_done': done & 1,\n            'o_fsm_state': state & 3\n        })\n\n        if posedge and rst_b != 0:\n            if clear:\n                state = 0\n                cs = 1\n                sclk = 0\n                data = 0\n                bits_left = 16\n                done = 0\n                shift = 0\n            elif fault:\n                if state != 3:\n                    done = 1\n                else:\n                    done = 0\n                state = 3\n                cs = 1\n                sclk = 0\n                data = 0\n                bits_left = 10\n            elif state == 3:\n                state = 3\n                cs = 1\n                sclk = 0\n                data = 0\n                bits_left = 10\n                done = 0\n            elif en == 0:\n                state = 0\n                cs = 1\n                sclk = 0\n                data = 0\n                bits_left = 16\n                done = 0\n                shift = 0\n            else:\n                if state == 0:\n                    cs = 1\n                    sclk = 0\n                    data = 0\n                    bits_left = 16\n                    done = 0\n                    shift = din\n                    state = 1\n                elif state == 1:\n                    cs = 0\n                    data = (shift >> 15) & 1\n                    shift = (shift << 1) & 0xFFFF\n                    done = 0\n                    state = 2\n                elif state == 2:\n                    old_bl = bits_left\n                    sclk = 1 - sclk\n                    bits_left = (bits_left - 1) & 0x1F\n                    if old_bl == 1:\n                        done = 1\n                        state = 0\n                    else:\n                        done = 0\n                        state = 1\n\n    return results\n"
