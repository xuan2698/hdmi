"def reference(vectors):\n    state = 0\n    cs = 1\n    clk = 0\n    data = 0\n    bits_left = 16\n    done = 0\n    outputs = []\n    for idx, row in enumerate(vectors):\n        i_rst_b = row.get('i_rst_b', 1)\n        i_data_in = row.get('i_data_in', 0)\n        i_enable = row.get('i_enable', 0)\n        i_fault = row.get('i_fault', 0)\n        i_clear = row.get('i_clear', 0)\n        posedge = (idx % 2 == 0)\n        if i_rst_b == 0:\n            state = 0\n            cs = 1\n            clk = 0\n            data = 0\n            bits_left = 16\n            done = 0\n        outputs.append({\n            'o_spi_cs_b': cs,\n            'o_spi_clk': clk,\n            'o_spi_data': data,\n            'o_bits_left': bits_left,\n            'o_done': done,\n            'o_fsm_state': state\n        })\n        if posedge and i_rst_b == 1:\n            n_state = state\n            n_cs = cs\n            n_clk = clk\n            n_data = data\n            n_bits_left = bits_left\n            n_done = done\n            if i_clear:\n                n_state = 0\n                n_cs = 1\n                n_clk = 0\n                n_data = 0\n                n_bits_left = 16\n                n_done = 0\n            elif i_fault:\n                n_state = 3\n                n_cs = 1\n                n_clk = 0\n                n_data = 0\n                n_bits_left = 16\n                n_done = 0\n            else:\n                if state == 0:\n                    n_cs = 1\n                    n_clk = 0\n                    n_data = 0\n                    n_bits_left = 16\n                    n_done = 0\n                    if i_enable:\n                        n_cs = 0\n                        n_state = 1\n                elif state == 1:\n                    if i_enable == 0:\n                        n_cs = 1\n                        n_clk = 0\n                        n_data = 0\n                        n_bits_left = 16\n                        n_done = 0\n                        n_state = 0\n                    else:\n                        n_cs = 0\n                        bit_idx = bits_left - 1\n                        if bit_idx < 0:\n                            bit_idx = 0\n                        if bit_idx > 15:\n                            bit_idx = 15\n                        n_data = (i_data_in >> bit_idx) & 1\n                        n_state = 2\n                elif state == 2:\n                    if i_enable == 0:\n                        n_cs = 1\n                        n_clk = 0\n                        n_data = 0\n                        n_bits_left = 16\n                        n_done = 0\n                        n_state = 0\n                    else:\n                        n_clk = 1 - clk\n                        if bits_left == 1:\n                            n_done = 1\n                            n_state = 0\n                            n_bits_left = 0\n                        else:\n                            n_bits_left = bits_left - 1\n                            n_state = 1\n                elif state == 3:\n                    n_cs = 1\n                    n_clk = 0\n                    n_data = 0\n                    n_bits_left = 16\n                    n_done = 0\n                    n_state = 3\n            state = n_state\n            cs = n_cs\n            clk = n_clk\n            data = n_data\n            bits_left = n_bits_left\n            done = n_done\n    return outputs\n"
