"def reference(vectors):\n    state = 0\n    data_reg = 0\n    bits_left = 16\n    cs = 1\n    clk = 0\n    spi_data = 0\n    done = 0\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            edge_val = row.get('edge', None)\n            if edge_val is None and 'i_clk' in row:\n                edge_val = row['i_clk']\n            rst = row.get('i_rst_b', 1)\n            data_in = row.get('i_data_in', 0)\n            enable = row.get('i_enable', 1)\n            fault = row.get('i_fault', 0)\n            clear = row.get('i_clear', 0)\n        else:\n            edge_val = row[0] if len(row) > 0 else None\n            rst = row[1] if len(row) > 1 else 1\n            data_in = row[2] if len(row) > 2 else 0\n            enable = row[3] if len(row) > 3 else 1\n            fault = row[4] if len(row) > 4 else 0\n            clear = row[5] if len(row) > 5 else 0\n\n        is_pos = False\n        if isinstance(edge_val, str):\n            e = edge_val.lower()\n            if 'pos' in e:\n                is_pos = True\n            elif 'neg' in e:\n                is_pos = False\n        else:\n            if edge_val == 1 or edge_val is True:\n                is_pos = True\n            elif edge_val == 0 or edge_val is False:\n                is_pos = False\n            else:\n                is_pos = (edge_val == 1)\n\n        rst = int(rst) & 1\n        data_in = int(data_in) & 0xFFFF\n        enable = int(enable) & 1\n        fault = int(fault) & 1\n        clear = int(clear) & 1\n\n        if rst == 0:\n            state = 0\n            data_reg = 0\n            bits_left = 16\n            cs = 1\n            clk = 0\n            spi_data = 0\n            done = 0\n\n        out.append({\n            'o_spi_cs_b': cs & 1,\n            'o_spi_clk': clk & 1,\n            'o_spi_data': spi_data & 1,\n            'o_bits_left': bits_left & 0x1F,\n            'o_done': done & 1,\n            'o_fsm_state': state & 3\n        })\n\n        if is_pos and rst == 1:\n            n_state = state\n            n_data_reg = data_reg\n            n_bits_left = bits_left\n            n_cs = cs\n            n_clk = clk\n            n_spi_data = spi_data\n            n_done = done\n\n            if fault == 1:\n                if state != 3:\n                    n_done = 1\n                else:\n                    n_done = 0\n                n_state = 3\n                n_cs = 1\n                n_clk = 0\n                n_spi_data = 0\n                n_bits_left = 16\n                n_data_reg = 0\n            elif clear == 1:\n                n_state = 0\n                n_cs = 1\n                n_clk = 0\n                n_spi_data = 0\n                n_bits_left = 16\n                n_done = 0\n                n_data_reg = 0\n            elif enable == 0:\n                n_state = 0\n                n_cs = 1\n                n_clk = 0\n                n_spi_data = 0\n                n_bits_left = 16\n                n_done = 0\n                n_data_reg = 0\n            else:\n                if state == 0:\n                    n_cs = 1\n                    n_clk = 0\n                    n_spi_data = 0\n                    n_bits_left = 16\n                    n_done = 0\n                    n_state = 1\n                    n_data_reg = data_in\n                elif state == 1:\n                    n_cs = 0\n                    n_clk = 0\n                    n_spi_data = (data_reg >> 15) & 1\n                    n_state = 2\n                elif state == 2:\n                    n_cs = 0\n                    n_clk = 1 if clk == 0 else 0\n                    n_data_reg = (data_reg << 1) & 0xFFFF\n                    if bits_left > 0:\n                        n_bits_left = bits_left - 1\n                    else:\n                        n_bits_left = 0\n                    if bits_left == 1:\n                        n_done = 1\n                        n_state = 0\n                    else:\n                        n_done = 0\n                        n_state = 1\n                elif state == 3:\n                    n_cs = 1\n                    n_clk = 0\n                    n_spi_data = 0\n                    n_bits_left = 16\n                    n_done = 0\n                    n_state = 3\n                else:\n                    n_state = 0\n\n            state = n_state\n            data_reg = n_data_reg\n            bits_left = n_bits_left\n            cs = n_cs\n            clk = n_clk\n            spi_data = n_spi_data\n            done = n_done\n\n    return out\n"
