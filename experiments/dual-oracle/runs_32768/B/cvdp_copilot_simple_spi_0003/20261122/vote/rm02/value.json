"def reference(vectors):\n    state = 0\n    cs_b = 1\n    spi_clk = 0\n    spi_data = 0\n    bits_left = 16\n    done = 0\n    data_reg = 0\n    result = []\n    for idx, v in enumerate(vectors):\n        def get_int(key, default=0):\n            if not isinstance(v, dict):\n                return default\n            x = v.get(key, default)\n            if isinstance(x, str):\n                s = x.strip().lower()\n                if s in ('1', 'true', 'high'):\n                    return 1\n                if s in ('0', 'false', 'low'):\n                    return 0\n                try:\n                    return int(s, 0)\n                except:\n                    return default\n            try:\n                return int(x)\n            except:\n                return default\n        i_rst_b = get_int('i_rst_b', 1)\n        i_data_in = get_int('i_data_in', 0) & 0xFFFF\n        i_enable = get_int('i_enable', 0) & 1\n        i_fault = get_int('i_fault', 0) & 1\n        i_clear = get_int('i_clear', 0) & 1\n        is_pos = (idx % 2 == 0)\n        if isinstance(v, dict):\n            if 'edge' in v:\n                e = str(v['edge']).lower()\n                is_pos = ('pos' in e) or e in ('1', 'true')\n            elif 'i_clk' in v:\n                try:\n                    is_pos = int(v['i_clk']) == 1\n                except:\n                    is_pos = str(v['i_clk']).lower() in ('1', 'true', 'posedge')\n            elif 'clk' in v:\n                try:\n                    is_pos = int(v['clk']) == 1\n                except:\n                    is_pos = str(v['clk']).lower() in ('1', 'true', 'posedge')\n        if i_rst_b == 0:\n            state = 0\n            cs_b = 1\n            spi_clk = 0\n            spi_data = 0\n            bits_left = 16\n            done = 0\n            data_reg = 0\n        result.append({\n            'o_spi_cs_b': cs_b & 1,\n            'o_spi_clk': spi_clk & 1,\n            'o_spi_data': spi_data & 1,\n            'o_bits_left': bits_left & 0x1F,\n            'o_done': done & 1,\n            'o_fsm_state': state & 3\n        })\n        if is_pos and i_rst_b != 0:\n            if i_clear:\n                n_state = 0\n                n_cs = 1\n                n_clk = 0\n                n_data = 0\n                n_bits = 16\n                n_done = 0\n                n_data_reg = 0\n            elif i_enable == 0:\n                n_state = 0\n                n_cs = 1\n                n_clk = 0\n                n_data = 0\n                n_bits = 16\n                n_done = 0\n                n_data_reg = 0\n            elif i_fault:\n                if state != 3:\n                    n_state = 3\n                    n_cs = 1\n                    n_clk = 0\n                    n_data = 0\n                    n_bits = 16\n                    n_done = 1\n                    n_data_reg = 0\n                else:\n                    n_state = 3\n                    n_cs = 1\n                    n_clk = 0\n                    n_data = 0\n                    n_bits = 16\n                    n_done = 0\n                    n_data_reg = 0\n            else:\n                n_state = state\n                n_cs = cs_b\n                n_clk = spi_clk\n                n_data = spi_data\n                n_bits = bits_left\n                n_done = 0\n                n_data_reg = data_reg\n                if state == 0:\n                    n_cs = 1\n                    n_clk = 0\n                    n_data = 0\n                    n_bits = 16\n                    n_done = 0\n                    if i_enable:\n                        n_state = 1\n                        n_cs = 0\n                        n_data_reg = i_data_in\n                elif state == 1:\n                    n_cs = 0\n                    n_clk = 0\n                    n_data = (data_reg >> 15) & 1\n                    n_data_reg = (data_reg << 1) & 0xFFFF\n                    n_state = 2\n                elif state == 2:\n                    n_cs = 0\n                    n_clk = 1\n                    n_data = spi_data\n                    if bits_left > 0:\n                        n_bits = bits_left - 1\n                    else:\n                        n_bits = 0\n                    if bits_left == 1:\n                        n_done = 1\n                        n_state = 0\n                    else:\n                        n_done = 0\n                        n_state = 1\n                elif state == 3:\n                    n_cs = 1\n                    n_clk = 0\n                    n_data = 0\n                    n_bits = 16\n                    n_done = 0\n                    n_state = 3\n                    n_data_reg = 0\n                else:\n                    n_state = 0\n                    n_cs = 1\n                    n_clk = 0\n                    n_data = 0\n                    n_bits = 16\n                    n_done = 0\n                    n_data_reg = 0\n            state = n_state & 3\n            cs_b = n_cs & 1\n            spi_clk = n_clk & 1\n            spi_data = n_data & 1\n            bits_left = n_bits & 0x1F\n            done = n_done & 1\n            data_reg = n_data_reg & 0xFFFF\n    return result\n"
