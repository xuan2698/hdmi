"def reference(vectors):\n    state = 0          # 0: Idle, 1: Transmit, 2: Clock Toggle, 3: Error\n    cs_b = 1\n    spi_clk = 0\n    spi_data = 0\n    bits_left = 16\n    done = 0\n    shift_reg = 0\n\n    outputs = []\n\n    for i, row in enumerate(vectors):\n        rst = row.get('i_rst_b', 1)\n        data_in = row.get('i_data_in', 0) & 0xFFFF\n        enable = row.get('i_enable', 0)\n        fault = row.get('i_fault', 0)\n        clear = row.get('i_clear', 0)\n\n        # Asynchronous reset (active low)\n        if rst == 0:\n            state = 0\n            cs_b = 1\n            spi_clk = 0\n            spi_data = 0\n            bits_left = 16\n            done = 0\n            shift_reg = 0\n            outputs.append({\n                'o_spi_cs_b': cs_b,\n                'o_spi_clk': spi_clk,\n                'o_spi_data': spi_data,\n                'o_bits_left': bits_left,\n                'o_done': done,\n                'o_fsm_state': state\n            })\n            continue\n\n        # Output current register values before any synchronous update\n        outputs.append({\n            'o_spi_cs_b': cs_b,\n            'o_spi_clk': spi_clk,\n            'o_spi_data': spi_data,\n            'o_bits_left': bits_left,\n            'o_done': done,\n            'o_fsm_state': state\n        })\n\n        # Synchronous updates occur on posedge (even row indices)\n        if i % 2 == 0:\n            if state == 3:  # Error state\n                if clear == 1:\n                    state = 0\n                    cs_b = 1\n                    spi_clk = 0\n                    spi_data = 0\n                    bits_left = 16\n                    done = 0\n                    shift_reg = 0\n                else:\n                    state = 3\n                    cs_b = 1\n                    spi_clk = 0\n                    spi_data = 0\n                    bits_left = 16\n                    done = 0\n                    shift_reg = 0\n            else:\n                if clear == 1:\n                    state = 0\n                    cs_b = 1\n                    spi_clk = 0\n                    spi_data = 0\n                    bits_left = 16\n                    done = 0\n                    shift_reg = 0\n                elif fault == 1:\n                    state = 3\n                    cs_b = 1\n                    spi_clk = 0\n                    spi_data = 0\n                    bits_left = 16\n                    done = 1\n                    shift_reg = 0\n                elif enable == 0:\n                    state = 0\n                    cs_b = 1\n                    spi_clk = 0\n                    spi_data = 0\n                    bits_left = 16\n                    done = 0\n                    shift_reg = 0\n                else:\n                    if state == 0:  # Idle\n                        state = 1\n                        cs_b = 0\n                        shift_reg = data_in\n                        bits_left = 16\n                        spi_data = 0\n                        spi_clk = 0\n                        done = 0\n                    elif state == 1:  # Transmit\n                        spi_data = (shift_reg >> 15) & 1\n                        state = 2\n                        done = 0\n                    elif state == 2:  # Clock Toggle\n                        spi_clk = 1 - spi_clk\n                        if bits_left > 1:\n                            bits_left = bits_left - 1\n                            shift_reg = (shift_reg << 1) & 0xFFFF\n                            state = 1\n                            done = 0\n                            cs_b = 0\n                        else:\n                            bits_left = 16\n                            state = 0\n                            done = 1\n                            cs_b = 1\n                            spi_clk = 0\n                            spi_data = 0\n                            shift_reg = 0\n\n    return outputs\n"
