"def reference(vectors):\n    LINES = 8192\n    MASK32 = 0xFFFFFFFF\n    ADDR_MASK = LINES - 1\n\n    mem = [0] * LINES\n    addr_a_reg = en_a_reg = be_a_reg = data_in_a_reg = 0\n    addr_b_reg = en_b_reg = be_b_reg = data_in_b_reg = 0\n    data_out_a = data_out_b = 0\n\n    def getv(d, name, default=0):\n        if name in d:\n            return d[name]\n        low = name.lower()\n        for k, v in d.items():\n            if isinstance(k, str) and k.lower() == low:\n                return v\n        return default\n\n    def parse_edge(v):\n        if isinstance(v, str):\n            s = v.lower()\n            if \"pos\" in s or \"rise\" in s or s in (\"1\", \"true\", \"high\", \"up\"):\n                return True\n            if \"neg\" in s or \"fall\" in s or s in (\"0\", \"false\", \"low\", \"down\"):\n                return False\n            try:\n                return int(s) == 1\n            except Exception:\n                return False\n        try:\n            return int(v) == 1\n        except Exception:\n            return bool(v)\n\n    outs = []\n\n    for i, row in enumerate(vectors):\n        posedge = None\n\n        for k, v in row.items():\n            if isinstance(k, str) and k.lower() == \"edge\":\n                posedge = parse_edge(v)\n                break\n\n        if posedge is None:\n            for k, v in row.items():\n                if isinstance(k, str) and k.lower() in (\"clk\", \"clock\"):\n                    posedge = parse_edge(v)\n                    break\n\n        if posedge is None:\n            posedge = (i % 2 == 0)\n\n        outs.append({\n            \"data_out_a\": data_out_a & MASK32,\n            \"data_out_b\": data_out_b & MASK32,\n        })\n\n        if not posedge:\n            continue\n\n        new_out_a = mem[addr_a_reg & ADDR_MASK] & MASK32\n        new_out_b = mem[addr_b_reg & ADDR_MASK] & MASK32\n\n        enA = en_a_reg & 1\n        enB = en_b_reg & 1\n        aA = addr_a_reg & ADDR_MASK\n        aB = addr_b_reg & ADDR_MASK\n        beA = be_a_reg & 0xF\n        beB = be_b_reg & 0xF\n        dA = data_in_a_reg & MASK32\n        dB = data_in_b_reg & MASK32\n\n        if enA and enB and aA == aB:\n            v = mem[aA]\n            for j in range(4):\n                sh = 8 * j\n                bm = 0xFF << sh\n                if (beA >> j) & 1:\n                    b = (dA >> sh) & 0xFF\n                    v = (v & ~bm) | (b << sh)\n                elif (beB >> j) & 1:\n                    b = (dB >> sh) & 0xFF\n                    v = (v & ~bm) | (b << sh)\n            mem[aA] = v & MASK32\n        else:\n            if enA:\n                v = mem[aA]\n                for j in range(4):\n                    if (beA >> j) & 1:\n                        sh = 8 * j\n                        bm = 0xFF << sh\n                        b = (dA >> sh) & 0xFF\n                        v = (v & ~bm) | (b << sh)\n                mem[aA] = v & MASK32\n\n            if enB:\n                v = mem[aB]\n                for j in range(4):\n                    if (beB >> j) & 1:\n                        sh = 8 * j\n                        bm = 0xFF << sh\n                        b = (dB >> sh) & 0xFF\n                        v = (v & ~bm) | (b << sh)\n                mem[aB] = v & MASK32\n\n        addr_a_reg = int(getv(row, \"addr_a\", 0)) & ADDR_MASK\n        en_a_reg = int(getv(row, \"en_a\", 0)) & 1\n        be_a_reg = int(getv(row, \"be_a\", 0)) & 0xF\n        data_in_a_reg = int(getv(row, \"data_in_a\", 0)) & MASK32\n\n        addr_b_reg = int(getv(row, \"addr_b\", 0)) & ADDR_MASK\n        en_b_reg = int(getv(row, \"en_b\", 0)) & 1\n        be_b_reg = int(getv(row, \"be_b\", 0)) & 0xF\n        data_in_b_reg = int(getv(row, \"data_in_b\", 0)) & MASK32\n\n        data_out_a = new_out_a\n        data_out_b = new_out_b\n\n    return outs\n"
