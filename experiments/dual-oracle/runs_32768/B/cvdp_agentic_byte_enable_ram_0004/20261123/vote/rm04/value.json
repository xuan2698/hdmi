"def reference(vectors):\n    LINES = 8192\n    ADDR_MASK = 8191\n    ram = [0] * LINES\n\n    s1a_a = 0\n    s1a_e = 0\n    s1a_b = 0\n    s1a_d = 0\n    s1b_a = 0\n    s1b_e = 0\n    s1b_b = 0\n    s1b_d = 0\n\n    out_a = 0\n    out_b = 0\n    res = []\n    prev_clk = None\n\n    for idx, row in enumerate(vectors):\n        edge = None\n        if isinstance(row, dict):\n            if 'edge' in row:\n                v = row['edge']\n                if isinstance(v, str):\n                    lv = v.lower()\n                    if 'pos' in lv:\n                        edge = 'pos'\n                    elif 'neg' in lv:\n                        edge = 'neg'\n                else:\n                    edge = 'pos' if v else 'neg'\n            elif 'clk' in row:\n                curr = 1 if row['clk'] else 0\n                if prev_clk is None:\n                    edge = 'pos' if curr == 1 else 'neg'\n                else:\n                    if prev_clk == 0 and curr == 1:\n                        edge = 'pos'\n                    elif prev_clk == 1 and curr == 0:\n                        edge = 'neg'\n                prev_clk = curr\n            elif 'posedge' in row:\n                if row['posedge']:\n                    edge = 'pos'\n            elif 'negedge' in row:\n                if row['negedge']:\n                    edge = 'neg'\n\n        if edge is None:\n            edge = 'pos' if idx % 2 == 0 else 'neg'\n\n        res.append({'data_out_a': out_a, 'data_out_b': out_b})\n\n        if edge == 'pos':\n            if isinstance(row, dict):\n                addr_a = int(row.get('addr_a', 0)) & ADDR_MASK\n                en_a = 1 if row.get('en_a', 0) else 0\n                be_a = int(row.get('be_a', 0)) & 15\n                data_in_a = int(row.get('data_in_a', 0)) & 0xFFFFFFFF\n                addr_b = int(row.get('addr_b', 0)) & ADDR_MASK\n                en_b = 1 if row.get('en_b', 0) else 0\n                be_b = int(row.get('be_b', 0)) & 15\n                data_in_b = int(row.get('data_in_b', 0)) & 0xFFFFFFFF\n            else:\n                addr_a = int(row[0]) & ADDR_MASK\n                en_a = 1 if row[1] else 0\n                be_a = int(row[2]) & 15\n                data_in_a = int(row[3]) & 0xFFFFFFFF\n                addr_b = int(row[4]) & ADDR_MASK\n                en_b = 1 if row[5] else 0\n                be_b = int(row[6]) & 15\n                data_in_b = int(row[7]) & 0xFFFFFFFF\n\n            read_a = ram[s1a_a] if s1a_a < LINES else 0\n            read_b = ram[s1b_a] if s1b_a < LINES else 0\n\n            writes = {}\n            if s1a_e:\n                wa = s1a_a\n                if wa not in writes:\n                    writes[wa] = [None, None, None, None]\n                be = s1a_b\n                data = s1a_d\n                for i in range(4):\n                    if (be >> i) & 1:\n                        writes[wa][i] = (data >> (8 * i)) & 0xFF\n\n            if s1b_e:\n                wb = s1b_a\n                if wb not in writes:\n                    writes[wb] = [None, None, None, None]\n                be = s1b_b\n                data = s1b_d\n                for i in range(4):\n                    if (be >> i) & 1:\n                        if writes[wb][i] is None:\n                            writes[wb][i] = (data >> (8 * i)) & 0xFF\n\n            for wa, bv in writes.items():\n                if 0 <= wa < LINES:\n                    word = ram[wa]\n                    for i in range(4):\n                        val = bv[i]\n                        if val is not None:\n                            shift = 8 * i\n                            word = (word & ~(0xFF << shift)) | (val << shift)\n                    ram[wa] = word & 0xFFFFFFFF\n\n            out_a = read_a & 0xFFFFFFFF\n            out_b = read_b & 0xFFFFFFFF\n\n            s1a_a = addr_a\n            s1a_e = en_a\n            s1a_b = be_a\n            s1a_d = data_in_a\n            s1b_a = addr_b\n            s1b_e = en_b\n            s1b_b = be_b\n            s1b_d = data_in_b\n\n    return res\n"
