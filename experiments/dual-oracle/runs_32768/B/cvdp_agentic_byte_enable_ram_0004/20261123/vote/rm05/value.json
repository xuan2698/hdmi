"def reference(vectors):\n    mem = [0] * 8192\n    aa = ea = ba = da = 0\n    ab = eb = bb = db = 0\n    oa = ob = 0\n    res = []\n    prev_clk = 0\n    for i, row in enumerate(vectors):\n        def g(k, d=0):\n            if isinstance(row, dict):\n                return row.get(k, d)\n            return d\n        pos = None\n        if isinstance(row, dict) and 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                pos = e.lower().startswith('pos')\n            else:\n                pos = bool(e)\n        elif isinstance(row, dict) and 'clk' in row:\n            c = row['clk']\n            pos = (prev_clk == 0 and c == 1)\n            prev_clk = c\n        else:\n            pos = (i % 2 == 0)\n        res.append({'data_out_a': oa & 0xFFFFFFFF, 'data_out_b': ob & 0xFFFFFFFF})\n        if pos:\n            noa = mem[aa] & 0xFFFFFFFF\n            nob = mem[ab] & 0xFFFFFFFF\n            if ea and eb and aa == ab:\n                idx = aa\n                w = mem[idx]\n                for j in range(4):\n                    m = 0xFF << (8 * j)\n                    if (ba >> j) & 1:\n                        w = (w & (~m & 0xFFFFFFFF)) | (da & m)\n                    elif (bb >> j) & 1:\n                        w = (w & (~m & 0xFFFFFFFF)) | (db & m)\n                mem[idx] = w & 0xFFFFFFFF\n            else:\n                if ea:\n                    idx = aa\n                    w = mem[idx]\n                    for j in range(4):\n                        if (ba >> j) & 1:\n                            m = 0xFF << (8 * j)\n                            w = (w & (~m & 0xFFFFFFFF)) | (da & m)\n                    mem[idx] = w & 0xFFFFFFFF\n                if eb:\n                    idx = ab\n                    w = mem[idx]\n                    for j in range(4):\n                        if (bb >> j) & 1:\n                            m = 0xFF << (8 * j)\n                            w = (w & (~m & 0xFFFFFFFF)) | (db & m)\n                    mem[idx] = w & 0xFFFFFFFF\n            aa = g('addr_a') & 0x1FFF\n            ea = g('en_a') & 1\n            ba = g('be_a') & 0xF\n            da = g('data_in_a') & 0xFFFFFFFF\n            ab = g('addr_b') & 0x1FFF\n            eb = g('en_b') & 1\n            bb = g('be_b') & 0xF\n            db = g('data_in_b') & 0xFFFFFFFF\n            oa = noa\n            ob = nob\n    return res\n"
