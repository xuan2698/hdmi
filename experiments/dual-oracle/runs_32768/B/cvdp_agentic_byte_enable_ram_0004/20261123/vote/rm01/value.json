"def reference(vectors):\n    XLEN = 32\n    LINES = 8192\n    ADDR_MASK = LINES - 1\n    WORD_MASK = 0xffffffff\n    BE_MASK = 0xf\n\n    def num(v):\n        if isinstance(v, str):\n            return int(v, 0)\n        return int(v)\n\n    ram = [0] * LINES\n    a_addr = a_en = a_be = a_data = 0\n    b_addr = b_en = b_be = b_data = 0\n    outs = []\n    toggle = 1\n\n    for row in vectors:\n        if isinstance(row, dict):\n            if 'edge' in row:\n                e = row['edge']\n            elif 'clk' in row:\n                e = row['clk']\n            elif 'posedge' in row:\n                e = 'posedge' if row['posedge'] else 'negedge'\n            else:\n                e = None\n        else:\n            e = None\n\n        if e is None:\n            pos = (toggle == 1)\n        else:\n            if isinstance(e, str):\n                el = e.lower()\n                pos = el.startswith('pos') or el in ('1', 'p', 'true')\n            else:\n                pos = (e == 1)\n\n        outs.append({\n            'data_out_a': ram[a_addr & ADDR_MASK] & WORD_MASK,\n            'data_out_b': ram[b_addr & ADDR_MASK] & WORD_MASK\n        })\n\n        if pos:\n            def get(k, default=0):\n                if isinstance(row, dict):\n                    return row.get(k, default)\n                return default\n\n            ia = num(get('addr_a')) & ADDR_MASK\n            ie = 1 if get('en_a') else 0\n            ibe = num(get('be_a')) & BE_MASK\n            ida = num(get('data_in_a')) & WORD_MASK\n\n            ja = num(get('addr_b')) & ADDR_MASK\n            je = 1 if get('en_b') else 0\n            jbe = num(get('be_b')) & BE_MASK\n            jdb = num(get('data_in_b')) & WORD_MASK\n\n            if a_en and b_en and a_addr == b_addr:\n                idx = a_addr & ADDR_MASK\n                old = ram[idx]\n                new = old\n                for i in range(4):\n                    sh = i * 8\n                    m = 0xff << sh\n                    if (a_be >> i) & 1:\n                        v = (a_data >> sh) & 0xff\n                        new = (new & ~m) | (v << sh)\n                    elif (b_be >> i) & 1:\n                        v = (b_data >> sh) & 0xff\n                        new = (new & ~m) | (v << sh)\n                ram[idx] = new & WORD_MASK\n            else:\n                if a_en:\n                    idx = a_addr & ADDR_MASK\n                    new = ram[idx]\n                    for i in range(4):\n                        if (a_be >> i) & 1:\n                            sh = i * 8\n                            v = (a_data >> sh) & 0xff\n                            new = (new & ~(0xff << sh)) | (v << sh)\n                    ram[idx] = new & WORD_MASK\n                if b_en:\n                    idx = b_addr & ADDR_MASK\n                    new = ram[idx]\n                    for i in range(4):\n                        if (b_be >> i) & 1:\n                            sh = i * 8\n                            v = (b_data >> sh) & 0xff\n                            new = (new & ~(0xff << sh)) | (v << sh)\n                    ram[idx] = new & WORD_MASK\n\n            a_addr, a_en, a_be, a_data = ia, ie, ibe, ida\n            b_addr, b_en, b_be, b_data = ja, je, jbe, jdb\n\n        if e is None:\n            toggle = 0 if pos else 1\n\n    return outs\n"
