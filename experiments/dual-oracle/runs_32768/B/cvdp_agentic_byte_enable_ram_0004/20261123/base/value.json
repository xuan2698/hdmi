"def reference(vectors):\n    LINES = 8192\n    MASK32 = (1 << 32) - 1\n    MASK_ADDR = LINES - 1\n    ram = [0] * LINES\n    aar = abr = 0\n    aer = ber = 0\n    abe = bbe = 0\n    adr = bdr = 0\n    results = []\n    for i, row in enumerate(vectors):\n        addr_a = row.get('addr_a', 0) & MASK_ADDR\n        en_a = row.get('en_a', 0) & 1\n        be_a = row.get('be_a', 0) & 0xF\n        data_in_a = row.get('data_in_a', 0) & MASK32\n        addr_b = row.get('addr_b', 0) & MASK_ADDR\n        en_b = row.get('en_b', 0) & 1\n        be_b = row.get('be_b', 0) & 0xF\n        data_in_b = row.get('data_in_b', 0) & MASK32\n\n        results.append({\n            'data_out_a': ram[aar] & MASK32,\n            'data_out_b': ram[abr] & MASK32\n        })\n\n        edge = row.get('edge', None)\n        if edge is None:\n            edge = row.get('clk', None)\n        if edge is None:\n            posedge = (i % 2 == 0)\n        else:\n            if isinstance(edge, str):\n                e = edge.lower()\n                posedge = e in ('posedge', 'pos', 'rising', '1', 'true')\n            else:\n                posedge = bool(edge)\n\n        if posedge:\n            if aer and ber and aar == abr:\n                for byte in range(4):\n                    bit = 1 << byte\n                    sh = 8 * byte\n                    mask = 0xFF << sh\n                    if abe & bit:\n                        val = (adr >> sh) & 0xFF\n                        ram[aar] = (ram[aar] & (MASK32 ^ mask)) | (val << sh)\n                    elif bbe & bit:\n                        val = (bdr >> sh) & 0xFF\n                        ram[aar] = (ram[aar] & (MASK32 ^ mask)) | (val << sh)\n            else:\n                if aer:\n                    for byte in range(4):\n                        bit = 1 << byte\n                        sh = 8 * byte\n                        if abe & bit:\n                            mask = 0xFF << sh\n                            val = (adr >> sh) & 0xFF\n                            ram[aar] = (ram[aar] & (MASK32 ^ mask)) | (val << sh)\n                if ber:\n                    for byte in range(4):\n                        bit = 1 << byte\n                        sh = 8 * byte\n                        if bbe & bit:\n                            mask = 0xFF << sh\n                            val = (bdr >> sh) & 0xFF\n                            ram[abr] = (ram[abr] & (MASK32 ^ mask)) | (val << sh)\n\n            aar = addr_a\n            aer = en_a\n            abe = be_a\n            adr = data_in_a\n            abr = addr_b\n            ber = en_b\n            bbe = be_b\n            bdr = data_in_b\n\n    return results\n"
