"def reference(vectors):\n    ram = [0] * 8192\n    addr_a_reg = 0\n    en_a_reg = 0\n    be_a_reg = 0\n    data_in_a_reg = 0\n    addr_b_reg = 0\n    en_b_reg = 0\n    be_b_reg = 0\n    data_in_b_reg = 0\n    data_out_a = 0\n    data_out_b = 0\n    cur = {\n        'addr_a': 0, 'en_a': 0, 'be_a': 0, 'data_in_a': 0,\n        'addr_b': 0, 'en_b': 0, 'be_b': 0, 'data_in_b': 0\n    }\n    inputs = list(cur.keys())\n    results = []\n    for row in vectors:\n        for k in inputs:\n            if k in row:\n                cur[k] = row[k]\n        e = row.get('edge', None)\n        if e is None:\n            pos = bool(row.get('clk', 0))\n        elif isinstance(e, str):\n            el = e.lower()\n            pos = el.startswith('p') or el in ('1', 'true', 'rise', 'rising', 'pos')\n        else:\n            pos = bool(e)\n        results.append({\n            'data_out_a': data_out_a & 0xFFFFFFFF,\n            'data_out_b': data_out_b & 0xFFFFFFFF\n        })\n        if not pos:\n            continue\n        out_a_new = ram[addr_a_reg & 0x1FFF]\n        out_b_new = ram[addr_b_reg & 0x1FFF]\n        if en_a_reg and en_b_reg and ((addr_a_reg & 0x1FFF) == (addr_b_reg & 0x1FFF)):\n            a = addr_a_reg & 0x1FFF\n            w = ram[a]\n            for i in range(4):\n                sh = 8 * i\n                m = 0xFF << sh\n                if (be_a_reg >> i) & 1:\n                    val = (data_in_a_reg >> sh) & 0xFF\n                    w = (w & ~m) | (val << sh)\n                elif (be_b_reg >> i) & 1:\n                    val = (data_in_b_reg >> sh) & 0xFF\n                    w = (w & ~m) | (val << sh)\n            ram[a] = w & 0xFFFFFFFF\n        else:\n            if en_a_reg:\n                a = addr_a_reg & 0x1FFF\n                w = ram[a]\n                for i in range(4):\n                    if (be_a_reg >> i) & 1:\n                        sh = 8 * i\n                        m = 0xFF << sh\n                        val = (data_in_a_reg >> sh) & 0xFF\n                        w = (w & ~m) | (val << sh)\n                ram[a] = w & 0xFFFFFFFF\n            if en_b_reg:\n                a = addr_b_reg & 0x1FFF\n                w = ram[a]\n                for i in range(4):\n                    if (be_b_reg >> i) & 1:\n                        sh = 8 * i\n                        m = 0xFF << sh\n                        val = (data_in_b_reg >> sh) & 0xFF\n                        w = (w & ~m) | (val << sh)\n                ram[a] = w & 0xFFFFFFFF\n        data_out_a = out_a_new & 0xFFFFFFFF\n        data_out_b = out_b_new & 0xFFFFFFFF\n        addr_a_reg = cur['addr_a'] & 0x1FFF\n        en_a_reg = cur['en_a'] & 1\n        be_a_reg = cur['be_a'] & 0xF\n        data_in_a_reg = cur['data_in_a'] & 0xFFFFFFFF\n        addr_b_reg = cur['addr_b'] & 0x1FFF\n        en_b_reg = cur['en_b'] & 1\n        be_b_reg = cur['be_b'] & 0xF\n        data_in_b_reg = cur['data_in_b'] & 0xFFFFFFFF\n    return results\n"
