"def reference(vectors):\n    ram = [0] * 8192\n    sa = sb = 0\n    sea = seb = 0\n    sba = sbb = 0\n    sda = sdb = 0\n    ca = cb = 0\n    cea = ceb = 0\n    cba = cbb = 0\n    cda = cdb = 0\n    oa = ob = 0\n    res = []\n    prev_clk = None\n    idx = 0\n\n    for row in vectors:\n        ca = row.get('addr_a', ca) & 8191\n        cb = row.get('addr_b', cb) & 8191\n        cea = row.get('en_a', cea) & 1\n        ceb = row.get('en_b', ceb) & 1\n        cba = row.get('be_a', cba) & 15\n        cbb = row.get('be_b', cbb) & 15\n        cda = row.get('data_in_a', cda) & 0xffffffff\n        cdb = row.get('data_in_b', cdb) & 0xffffffff\n\n        e = row.get('edge', None)\n        c = row.get('clk', None)\n\n        if e is not None:\n            if isinstance(e, str):\n                es = e.lower()\n                is_pos = es.startswith('pos') or es in ('1', 'rise', 'rising')\n            else:\n                is_pos = (e == 1 or e is True)\n            if c is not None:\n                prev_clk = c & 1\n        elif c is not None:\n            c = c & 1\n            if prev_clk is None:\n                is_pos = (c == 1)\n            else:\n                is_pos = (prev_clk == 0 and c == 1)\n            prev_clk = c\n        else:\n            p = row.get('posedge', None)\n            if p is not None:\n                is_pos = bool(p)\n            else:\n                is_pos = (idx % 2 == 0)\n\n        res.append({'data_out_a': oa & 0xffffffff, 'data_out_b': ob & 0xffffffff})\n\n        if is_pos:\n            noa = ram[sa] & 0xffffffff\n            nob = ram[sb] & 0xffffffff\n\n            if sea and seb and sa == sb:\n                val = ram[sa] & 0xffffffff\n                for i in range(4):\n                    sh = i * 8\n                    mask = 255 << sh\n                    if (sba >> i) & 1:\n                        val = (val & ~mask) | (((sda >> sh) & 255) << sh)\n                    elif (sbb >> i) & 1:\n                        val = (val & ~mask) | (((sdb >> sh) & 255) << sh)\n                ram[sa] = val & 0xffffffff\n            else:\n                if sea:\n                    val = ram[sa] & 0xffffffff\n                    for i in range(4):\n                        sh = i * 8\n                        mask = 255 << sh\n                        if (sba >> i) & 1:\n                            val = (val & ~mask) | (((sda >> sh) & 255) << sh)\n                    ram[sa] = val & 0xffffffff\n\n                if seb:\n                    val = ram[sb] & 0xffffffff\n                    for i in range(4):\n                        sh = i * 8\n                        mask = 255 << sh\n                        if (sbb >> i) & 1:\n                            val = (val & ~mask) | (((sdb >> sh) & 255) << sh)\n                    ram[sb] = val & 0xffffffff\n\n            sa = ca\n            sb = cb\n            sea = cea\n            seb = ceb\n            sba = cba\n            sbb = cbb\n            sda = cda\n            sdb = cdb\n            oa = noa\n            ob = nob\n\n        idx += 1\n\n    return res\n"
