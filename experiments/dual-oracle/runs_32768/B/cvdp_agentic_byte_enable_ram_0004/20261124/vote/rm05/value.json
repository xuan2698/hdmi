"def reference(vectors):\n    ram = [0] * 8192\n    ra = rb = 0\n    ea = eb = 0\n    ba = bb = 0\n    da = db = 0\n    oa = ob = 0\n    prev_clk = None\n    out = []\n\n    def val(r, k):\n        if isinstance(r, dict):\n            if k in r:\n                return int(r[k])\n            ku = k.upper()\n            if ku in r:\n                return int(r[ku])\n        return 0\n\n    for i, r in enumerate(vectors):\n        pos = None\n        if isinstance(r, dict):\n            e = None\n            for ek in ('edge', 'Edge', 'EDGE'):\n                if ek in r:\n                    e = r[ek]\n                    break\n            if e is not None:\n                if isinstance(e, str):\n                    el = e.lower()\n                    pos = el.startswith('p') or el == '1' or el == 'true'\n                else:\n                    pos = bool(e)\n            else:\n                for pk in ('posedge', 'POSEDGE'):\n                    if pk in r:\n                        pos = bool(r[pk])\n                        break\n                if pos is None:\n                    for nk in ('negedge', 'NEGEDGE'):\n                        if nk in r:\n                            pos = not bool(r[nk])\n                            break\n\n        if pos is None:\n            if isinstance(r, dict) and ('clk' in r or 'CLK' in r):\n                c = r.get('clk', r.get('CLK'))\n                c = 1 if c else 0\n                if prev_clk is None:\n                    pos = (c == 1)\n                else:\n                    pos = (prev_clk == 0 and c == 1)\n                prev_clk = c\n            else:\n                pos = (i % 2 == 0)\n\n        if pos:\n            out.append({'data_out_a': oa & 0xffffffff, 'data_out_b': ob & 0xffffffff})\n\n            ca = val(r, 'addr_a') & 0x1fff\n            cea = 1 if val(r, 'en_a') else 0\n            cba = val(r, 'be_a') & 0xf\n            cda = val(r, 'data_in_a') & 0xffffffff\n            cb = val(r, 'addr_b') & 0x1fff\n            ceb = 1 if val(r, 'en_b') else 0\n            cbb = val(r, 'be_b') & 0xf\n            cdb = val(r, 'data_in_b') & 0xffffffff\n\n            noa = ram[ra & 0x1fff] & 0xffffffff\n            nob = ram[rb & 0x1fff] & 0xffffffff\n\n            if ea and eb and ((ra & 0x1fff) == (rb & 0x1fff)):\n                idx = ra & 0x1fff\n                nv = ram[idx]\n                for j in range(4):\n                    if (ba >> j) & 1:\n                        mask = 0xff << (8 * j)\n                        nv = (nv & ~mask) | (((da >> (8 * j)) & 0xff) << (8 * j))\n                    elif (bb >> j) & 1:\n                        mask = 0xff << (8 * j)\n                        nv = (nv & ~mask) | (((db >> (8 * j)) & 0xff) << (8 * j))\n                ram[idx] = nv & 0xffffffff\n            else:\n                if ea:\n                    idx = ra & 0x1fff\n                    nv = ram[idx]\n                    for j in range(4):\n                        if (ba >> j) & 1:\n                            mask = 0xff << (8 * j)\n                            nv = (nv & ~mask) | (((da >> (8 * j)) & 0xff) << (8 * j))\n                    ram[idx] = nv & 0xffffffff\n                if eb:\n                    idx = rb & 0x1fff\n                    nv = ram[idx]\n                    for j in range(4):\n                        if (bb >> j) & 1:\n                            mask = 0xff << (8 * j)\n                            nv = (nv & ~mask) | (((db >> (8 * j)) & 0xff) << (8 * j))\n                    ram[idx] = nv & 0xffffffff\n\n            ra, ea, ba, da = ca, cea, cba, cda\n            rb, eb, bb, db = cb, ceb, cbb, cdb\n            oa, ob = noa, nob\n        else:\n            out.append({'data_out_a': oa & 0xffffffff, 'data_out_b': ob & 0xffffffff})\n\n    return out\n"
