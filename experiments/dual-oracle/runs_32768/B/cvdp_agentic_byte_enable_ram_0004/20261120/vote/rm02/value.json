"def reference(vectors):\n    MASK = 0xFFFFFFFF\n    LINES = 8192\n    AMASK = LINES - 1\n    mem = [0] * LINES\n\n    st_addr_a = 0\n    st_en_a = 0\n    st_be_a = 0\n    st_data_a = 0\n    st_addr_b = 0\n    st_en_b = 0\n    st_be_b = 0\n    st_data_b = 0\n\n    latest_addr_a = 0\n    latest_en_a = 0\n    latest_be_a = 0\n    latest_data_a = 0\n    latest_addr_b = 0\n    latest_en_b = 0\n    latest_be_b = 0\n    latest_data_b = 0\n\n    out_a = 0\n    out_b = 0\n    outs = []\n    prev_clk = None\n\n    def vi(v):\n        if isinstance(v, str):\n            s = v.lower()\n            if 'pos' in s:\n                return 1\n            if 'neg' in s:\n                return 0\n            try:\n                return int(v, 0)\n            except:\n                return int(v)\n        return int(v)\n\n    for row in vectors:\n        if 'addr_a' in row:\n            latest_addr_a = vi(row['addr_a']) & AMASK\n        if 'en_a' in row:\n            latest_en_a = vi(row['en_a']) & 1\n        if 'be_a' in row:\n            latest_be_a = vi(row['be_a']) & 0xF\n        if 'data_in_a' in row:\n            latest_data_a = vi(row['data_in_a']) & MASK\n        if 'addr_b' in row:\n            latest_addr_b = vi(row['addr_b']) & AMASK\n        if 'en_b' in row:\n            latest_en_b = vi(row['en_b']) & 1\n        if 'be_b' in row:\n            latest_be_b = vi(row['be_b']) & 0xF\n        if 'data_in_b' in row:\n            latest_data_b = vi(row['data_in_b']) & MASK\n\n        pos = False\n        if 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                s = e.lower()\n                pos = ('pos' in s) or s == '1' or s == 'true'\n            else:\n                pos = bool(vi(e))\n        else:\n            cval = None\n            if 'clk' in row:\n                cval = row['clk']\n            elif 'CLK' in row:\n                cval = row['CLK']\n\n            if cval is not None:\n                if isinstance(cval, str) and ('pos' in cval.lower() or 'neg' in cval.lower()):\n                    pos = 'pos' in cval.lower()\n                    c = 1 if pos else 0\n                else:\n                    c = vi(cval) & 1\n                    pos = (c == 1 and prev_clk != 1)\n                prev_clk = c\n            else:\n                pos = (prev_clk is None or prev_clk == 0)\n                prev_clk = 1 if pos else 0\n\n        outs.append({'data_out_a': out_a & MASK, 'data_out_b': out_b & MASK})\n\n        if pos:\n            a_addr = st_addr_a\n            b_addr = st_addr_b\n            read_a = mem[a_addr] if 0 <= a_addr < LINES else 0\n            read_b = mem[b_addr] if 0 <= b_addr < LINES else 0\n\n            if st_en_a and st_en_b and a_addr == b_addr and 0 <= a_addr < LINES:\n                old = mem[a_addr]\n                new = old\n                for i in range(4):\n                    sh = i * 8\n                    bm = 1 << i\n                    clear = MASK ^ (0xFF << sh)\n                    if st_be_a & bm:\n                        new = (new & clear) | (((st_data_a >> sh) & 0xFF) << sh)\n                    elif st_be_b & bm:\n                        new = (new & clear) | (((st_data_b >> sh) & 0xFF) << sh)\n                mem[a_addr] = new & MASK\n            else:\n                if st_en_a and 0 <= a_addr < LINES:\n                    old = mem[a_addr]\n                    new = old\n                    for i in range(4):\n                        sh = i * 8\n                        bm = 1 << i\n                        if st_be_a & bm:\n                            clear = MASK ^ (0xFF << sh)\n                            new = (new & clear) | (((st_data_a >> sh) & 0xFF) << sh)\n                    mem[a_addr] = new & MASK\n\n                if st_en_b and 0 <= b_addr < LINES:\n                    old = mem[b_addr]\n                    new = old\n                    for i in range(4):\n                        sh = i * 8\n                        bm = 1 << i\n                        if st_be_b & bm:\n                            clear = MASK ^ (0xFF << sh)\n                            new = (new & clear) | (((st_data_b >> sh) & 0xFF) << sh)\n                    mem[b_addr] = new & MASK\n\n            out_a = read_a & MASK\n            out_b = read_b & MASK\n\n            st_addr_a = latest_addr_a\n            st_en_a = latest_en_a\n            st_be_a = latest_be_a\n            st_data_a = latest_data_a\n            st_addr_b = latest_addr_b\n            st_en_b = latest_en_b\n            st_be_b = latest_be_b\n            st_data_b = latest_data_b\n\n    return outs\n"
