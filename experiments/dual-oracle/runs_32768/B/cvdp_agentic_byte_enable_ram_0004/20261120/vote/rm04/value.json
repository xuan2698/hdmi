"def reference(vectors):\n    LINES = 8192\n    MASK = 0xFFFFFFFF\n    ADDR_MASK = LINES - 1\n    ram = [0] * LINES\n    sa = 0\n    sea = 0\n    sba = 0\n    sda = 0\n    sb = 0\n    seb = 0\n    sbb = 0\n    sdb = 0\n    oa = 0\n    ob = 0\n    inp = {\n        'addr_a': 0, 'en_a': 0, 'be_a': 0, 'data_in_a': 0,\n        'addr_b': 0, 'en_b': 0, 'be_b': 0, 'data_in_b': 0\n    }\n    res = []\n    for idx, row in enumerate(vectors):\n        for k in inp:\n            if k in row:\n                inp[k] = row[k]\n\n        is_pos = None\n        if 'edge' in row:\n            ev = row['edge']\n            if ev in (1, 'posedge', 'pos', 'rise', 'rising', True, '1'):\n                is_pos = True\n            elif ev in (0, -1, 'negedge', 'neg', 'fall', 'falling', False, '0'):\n                is_pos = False\n        if is_pos is None and 'clk' in row:\n            cv = row['clk']\n            if cv in (0, 1, False, True):\n                is_pos = bool(cv)\n        if is_pos is None:\n            is_pos = (idx % 2 == 0)\n\n        res.append({'data_out_a': oa & MASK, 'data_out_b': ob & MASK})\n\n        if is_pos:\n            a_en = sea & 1\n            b_en = seb & 1\n            a_addr = sa & ADDR_MASK\n            b_addr = sb & ADDR_MASK\n            a_be = sba & 0xF\n            b_be = sbb & 0xF\n\n            ra = ram[a_addr]\n            rb = ram[b_addr]\n\n            if a_en and b_en and (a_addr == b_addr):\n                word = ram[a_addr]\n                for i in range(4):\n                    shift = i * 8\n                    bit = 1 << i\n                    if a_be & bit:\n                        val = (sda >> shift) & 0xFF\n                        word = (word & ~(0xFF << shift)) | (val << shift)\n                    elif b_be & bit:\n                        val = (sdb >> shift) & 0xFF\n                        word = (word & ~(0xFF << shift)) | (val << shift)\n                ram[a_addr] = word & MASK\n            else:\n                if a_en:\n                    word = ram[a_addr]\n                    for i in range(4):\n                        shift = i * 8\n                        if a_be & (1 << i):\n                            val = (sda >> shift) & 0xFF\n                            word = (word & ~(0xFF << shift)) | (val << shift)\n                    ram[a_addr] = word & MASK\n                if b_en:\n                    word = ram[b_addr]\n                    for i in range(4):\n                        shift = i * 8\n                        if b_be & (1 << i):\n                            val = (sdb >> shift) & 0xFF\n                            word = (word & ~(0xFF << shift)) | (val << shift)\n                    ram[b_addr] = word & MASK\n\n            oa = ra & MASK\n            ob = rb & MASK\n\n            sa = inp['addr_a'] & ADDR_MASK\n            sea = inp['en_a'] & 1\n            sba = inp['be_a'] & 0xF\n            sda = inp['data_in_a'] & MASK\n            sb = inp['addr_b'] & ADDR_MASK\n            seb = inp['en_b'] & 1\n            sbb = inp['be_b'] & 0xF\n            sdb = inp['data_in_b'] & MASK\n\n    return res\n"
