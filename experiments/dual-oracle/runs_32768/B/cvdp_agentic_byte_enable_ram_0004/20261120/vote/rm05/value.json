"def reference(vectors):\n    LINES = 8192\n    MASK32 = 0xFFFFFFFF\n    ram = [0] * LINES\n    a_addr = 0\n    a_en = 0\n    a_be = 0\n    a_data = 0\n    b_addr = 0\n    b_en = 0\n    b_be = 0\n    b_data = 0\n    out_a = 0\n    out_b = 0\n    res = []\n    for idx, row in enumerate(vectors):\n        clk = None\n        if isinstance(row, dict):\n            addr_a = int(row.get('addr_a', 0))\n            en_a = int(row.get('en_a', 0))\n            be_a = int(row.get('be_a', 0))\n            data_in_a = int(row.get('data_in_a', 0))\n            addr_b = int(row.get('addr_b', 0))\n            en_b = int(row.get('en_b', 0))\n            be_b = int(row.get('be_b', 0))\n            data_in_b = int(row.get('data_in_b', 0))\n            if 'clk' in row:\n                clk = int(row['clk'])\n        else:\n            try:\n                addr_a = int(row.addr_a)\n                en_a = int(row.en_a)\n                be_a = int(row.be_a)\n                data_in_a = int(row.data_in_a)\n                addr_b = int(row.addr_b)\n                en_b = int(row.en_b)\n                be_b = int(row.be_b)\n                data_in_b = int(row.data_in_b)\n                clk = int(row.clk) if hasattr(row, 'clk') else None\n            except Exception:\n                try:\n                    L = len(row)\n                except Exception:\n                    L = 0\n                if L == 9:\n                    clk = int(row[0])\n                    addr_a = int(row[1])\n                    en_a = int(row[2])\n                    be_a = int(row[3])\n                    data_in_a = int(row[4])\n                    addr_b = int(row[5])\n                    en_b = int(row[6])\n                    be_b = int(row[7])\n                    data_in_b = int(row[8])\n                elif L == 8:\n                    clk = None\n                    addr_a = int(row[0])\n                    en_a = int(row[1])\n                    be_a = int(row[2])\n                    data_in_a = int(row[3])\n                    addr_b = int(row[4])\n                    en_b = int(row[5])\n                    be_b = int(row[6])\n                    data_in_b = int(row[7])\n                else:\n                    clk = None\n                    addr_a = en_a = be_a = data_in_a = addr_b = en_b = be_b = data_in_b = 0\n        addr_a &= 0x1FFF\n        en_a &= 1\n        be_a &= 0xF\n        data_in_a &= MASK32\n        addr_b &= 0x1FFF\n        en_b &= 1\n        be_b &= 0xF\n        data_in_b &= MASK32\n        if clk is None:\n            posedge = (idx % 2 == 0)\n        else:\n            posedge = (clk == 1)\n        res.append({'data_out_a': out_a & MASK32, 'data_out_b': out_b & MASK32})\n        if not posedge:\n            continue\n        read_a = ram[a_addr] if a_addr < LINES else 0\n        read_b = ram[b_addr] if b_addr < LINES else 0\n        if a_en and b_en and (a_addr == b_addr):\n            addr = a_addr\n            if 0 <= addr < LINES:\n                old_word = ram[addr]\n                new_word = old_word\n                for i in range(4):\n                    shift = 8 * i\n                    mask = 0xFF << shift\n                    if a_be & (1 << i):\n                        byte_val = (a_data >> shift) & 0xFF\n                        new_word = (new_word & ~mask) | (byte_val << shift)\n                    elif b_be & (1 << i):\n                        byte_val = (b_data >> shift) & 0xFF\n                        new_word = (new_word & ~mask) | (byte_val << shift)\n                ram[addr] = new_word & MASK32\n        else:\n            if a_en and 0 <= a_addr < LINES:\n                old_word = ram[a_addr]\n                new_word = old_word\n                for i in range(4):\n                    if a_be & (1 << i):\n                        shift = 8 * i\n                        mask = 0xFF << shift\n                        byte_val = (a_data >> shift) & 0xFF\n                        new_word = (new_word & ~mask) | (byte_val << shift)\n                ram[a_addr] = new_word & MASK32\n            if b_en and 0 <= b_addr < LINES:\n                old_word = ram[b_addr]\n                new_word = old_word\n                for i in range(4):\n                    if b_be & (1 << i):\n                        shift = 8 * i\n                        mask = 0xFF << shift\n                        byte_val = (b_data >> shift) & 0xFF\n                        new_word = (new_word & ~mask) | (byte_val << shift)\n                ram[b_addr] = new_word & MASK32\n        a_addr = addr_a\n        a_en = en_a\n        a_be = be_a\n        a_data = data_in_a\n        b_addr = addr_b\n        b_en = en_b\n        b_be = be_b\n        b_data = data_in_b\n        out_a = read_a & MASK32\n        out_b = read_b & MASK32\n    return res\n"
