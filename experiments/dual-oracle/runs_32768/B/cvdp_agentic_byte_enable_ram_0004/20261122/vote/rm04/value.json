"def reference(vectors):\n    MASK_ADDR = 8191\n    MASK32 = 0xFFFFFFFF\n    ram = [0] * 8192\n\n    ar = br = 0\n    ena = enb = 0\n    bea = beb = 0\n    da = db = 0\n\n    ca = cb = 0\n    cena = cenb = 0\n    cbea = cbeb = 0\n    cda = cdb = 0\n\n    outs = []\n\n    for i, row in enumerate(vectors):\n        if 'addr_a' in row:\n            ca = row['addr_a'] & MASK_ADDR\n        if 'en_a' in row:\n            cena = row['en_a'] & 1\n        if 'be_a' in row:\n            cbea = row['be_a'] & 0xF\n        if 'data_in_a' in row:\n            cda = row['data_in_a'] & MASK32\n\n        if 'addr_b' in row:\n            cb = row['addr_b'] & MASK_ADDR\n        if 'en_b' in row:\n            cenb = row['en_b'] & 1\n        if 'be_b' in row:\n            cbeb = row['be_b'] & 0xF\n        if 'data_in_b' in row:\n            cdb = row['data_in_b'] & MASK32\n\n        ev = row.get('edge', row.get('Edge', None))\n        if ev is None:\n            pos = (i % 2 == 0)\n        else:\n            if isinstance(ev, str):\n                s = ev.lower()\n                if 'pos' in s:\n                    pos = True\n                elif 'neg' in s:\n                    pos = False\n                else:\n                    pos = (i % 2 == 0)\n            else:\n                pos = bool(ev)\n\n        outs.append({\n            'data_out_a': ram[ar & MASK_ADDR] & MASK32,\n            'data_out_b': ram[br & MASK_ADDR] & MASK32\n        })\n\n        if pos:\n            if ena and enb and ar == br:\n                a_addr = ar & MASK_ADDR\n                word = ram[a_addr]\n                for b in range(4):\n                    sh = b * 8\n                    if (bea >> b) & 1:\n                        word = (word & ~(0xFF << sh)) | (((da >> sh) & 0xFF) << sh)\n                    elif (beb >> b) & 1:\n                        word = (word & ~(0xFF << sh)) | (((db >> sh) & 0xFF) << sh)\n                ram[a_addr] = word & MASK32\n            else:\n                if ena:\n                    a_addr = ar & MASK_ADDR\n                    word = ram[a_addr]\n                    for b in range(4):\n                        if (bea >> b) & 1:\n                            sh = b * 8\n                            word = (word & ~(0xFF << sh)) | (((da >> sh) & 0xFF) << sh)\n                    ram[a_addr] = word & MASK32\n\n                if enb:\n                    b_addr = br & MASK_ADDR\n                    word = ram[b_addr]\n                    for b in range(4):\n                        if (beb >> b) & 1:\n                            sh = b * 8\n                            word = (word & ~(0xFF << sh)) | (((db >> sh) & 0xFF) << sh)\n                    ram[b_addr] = word & MASK32\n\n            ar, br = ca, cb\n            ena, enb = cena, cenb\n            bea, beb = cbea, cbeb\n            da, db = cda, cdb\n\n    return outs\n"
