"def reference(vectors):\n    ram = {}\n    MASK = 0xFFFFFFFF\n    AMASK = 8191\n    a_addr_r = b_addr_r = 0\n    a_en_r = b_en_r = 0\n    a_be_r = b_be_r = 0\n    a_din_r = b_din_r = 0\n    a_out = b_out = 0\n    res = []\n    for i, r in enumerate(vectors):\n        res.append({'data_out_a': a_out & MASK, 'data_out_b': b_out & MASK})\n        if i % 2 == 0:\n            read_a = ram.get(a_addr_r, 0)\n            read_b = ram.get(b_addr_r, 0)\n            if a_en_r and b_en_r and a_addr_r == b_addr_r:\n                addr = a_addr_r\n                base = ram.get(addr, 0)\n                nw = base\n                for j in range(4):\n                    sh = j * 8\n                    if (a_be_r >> j) & 1:\n                        nw = (nw & ~(0xFF << sh)) | (((a_din_r >> sh) & 0xFF) << sh)\n                    elif (b_be_r >> j) & 1:\n                        nw = (nw & ~(0xFF << sh)) | (((b_din_r >> sh) & 0xFF) << sh)\n                if a_be_r or b_be_r:\n                    ram[addr] = nw & MASK\n            else:\n                if a_en_r:\n                    addr = a_addr_r\n                    base = ram.get(addr, 0)\n                    nw = base\n                    for j in range(4):\n                        if (a_be_r >> j) & 1:\n                            sh = j * 8\n                            nw = (nw & ~(0xFF << sh)) | (((a_din_r >> sh) & 0xFF) << sh)\n                    if a_be_r:\n                        ram[addr] = nw & MASK\n                if b_en_r:\n                    addr = b_addr_r\n                    base = ram.get(addr, 0)\n                    nw = base\n                    for j in range(4):\n                        if (b_be_r >> j) & 1:\n                            sh = j * 8\n                            nw = (nw & ~(0xFF << sh)) | (((b_din_r >> sh) & 0xFF) << sh)\n                    if b_be_r:\n                        ram[addr] = nw & MASK\n            a_out = read_a & MASK\n            b_out = read_b & MASK\n            a_addr_r = r.get('addr_a', a_addr_r) & AMASK\n            a_en_r = r.get('en_a', a_en_r) & 1\n            a_be_r = r.get('be_a', a_be_r) & 0xF\n            a_din_r = r.get('data_in_a', a_din_r) & MASK\n            b_addr_r = r.get('addr_b', b_addr_r) & AMASK\n            b_en_r = r.get('en_b', b_en_r) & 1\n            b_be_r = r.get('be_b', b_be_r) & 0xF\n            b_din_r = r.get('data_in_b', b_din_r) & MASK\n    return res\n"
