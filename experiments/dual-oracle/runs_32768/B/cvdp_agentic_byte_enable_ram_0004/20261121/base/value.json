"def reference(vectors):\n    LINES = 8192\n    MASK32 = 0xFFFFFFFF\n    MASKADDR = 0x1FFF\n    ram = [0] * LINES\n    oa = 0\n    ob = 0\n    ra = 0\n    rb = 0\n    ea = 0\n    eb = 0\n    bea = 0\n    beb = 0\n    dia = 0\n    dib = 0\n    ia_addr_a = 0\n    ia_en_a = 0\n    ia_be_a = 0\n    ia_data_in_a = 0\n    ia_addr_b = 0\n    ia_en_b = 0\n    ia_be_b = 0\n    ia_data_in_b = 0\n\n    def wr(addr, be, data):\n        word = ram[addr]\n        if be & 1:\n            word = (word & 0xFFFFFF00) | (data & 0x000000FF)\n        if be & 2:\n            word = (word & 0xFFFF00FF) | (data & 0x0000FF00)\n        if be & 4:\n            word = (word & 0xFF00FFFF) | (data & 0x00FF0000)\n        if be & 8:\n            word = (word & 0x00FFFFFF) | (data & 0xFF000000)\n        ram[addr] = word & MASK32\n\n    out = []\n    idx = 0\n    for row in vectors:\n        if isinstance(row, dict):\n            if 'addr_a' in row:\n                ia_addr_a = int(row['addr_a'])\n            if 'en_a' in row:\n                ia_en_a = int(row['en_a'])\n            if 'be_a' in row:\n                ia_be_a = int(row['be_a'])\n            if 'data_in_a' in row:\n                ia_data_in_a = int(row['data_in_a'])\n            if 'addr_b' in row:\n                ia_addr_b = int(row['addr_b'])\n            if 'en_b' in row:\n                ia_en_b = int(row['en_b'])\n            if 'be_b' in row:\n                ia_be_b = int(row['be_b'])\n            if 'data_in_b' in row:\n                ia_data_in_b = int(row['data_in_b'])\n\n        is_pos = None\n        if isinstance(row, dict) and 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                s = e.lower()\n                if 'pos' in s or 'ris' in s or s == '1':\n                    is_pos = True\n                elif 'neg' in s or 'fal' in s or s == '0':\n                    is_pos = False\n                else:\n                    is_pos = True\n            else:\n                is_pos = bool(e)\n        else:\n            c = None\n            if isinstance(row, dict):\n                if 'clk' in row:\n                    c = row['clk']\n                elif 'clock' in row:\n                    c = row['clock']\n            if c is not None:\n                is_pos = (int(c) & 1) == 1\n            else:\n                is_pos = (idx % 2) == 0\n\n        out.append({\n            'data_out_a': oa & MASK32,\n            'data_out_b': ob & MASK32\n        })\n\n        if is_pos:\n            read_a = ram[ra]\n            read_b = ram[rb]\n\n            if ea and eb and ra == rb:\n                word = ram[ra]\n                if bea & 1:\n                    word = (word & 0xFFFFFF00) | (dia & 0x000000FF)\n                elif beb & 1:\n                    word = (word & 0xFFFFFF00) | (dib & 0x000000FF)\n                if bea & 2:\n                    word = (word & 0xFFFF00FF) | (dia & 0x0000FF00)\n                elif beb & 2:\n                    word = (word & 0xFFFF00FF) | (dib & 0x0000FF00)\n                if bea & 4:\n                    word = (word & 0xFF00FFFF) | (dia & 0x00FF0000)\n                elif beb & 4:\n                    word = (word & 0xFF00FFFF) | (dib & 0x00FF0000)\n                if bea & 8:\n                    word = (word & 0x00FFFFFF) | (dia & 0xFF000000)\n                elif beb & 8:\n                    word = (word & 0x00FFFFFF) | (dib & 0xFF000000)\n                ram[ra] = word & MASK32\n            else:\n                if ea:\n                    wr(ra, bea, dia)\n                if eb:\n                    wr(rb, beb, dib)\n\n            oa = read_a & MASK32\n            ob = read_b & MASK32\n\n            ra = ia_addr_a & MASKADDR\n            ea = ia_en_a & 1\n            bea = ia_be_a & 0xF\n            dia = ia_data_in_a & MASK32\n            rb = ia_addr_b & MASKADDR\n            eb = ia_en_b & 1\n            beb = ia_be_b & 0xF\n            dib = ia_data_in_b & MASK32\n\n        idx += 1\n\n    return out\n"
