"def reference(vectors):\n    if isinstance(vectors, dict):\n        n = 0\n        for v in vectors.values():\n            n = len(v)\n            break\n        rows = [{k: vectors[k][i] for k in vectors} for i in range(n)]\n    else:\n        rows = vectors\n\n    LINES = 8192\n    BYTES = 4\n    ram = [0] * LINES\n    a_addr = a_en = a_be = a_data = 0\n    b_addr = b_en = b_be = b_data = 0\n    out_a = out_b = 0\n    res = []\n\n    for idx, row in enumerate(rows):\n        is_pos = None\n        if 'clk' in row:\n            clk = row['clk']\n            if isinstance(clk, str):\n                s = clk.lower()\n                if 'pos' in s or s == '1' or s == 'true':\n                    is_pos = True\n                elif 'neg' in s or s == '0' or s == 'false':\n                    is_pos = False\n            else:\n                is_pos = (clk == 1)\n        if is_pos is None and 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                s = e.lower()\n                if 'pos' in s:\n                    is_pos = True\n                elif 'neg' in s:\n                    is_pos = False\n        if is_pos is None:\n            is_pos = (idx % 2 == 0)\n\n        res.append({'data_out_a': out_a & 0xFFFFFFFF, 'data_out_b': out_b & 0xFFFFFFFF})\n\n        if is_pos:\n            ra = a_addr & (LINES - 1)\n            rb = b_addr & (LINES - 1)\n            noa = ram[ra]\n            nob = ram[rb]\n\n            if a_en and b_en and a_addr == b_addr:\n                addr = a_addr & (LINES - 1)\n                old = ram[addr]\n                neww = old\n                for i in range(BYTES):\n                    bit = 1 << i\n                    sh = 8 * i\n                    mask = 0xFF << sh\n                    if a_be & bit:\n                        byte = (a_data >> sh) & 0xFF\n                        neww = (neww & ~mask) | (byte << sh)\n                    elif b_be & bit:\n                        byte = (b_data >> sh) & 0xFF\n                        neww = (neww & ~mask) | (byte << sh)\n                ram[addr] = neww & 0xFFFFFFFF\n            else:\n                if a_en:\n                    addr = a_addr & (LINES - 1)\n                    old = ram[addr]\n                    neww = old\n                    for i in range(BYTES):\n                        bit = 1 << i\n                        sh = 8 * i\n                        if a_be & bit:\n                            byte = (a_data >> sh) & 0xFF\n                            neww = (neww & ~(0xFF << sh)) | (byte << sh)\n                    ram[addr] = neww & 0xFFFFFFFF\n                if b_en:\n                    addr = b_addr & (LINES - 1)\n                    old = ram[addr]\n                    neww = old\n                    for i in range(BYTES):\n                        bit = 1 << i\n                        sh = 8 * i\n                        if b_be & bit:\n                            byte = (b_data >> sh) & 0xFF\n                            neww = (neww & ~(0xFF << sh)) | (byte << sh)\n                    ram[addr] = neww & 0xFFFFFFFF\n\n            out_a = noa & 0xFFFFFFFF\n            out_b = nob & 0xFFFFFFFF\n\n            a_addr = row.get('addr_a', 0) & 0x1FFF\n            a_en = row.get('en_a', 0) & 1\n            a_be = row.get('be_a', 0) & 0xF\n            a_data = row.get('data_in_a', 0) & 0xFFFFFFFF\n            b_addr = row.get('addr_b', 0) & 0x1FFF\n            b_en = row.get('en_b', 0) & 1\n            b_be = row.get('be_b', 0) & 0xF\n            b_data = row.get('data_in_b', 0) & 0xFFFFFFFF\n\n    return res\n"
