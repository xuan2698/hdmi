"def reference(vectors):\n    cnt = 0\n    out = []\n    if vectors and vectors[0].get('reset', 0) == 1:\n        cnt = 31\n    for i, row in enumerate(vectors):\n        reset = row.get('reset', 0)\n        c = cnt & 31\n        out.append({\n            'cnt_q': c,\n            'gate_clk_o': 1 if 0 < c < 14 else 0,\n            'release_reset_o': 1 if c < 8 else 0\n        })\n        if reset:\n            cnt = 31\n        elif i % 2 == 0:\n            if cnt > 0:\n                cnt -= 1\n    return out\n"
