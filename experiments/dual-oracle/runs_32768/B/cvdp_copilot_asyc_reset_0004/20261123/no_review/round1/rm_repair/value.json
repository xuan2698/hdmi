"def reference(vectors):\n    cnt = 31\n    outs = []\n    for row in vectors:\n        reset = 0\n        edge = None\n        clk = None\n        if isinstance(row, dict):\n            if 'reset' in row:\n                reset = row['reset']\n            if 'edge' in row:\n                edge = row['edge']\n            if 'clk' in row:\n                clk = row['clk']\n        elif isinstance(row, (list, tuple)):\n            if len(row) == 2:\n                if isinstance(row[0], str):\n                    edge = row[0]\n                    reset = row[1]\n                else:\n                    clk = row[0]\n                    reset = row[1]\n            elif len(row) >= 3:\n                clk = row[0]\n                reset = row[1]\n                edge = row[2]\n            elif len(row) == 1:\n                reset = row[0]\n\n        if isinstance(reset, str):\n            reset = 1 if reset.lower() in ('1', 'true', 'high') else 0\n        else:\n            reset = int(reset) & 1\n\n        is_pos = False\n        if clk is not None:\n            if isinstance(clk, str):\n                is_pos = 'pos' in clk.lower() or clk == '1'\n            else:\n                is_pos = (int(clk) & 1) == 1\n        elif edge is not None:\n            if isinstance(edge, str):\n                e = edge.lower()\n                is_pos = ('pos' in e) or e.startswith('1') or e == 'p'\n            else:\n                is_pos = (int(edge) & 1) == 1\n\n        if reset:\n            cnt = 31\n\n        gate = 1 if (cnt > 0 and cnt < 14) else 0\n        rel = 1 if cnt < 8 else 0\n        outs.append({'cnt_q': cnt, 'gate_clk_o': gate, 'release_reset_o': rel})\n\n        if is_pos:\n            if reset:\n                cnt = 31\n            elif cnt > 0:\n                cnt -= 1\n\n    return outs\n"
