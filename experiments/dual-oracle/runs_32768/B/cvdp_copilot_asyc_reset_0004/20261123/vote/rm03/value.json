"def reference(vectors):\n    cnt = 31\n    out = []\n    idx = 0\n    for row in vectors:\n        reset = 0\n        edge = None\n        if isinstance(row, dict):\n            reset = row.get('reset', 0)\n            if 'edge' in row:\n                edge = row['edge']\n            elif 'clk' in row:\n                edge = row['clk']\n            elif 'clock' in row:\n                edge = row['clock']\n        else:\n            if isinstance(row, (list, tuple)):\n                if len(row) == 1:\n                    reset = row[0]\n                elif len(row) >= 2:\n                    edge = row[0]\n                    reset = row[1]\n            else:\n                reset = row\n        if isinstance(reset, str):\n            r = reset.lower()\n            reset = 1 if r in ('1', 'true', 'high', 'yes') else 0\n        else:\n            reset = 1 if reset else 0\n        if reset:\n            cnt = 31\n        is_pos = False\n        if edge is not None:\n            if isinstance(edge, str):\n                e = edge.lower()\n                if e in ('posedge', 'pos', 'positive', 'p', '1', 'true', 'high'):\n                    is_pos = True\n                elif e in ('negedge', 'neg', 'negative', 'n', '0', 'false', 'low'):\n                    is_pos = False\n                else:\n                    try:\n                        is_pos = int(e) != 0\n                    except:\n                        is_pos = False\n            else:\n                is_pos = bool(edge)\n        else:\n            is_pos = (idx % 2 == 0)\n        c = cnt\n        g = 1 if (c > 0 and c < 14) else 0\n        rr = 1 if c < 8 else 0\n        out.append({'cnt_q': c, 'gate_clk_o': g, 'release_reset_o': rr})\n        if is_pos:\n            if reset:\n                cnt = 31\n            else:\n                if cnt > 0:\n                    cnt -= 1\n        idx += 1\n    return out\n"
