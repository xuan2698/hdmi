  "RM": "def reference(vectors):\n    cnt = 31\n    out = []\n    expect_pos = True\n    for row in vectors:\n        reset_val = 0\n        edge_pos = expect_pos\n        if isinstance(row, dict):\n            if 'reset' in row:\n                reset_val = int(row['reset']) & 1\n            if 'edge' in row:\n                e = row['edge']\n                if isinstance(e, str):\n                    le = e.lower()\n                    if 'pos' in le:\n                        edge_pos = True\n                    elif 'neg' in le:\n                        edge_pos = False\n                elif isinstance(e, (int, bool)):\n                    edge_pos = (e == 1)\n            elif 'clk' in row:\n                c = row['clk']\n                if isinstance(c, str):\n                    lc = c.lower()\n                    if 'pos' in lc or c == '1':\n                        edge_pos = True\n                    elif 'neg' in lc or c == '0':\n                        edge_pos = False\n                elif isinstance(c, (int, bool)):\n                    edge_pos = (c == 1)\n\n        if reset_val == 1:\n            cnt = 31\n\n        q = cnt & 31\n        gate = 1 if (q > 0 and q < 14) else 0\n        rel = 1 if q < 8 else 0\n        out.append({'cnt_q': q, 'gate_clk_o': gate, 'release_reset_o': rel})\n\n        if edge_pos:\n            if reset_val == 1:\n                cnt = 31\n            elif cnt > 0:\n                cnt -= 1\n\n        expect_pos = not edge_pos\n\n    return out\n",
