"def reference(vectors):\n    cnt = 31\n    result = []\n    for row in vectors:\n        reset_val = 0\n        edge = None\n        if isinstance(row, dict):\n            if 'reset' in row:\n                reset_val = int(row['reset'])\n            if 'edge' in row:\n                v = row['edge']\n                s = str(v).lower()\n                if 'pos' in s or s == '1':\n                    edge = 1\n                elif 'neg' in s or s == '0':\n                    edge = 0\n            elif 'clk' in row:\n                v = row['clk']\n                s = str(v).lower()\n                if 'pos' in s or s == '1':\n                    edge = 1\n                elif 'neg' in s or s == '0':\n                    edge = 0\n        if reset_val == 1:\n            cnt = 31\n        out_cnt = cnt & 31\n        gate = 1 if (0 < out_cnt < 14) else 0\n        rel = 1 if out_cnt < 8 else 0\n        result.append({'cnt_q': out_cnt, 'gate_clk_o': gate, 'release_reset_o': rel})\n        if edge == 1:\n            if reset_val == 1:\n                cnt = 31\n            elif cnt > 0:\n                cnt -= 1\n    return result\n"
