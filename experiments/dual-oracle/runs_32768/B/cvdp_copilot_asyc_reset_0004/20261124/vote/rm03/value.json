"def reference(vectors):\n    cnt = 31\n    res = []\n    for i, row in enumerate(vectors):\n        edge = 1 if i % 2 == 0 else 0\n        rst = 0\n        if isinstance(row, dict):\n            if 'edge' in row:\n                edge = row['edge']\n            elif 'clk' in row:\n                edge = row['clk']\n            if 'reset' in row:\n                rst = row['reset']\n        elif isinstance(row, (list, tuple)):\n            if len(row) == 1:\n                rst = row[0]\n            elif len(row) >= 2:\n                edge = row[0]\n                rst = row[1]\n        else:\n            rst = row\n        rst = 1 if rst else 0\n        edge = 1 if edge else 0\n        if rst:\n            cnt = 31\n        res.append({\n            'cnt_q': cnt,\n            'gate_clk_o': 1 if (cnt > 0 and cnt < 14) else 0,\n            'release_reset_o': 1 if (cnt < 8) else 0\n        })\n        if edge and not rst:\n            if cnt > 0:\n                cnt -= 1\n    return res\n"
