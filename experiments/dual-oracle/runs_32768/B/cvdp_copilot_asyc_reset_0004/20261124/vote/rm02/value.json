"def reference(vectors):\n    st = 31\n    ans = []\n    for i, row in enumerate(vectors):\n        if isinstance(row, dict):\n            r = row.get('reset', 0)\n            clk = row.get('clk', None)\n            edge = row.get('edge', None)\n            if edge is None and isinstance(clk, str) and ('pos' in clk.lower() or 'neg' in clk.lower()):\n                edge = clk\n                clk = None\n        elif isinstance(row, (list, tuple)):\n            r = row[0] if len(row) > 0 else 0\n            clk = row[1] if len(row) > 1 else None\n            edge = None\n            if isinstance(clk, str) and ('pos' in clk.lower() or 'neg' in clk.lower()):\n                edge = clk\n                clk = None\n        else:\n            r = row\n            clk = None\n            edge = None\n\n        if isinstance(r, str):\n            s = r.strip().lower()\n            if s in ('1', 'true'):\n                r = 1\n            elif s in ('0', 'false'):\n                r = 0\n            else:\n                r = int(s, 0)\n        r = int(r) & 1\n\n        if r:\n            st = 31\n\n        if edge is not None:\n            if isinstance(edge, str):\n                pos = 'pos' in edge.lower()\n            else:\n                pos = bool(int(edge) & 1)\n        elif clk is not None:\n            if isinstance(clk, str):\n                s = clk.strip().lower()\n                if 'pos' in s:\n                    pos = True\n                elif 'neg' in s:\n                    pos = False\n                else:\n                    cv = int(s, 2) if s in ('0', '1') else int(s, 0)\n                    pos = (cv & 1) == 1\n            else:\n                pos = (int(clk) & 1) == 1\n        else:\n            pos = (i % 2 == 0)\n\n        cnt = st & 31\n        ans.append({\n            'cnt_q': cnt,\n            'gate_clk_o': 1 if (0 < cnt < 14) else 0,\n            'release_reset_o': 1 if (cnt < 8) else 0\n        })\n\n        if pos:\n            if r:\n                st = 31\n            elif st > 0:\n                st -= 1\n    return ans\n"
