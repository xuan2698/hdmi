"def reference(vectors):\n    cnt = 0\n    res = []\n    for i, row in enumerate(vectors):\n        reset = row.get('reset', 0)\n        if reset == 1:\n            cnt = 0x1F\n        gate = 1 if 0 < cnt < 0xE else 0\n        release = 1 if cnt < 0x8 else 0\n        res.append({'cnt_q': cnt, 'gate_clk_o': gate, 'release_reset_o': release})\n        if 'clk' in row:\n            posedge = (row['clk'] == 1)\n        else:\n            posedge = (i % 2 == 0)\n        if posedge:\n            if reset == 1:\n                cnt = 0x1F\n            else:\n                if cnt > 0:\n                    cnt -= 1\n    return res\n"
