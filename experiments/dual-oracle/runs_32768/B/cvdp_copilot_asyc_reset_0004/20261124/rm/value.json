"def reference(vectors):\n    cnt = 31\n    result = []\n    alt_pos = True\n    for row in vectors:\n        reset_val = 0\n        edge_pos = alt_pos\n        if isinstance(row, dict):\n            if 'reset' in row:\n                reset_val = int(row['reset'])\n            if 'clk' in row:\n                v = row['clk']\n                if isinstance(v, str):\n                    lv = v.lower()\n                    if 'pos' in lv or v == '1':\n                        edge_pos = True\n                    elif 'neg' in lv or v == '0':\n                        edge_pos = False\n                elif isinstance(v, (int, bool)):\n                    edge_pos = (v == 1)\n            elif 'edge' in row:\n                v = row['edge']\n                if isinstance(v, str):\n                    lv = v.lower()\n                    if 'pos' in lv:\n                        edge_pos = True\n                    elif 'neg' in lv:\n                        edge_pos = False\n                elif isinstance(v, (int, bool)):\n                    edge_pos = (v == 1)\n        if reset_val == 1:\n            cnt = 31\n        out_cnt = cnt & 0x1F\n        gate = 1 if (out_cnt > 0 and out_cnt < 14) else 0\n        rel = 1 if (out_cnt < 8) else 0\n        result.append({'cnt_q': out_cnt, 'gate_clk_o': gate, 'release_reset_o': rel})\n        if edge_pos:\n            if reset_val == 1:\n                cnt = 31\n            else:\n                if cnt > 0:\n                    cnt = cnt - 1\n        alt_pos = not edge_pos\n    return result\n"
