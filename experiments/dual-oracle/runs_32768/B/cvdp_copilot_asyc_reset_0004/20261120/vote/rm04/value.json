"def reference(vectors):\n    cnt = 0\n    out = []\n    for i, row in enumerate(vectors):\n        if isinstance(row, dict):\n            reset = int(row.get('reset', 0))\n            if 'clk' in row:\n                c = row['clk']\n                if isinstance(c, str):\n                    posedge = (c == 'posedge' or c == '1')\n                else:\n                    posedge = (int(c) == 1)\n            elif 'edge' in row:\n                e = row['edge']\n                posedge = (e == 'posedge' or e == 1)\n            else:\n                posedge = (i % 2 == 0)\n        else:\n            reset = int(row)\n            posedge = (i % 2 == 0)\n\n        gate = 1 if (cnt > 0 and cnt < 14) else 0\n        rel = 1 if (cnt < 8) else 0\n        out.append({'cnt_q': cnt, 'gate_clk_o': gate, 'release_reset_o': rel})\n\n        if reset == 1:\n            cnt = 31\n        elif posedge and cnt > 0:\n            cnt -= 1\n    return out\n"
