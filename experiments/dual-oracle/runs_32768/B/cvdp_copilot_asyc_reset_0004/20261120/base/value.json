"def reference(vectors):\n    c = 31\n    out = []\n    for i, row in enumerate(vectors):\n        if isinstance(row, dict):\n            reset = row.get('reset', 0)\n        else:\n            reset = row[0] if isinstance(row, (list, tuple)) else row\n        if reset:\n            c = 31\n        clk = 1 if i % 2 == 0 else 0\n        gate = 1 if (clk and 0 < c < 14) else 0\n        rel = 1 if c < 8 else 0\n        out.append({'cnt_q': c, 'gate_clk_o': gate, 'release_reset_o': rel})\n        if i % 2 == 0:\n            if reset:\n                c = 31\n            elif c > 0:\n                c -= 1\n    return out\n"
