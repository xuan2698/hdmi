  ],
  "RM": "def reference(vectors):\n    cnt = 0x1F\n    out = []\n    next_pos = True\n    for row in vectors:\n        if isinstance(row, dict):\n            r = row.get('reset', 0)\n            e = row.get('edge', None)\n        elif isinstance(row, (list, tuple)):\n            r = row[-1] if len(row) else 0\n            e = None\n            for v in row:\n                if isinstance(v, str) and v in ('posedge', 'negedge'):\n                    e = v\n                    break\n        else:\n            r = row\n            e = None\n\n        if e is None:\n            edge = 'posedge' if next_pos else 'negedge'\n            next_pos = not next_pos\n        else:\n            edge = e\n            next_pos = (edge != 'posedge')\n\n        if r:\n            cnt = 0x1F\n\n        gate = 1 if 0 < cnt < 0xE else 0\n        rel = 1 if cnt < 0x8 else 0\n\n        out.append({\n            'cnt_q': cnt & 0x1F,\n            'gate_clk_o': gate,\n            'release_reset_o': rel\n        })\n\n        if edge == 'posedge' and not r and cnt > 0:\n            cnt = (cnt - 1) & 0x1F\n\n    return out\n",
