    },
    {
      "id": "s4/3/release_reset_o",
      "label": "RM",
      "spec_quote": "active when the counter is less than `5'h8`"
    },
    {
      "id": "s6/2/cnt_q",
      "label": "RM",
      "spec_quote": "initializes to `5'h1F` upon reset and decrements on each clock cycle"
    },
    {
      "id": "s6/3/gate_clk_o",
      "label": "RM",
      "spec_quote": "enabled when the counter is greater than zero and less than `5'hE`"
    },
    {
      "id": "s6/3/cnt_q",
      "label": "RM",
      "spec_quote": "initializes to `5'h1F` upon reset and decrements on each clock cycle"
    }
  ],
  "RM": "def reference(vectors):\n    cnt = 0x1F\n    out = []\n    for i, row in enumerate(vectors):\n        if isinstance(row, dict):\n            reset = row.get('reset', 0)\n            edge = row.get('edge', 'posedge' if i % 2 == 0 else 'negedge')\n        elif isinstance(row, (list, tuple)):\n            reset = 0\n            edge = None\n            for v in row:\n                if isinstance(v, str):\n                    edge = v\n                else:\n                    reset = v\n            if edge is None:\n                edge = 'posedge' if i % 2 == 0 else 'negedge'\n        else:\n            reset = row\n            edge = 'posedge' if i % 2 == 0 else 'negedge'\n\n        if reset:\n            cnt = 0x1F\n\n        gate = 1 if 0 < cnt < 0xE else 0\n        rel = 1 if cnt < 0x8 else 0\n        out.append({'cnt_q': cnt & 0x1F, 'gate_clk_o': gate, 'release_reset_o': rel})\n\n        if isinstance(edge, str) and edge.lower().startswith('pos') and not reset:\n            if cnt > 0:\n                cnt = (cnt - 1) & 0x1F\n\n    return out\n",
