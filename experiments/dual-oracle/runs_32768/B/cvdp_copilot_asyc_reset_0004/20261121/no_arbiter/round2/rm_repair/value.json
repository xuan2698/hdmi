"def reference(vectors):\n    cnt = 0x1F\n    out = []\n    for i, row in enumerate(vectors):\n        is_pos = (i % 2 == 0)\n        reset = 0\n\n        if isinstance(row, dict):\n            reset = row.get('reset', 0)\n            if 'edge' in row:\n                e = row['edge']\n                if isinstance(e, str):\n                    e_l = e.lower()\n                    if e_l.startswith('pos') or e_l == '1':\n                        is_pos = True\n                    elif e_l.startswith('neg') or e_l == '0':\n                        is_pos = False\n                else:\n                    is_pos = bool(e)\n            elif 'clk' in row:\n                is_pos = (row['clk'] == 1)\n        elif isinstance(row, (list, tuple)):\n            if len(row) > 0:\n                reset = row[0]\n            if len(row) > 1:\n                e = row[1]\n                if isinstance(e, str):\n                    e_l = e.lower()\n                    if e_l.startswith('pos') or e_l == '1':\n                        is_pos = True\n                    elif e_l.startswith('neg') or e_l == '0':\n                        is_pos = False\n                else:\n                    is_pos = (e == 1)\n        else:\n            reset = row\n\n        if reset:\n            cnt = 0x1F\n\n        gate = 1 if 0 < cnt < 0x0E else 0\n        release = 1 if cnt < 0x08 else 0\n\n        out.append({\n            'cnt_q': cnt & 0x1F,\n            'gate_clk_o': gate,\n            'release_reset_o': release\n        })\n\n        if is_pos and not reset and cnt > 0:\n            cnt = (cnt - 1) & 0x1F\n\n    return out\n"
