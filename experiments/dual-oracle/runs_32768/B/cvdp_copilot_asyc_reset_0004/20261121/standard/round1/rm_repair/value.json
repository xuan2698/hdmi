"def reference(vectors):\n    cnt = 0x1F\n    out = []\n    for i, row in enumerate(vectors):\n        is_pos = (i % 2 == 0)\n        reset = 0\n        if isinstance(row, dict):\n            reset = row.get('reset', 0)\n            if 'edge' in row:\n                e = row['edge']\n                if isinstance(e, str):\n                    is_pos = e.lower().startswith('pos') or e == '1'\n                else:\n                    is_pos = bool(e)\n            elif 'clk' in row:\n                is_pos = (row['clk'] == 1)\n        elif isinstance(row, (list, tuple)):\n            if len(row) > 0:\n                reset = row[0]\n            if len(row) > 1:\n                is_pos = (row[1] == 1)\n        else:\n            reset = row\n\n        if reset:\n            cnt = 0x1F\n\n        gate = 1 if 0 < cnt < 0x0E else 0\n        release = 1 if cnt < 0x08 else 0\n        out.append({'cnt_q': cnt, 'gate_clk_o': gate, 'release_reset_o': release})\n\n        if is_pos and not reset and cnt > 0:\n            cnt -= 1\n\n    return out\n"
