"def reference(vectors):\n    cnt = 31\n    result = []\n    for i, row in enumerate(vectors):\n        expected_pos = (i % 2 == 0)\n        expected_clk = 1 if expected_pos else 0\n        reset = 0\n        edge = None\n\n        if isinstance(row, dict):\n            if 'reset' in row:\n                reset = row['reset']\n            elif 'rst' in row:\n                reset = row['rst']\n            if 'edge' in row:\n                edge = row['edge']\n            elif 'clk' in row:\n                edge = row['clk']\n            else:\n                edge = expected_clk\n\n        elif isinstance(row, (list, tuple)):\n            n = len(row)\n            if n == 0:\n                edge = expected_clk\n            elif n == 1:\n                reset = row[0]\n                edge = expected_clk\n            else:\n                a = row[0]\n                b = row[1]\n                if isinstance(a, str) and (('pos' in a.lower()) or ('neg' in a.lower())):\n                    edge = a\n                    reset = b\n                elif isinstance(b, str) and (('pos' in b.lower()) or ('neg' in b.lower())):\n                    edge = b\n                    reset = a\n                else:\n                    try:\n                        ai = int(a) & 1\n                        bi = int(b) & 1\n                    except:\n                        ai = None\n                        bi = None\n                    if ai == expected_clk and bi != expected_clk:\n                        edge = a\n                        reset = b\n                    elif bi == expected_clk and ai != expected_clk:\n                        edge = b\n                        reset = a\n                    else:\n                        edge = a\n                        reset = b\n        else:\n            reset = row\n            edge = expected_clk\n\n        if isinstance(reset, str):\n            s = reset.strip().lower()\n            reset = 1 if s in ('1', 'true', 'high', 'h') else 0\n        else:\n            reset = 1 if reset else 0\n\n        if isinstance(edge, str):\n            s = edge.strip().lower()\n            if s in ('posedge', 'pos', 'p', 'rise', 'rising', '1', 'true'):\n                pos = True\n            elif s in ('negedge', 'neg', 'n', 'fall', 'falling', '0', 'false'):\n                pos = False\n            else:\n                pos = expected_pos\n        else:\n            if edge is None:\n                pos = expected_pos\n            else:\n                pos = (int(edge) & 1) == 1\n\n        if reset:\n            cnt = 31\n\n        cnt_q = cnt & 31\n        gate_clk_o = 1 if (cnt_q > 0 and cnt_q < 14) else 0\n        release_reset_o = 1 if (cnt_q < 8) else 0\n\n        result.append({\n            'cnt_q': cnt_q,\n            'gate_clk_o': gate_clk_o,\n            'release_reset_o': release_reset_o\n        })\n\n        if pos and not reset:\n            if cnt > 0:\n                cnt = cnt - 1\n\n    return result\n"
