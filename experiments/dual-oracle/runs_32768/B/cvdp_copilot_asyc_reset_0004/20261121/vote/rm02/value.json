"def reference(vectors):\n    cnt = 0\n    out = []\n    for i, row in enumerate(vectors):\n        if isinstance(row, dict):\n            rst = row.get('reset', 0)\n            if 'clk' in row:\n                pos = bool(row['clk'])\n            elif 'edge' in row:\n                e = row['edge']\n                if isinstance(e, str):\n                    pos = 'pos' in e.lower()\n                else:\n                    pos = bool(e)\n            else:\n                pos = (i % 2 == 0)\n        elif isinstance(row, (list, tuple)):\n            if len(row) == 0:\n                rst = 0\n                pos = (i % 2 == 0)\n            elif len(row) == 1:\n                rst = row[0]\n                pos = (i % 2 == 0)\n            else:\n                rst = row[0]\n                pos = bool(row[1])\n        else:\n            rst = row\n            pos = (i % 2 == 0)\n\n        if rst:\n            cnt = 31\n\n        gate = 1 if (cnt > 0 and cnt < 14) else 0\n        release = 1 if (cnt < 8) else 0\n        out.append({'cnt_q': cnt, 'gate_clk_o': gate, 'release_reset_o': release})\n\n        if pos:\n            if rst:\n                cnt = 31\n            else:\n                if cnt != 0:\n                    cnt -= 1\n\n    return out\n"
