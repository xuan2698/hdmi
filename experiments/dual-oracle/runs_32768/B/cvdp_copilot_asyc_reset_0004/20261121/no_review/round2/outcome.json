    {
      "id": "s6/1/cnt_q",
      "label": "RM",
      "spec_quote": "counter resets to `5'h1F`"
    },
    {
      "id": "s6/2/gate_clk_o",
      "label": "RM",
      "spec_quote": "enabled when the counter is greater than zero and less than `5'hE`"
    }
  ],
  "RM": "def reference(vectors):\n    cnt = 0x1F\n    out = []\n    for i, row in enumerate(vectors):\n        is_pos = (i % 2 == 0)\n        reset = 0\n\n        if isinstance(row, dict):\n            reset = int(row.get('reset', 0))\n            if 'edge' in row:\n                e = row['edge']\n                if isinstance(e, str):\n                    el = e.lower()\n                    is_pos = el.startswith('pos') or el == '1'\n                else:\n                    is_pos = bool(e)\n            elif 'clk' in row:\n                is_pos = (int(row['clk']) == 1)\n        elif isinstance(row, (list, tuple)):\n            if len(row) > 0:\n                reset = int(row[0])\n            if len(row) > 1:\n                v = row[1]\n                if isinstance(v, str):\n                    lv = v.lower()\n                    is_pos = lv.startswith('pos') or lv == '1'\n                else:\n                    is_pos = bool(v)\n        else:\n            reset = int(row)\n\n        if reset:\n            cnt = 0x1F\n\n        gate = 1 if 0 < cnt < 0x0E else 0\n        release = 1 if cnt < 0x08 else 0\n\n        out.append({\n            'cnt_q': cnt,\n            'gate_clk_o': gate,\n            'release_reset_o': release\n        })\n\n        if is_pos and not reset and cnt > 0:\n            cnt -= 1\n\n    return out\n",
