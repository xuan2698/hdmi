  "RM": "def reference(vectors):\n    prev = 0\n    latched = 0\n    word = 0\n    pat = 0\n    out = []\n    for i, row in enumerate(vectors):\n        rst = int(row.get('reset', 0)) & 1\n        data = int(row.get('data_in', 0)) & 255\n        mask = int(row.get('mask', 0)) & 255\n        match = int(row.get('match_pattern', 0)) & 255\n        en = int(row.get('enable', 0)) & 1\n        lp = int(row.get('latch_pattern', 0)) & 1\n\n        edge = row.get('edge', None)\n        if edge is None:\n            if 'posedge' in row:\n                pos = bool(row['posedge'])\n            elif 'clk' in row:\n                c = row['clk']\n                if isinstance(c, str):\n                    e = c.lower()\n                    if 'pos' in e:\n                        pos = True\n                    elif 'neg' in e:\n                        pos = False\n                    else:\n                        try:\n                            pos = (int(c) & 1) == 1\n                        except:\n                            pos = (i % 2 == 0)\n                else:\n                    pos = (int(c) & 1) == 1\n            else:\n                pos = (i % 2 == 0)\n        else:\n            if isinstance(edge, str):\n                e = edge.lower()\n                if 'pos' in e:\n                    pos = True\n                elif 'neg' in e:\n                    pos = False\n                else:\n                    try:\n                        pos = (int(edge) & 1) == 1\n                    except:\n                        pos = (i % 2 == 0)\n            else:\n                pos = bool(edge)\n\n        if rst:\n            prev = 0\n            latched = 0\n            word = 0\n            pat = 0\n\n        out.append({\n            'word_change_pulse': word & 1,\n            'pattern_match_pulse': pat & 1,\n            'latched_pattern': latched & 255\n        })\n\n        if rst:\n            prev = 0\n            latched = 0\n            word = 0\n            pat = 0\n        elif pos:\n            new_latched = match if lp else latched\n            new_word = 1 if (en and (((data ^ prev) & mask) != 0)) else 0\n            new_pat = 1 if (en and (((data ^ latched) & mask) == 0)) else 0\n            word = new_word\n            pat = new_pat\n            latched = new_latched & 255\n            prev = data & 255\n\n    return out\n",
