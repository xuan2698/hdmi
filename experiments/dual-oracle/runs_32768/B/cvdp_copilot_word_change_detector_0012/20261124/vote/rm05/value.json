"def reference(vectors):\n    data_in_prev = 0\n    latched_pattern = 0\n    word_change_pulse = 0\n    pattern_match_pulse = 0\n    out = []\n    for row in vectors:\n        reset = row.get('reset', 0)\n        reset = int(reset) & 1\n        if reset:\n            data_in_prev = 0\n            latched_pattern = 0\n            word_change_pulse = 0\n            pattern_match_pulse = 0\n            out.append({\n                'word_change_pulse': 0,\n                'pattern_match_pulse': 0,\n                'latched_pattern': 0\n            })\n            continue\n        edge = row.get('edge', row.get('clk', row.get('clk_edge', None)))\n        is_posedge = False\n        if isinstance(edge, str):\n            if 'pos' in edge.lower():\n                is_posedge = True\n        elif isinstance(edge, (int, bool)):\n            if edge == 1:\n                is_posedge = True\n        out.append({\n            'word_change_pulse': int(word_change_pulse),\n            'pattern_match_pulse': int(pattern_match_pulse),\n            'latched_pattern': int(latched_pattern) & 0xFF\n        })\n        if is_posedge:\n            data_in = int(row.get('data_in', 0)) & 0xFF\n            mask = int(row.get('mask', 0)) & 0xFF\n            match_pattern = int(row.get('match_pattern', 0)) & 0xFF\n            enable = int(row.get('enable', 0)) & 1\n            latch_pattern = int(row.get('latch_pattern', 0)) & 1\n            next_word_change = 0\n            next_pattern_match = 0\n            if enable:\n                if ((data_in ^ data_in_prev) & mask) != 0:\n                    next_word_change = 1\n                if ((data_in & mask) == (latched_pattern & mask)):\n                    next_pattern_match = 1\n            next_latched = latched_pattern\n            if latch_pattern:\n                next_latched = match_pattern\n            word_change_pulse = next_word_change\n            pattern_match_pulse = next_pattern_match\n            latched_pattern = next_latched\n            data_in_prev = data_in\n    return out\n"
