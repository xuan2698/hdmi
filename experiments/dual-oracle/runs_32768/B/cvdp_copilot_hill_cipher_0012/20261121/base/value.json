"def reference(vectors):\n    state = 0\n    cipher = 0\n    outs = []\n    prev_clk = None\n    idx = 0\n    for row in vectors:\n        if isinstance(row, dict):\n            reset = int(row.get('reset', 0))\n            start = int(row.get('start', 0))\n            plain = int(row.get('plaintext', 0))\n            key = int(row.get('key', 0))\n            if 'clk' in row:\n                clk = int(row['clk'])\n                posedge = (clk == 1 and prev_clk != 1)\n                if prev_clk is None and clk == 1:\n                    posedge = True\n                prev_clk = clk\n            elif 'edge' in row:\n                e = row['edge']\n                if isinstance(e, str):\n                    posedge = (e == 'posedge' or e == 'rise' or e == '1')\n                else:\n                    posedge = bool(e)\n                prev_clk = 1 if posedge else 0\n            else:\n                posedge = (idx % 2 == 0)\n                prev_clk = 1 if posedge else 0\n        else:\n            if isinstance(row, (list, tuple)) and len(row) >= 5:\n                clk = int(row[0])\n                reset = int(row[1])\n                start = int(row[2])\n                plain = int(row[3])\n                key = int(row[4])\n                posedge = (clk == 1 and prev_clk != 1)\n                if prev_clk is None and clk == 1:\n                    posedge = True\n                prev_clk = clk\n            elif isinstance(row, (list, tuple)) and len(row) == 4:\n                reset = int(row[0])\n                start = int(row[1])\n                plain = int(row[2])\n                key = int(row[3])\n                posedge = (idx % 2 == 0)\n                prev_clk = 1 if posedge else 0\n            else:\n                reset = start = plain = key = 0\n                posedge = (idx % 2 == 0)\n                prev_clk = 1 if posedge else 0\n\n        done = 1 if state == 3 else 0\n        outs.append({'ciphertext': cipher & 0x7fff, 'done': done})\n\n        if posedge:\n            if reset:\n                state = 0\n                cipher = 0\n            else:\n                if state == 0:\n                    if start:\n                        state = 1\n                elif state == 1:\n                    state = 2\n                elif state == 2:\n                    p0 = plain & 0x1f\n                    p1 = (plain >> 5) & 0x1f\n                    p2 = (plain >> 10) & 0x1f\n                    k00 = key & 0x1f\n                    k01 = (key >> 5) & 0x1f\n                    k02 = (key >> 10) & 0x1f\n                    k10 = (key >> 15) & 0x1f\n                    k11 = (key >> 20) & 0x1f\n                    k12 = (key >> 25) & 0x1f\n                    k20 = (key >> 30) & 0x1f\n                    k21 = (key >> 35) & 0x1f\n                    k22 = (key >> 40) & 0x1f\n                    c0 = (p0*k00 + p1*k01 + p2*k02) % 26\n                    c1 = (p0*k10 + p1*k11 + p2*k12) % 26\n                    c2 = (p0*k20 + p1*k21 + p2*k22) % 26\n                    cipher = (c2 << 10) | (c1 << 5) | c0\n                    state = 3\n                elif state == 3:\n                    state = 0\n        idx += 1\n    return outs\n"
