  "RM": "def reference(vectors):\n    state = 0\n    ciphertext = 0\n    done = 0\n    sums = [0, 0, 0]\n    cur_reset = 0\n    cur_start = 0\n    cur_plaintext = 0\n    cur_key = 0\n    prev_clk = 0\n    out = []\n    for idx, v in enumerate(vectors):\n        if 'reset' in v:\n            cur_reset = v['reset'] & 1\n        if 'start' in v:\n            cur_start = v['start'] & 1\n        if 'plaintext' in v:\n            cur_plaintext = v['plaintext'] & 0x7fff\n        if 'key' in v:\n            cur_key = v['key'] & ((1 << 45) - 1)\n        if 'clk' in v:\n            clk = v['clk'] & 1\n            posedge = (prev_clk == 0 and clk == 1)\n            prev_clk = clk\n        else:\n            posedge = (idx % 2 == 0)\n        out.append({'ciphertext': ciphertext & 0x7fff, 'done': done & 1})\n        if posedge:\n            if cur_reset:\n                state = 0\n                ciphertext = 0\n                done = 0\n                sums = [0, 0, 0]\n            else:\n                if state == 0:\n                    if cur_start:\n                        state = 1\n                elif state == 1:\n                    plaintext = cur_plaintext\n                    key = cur_key\n                    p0 = plaintext & 31\n                    p1 = (plaintext >> 5) & 31\n                    p2 = (plaintext >> 10) & 31\n                    k0 = key & 31\n                    k1 = (key >> 5) & 31\n                    k2 = (key >> 10) & 31\n                    k3 = (key >> 15) & 31\n                    k4 = (key >> 20) & 31\n                    k5 = (key >> 25) & 31\n                    k6 = (key >> 30) & 31\n                    k7 = (key >> 35) & 31\n                    k8 = (key >> 40) & 31\n                    sums[0] = p0 * k0 + p1 * k1 + p2 * k2\n                    sums[1] = p0 * k3 + p1 * k4 + p2 * k5\n                    sums[2] = p0 * k6 + p1 * k7 + p2 * k8\n                    state = 2\n                elif state == 2:\n                    c0 = sums[0] % 26\n                    c1 = sums[1] % 26\n                    c2 = sums[2] % 26\n                    ciphertext = c0 | (c1 << 5) | (c2 << 10)\n                    state = 3\n                    done = 1\n                elif state == 3:\n                    done = 0\n                    state = 0\n    return out\n",
