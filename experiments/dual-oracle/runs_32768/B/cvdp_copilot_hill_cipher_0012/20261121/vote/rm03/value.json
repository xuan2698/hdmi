"def reference(vectors):\n    state = 'IDLE'\n    ciphertext_reg = 0\n    sum0 = sum1 = sum2 = 0\n    prev_clk = 0\n    out = []\n    for i, row in enumerate(vectors):\n        clk = row.get('clk', 1 if i % 2 == 0 else 0)\n        reset = row.get('reset', 0)\n        start = row.get('start', 0)\n        plaintext = row.get('plaintext', 0)\n        key = row.get('key', 0)\n        done_out = 1 if state == 'DONE' else 0\n        out.append({'ciphertext': ciphertext_reg & 0x7FFF, 'done': done_out})\n        if clk == 1 and prev_clk == 0:\n            if reset:\n                state = 'IDLE'\n                ciphertext_reg = 0\n                sum0 = sum1 = sum2 = 0\n            else:\n                if state == 'IDLE':\n                    if start:\n                        state = 'COMPUTE'\n                elif state == 'COMPUTE':\n                    p0 = plaintext & 0x1F\n                    p1 = (plaintext >> 5) & 0x1F\n                    p2 = (plaintext >> 10) & 0x1F\n                    k0 = key & 0x1F\n                    k1 = (key >> 5) & 0x1F\n                    k2 = (key >> 10) & 0x1F\n                    k3 = (key >> 15) & 0x1F\n                    k4 = (key >> 20) & 0x1F\n                    k5 = (key >> 25) & 0x1F\n                    k6 = (key >> 30) & 0x1F\n                    k7 = (key >> 35) & 0x1F\n                    k8 = (key >> 40) & 0x1F\n                    sum0 = k0 * p0 + k1 * p1 + k2 * p2\n                    sum1 = k3 * p0 + k4 * p1 + k5 * p2\n                    sum2 = k6 * p0 + k7 * p1 + k8 * p2\n                    state = 'COMPUTE_MOD'\n                elif state == 'COMPUTE_MOD':\n                    c0 = sum0 % 26\n                    c1 = sum1 % 26\n                    c2 = sum2 % 26\n                    ciphertext_reg = (c0 | (c1 << 5) | (c2 << 10)) & 0x7FFF\n                    state = 'DONE'\n                elif state == 'DONE':\n                    state = 'IDLE'\n        prev_clk = clk\n    return out\n"
