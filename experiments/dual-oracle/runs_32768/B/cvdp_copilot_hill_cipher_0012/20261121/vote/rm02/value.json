"def reference(vectors):\n    state = 0  # 0=IDLE, 1=COMPUTE, 2=COMPUTE_MOD, 3=DONE\n    ciphertext = 0\n    prev_clk = 0\n    results = []\n    for i, row in enumerate(vectors):\n        reset = row.get('reset', 0)\n        start = row.get('start', 0)\n        plaintext = row.get('plaintext', 0)\n        key = row.get('key', 0)\n\n        if 'clk' in row:\n            clk = row['clk']\n            posedge = (clk == 1 and prev_clk == 0)\n            prev_clk = clk\n        else:\n            posedge = (i % 2 == 0)\n\n        done = 1 if state == 3 else 0\n        results.append({'ciphertext': ciphertext, 'done': done})\n\n        if posedge:\n            if reset:\n                state = 0\n                ciphertext = 0\n            else:\n                if state == 0:\n                    if start:\n                        state = 1\n                elif state == 1:\n                    state = 2\n                elif state == 2:\n                    p0 = plaintext & 0x1F\n                    p1 = (plaintext >> 5) & 0x1F\n                    p2 = (plaintext >> 10) & 0x1F\n\n                    k0 = key & 0x1F\n                    k1 = (key >> 5) & 0x1F\n                    k2 = (key >> 10) & 0x1F\n                    k3 = (key >> 15) & 0x1F\n                    k4 = (key >> 20) & 0x1F\n                    k5 = (key >> 25) & 0x1F\n                    k6 = (key >> 30) & 0x1F\n                    k7 = (key >> 35) & 0x1F\n                    k8 = (key >> 40) & 0x1F\n\n                    c0 = (p0 * k0 + p1 * k1 + p2 * k2) % 26\n                    c1 = (p0 * k3 + p1 * k4 + p2 * k5) % 26\n                    c2 = (p0 * k6 + p1 * k7 + p2 * k8) % 26\n\n                    ciphertext = c0 | (c1 << 5) | (c2 << 10)\n                    state = 3\n                elif state == 3:\n                    state = 0\n    return results\n"
