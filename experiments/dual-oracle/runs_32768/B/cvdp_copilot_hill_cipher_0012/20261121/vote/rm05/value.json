"def reference(vectors):\n    state = 0  # 0 IDLE, 1 COMPUTE, 2 COMPUTE_MOD, 3 DONE\n    ciphertext = 0\n    done = 0\n    sums = [0, 0, 0]\n    results = []\n    prev_clk = 0\n    for idx, row in enumerate(vectors):\n        results.append({'ciphertext': ciphertext & 0x7fff, 'done': done & 1})\n        \n        is_pos = None\n        if 'clk' in row:\n            clk_val = row['clk']\n            if clk_val == 1 and prev_clk == 0:\n                is_pos = True\n            else:\n                is_pos = False\n            prev_clk = clk_val\n        if 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                is_pos = (e.lower() in ('posedge', 'pos', '1'))\n            else:\n                is_pos = (e == 1)\n        if is_pos is None:\n            is_pos = (idx % 2 == 0)\n        \n        if is_pos:\n            reset = row.get('reset', 0)\n            if reset:\n                state = 0\n                ciphertext = 0\n                done = 0\n                sums = [0, 0, 0]\n            else:\n                if state == 0:  # IDLE\n                    if row.get('start', 0):\n                        state = 1\n                    done = 0\n                elif state == 1:  # COMPUTE\n                    plaintext = row.get('plaintext', 0)\n                    key = row.get('key', 0)\n                    p0 = plaintext & 0x1F\n                    p1 = (plaintext >> 5) & 0x1F\n                    p2 = (plaintext >> 10) & 0x1F\n                    for i in range(3):\n                        base = i * 3\n                        k0 = (key >> (5 * base)) & 0x1F\n                        k1 = (key >> (5 * (base + 1))) & 0x1F\n                        k2 = (key >> (5 * (base + 2))) & 0x1F\n                        sums[i] = p0 * k0 + p1 * k1 + p2 * k2\n                    state = 2  # COMPUTE_MOD\n                elif state == 2:  # COMPUTE_MOD\n                    mod0 = sums[0] % 26\n                    mod1 = sums[1] % 26\n                    mod2 = sums[2] % 26\n                    ciphertext = mod0 | (mod1 << 5) | (mod2 << 10)\n                    done = 1\n                    state = 3  # DONE\n                elif state == 3:  # DONE\n                    done = 0\n                    state = 0  # IDLE\n    return results\n"
