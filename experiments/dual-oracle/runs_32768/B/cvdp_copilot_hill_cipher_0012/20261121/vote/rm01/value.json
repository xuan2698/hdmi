"def reference(vectors):\n    state = 0\n    ciphertext_reg = 0\n    last_reset = 0\n    last_start = 0\n    last_plaintext = 0\n    last_key = 0\n    out = []\n    for i, row in enumerate(vectors):\n        is_posedge = None\n        if isinstance(row, dict):\n            if 'reset' in row: last_reset = row['reset']\n            if 'start' in row: last_start = row['start']\n            if 'plaintext' in row: last_plaintext = row['plaintext']\n            if 'key' in row: last_key = row['key']\n            if 'clk' in row:\n                v = row['clk']\n                if isinstance(v, str):\n                    is_posedge = v.lower() in ('posedge', 'pos', '1', 'rising', 'rise')\n                else:\n                    is_posedge = (v == 1 or v is True)\n            elif 'edge' in row:\n                v = row['edge']\n                if isinstance(v, str):\n                    is_posedge = v.lower() in ('posedge', 'pos', '1', 'rising', 'rise')\n                else:\n                    is_posedge = (v == 1 or v is True)\n            else:\n                is_posedge = (i % 2 == 0)\n        elif isinstance(row, (list, tuple)):\n            if len(row) >= 1 and isinstance(row[0], str):\n                v = row[0].lower()\n                is_posedge = v in ('posedge', 'pos', '1', 'rising', 'rise')\n                if len(row) >= 5:\n                    last_reset = row[1]\n                    last_start = row[2]\n                    last_plaintext = row[3]\n                    last_key = row[4]\n                elif len(row) >= 4:\n                    last_reset = row[1]\n                    last_start = row[2]\n                    last_plaintext = row[3]\n            else:\n                if len(row) >= 5:\n                    v = row[0]\n                    if isinstance(v, str):\n                        is_posedge = v.lower() in ('posedge', 'pos', '1', 'rising', 'rise')\n                    else:\n                        is_posedge = (v == 1 or v is True)\n                    last_reset = row[1]\n                    last_start = row[2]\n                    last_plaintext = row[3]\n                    last_key = row[4]\n                elif len(row) == 4:\n                    is_posedge = (i % 2 == 0)\n                    last_reset = row[0]\n                    last_start = row[1]\n                    last_plaintext = row[2]\n                    last_key = row[3]\n                else:\n                    is_posedge = (i % 2 == 0)\n        else:\n            is_posedge = (i % 2 == 0)\n\n        if is_posedge is None:\n            is_posedge = (i % 2 == 0)\n\n        done = 1 if state == 3 else 0\n        out.append({'ciphertext': ciphertext_reg & 0x7fff, 'done': done})\n\n        if is_posedge:\n            if last_reset:\n                state = 0\n                ciphertext_reg = 0\n            else:\n                if state == 0:\n                    if last_start:\n                        state = 1\n                    else:\n                        state = 0\n                elif state == 1:\n                    state = 2\n                elif state == 2:\n                    p0 = last_plaintext & 0x1f\n                    p1 = (last_plaintext >> 5) & 0x1f\n                    p2 = (last_plaintext >> 10) & 0x1f\n                    k = last_key\n                    k0 = k & 0x1f\n                    k1 = (k >> 5) & 0x1f\n                    k2 = (k >> 10) & 0x1f\n                    k3 = (k >> 15) & 0x1f\n                    k4 = (k >> 20) & 0x1f\n                    k5 = (k >> 25) & 0x1f\n                    k6 = (k >> 30) & 0x1f\n                    k7 = (k >> 35) & 0x1f\n                    k8 = (k >> 40) & 0x1f\n                    s0 = p0 * k0 + p1 * k1 + p2 * k2\n                    s1 = p0 * k3 + p1 * k4 + p2 * k5\n                    s2 = p0 * k6 + p1 * k7 + p2 * k8\n                    o0 = s0 % 26\n                    o1 = s1 % 26\n                    o2 = s2 % 26\n                    ciphertext_reg = (o2 << 10) | (o1 << 5) | o0\n                    state = 3\n                elif state == 3:\n                    state = 0\n                else:\n                    state = 0\n    return out\n"
