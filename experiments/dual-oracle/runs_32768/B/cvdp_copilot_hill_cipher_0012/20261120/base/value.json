"def reference(vectors):\n    state = 0\n    cipher = 0\n    result = []\n    for row in vectors:\n        result.append({\n            \"ciphertext\": cipher & 0x7fff,\n            \"done\": 1 if state == 3 else 0\n        })\n        edge = row.get(\"edge\", None)\n        is_pos = False\n        if edge is not None:\n            if isinstance(edge, str):\n                e = edge.lower()\n                if \"pos\" in e or e in (\"1\", \"rising\", \"rise\"):\n                    is_pos = True\n                elif \"neg\" in e or e in (\"0\", \"falling\", \"fall\"):\n                    is_pos = False\n                else:\n                    try:\n                        is_pos = int(e) == 1\n                    except:\n                        is_pos = False\n            else:\n                is_pos = (edge == 1 or edge is True)\n        if is_pos:\n            reset = row.get(\"reset\", 0)\n            if reset:\n                state = 0\n                cipher = 0\n            else:\n                start = row.get(\"start\", 0)\n                if state == 0:\n                    if start:\n                        state = 1\n                elif state == 1:\n                    state = 2\n                elif state == 2:\n                    pt = row.get(\"plaintext\", 0)\n                    key = row.get(\"key\", 0)\n                    p0 = pt & 31\n                    p1 = (pt >> 5) & 31\n                    p2 = (pt >> 10) & 31\n                    k0 = key & 31\n                    k1 = (key >> 5) & 31\n                    k2 = (key >> 10) & 31\n                    k3 = (key >> 15) & 31\n                    k4 = (key >> 20) & 31\n                    k5 = (key >> 25) & 31\n                    k6 = (key >> 30) & 31\n                    k7 = (key >> 35) & 31\n                    k8 = (key >> 40) & 31\n                    c0 = (p0 * k0 + p1 * k1 + p2 * k2) % 26\n                    c1 = (p0 * k3 + p1 * k4 + p2 * k5) % 26\n                    c2 = (p0 * k6 + p1 * k7 + p2 * k8) % 26\n                    cipher = (c2 << 10) | (c1 << 5) | c0\n                    state = 3\n                elif state == 3:\n                    state = 0\n    return result\n"
