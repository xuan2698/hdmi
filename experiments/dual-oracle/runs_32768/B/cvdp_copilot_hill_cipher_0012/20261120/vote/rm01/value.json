"def reference(vectors):\n    state = 0\n    cipher = 0\n    sums = [0, 0, 0]\n    p_lat = [0, 0, 0]\n    k_lat = [0, 0, 0, 0, 0, 0, 0, 0, 0]\n    reset = 0\n    start = 0\n    plaintext = 0\n    key = 0\n    prev_clk = 0\n    out = []\n\n    for row in vectors:\n        if 'reset' in row:\n            reset = row['reset']\n        if 'start' in row:\n            start = row['start']\n        if 'plaintext' in row:\n            plaintext = row['plaintext']\n        if 'key' in row:\n            key = row['key']\n\n        is_pos = False\n        if 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                s = e.lower()\n                if s.startswith('p') or s == '1' or s == 'rise' or s == 'rising':\n                    is_pos = True\n            else:\n                if e == 1 or e is True:\n                    is_pos = True\n        elif 'clk' in row:\n            clk = row['clk']\n            if clk == 1 and prev_clk == 0:\n                is_pos = True\n            prev_clk = clk\n\n        out.append({\n            'ciphertext': cipher & 0x7fff,\n            'done': 1 if state == 3 else 0\n        })\n\n        if is_pos:\n            if reset:\n                state = 0\n                cipher = 0\n                sums = [0, 0, 0]\n                p_lat = [0, 0, 0]\n                k_lat = [0, 0, 0, 0, 0, 0, 0, 0, 0]\n            else:\n                if state == 0:\n                    if start:\n                        p_lat = [\n                            plaintext & 31,\n                            (plaintext >> 5) & 31,\n                            (plaintext >> 10) & 31\n                        ]\n                        k_lat = [\n                            key & 31,\n                            (key >> 5) & 31,\n                            (key >> 10) & 31,\n                            (key >> 15) & 31,\n                            (key >> 20) & 31,\n                            (key >> 25) & 31,\n                            (key >> 30) & 31,\n                            (key >> 35) & 31,\n                            (key >> 40) & 31\n                        ]\n                        state = 1\n                elif state == 1:\n                    sums = [\n                        p_lat[0] * k_lat[0] + p_lat[1] * k_lat[1] + p_lat[2] * k_lat[2],\n                        p_lat[0] * k_lat[3] + p_lat[1] * k_lat[4] + p_lat[2] * k_lat[5],\n                        p_lat[0] * k_lat[6] + p_lat[1] * k_lat[7] + p_lat[2] * k_lat[8]\n                    ]\n                    state = 2\n                elif state == 2:\n                    c0 = sums[0] % 26\n                    c1 = sums[1] % 26\n                    c2 = sums[2] % 26\n                    cipher = c0 | (c1 << 5) | (c2 << 10)\n                    state = 3\n                elif state == 3:\n                    state = 0\n\n    return out\n"
