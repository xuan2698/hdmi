"def reference(vectors):\n    state = 0  # 0=IDLE, 1=COMPUTE, 2=COMPUTE_MOD, 3=DONE\n    cipher_reg = 0\n    out = []\n    for i, v in enumerate(vectors):\n        reset = v.get('reset', 0)\n        start = v.get('start', 0)\n        plaintext = v.get('plaintext', 0)\n        key = v.get('key', 0)\n        done = 1 if state == 3 else 0\n        out.append({'ciphertext': cipher_reg, 'done': done})\n        if i % 2 == 0:  # posedge\n            if reset:\n                state = 0\n                cipher_reg = 0\n            else:\n                if state == 0:\n                    if start:\n                        state = 1\n                elif state == 1:\n                    state = 2\n                elif state == 2:\n                    p0 = plaintext & 31\n                    p1 = (plaintext >> 5) & 31\n                    p2 = (plaintext >> 10) & 31\n                    k0 = key & 31\n                    k1 = (key >> 5) & 31\n                    k2 = (key >> 10) & 31\n                    k3 = (key >> 15) & 31\n                    k4 = (key >> 20) & 31\n                    k5 = (key >> 25) & 31\n                    k6 = (key >> 30) & 31\n                    k7 = (key >> 35) & 31\n                    k8 = (key >> 40) & 31\n                    c0 = (p0*k0 + p1*k1 + p2*k2) % 26\n                    c1 = (p0*k3 + p1*k4 + p2*k5) % 26\n                    c2 = (p0*k6 + p1*k7 + p2*k8) % 26\n                    cipher_reg = (c2 << 10) | (c1 << 5) | c0\n                    state = 3\n                elif state == 3:\n                    state = 0\n    return out\n"
