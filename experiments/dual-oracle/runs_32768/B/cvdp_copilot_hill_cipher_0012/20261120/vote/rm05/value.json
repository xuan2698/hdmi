"def reference(vectors):\n    state = 'IDLE'\n    ciphertext_reg = 0\n    done_reg = 0\n    latched_plaintext = 0\n    latched_key = 0\n\n    cur_reset = 0\n    cur_start = 0\n    cur_plaintext = 0\n    cur_key = 0\n\n    prev_clk = 0\n    expect_pos = True\n    out = []\n\n    for row in vectors:\n        if 'reset' in row:\n            cur_reset = row['reset']\n        if 'start' in row:\n            cur_start = row['start']\n        if 'plaintext' in row:\n            cur_plaintext = row['plaintext']\n        if 'key' in row:\n            cur_key = row['key']\n\n        is_pos = False\n        if 'clk' in row:\n            clk = row['clk']\n            is_pos = (prev_clk == 0 and clk == 1)\n            prev_clk = clk\n        elif 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                is_pos = ('pos' in e.lower())\n            else:\n                is_pos = bool(e)\n        else:\n            is_pos = expect_pos\n            expect_pos = not expect_pos\n\n        out.append({\n            'ciphertext': ciphertext_reg & 0x7FFF,\n            'done': done_reg & 1\n        })\n\n        if is_pos:\n            if cur_reset == 1:\n                state = 'IDLE'\n                ciphertext_reg = 0\n                done_reg = 0\n                latched_plaintext = 0\n                latched_key = 0\n            else:\n                if state == 'IDLE':\n                    if cur_start == 1:\n                        latched_plaintext = cur_plaintext & 0x7FFF\n                        latched_key = cur_key & ((1 << 45) - 1)\n                        state = 'COMPUTE'\n                    done_reg = 0\n                elif state == 'COMPUTE':\n                    state = 'COMPUTE_MOD'\n                elif state == 'COMPUTE_MOD':\n                    p = latched_plaintext\n                    k = latched_key\n\n                    p0 = p & 0x1F\n                    p1 = (p >> 5) & 0x1F\n                    p2 = (p >> 10) & 0x1F\n\n                    k0 = k & 0x1F\n                    k1 = (k >> 5) & 0x1F\n                    k2 = (k >> 10) & 0x1F\n                    k3 = (k >> 15) & 0x1F\n                    k4 = (k >> 20) & 0x1F\n                    k5 = (k >> 25) & 0x1F\n                    k6 = (k >> 30) & 0x1F\n                    k7 = (k >> 35) & 0x1F\n                    k8 = (k >> 40) & 0x1F\n\n                    c0 = (p0 * k0 + p1 * k1 + p2 * k2) % 26\n                    c1 = (p0 * k3 + p1 * k4 + p2 * k5) % 26\n                    c2 = (p0 * k6 + p1 * k7 + p2 * k8) % 26\n\n                    ciphertext_reg = c0 | (c1 << 5) | (c2 << 10)\n                    done_reg = 1\n                    state = 'DONE'\n                elif state == 'DONE':\n                    done_reg = 0\n                    state = 'IDLE'\n\n    return out\n"
