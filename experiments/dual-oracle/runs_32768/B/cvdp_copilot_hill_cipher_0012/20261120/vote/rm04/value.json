"def reference(vectors):\n    IDLE, COMPUTE, COMPUTE_MOD, DONE = 0, 1, 2, 3\n    state = IDLE\n    ciphertext = 0\n    sum0 = sum1 = sum2 = 0\n    prev_clk = 0\n    out = []\n    for i, row in enumerate(vectors):\n        if 'clk' in row:\n            clk = row['clk']\n            posedge = (prev_clk == 0 and clk == 1)\n            prev_clk = clk\n        elif 'edge' in row:\n            e = row['edge']\n            posedge = (e == 1 or e == 'posedge')\n        else:\n            posedge = (i % 2 == 0)\n        reset = row.get('reset', 0)\n        start = row.get('start', 0)\n        plaintext = row.get('plaintext', 0)\n        key = row.get('key', 0)\n        done = 1 if state == DONE else 0\n        out.append({'ciphertext': ciphertext, 'done': done})\n        if posedge:\n            if reset:\n                state = IDLE\n                ciphertext = 0\n                sum0 = sum1 = sum2 = 0\n            else:\n                if state == IDLE:\n                    if start:\n                        state = COMPUTE\n                elif state == COMPUTE:\n                    p0 = plaintext & 0x1F\n                    p1 = (plaintext >> 5) & 0x1F\n                    p2 = (plaintext >> 10) & 0x1F\n                    k0 = key & 0x1F\n                    k1 = (key >> 5) & 0x1F\n                    k2 = (key >> 10) & 0x1F\n                    k3 = (key >> 15) & 0x1F\n                    k4 = (key >> 20) & 0x1F\n                    k5 = (key >> 25) & 0x1F\n                    k6 = (key >> 30) & 0x1F\n                    k7 = (key >> 35) & 0x1F\n                    k8 = (key >> 40) & 0x1F\n                    sum0 = k0*p0 + k1*p1 + k2*p2\n                    sum1 = k3*p0 + k4*p1 + k5*p2\n                    sum2 = k6*p0 + k7*p1 + k8*p2\n                    state = COMPUTE_MOD\n                elif state == COMPUTE_MOD:\n                    c0 = sum0 % 26\n                    c1 = sum1 % 26\n                    c2 = sum2 % 26\n                    ciphertext = c0 | (c1 << 5) | (c2 << 10)\n                    state = DONE\n                elif state == DONE:\n                    state = IDLE\n    return out\n"
