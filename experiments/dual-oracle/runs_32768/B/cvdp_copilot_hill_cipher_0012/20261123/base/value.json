"def reference(vectors):\n    IDLE, COMPUTE, COMPUTE_MOD, DONE = 0, 1, 2, 3\n    state = IDLE\n    ciphertext_reg = 0\n    done_reg = 0\n    sum0 = sum1 = sum2 = 0\n    results = []\n    \n    for row in vectors:\n        reset = row.get('reset', 0)\n        start = row.get('start', 0)\n        plaintext = row.get('plaintext', 0)\n        key = row.get('key', 0)\n        edge = row.get('edge', None)\n        \n        is_pos = False\n        if edge is not None:\n            if isinstance(edge, str):\n                if edge.lower().startswith('pos') or edge == '1':\n                    is_pos = True\n            else:\n                if edge == 1:\n                    is_pos = True\n        else:\n            if row.get('posedge', False):\n                is_pos = True\n            elif 'clk' in row:\n                if row['clk'] == 1:\n                    is_pos = True\n        \n        results.append({\n            'ciphertext': ciphertext_reg & 0x7fff,\n            'done': done_reg & 1\n        })\n        \n        if is_pos:\n            next_state = state\n            next_cipher = ciphertext_reg\n            next_done = done_reg\n            next_sum0, next_sum1, next_sum2 = sum0, sum1, sum2\n            \n            if reset:\n                next_state = IDLE\n                next_cipher = 0\n                next_done = 0\n                next_sum0 = next_sum1 = next_sum2 = 0\n            else:\n                if state == IDLE:\n                    next_done = 0\n                    if start:\n                        next_state = COMPUTE\n                elif state == COMPUTE:\n                    p0 = plaintext & 0x1f\n                    p1 = (plaintext >> 5) & 0x1f\n                    p2 = (plaintext >> 10) & 0x1f\n\n                    k00 = key & 0x1f\n                    k01 = (key >> 5) & 0x1f\n                    k02 = (key >> 10) & 0x1f\n                    k10 = (key >> 15) & 0x1f\n                    k11 = (key >> 20) & 0x1f\n                    k12 = (key >> 25) & 0x1f\n                    k20 = (key >> 30) & 0x1f\n                    k21 = (key >> 35) & 0x1f\n                    k22 = (key >> 40) & 0x1f\n\n                    next_sum0 = k00 * p0 + k01 * p1 + k02 * p2\n                    next_sum1 = k10 * p0 + k11 * p1 + k12 * p2\n                    next_sum2 = k20 * p0 + k21 * p1 + k22 * p2\n                    next_state = COMPUTE_MOD\n                elif state == COMPUTE_MOD:\n                    c0 = sum0 % 26\n                    c1 = sum1 % 26\n                    c2 = sum2 % 26\n                    next_cipher = (c2 << 10) | (c1 << 5) | c0\n                    next_state = DONE\n                elif state == DONE:\n                    next_done = 1\n                    next_state = IDLE\n            \n            state = next_state\n            ciphertext_reg = next_cipher\n            done_reg = next_done\n            sum0, sum1, sum2 = next_sum0, next_sum1, next_sum2\n    \n    return results\n"
