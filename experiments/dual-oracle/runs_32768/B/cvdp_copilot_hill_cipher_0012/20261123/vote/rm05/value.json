"def reference(vectors):\n    state = 0  # 0=IDLE, 1=COMPUTE, 2=COMPUTE_MOD, 3=DONE\n    ciphertext = 0\n    reset = start = plaintext = key = 0\n    prev_clk = 0\n    toggle = 0\n    out = []\n\n    for row in vectors:\n        if 'reset' in row: reset = row['reset']\n        if 'start' in row: start = row['start']\n        if 'plaintext' in row: plaintext = row['plaintext']\n        if 'key' in row: key = row['key']\n\n        is_pos = False\n        if 'edge' in row:\n            ed = row['edge']\n            if isinstance(ed, str):\n                s = ed.lower()\n                is_pos = s.startswith('pos') or s == '1'\n            else:\n                is_pos = bool(ed)\n        elif 'clk' in row:\n            clk = row['clk']\n            is_pos = (prev_clk == 0 and clk == 1)\n            prev_clk = clk\n        else:\n            is_pos = (toggle % 2 == 0)\n            toggle += 1\n\n        out.append({\n            'ciphertext': ciphertext & 0x7fff,\n            'done': 1 if state == 3 else 0\n        })\n\n        if is_pos:\n            if reset:\n                state = 0\n                ciphertext = 0\n            else:\n                if state == 0:\n                    if start:\n                        state = 1\n                elif state == 1:\n                    state = 2\n                elif state == 2:\n                    pt0 = plaintext & 0x1f\n                    pt1 = (plaintext >> 5) & 0x1f\n                    pt2 = (plaintext >> 10) & 0x1f\n                    k0 = key & 0x1f\n                    k1 = (key >> 5) & 0x1f\n                    k2 = (key >> 10) & 0x1f\n                    k3 = (key >> 15) & 0x1f\n                    k4 = (key >> 20) & 0x1f\n                    k5 = (key >> 25) & 0x1f\n                    k6 = (key >> 30) & 0x1f\n                    k7 = (key >> 35) & 0x1f\n                    k8 = (key >> 40) & 0x1f\n                    c0 = (pt0 * k0 + pt1 * k1 + pt2 * k2) % 26\n                    c1 = (pt0 * k3 + pt1 * k4 + pt2 * k5) % 26\n                    c2 = (pt0 * k6 + pt1 * k7 + pt2 * k8) % 26\n                    ciphertext = ((c2 & 0x1f) << 10) | ((c1 & 0x1f) << 5) | (c0 & 0x1f)\n                    state = 3\n                elif state == 3:\n                    state = 0\n\n    return out\n"
