"def reference(vectors):\n    IDLE, COMPUTE, COMPUTE_MOD, DONE = 0, 1, 2, 3\n    state = IDLE\n    ciphertext = 0\n    latch_p = 0\n    latch_k = 0\n    out = []\n    prev_clk = 0\n    have_prev = False\n    for i, row in enumerate(vectors):\n        def g(name, default=0):\n            if isinstance(row, dict):\n                return row.get(name, default)\n            return getattr(row, name, default)\n\n        clk = g('clk', None)\n        if clk is None:\n            posedge = (i % 2 == 0)\n        else:\n            clk = 1 if clk else 0\n            if not have_prev:\n                posedge = (clk == 1)\n            else:\n                posedge = (prev_clk == 0 and clk == 1)\n\n        out.append({\n            'ciphertext': ciphertext,\n            'done': 1 if state == DONE else 0\n        })\n\n        if posedge:\n            reset = g('reset', 0)\n            if reset:\n                state = IDLE\n                ciphertext = 0\n                latch_p = 0\n                latch_k = 0\n            else:\n                start = g('start', 0)\n                plaintext = g('plaintext', 0)\n                key = g('key', 0)\n                if state == IDLE:\n                    if start:\n                        latch_p = plaintext & 0x7fff\n                        latch_k = key & ((1 << 45) - 1)\n                        state = COMPUTE\n                elif state == COMPUTE:\n                    state = COMPUTE_MOD\n                elif state == COMPUTE_MOD:\n                    p0 = latch_p & 31\n                    p1 = (latch_p >> 5) & 31\n                    p2 = (latch_p >> 10) & 31\n                    k0 = latch_k & 31\n                    k1 = (latch_k >> 5) & 31\n                    k2 = (latch_k >> 10) & 31\n                    k3 = (latch_k >> 15) & 31\n                    k4 = (latch_k >> 20) & 31\n                    k5 = (latch_k >> 25) & 31\n                    k6 = (latch_k >> 30) & 31\n                    k7 = (latch_k >> 35) & 31\n                    k8 = (latch_k >> 40) & 31\n                    c0 = (p0 * k0 + p1 * k1 + p2 * k2) % 26\n                    c1 = (p0 * k3 + p1 * k4 + p2 * k5) % 26\n                    c2 = (p0 * k6 + p1 * k7 + p2 * k8) % 26\n                    ciphertext = (c0 & 31) | ((c1 & 31) << 5) | ((c2 & 31) << 10)\n                    state = DONE\n                elif state == DONE:\n                    state = IDLE\n\n        if clk is not None:\n            prev_clk = clk\n            have_prev = True\n\n    return out\n"
