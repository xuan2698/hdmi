"def reference(vectors):\n    state = \"IDLE\"\n    cipher = 0\n    latched_p = 0\n    latched_k = 0\n    outs = []\n    expect_pos = 1\n    for row in vectors:\n        try:\n            reset = row[\"reset\"]\n        except:\n            try:\n                reset = row.get(\"reset\", 0)\n            except:\n                reset = 0\n        try:\n            start = row[\"start\"]\n        except:\n            try:\n                start = row.get(\"start\", 0)\n            except:\n                start = 0\n        try:\n            plaintext = row[\"plaintext\"]\n        except:\n            try:\n                plaintext = row.get(\"plaintext\", 0)\n            except:\n                plaintext = 0\n        try:\n            key = row[\"key\"]\n        except:\n            try:\n                key = row.get(\"key\", 0)\n            except:\n                key = 0\n        e = None\n        try:\n            e = row[\"edge\"]\n        except:\n            try:\n                e = row.get(\"edge\", None)\n            except:\n                e = None\n        if e is None:\n            try:\n                e = row[\"clk\"]\n            except:\n                try:\n                    e = row.get(\"clk\", None)\n                except:\n                    e = None\n        is_pos = expect_pos\n        if e is not None:\n            if e == \"posedge\" or e == \"pos\" or e == 1 or e == \"1\":\n                is_pos = 1\n            elif e == \"negedge\" or e == \"neg\" or e == 0 or e == \"0\":\n                is_pos = 0\n            else:\n                is_pos = expect_pos\n        outs.append({\"ciphertext\": cipher & 32767, \"done\": 1 if state == \"DONE\" else 0})\n        if is_pos:\n            if reset:\n                state = \"IDLE\"\n                cipher = 0\n                latched_p = 0\n                latched_k = 0\n            else:\n                if state == \"IDLE\":\n                    if start:\n                        state = \"COMPUTE\"\n                        latched_p = plaintext\n                        latched_k = key\n                elif state == \"COMPUTE\":\n                    state = \"COMPUTE_MOD\"\n                elif state == \"COMPUTE_MOD\":\n                    p0 = latched_p & 31\n                    p1 = (latched_p >> 5) & 31\n                    p2 = (latched_p >> 10) & 31\n                    k0 = latched_k & 31\n                    k1 = (latched_k >> 5) & 31\n                    k2 = (latched_k >> 10) & 31\n                    k3 = (latched_k >> 15) & 31\n                    k4 = (latched_k >> 20) & 31\n                    k5 = (latched_k >> 25) & 31\n                    k6 = (latched_k >> 30) & 31\n                    k7 = (latched_k >> 35) & 31\n                    k8 = (latched_k >> 40) & 31\n                    c0 = (p0 * k0 + p1 * k1 + p2 * k2) % 26\n                    c1 = (p0 * k3 + p1 * k4 + p2 * k5) % 26\n                    c2 = (p0 * k6 + p1 * k7 + p2 * k8) % 26\n                    cipher = c0 | (c1 << 5) | (c2 << 10)\n                    state = \"DONE\"\n                elif state == \"DONE\":\n                    state = \"IDLE\"\n        if expect_pos:\n            expect_pos = 0\n        else:\n            expect_pos = 1\n    return outs\n"
