"def reference(vectors):\n    IDLE, COMPUTE, COMPUTE_MOD, DONE = 0, 1, 2, 3\n    state = IDLE\n    cipher = 0\n    sum0 = sum1 = sum2 = 0\n    out = []\n    prev_clk = None\n\n    def get(row, name, default=0):\n        if isinstance(row, dict):\n            if name in row:\n                return int(row[name])\n            if name.upper() in row:\n                return int(row[name.upper()])\n            return default\n        if hasattr(row, 'get'):\n            try:\n                v = row.get(name, None)\n                if v is not None:\n                    return int(v)\n            except Exception:\n                pass\n        return default\n\n    for i, row in enumerate(vectors):\n        reset = get(row, 'reset', 0) & 1\n        start = get(row, 'start', 0) & 1\n        plaintext = get(row, 'plaintext', 0) & 0x7FFF\n        key = get(row, 'key', 0) & ((1 << 45) - 1)\n\n        done = 1 if state == DONE else 0\n        out.append({'ciphertext': cipher & 0x7FFF, 'done': done})\n\n        is_posedge = (i % 2 == 0)\n        if isinstance(row, dict):\n            if 'edge' in row:\n                e = row['edge']\n                if isinstance(e, str):\n                    is_posedge = e.lower().startswith('pos')\n                else:\n                    is_posedge = bool(e)\n            elif 'clk' in row:\n                clk = int(row['clk']) & 1\n                if prev_clk is None:\n                    is_posedge = (clk == 1)\n                else:\n                    is_posedge = (prev_clk == 0 and clk == 1)\n                prev_clk = clk\n\n        if is_posedge:\n            if reset:\n                state = IDLE\n                cipher = 0\n                sum0 = sum1 = sum2 = 0\n            else:\n                if state == IDLE:\n                    if start:\n                        state = COMPUTE\n                elif state == COMPUTE:\n                    p0 = plaintext & 0x1F\n                    p1 = (plaintext >> 5) & 0x1F\n                    p2 = (plaintext >> 10) & 0x1F\n                    k0 = key & 0x1F\n                    k1 = (key >> 5) & 0x1F\n                    k2 = (key >> 10) & 0x1F\n                    k3 = (key >> 15) & 0x1F\n                    k4 = (key >> 20) & 0x1F\n                    k5 = (key >> 25) & 0x1F\n                    k6 = (key >> 30) & 0x1F\n                    k7 = (key >> 35) & 0x1F\n                    k8 = (key >> 40) & 0x1F\n                    sum0 = p0 * k0 + p1 * k1 + p2 * k2\n                    sum1 = p0 * k3 + p1 * k4 + p2 * k5\n                    sum2 = p0 * k6 + p1 * k7 + p2 * k8\n                    state = COMPUTE_MOD\n                elif state == COMPUTE_MOD:\n                    c0 = sum0 % 26\n                    c1 = sum1 % 26\n                    c2 = sum2 % 26\n                    cipher = c0 | (c1 << 5) | (c2 << 10)\n                    state = DONE\n                elif state == DONE:\n                    state = IDLE\n\n    return out\n"
