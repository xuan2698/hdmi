"def reference(vectors):\n    IDLE, COMPUTE, COMPUTE_MOD, DONE = 0, 1, 2, 3\n    state = IDLE\n    cipher_reg = 0\n    reset = 0\n    start = 0\n    plaintext = 0\n    key = 0\n    prev_clk = 0\n    result = []\n\n    for idx, row in enumerate(vectors):\n        if isinstance(row, dict):\n            if \"reset\" in row:\n                reset = row[\"reset\"]\n            if \"start\" in row:\n                start = row[\"start\"]\n            if \"plaintext\" in row:\n                plaintext = row[\"plaintext\"]\n            if \"key\" in row:\n                key = row[\"key\"]\n\n        reset_i = int(reset) if reset is not None else 0\n        start_i = int(start) if start is not None else 0\n        plaintext_i = int(plaintext) if plaintext is not None else 0\n        key_i = int(key) if key is not None else 0\n\n        posedge = False\n        if isinstance(row, dict):\n            handled = False\n            if \"edge\" in row:\n                e = row[\"edge\"]\n                handled = True\n            elif \"clk_edge\" in row:\n                e = row[\"clk_edge\"]\n                handled = True\n            elif \"edge_type\" in row:\n                e = row[\"edge_type\"]\n                handled = True\n            elif \"posedge\" in row:\n                posedge = bool(row[\"posedge\"])\n                handled = True\n            elif \"negedge\" in row:\n                posedge = not bool(row[\"negedge\"])\n                handled = True\n            elif \"clk\" in row:\n                clk = int(row[\"clk\"])\n                if idx == 0:\n                    posedge = (clk == 1)\n                else:\n                    posedge = (prev_clk == 0 and clk == 1)\n                prev_clk = clk\n                handled = True\n\n            if handled and (\"edge\" in row or \"clk_edge\" in row or \"edge_type\" in row):\n                if isinstance(e, str):\n                    s = e.lower()\n                    if \"pos\" in s or \"rise\" in s:\n                        posedge = True\n                    elif \"neg\" in s or \"fall\" in s:\n                        posedge = False\n                    else:\n                        posedge = bool(int(s)) if s.isdigit() else (idx % 2 == 0)\n                else:\n                    posedge = bool(e)\n            elif not handled:\n                posedge = (idx % 2 == 0)\n        else:\n            posedge = (idx % 2 == 0)\n\n        done_now = 1 if state == DONE else 0\n        result.append({\"ciphertext\": cipher_reg, \"done\": done_now})\n\n        if posedge:\n            if reset_i:\n                state = IDLE\n                cipher_reg = 0\n            else:\n                if state == IDLE:\n                    if start_i:\n                        state = COMPUTE\n                elif state == COMPUTE:\n                    state = COMPUTE_MOD\n                elif state == COMPUTE_MOD:\n                    p0 = plaintext_i & 31\n                    p1 = (plaintext_i >> 5) & 31\n                    p2 = (plaintext_i >> 10) & 31\n\n                    k0 = key_i & 31\n                    k1 = (key_i >> 5) & 31\n                    k2 = (key_i >> 10) & 31\n                    k3 = (key_i >> 15) & 31\n                    k4 = (key_i >> 20) & 31\n                    k5 = (key_i >> 25) & 31\n                    k6 = (key_i >> 30) & 31\n                    k7 = (key_i >> 35) & 31\n                    k8 = (key_i >> 40) & 31\n\n                    c0 = (p0 * k0 + p1 * k1 + p2 * k2) % 26\n                    c1 = (p0 * k3 + p1 * k4 + p2 * k5) % 26\n                    c2 = (p0 * k6 + p1 * k7 + p2 * k8) % 26\n\n                    cipher_reg = c0 | (c1 << 5) | (c2 << 10)\n                    state = DONE\n                elif state == DONE:\n                    state = IDLE\n\n    return result\n"
