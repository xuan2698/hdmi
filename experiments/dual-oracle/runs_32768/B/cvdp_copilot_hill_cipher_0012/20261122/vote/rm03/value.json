"def reference(vectors):\n    state = 0\n    ciphertext = 0\n    sum0 = 0\n    sum1 = 0\n    sum2 = 0\n    p_lat = 0\n    k_lat = 0\n    results = []\n    for i, row in enumerate(vectors):\n        reset = row.get('reset', 0)\n        start = row.get('start', 0)\n        plaintext = row.get('plaintext', 0)\n        key = row.get('key', 0)\n        done = 1 if state == 3 else 0\n        results.append({'ciphertext': ciphertext, 'done': done})\n        if i % 2 == 0:  # posedge\n            if reset:\n                state = 0\n                ciphertext = 0\n                sum0 = sum1 = sum2 = 0\n                p_lat = 0\n                k_lat = 0\n            else:\n                if state == 0:\n                    if start:\n                        p_lat = plaintext\n                        k_lat = key\n                        state = 1\n                elif state == 1:\n                    p0 = p_lat & 0x1F\n                    p1 = (p_lat >> 5) & 0x1F\n                    p2 = (p_lat >> 10) & 0x1F\n                    k00 = k_lat & 0x1F\n                    k01 = (k_lat >> 5) & 0x1F\n                    k02 = (k_lat >> 10) & 0x1F\n                    k10 = (k_lat >> 15) & 0x1F\n                    k11 = (k_lat >> 20) & 0x1F\n                    k12 = (k_lat >> 25) & 0x1F\n                    k20 = (k_lat >> 30) & 0x1F\n                    k21 = (k_lat >> 35) & 0x1F\n                    k22 = (k_lat >> 40) & 0x1F\n                    sum0 = p0 * k00 + p1 * k01 + p2 * k02\n                    sum1 = p0 * k10 + p1 * k11 + p2 * k12\n                    sum2 = p0 * k20 + p1 * k21 + p2 * k22\n                    state = 2\n                elif state == 2:\n                    out0 = sum0 % 26\n                    out1 = sum1 % 26\n                    out2 = sum2 % 26\n                    ciphertext = (out2 << 10) | (out1 << 5) | out0\n                    state = 3\n                elif state == 3:\n                    state = 0\n    return results\n"
