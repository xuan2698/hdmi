"def reference(vectors):\n    state = 0\n    ciphertext = 0\n    done = 0\n    sums = [0, 0, 0]\n    out = []\n    for i, row in enumerate(vectors):\n        if 'clk' in row:\n            is_pos = int(row.get('clk', 0)) != 0\n        else:\n            is_pos = (i % 2 == 0)\n        out.append({'ciphertext': ciphertext & 0x7fff, 'done': done & 1})\n        if not is_pos:\n            continue\n        if int(row.get('reset', 0)) & 1:\n            state = 0\n            ciphertext = 0\n            done = 0\n            sums = [0, 0, 0]\n        else:\n            start = int(row.get('start', 0)) & 1\n            if state == 0:\n                done = 0\n                if start:\n                    state = 1\n            elif state == 1:\n                pt = int(row.get('plaintext', 0)) & 0x7fff\n                key = int(row.get('key', 0)) & ((1 << 45) - 1)\n                p0 = pt & 31\n                p1 = (pt >> 5) & 31\n                p2 = (pt >> 10) & 31\n                k0 = key & 31\n                k1 = (key >> 5) & 31\n                k2 = (key >> 10) & 31\n                k3 = (key >> 15) & 31\n                k4 = (key >> 20) & 31\n                k5 = (key >> 25) & 31\n                k6 = (key >> 30) & 31\n                k7 = (key >> 35) & 31\n                k8 = (key >> 40) & 31\n                sums[0] = p0 * k0 + p1 * k1 + p2 * k2\n                sums[1] = p0 * k3 + p1 * k4 + p2 * k5\n                sums[2] = p0 * k6 + p1 * k7 + p2 * k8\n                state = 2\n            elif state == 2:\n                c0 = sums[0] % 26\n                c1 = sums[1] % 26\n                c2 = sums[2] % 26\n                ciphertext = c0 | (c1 << 5) | (c2 << 10)\n                state = 3\n            elif state == 3:\n                done = 1\n                state = 0\n    return out\n"
