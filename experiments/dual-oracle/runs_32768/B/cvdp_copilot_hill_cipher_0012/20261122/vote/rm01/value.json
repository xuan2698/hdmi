"def reference(vectors):\n    state = 0\n    ciphertext_reg = 0\n    sums = [0, 0, 0]\n    out = []\n    for i, row in enumerate(vectors):\n        out.append({\n            'ciphertext': ciphertext_reg & 0x7FFF,\n            'done': 1 if state == 3 else 0\n        })\n        if i % 2 == 0:\n            reset = row.get('reset', 0) & 1\n            start = row.get('start', 0) & 1\n            plaintext = row.get('plaintext', 0) & 0x7FFF\n            key = row.get('key', 0) & ((1 << 45) - 1)\n            if reset:\n                state = 0\n                ciphertext_reg = 0\n                sums = [0, 0, 0]\n            else:\n                if state == 0:\n                    if start:\n                        state = 1\n                elif state == 1:\n                    p0 = plaintext & 0x1F\n                    p1 = (plaintext >> 5) & 0x1F\n                    p2 = (plaintext >> 10) & 0x1F\n                    k0 = key & 0x1F\n                    k1 = (key >> 5) & 0x1F\n                    k2 = (key >> 10) & 0x1F\n                    k3 = (key >> 15) & 0x1F\n                    k4 = (key >> 20) & 0x1F\n                    k5 = (key >> 25) & 0x1F\n                    k6 = (key >> 30) & 0x1F\n                    k7 = (key >> 35) & 0x1F\n                    k8 = (key >> 40) & 0x1F\n                    sums[0] = p0 * k0 + p1 * k1 + p2 * k2\n                    sums[1] = p0 * k3 + p1 * k4 + p2 * k5\n                    sums[2] = p0 * k6 + p1 * k7 + p2 * k8\n                    state = 2\n                elif state == 2:\n                    c0 = sums[0] % 26\n                    c1 = sums[1] % 26\n                    c2 = sums[2] % 26\n                    ciphertext_reg = (c2 << 10) | (c1 << 5) | c0\n                    state = 3\n                elif state == 3:\n                    state = 0\n    return out\n"
