"def reference(vectors):\n    state = 0  # 0=IDLE, 1=COMPUTE, 2=COMPUTE_MOD, 3=DONE\n    cipher = 0\n    sum0 = sum1 = sum2 = 0\n    outs = []\n\n    for row in vectors:\n        is_pos = True\n        if isinstance(row, dict):\n            if 'edge' in row:\n                e = row['edge']\n                if isinstance(e, str):\n                    s = e.lower()\n                    if 'pos' in s:\n                        is_pos = True\n                    elif 'neg' in s:\n                        is_pos = False\n                    else:\n                        try:\n                            is_pos = int(s) != 0\n                        except:\n                            is_pos = True\n                else:\n                    is_pos = bool(e)\n            elif 'clk' in row:\n                e = row['clk']\n                if isinstance(e, str):\n                    s = e.lower()\n                    is_pos = s not in ('0', 'false', 'neg', 'negedge')\n                else:\n                    is_pos = bool(e)\n            elif 'posedge' in row:\n                is_pos = bool(row['posedge'])\n\n        outs.append({\n            'ciphertext': cipher & 0x7FFF,\n            'done': 1 if state == 3 else 0\n        })\n\n        if is_pos:\n            reset = 0\n            start = 0\n            plaintext = 0\n            key = 0\n            if isinstance(row, dict):\n                reset = int(row.get('reset', 0))\n                start = int(row.get('start', 0))\n                plaintext = int(row.get('plaintext', 0))\n                key = int(row.get('key', 0))\n\n            if reset:\n                state = 0\n                cipher = 0\n                sum0 = sum1 = sum2 = 0\n            else:\n                if state == 0:\n                    if start:\n                        state = 1\n                elif state == 1:\n                    p0 = plaintext & 31\n                    p1 = (plaintext >> 5) & 31\n                    p2 = (plaintext >> 10) & 31\n\n                    k0 = key & 31\n                    k1 = (key >> 5) & 31\n                    k2 = (key >> 10) & 31\n                    k3 = (key >> 15) & 31\n                    k4 = (key >> 20) & 31\n                    k5 = (key >> 25) & 31\n                    k6 = (key >> 30) & 31\n                    k7 = (key >> 35) & 31\n                    k8 = (key >> 40) & 31\n\n                    sum0 = k0 * p0 + k1 * p1 + k2 * p2\n                    sum1 = k3 * p0 + k4 * p1 + k5 * p2\n                    sum2 = k6 * p0 + k7 * p1 + k8 * p2\n                    state = 2\n                elif state == 2:\n                    c0 = sum0 % 26\n                    c1 = sum1 % 26\n                    c2 = sum2 % 26\n                    cipher = c0 | (c1 << 5) | (c2 << 10)\n                    state = 3\n                elif state == 3:\n                    state = 0\n\n    return outs\n"
