"def reference(vectors):\n    IDLE, COMPUTE, COMPUTE_MOD, DONE = 0, 1, 2, 3\n    state = IDLE\n    ciphertext_reg = 0\n    done_reg = 0\n    pt_reg = 0\n    key_reg = 0\n    sum0 = sum1 = sum2 = 0\n    last_reset = 0\n    last_start = 0\n    last_plaintext = 0\n    last_key = 0\n    prev_clk = None\n    edge_toggle = 0\n    results = []\n    for v in vectors:\n        reset = int(v.get('reset', last_reset)) if 'reset' in v else last_reset\n        start = int(v.get('start', last_start)) if 'start' in v else last_start\n        plaintext = int(v.get('plaintext', last_plaintext)) if 'plaintext' in v else last_plaintext\n        key = int(v.get('key', last_key)) if 'key' in v else last_key\n        last_reset, last_start, last_plaintext, last_key = reset, start, plaintext, key\n\n        is_posedge = False\n        is_negedge = False\n        if 'edge' in v:\n            e = v['edge']\n            if isinstance(e, str):\n                el = e.lower()\n                if 'pos' in el:\n                    is_posedge = True\n                elif 'neg' in el:\n                    is_negedge = True\n            else:\n                if e == 1:\n                    is_posedge = True\n                elif e == 0:\n                    is_negedge = True\n        if not is_posedge and not is_negedge:\n            if 'clk' in v:\n                clk_val = int(v['clk'])\n                if prev_clk is None:\n                    if clk_val == 1:\n                        is_posedge = True\n                    else:\n                        is_negedge = True\n                else:\n                    if prev_clk == 0 and clk_val == 1:\n                        is_posedge = True\n                    elif prev_clk == 1 and clk_val == 0:\n                        is_negedge = True\n                prev_clk = clk_val\n            else:\n                if edge_toggle % 2 == 0:\n                    is_posedge = True\n                else:\n                    is_negedge = True\n                edge_toggle += 1\n        else:\n            if 'clk' in v:\n                prev_clk = int(v['clk'])\n\n        results.append({\n            'ciphertext': ciphertext_reg & 0x7FFF,\n            'done': done_reg & 1\n        })\n\n        if is_posedge:\n            if reset:\n                state = IDLE\n                ciphertext_reg = 0\n                done_reg = 0\n                pt_reg = 0\n                key_reg = 0\n                sum0 = sum1 = sum2 = 0\n            else:\n                if state == IDLE:\n                    done_reg = 0\n                    if start:\n                        pt_reg = plaintext\n                        key_reg = key\n                        state = COMPUTE\n                elif state == COMPUTE:\n                    k00 = key_reg & 0x1F\n                    k01 = (key_reg >> 5) & 0x1F\n                    k02 = (key_reg >> 10) & 0x1F\n                    k10 = (key_reg >> 15) & 0x1F\n                    k11 = (key_reg >> 20) & 0x1F\n                    k12 = (key_reg >> 25) & 0x1F\n                    k20 = (key_reg >> 30) & 0x1F\n                    k21 = (key_reg >> 35) & 0x1F\n                    k22 = (key_reg >> 40) & 0x1F\n                    p0 = pt_reg & 0x1F\n                    p1 = (pt_reg >> 5) & 0x1F\n                    p2 = (pt_reg >> 10) & 0x1F\n                    sum0 = k00 * p0 + k01 * p1 + k02 * p2\n                    sum1 = k10 * p0 + k11 * p1 + k12 * p2\n                    sum2 = k20 * p0 + k21 * p1 + k22 * p2\n                    state = COMPUTE_MOD\n                elif state == COMPUTE_MOD:\n                    ciphertext_reg = (sum0 % 26) | ((sum1 % 26) << 5) | ((sum2 % 26) << 10)\n                    done_reg = 1\n                    state = DONE\n                elif state == DONE:\n                    done_reg = 0\n                    state = IDLE\n    return results\n"
