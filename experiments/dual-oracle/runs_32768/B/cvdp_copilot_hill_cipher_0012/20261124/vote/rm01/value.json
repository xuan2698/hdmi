"def reference(vectors):\n    state = 0\n    ciphertext = 0\n    sums = [0, 0, 0]\n    out = []\n\n    for i, row in enumerate(vectors):\n        if isinstance(row, dict):\n            edge = row.get('edge', None)\n            reset = row.get('reset', 0)\n            start = row.get('start', 0)\n            plaintext = row.get('plaintext', 0)\n            key = row.get('key', 0)\n        else:\n            if len(row) >= 5 and isinstance(row[0], str):\n                edge, reset, start, plaintext, key = row[0], row[1], row[2], row[3], row[4]\n            elif len(row) == 5:\n                edge, reset, start, plaintext, key = row\n            elif len(row) == 4:\n                edge = None\n                reset, start, plaintext, key = row\n            else:\n                edge = None\n                reset = start = plaintext = key = 0\n\n        if edge is None:\n            is_pos = (i % 2 == 0)\n        elif isinstance(edge, str):\n            s = edge.lower()\n            if s.startswith('p') or 'pos' in s:\n                is_pos = True\n            elif s.startswith('n') or 'neg' in s:\n                is_pos = False\n            else:\n                is_pos = (i % 2 == 0)\n        elif isinstance(edge, int):\n            is_pos = (edge != 0)\n        else:\n            is_pos = (i % 2 == 0)\n\n        out.append({'ciphertext': ciphertext, 'done': 1 if state == 3 else 0})\n\n        if is_pos:\n            if reset:\n                state = 0\n                ciphertext = 0\n                sums = [0, 0, 0]\n            else:\n                if state == 0:\n                    if start:\n                        state = 1\n                elif state == 1:\n                    p0 = plaintext & 0x1F\n                    p1 = (plaintext >> 5) & 0x1F\n                    p2 = (plaintext >> 10) & 0x1F\n\n                    k0 = key & 0x1F\n                    k1 = (key >> 5) & 0x1F\n                    k2 = (key >> 10) & 0x1F\n                    k3 = (key >> 15) & 0x1F\n                    k4 = (key >> 20) & 0x1F\n                    k5 = (key >> 25) & 0x1F\n                    k6 = (key >> 30) & 0x1F\n                    k7 = (key >> 35) & 0x1F\n                    k8 = (key >> 40) & 0x1F\n\n                    s0 = p0 * k0 + p1 * k1 + p2 * k2\n                    s1 = p0 * k3 + p1 * k4 + p2 * k5\n                    s2 = p0 * k6 + p1 * k7 + p2 * k8\n                    sums = [s0, s1, s2]\n                    state = 2\n                elif state == 2:\n                    r0 = sums[0] % 26\n                    r1 = sums[1] % 26\n                    r2 = sums[2] % 26\n                    ciphertext = r0 | (r1 << 5) | (r2 << 10)\n                    state = 3\n                elif state == 3:\n                    state = 0\n\n    return out\n"
