"def reference(vectors):\n    state = 0\n    ciphertext = 0\n    s0 = s1 = s2 = 0\n    out = []\n    prev_clk = 0\n    for i, row in enumerate(vectors):\n        if 'edge' in row:\n            ed = row['edge']\n            if isinstance(ed, str):\n                posedge = ed.lower() in ('posedge', 'pos', '1')\n            else:\n                posedge = bool(ed)\n        elif 'clk' in row:\n            clk = 1 if row['clk'] else 0\n            posedge = (prev_clk == 0 and clk == 1)\n        else:\n            posedge = (i % 2 == 0)\n        done = 1 if state == 3 else 0\n        out.append({'ciphertext': ciphertext & 0x7fff, 'done': done & 1})\n        if posedge:\n            if row.get('reset', 0):\n                state = 0\n                ciphertext = 0\n                s0 = s1 = s2 = 0\n            else:\n                if state == 0:\n                    if row.get('start', 0):\n                        state = 1\n                elif state == 1:\n                    p = int(row.get('plaintext', 0)) & 0x7fff\n                    k = int(row.get('key', 0)) & ((1 << 45) - 1)\n                    p0 = p & 31\n                    p1 = (p >> 5) & 31\n                    p2 = (p >> 10) & 31\n                    k00 = k & 31\n                    k01 = (k >> 5) & 31\n                    k02 = (k >> 10) & 31\n                    k10 = (k >> 15) & 31\n                    k11 = (k >> 20) & 31\n                    k12 = (k >> 25) & 31\n                    k20 = (k >> 30) & 31\n                    k21 = (k >> 35) & 31\n                    k22 = (k >> 40) & 31\n                    s0 = p0 * k00 + p1 * k01 + p2 * k02\n                    s1 = p0 * k10 + p1 * k11 + p2 * k12\n                    s2 = p0 * k20 + p1 * k21 + p2 * k22\n                    state = 2\n                elif state == 2:\n                    c0 = s0 % 26\n                    c1 = s1 % 26\n                    c2 = s2 % 26\n                    ciphertext = c0 | (c1 << 5) | (c2 << 10)\n                    state = 3\n                elif state == 3:\n                    state = 0\n        if 'clk' in row:\n            prev_clk = 1 if row['clk'] else 0\n    return out\n"
