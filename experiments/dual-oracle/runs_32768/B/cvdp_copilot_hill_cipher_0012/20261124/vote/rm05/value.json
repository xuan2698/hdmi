"def reference(vectors):\n    state = 0  # 0 IDLE, 1 COMPUTE, 2 COMPUTE_MOD, 3 DONE\n    cipher = 0\n    p_lat = 0\n    k_lat = 0\n    sum0 = sum1 = sum2 = 0\n    out = []\n    prev_clk = None\n    alt_pos = True\n\n    for row in vectors:\n        edge = None\n        if 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                s = e.lower()\n                if 'pos' in s:\n                    edge = 'pos'\n                elif 'neg' in s:\n                    edge = 'neg'\n                else:\n                    edge = 'pos' if e.strip() in ('1', 'true') else 'neg'\n            else:\n                edge = 'pos' if e else 'neg'\n        elif 'clk' in row:\n            clk = row['clk']\n            if prev_clk is None:\n                edge = 'pos' if clk else 'neg'\n            else:\n                if clk == 1 and prev_clk == 0:\n                    edge = 'pos'\n                elif clk == 0 and prev_clk == 1:\n                    edge = 'neg'\n                else:\n                    edge = 'pos' if clk else 'neg'\n            prev_clk = clk\n        else:\n            edge = 'pos' if alt_pos else 'neg'\n            alt_pos = not alt_pos\n\n        reset = row.get('reset', 0)\n        start = row.get('start', 0)\n        plain = row.get('plaintext', 0)\n        key = row.get('key', 0)\n\n        out.append({\n            'ciphertext': cipher,\n            'done': 1 if state == 3 else 0\n        })\n\n        if edge == 'pos':\n            if reset:\n                state = 0\n                cipher = 0\n                p_lat = 0\n                k_lat = 0\n                sum0 = sum1 = sum2 = 0\n            else:\n                if state == 0:\n                    if start:\n                        p_lat = plain\n                        k_lat = key\n                        state = 1\n                elif state == 1:\n                    p0 = p_lat & 31\n                    p1 = (p_lat >> 5) & 31\n                    p2 = (p_lat >> 10) & 31\n\n                    k0 = k_lat & 31\n                    k1 = (k_lat >> 5) & 31\n                    k2 = (k_lat >> 10) & 31\n                    k3 = (k_lat >> 15) & 31\n                    k4 = (k_lat >> 20) & 31\n                    k5 = (k_lat >> 25) & 31\n                    k6 = (k_lat >> 30) & 31\n                    k7 = (k_lat >> 35) & 31\n                    k8 = (k_lat >> 40) & 31\n\n                    sum0 = p0 * k0 + p1 * k1 + p2 * k2\n                    sum1 = p0 * k3 + p1 * k4 + p2 * k5\n                    sum2 = p0 * k6 + p1 * k7 + p2 * k8\n                    state = 2\n                elif state == 2:\n                    c0 = sum0 % 26\n                    c1 = sum1 % 26\n                    c2 = sum2 % 26\n                    cipher = c0 | (c1 << 5) | (c2 << 10)\n                    state = 3\n                elif state == 3:\n                    state = 0\n\n    return out\n"
