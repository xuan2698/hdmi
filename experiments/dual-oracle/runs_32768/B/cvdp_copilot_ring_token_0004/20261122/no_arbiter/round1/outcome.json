{
  "decisions": [],
  "RM": "def reference(vectors):\n    state = 0\n    out = []\n    for idx, row in enumerate(vectors):\n        if isinstance(row, dict):\n            clk = row.get('clk')\n            rst = row.get('rst', 0)\n            data_in = row.get('data_in', 0)\n            has_data = row.get('has_data_to_send', 0)\n        else:\n            if len(row) >= 4:\n                clk, rst, data_in, has_data = row[0], row[1], row[2], row[3]\n            elif len(row) == 3:\n                clk = None\n                rst, data_in, has_data = row[0], row[1], row[2]\n            else:\n                clk = None\n                rst = data_in = has_data = 0\n        try:\n            rst = int(rst) & 1\n        except:\n            rst = 0\n        try:\n            data_in = int(data_in) & 0xF\n        except:\n            data_in = 0\n        try:\n            has_data = int(has_data) & 1\n        except:\n            has_data = 0\n        if clk is None:\n            is_posedge = (idx % 2 == 0)\n        else:\n            if isinstance(clk, str):\n                is_posedge = ('pos' in clk.lower())\n            else:\n                is_posedge = (int(clk) == 1)\n        if rst:\n            state = 0\n        if rst:\n            data_out = 0\n            token_received = 1\n            token = 0\n        else:\n            token_received = 1 << state\n            token = 1 << ((state + 1) % 4)\n            data_out = data_in if has_data else 0\n        out.append({\n            'data_out': data_out,\n            'token_received': token_received,\n            'token': token\n        })\n        if is_posedge:\n            if rst:\n                state = 0\n            else:\n                state = (state + 1) % 4\n    return out\n",
