"def reference(vectors):\n    state = 0\n    result = []\n    for i, row in enumerate(vectors):\n        if isinstance(row, dict):\n            rst = int(row.get('rst', 0))\n            data_in = int(row.get('data_in', 0))\n            has = int(row.get('has_data_to_send', 0))\n            if 'edge' in row:\n                e = row['edge']\n                if isinstance(e, str):\n                    posedge = e.lower().startswith('pos') or e == '1'\n                else:\n                    posedge = int(e) != 0\n            elif 'clk' in row:\n                posedge = int(row['clk']) != 0\n            else:\n                posedge = (i % 2 == 0)\n        else:\n            vals = list(row)\n            rst = int(vals[0]) if len(vals) > 0 else 0\n            data_in = int(vals[1]) if len(vals) > 1 else 0\n            has = int(vals[2]) if len(vals) > 2 else 0\n            posedge = (i % 2 == 0)\n            if len(vals) > 3:\n                posedge = int(vals[3]) != 0\n\n        if rst:\n            state = 0\n\n        if rst:\n            token_received = 1\n            token = 0\n            data_out = 0\n        else:\n            token_received = 1 << (state % 4)\n            next_state = (state + 1) % 4\n            token = 1 << next_state\n            data_out = (data_in & 0xF) if has else 0\n\n        result.append({\n            'data_out': data_out & 0xF,\n            'token_received': token_received & 0xF,\n            'token': token & 0xF\n        })\n\n        if posedge and not rst:\n            state = (state + 1) % 4\n\n    return result\n"
