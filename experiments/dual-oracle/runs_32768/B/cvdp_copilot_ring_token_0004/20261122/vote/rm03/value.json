"def reference(vectors):\n    token_received = 1\n    results = []\n    for idx, row in enumerate(vectors):\n        if 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                edge = 'posedge' if 'pos' in e.lower() else 'negedge'\n            else:\n                edge = 'posedge' if e == 1 else 'negedge'\n        elif 'clk' in row:\n            v = row['clk']\n            if isinstance(v, str):\n                edge = 'posedge' if 'pos' in v.lower() else 'negedge'\n            else:\n                edge = 'posedge' if v == 1 else 'negedge'\n        else:\n            edge = 'posedge' if idx % 2 == 0 else 'negedge'\n\n        rst = row.get('rst', 0)\n        if rst == 1:\n            token_received = 1\n            token_received_out = 1\n            token_out = 0\n            data_out = 0\n        else:\n            token_received_out = token_received & 0xF\n            token_out = ((token_received << 1) & 0xF) | ((token_received >> 3) & 0xF)\n            has = row.get('has_data_to_send', 0)\n            if token_received != 0 and has == 1:\n                data_out = row.get('data_in', 0) & 0xF\n            else:\n                data_out = 0\n\n        results.append({\n            'data_out': data_out & 0xF,\n            'token_received': token_received_out & 0xF,\n            'token': token_out & 0xF\n        })\n\n        if edge == 'posedge' and rst != 1:\n            token_received = token_out\n\n    return results\n"
