"def reference(vectors):\n    state = 1\n    res = []\n    for i, row in enumerate(vectors):\n        rst = row.get('rst', 0)\n        data_in = row.get('data_in', 0) & 15\n        has = row.get('has_data_to_send', 0)\n        edge = row.get('edge', None)\n        if edge is None:\n            clk = row.get('clk', None)\n            if clk is None:\n                is_pos = (i % 2 == 0)\n            elif isinstance(clk, str):\n                is_pos = clk.lower().startswith('p')\n            else:\n                is_pos = (int(clk) == 1)\n        else:\n            if isinstance(edge, str):\n                is_pos = edge.lower().startswith('p')\n            else:\n                is_pos = bool(edge)\n        if rst:\n            state = 1\n        if state == 1:\n            nxt = 2\n        elif state == 2:\n            nxt = 4\n        elif state == 4:\n            nxt = 8\n        elif state == 8:\n            nxt = 1\n        else:\n            nxt = 1\n        token_received = state\n        token = 0 if rst else nxt\n        if (not rst) and has and state in (1, 2, 4, 8):\n            data_out = data_in\n        else:\n            data_out = 0\n        res.append({'data_out': data_out, 'token_received': token_received, 'token': token})\n        if is_pos and not rst:\n            state = nxt\n    return res\n"
