"def reference(vectors):\n    state = 1\n    results = []\n    for i, row in enumerate(vectors):\n        rst = 0\n        data_in = 0\n        has = 0\n        is_pos = (i % 2 == 0)\n        if isinstance(row, dict):\n            rst = int(row.get('rst', 0)) & 1\n            data_in = int(row.get('data_in', 0)) & 0xF\n            has = int(row.get('has_data_to_send', 0)) & 1\n            if 'edge' in row:\n                v = row['edge']\n                if isinstance(v, str):\n                    s = v.lower()\n                    if 'pos' in s or 'rise' in s:\n                        is_pos = True\n                    elif 'neg' in s or 'fall' in s:\n                        is_pos = False\n                else:\n                    is_pos = bool(v)\n            elif 'clk' in row:\n                v = row['clk']\n                if isinstance(v, str):\n                    s = v.lower()\n                    if 'pos' in s or 'rise' in s or s == '1':\n                        is_pos = True\n                    elif 'neg' in s or 'fall' in s or s == '0':\n                        is_pos = False\n                else:\n                    is_pos = bool(v)\n            elif 'posedge' in row:\n                is_pos = bool(row['posedge'])\n            elif 'negedge' in row:\n                is_pos = not bool(row['negedge'])\n        elif isinstance(row, (list, tuple)):\n            vals = list(row)\n            if vals and isinstance(vals[0], str):\n                s = vals[0].lower()\n                if 'pos' in s or 'rise' in s:\n                    is_pos = True\n                    vals = vals[1:]\n                elif 'neg' in s or 'fall' in s:\n                    is_pos = False\n                    vals = vals[1:]\n            elif len(vals) == 4 and isinstance(vals[0], (int, bool)) and vals[0] in (0, 1):\n                is_pos = bool(vals[0])\n                vals = vals[1:]\n            if len(vals) >= 3:\n                rst = int(vals[0]) & 1\n                data_in = int(vals[1]) & 0xF\n                has = int(vals[2]) & 1\n            elif len(vals) == 2:\n                rst = 0\n                data_in = int(vals[0]) & 0xF\n                has = int(vals[1]) & 1\n            elif len(vals) == 1:\n                rst = int(vals[0]) & 1\n                data_in = 0\n                has = 0\n        if rst:\n            state = 1\n        if state not in (1, 2, 4, 8):\n            state = 1\n        if rst:\n            data_out = 0\n            tr_out = 1\n            token_out = 0\n        else:\n            data_out = data_in if has else 0\n            tr_out = state & 0xF\n            token_out = ((state << 1) | (state >> 3)) & 0xF\n        results.append({\n            'data_out': data_out & 0xF,\n            'token_received': tr_out & 0xF,\n            'token': token_out & 0xF\n        })\n        if is_pos:\n            if rst:\n                state = 1\n            else:\n                state = token_out\n    return results\n"
