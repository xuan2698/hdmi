"def reference(vectors):\n    node = 0\n    tr = 1\n    tok = 0\n    dout = 0\n    result = []\n    for i, row in enumerate(vectors):\n        rst = row.get('rst', 0) if isinstance(row, dict) else 0\n        data_in = row.get('data_in', 0) if isinstance(row, dict) else 0\n        has = row.get('has_data_to_send', 0) if isinstance(row, dict) else 0\n        rst = 1 if rst else 0\n        has = 1 if has else 0\n        data_in = data_in & 0xF\n\n        posedge = None\n        if isinstance(row, dict):\n            if 'edge' in row:\n                ev = row['edge']\n                if isinstance(ev, str):\n                    posedge = ev.lower().startswith('pos')\n                else:\n                    posedge = bool(ev)\n            elif 'clk' in row:\n                posedge = bool(row['clk'])\n        if posedge is None:\n            posedge = (i % 2 == 0)\n\n        if rst:\n            node = 0\n            tr = 1\n            tok = 0\n            dout = 0\n\n        result.append({\n            'data_out': dout & 0xF,\n            'token_received': tr & 0xF,\n            'token': tok & 0xF\n        })\n\n        if posedge and not rst:\n            next_dout = data_in if has else 0\n            next_tok = tr\n            next_node = (node + 1) % 4\n            next_tr = 1 << next_node\n            node = next_node\n            tr = next_tr\n            tok = next_tok\n            dout = next_dout\n\n    return result\n"
