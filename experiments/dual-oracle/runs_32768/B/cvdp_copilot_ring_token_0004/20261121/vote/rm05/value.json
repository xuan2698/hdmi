"def reference(vectors):\n    node = 0\n    out_rows = []\n    for i, row in enumerate(vectors):\n        if isinstance(row, dict):\n            rst = int(row.get('rst', 0))\n            data_in = int(row.get('data_in', 0)) & 0xF\n            has = int(row.get('has_data_to_send', 0)) & 1\n            if 'edge' in row:\n                e = row['edge']\n                if isinstance(e, str):\n                    el = e.lower()\n                    if 'pos' in el or el in ('1', 'true', 'high'):\n                        is_pos = True\n                    elif 'neg' in el or el in ('0', 'false', 'low'):\n                        is_pos = False\n                    else:\n                        is_pos = (i % 2 == 0)\n                else:\n                    is_pos = bool(e)\n            elif 'posedge' in row:\n                is_pos = bool(row['posedge'])\n            elif 'clk' in row:\n                is_pos = (int(row['clk']) == 1)\n            else:\n                is_pos = (i % 2 == 0)\n        else:\n            if isinstance(row, (list, tuple)):\n                if len(row) >= 3:\n                    rst = int(row[0])\n                    data_in = int(row[1]) & 0xF\n                    has = int(row[2]) & 1\n                elif len(row) == 2:\n                    rst = int(row[0])\n                    data_in = int(row[1]) & 0xF\n                    has = 0\n                elif len(row) == 1:\n                    rst = int(row[0])\n                    data_in = 0\n                    has = 0\n                else:\n                    rst = 0\n                    data_in = 0\n                    has = 0\n                if len(row) >= 4:\n                    is_pos = (int(row[3]) == 1)\n                else:\n                    is_pos = (i % 2 == 0)\n            else:\n                rst = 0\n                data_in = 0\n                has = 0\n                is_pos = (i % 2 == 0)\n\n        if rst:\n            node = 0\n            out_data = 0\n            out_tr = 1\n            out_token = 0\n        else:\n            out_tr = 1 << node\n            out_token = 1 << ((node + 1) % 4)\n            out_data = data_in if has else 0\n\n        out_rows.append({\n            'data_out': out_data,\n            'token_received': out_tr,\n            'token': out_token\n        })\n\n        if is_pos and not rst:\n            node = (node + 1) % 4\n\n    return out_rows\n"
