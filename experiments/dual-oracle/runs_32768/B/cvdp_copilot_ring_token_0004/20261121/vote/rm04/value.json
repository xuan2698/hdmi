"def reference(vectors):\n    state = 1  # NODE0\n    prev_clk = None\n    result = []\n    for i, row in enumerate(vectors):\n        rst = row.get('rst', 0)\n        data_in = row.get('data_in', 0) & 0xF\n        has_data = row.get('has_data_to_send', 0)\n        \n        # Determine if this row is a posedge\n        is_posedge = False\n        edge = row.get('edge', None)\n        if edge is not None:\n            if isinstance(edge, str):\n                if 'pos' in edge.lower():\n                    is_posedge = True\n            else:\n                if edge == 1:\n                    is_posedge = True\n        else:\n            clk = row.get('clk', None)\n            if clk is not None:\n                if prev_clk is None:\n                    is_posedge = (i % 2 == 0)\n                else:\n                    is_posedge = (prev_clk == 0 and clk == 1)\n                prev_clk = clk\n            else:\n                is_posedge = (i % 2 == 0)\n        \n        # Asynchronous reset applies immediately\n        if rst:\n            state = 1\n        \n        if rst:\n            token_received = 1\n            data_out = 0\n            token = 0\n        else:\n            token_received = state & 0xF\n            token = ((state << 1) | (state >> 3)) & 0xF\n            if has_data and state != 0:\n                data_out = data_in\n            else:\n                data_out = 0\n        \n        result.append({\n            'data_out': data_out,\n            'token_received': token_received,\n            'token': token\n        })\n        \n        # State update after posedge, using next-state logic\n        if is_posedge:\n            if rst:\n                state = 1\n            else:\n                nxt = ((state << 1) | (state >> 3)) & 0xF\n                if state not in (1, 2, 4, 8):\n                    nxt = 1\n                state = nxt\n    return result\n"
