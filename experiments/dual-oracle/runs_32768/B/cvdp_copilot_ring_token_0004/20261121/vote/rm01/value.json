"def reference(vectors):\n    state = 0\n    res = []\n    for i, row in enumerate(vectors):\n        r = {str(k).lower(): v for k, v in row.items()} if isinstance(row, dict) else {}\n        rst = r.get('rst', 0)\n        data_in = r.get('data_in', 0)\n        has_data = r.get('has_data_to_send', 0)\n\n        if 'clk' in r:\n            is_pos = (r['clk'] == 1)\n        elif 'edge' in r:\n            e = str(r['edge']).lower()\n            is_pos = ('posedge' in e)\n        elif 'posedge' in r:\n            is_pos = bool(r['posedge'])\n        elif 'negedge' in r:\n            is_pos = not bool(r['negedge'])\n        else:\n            is_pos = (i % 2 == 0)\n\n        if rst == 1:\n            state = 0\n            out_data = 0\n            out_tr = 1\n            out_t = 0\n        else:\n            out_tr = 1 << state\n            next_state = (state + 1) % 4\n            out_t = 1 << next_state\n            out_data = data_in if has_data else 0\n\n        res.append({\n            'data_out': out_data & 0xF,\n            'token_received': out_tr & 0xF,\n            'token': out_t & 0xF\n        })\n\n        if is_pos and rst == 0:\n            state = (state + 1) % 4\n\n    return res\n"
