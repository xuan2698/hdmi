"def reference(vectors):\n    def parse_edge(val):\n        if isinstance(val, str):\n            s = val.lower()\n            if 'pos' in s or 'rise' in s or s == '1' or 'high' in s:\n                return True\n            if 'neg' in s or 'fall' in s or s == '0' or 'low' in s:\n                return False\n            return True\n        try:\n            return int(val) != 0\n        except:\n            return True\n\n    def get(row, names, default=None):\n        if isinstance(row, dict):\n            for k in row:\n                if isinstance(k, str):\n                    lk = k.lower()\n                    for n in names:\n                        if lk == n.lower():\n                            return row[k]\n        return default\n\n    state = 1\n    result = []\n    for i, row in enumerate(vectors):\n        if isinstance(row, dict):\n            rst = int(get(row, ['rst', 'reset'], 0) or 0) & 1\n            data_in = int(get(row, ['data_in', 'data'], 0) or 0) & 15\n            has = int(get(row, ['has_data_to_send', 'has_data', 'send'], 0) or 0) & 1\n            ev = get(row, ['edge', 'clk_edge', 'event', 'ev', 'posedge', 'negedge', 'clk', 'clock'], None)\n            pos = (i % 2 == 0) if ev is None else parse_edge(ev)\n        else:\n            vals = list(row) if isinstance(row, (list, tuple)) else [row]\n            rst = 0\n            data_in = 0\n            has = 0\n            edge_found = False\n            for j, v in enumerate(vals):\n                if isinstance(v, str) and ('pos' in v.lower() or 'neg' in v.lower() or 'rise' in v.lower() or 'fall' in v.lower()):\n                    pos = parse_edge(v)\n                    rest = vals[:j] + vals[j+1:]\n                    if len(rest) >= 3:\n                        rst = int(rest[0]) & 1\n                        data_in = int(rest[1]) & 15\n                        has = int(rest[2]) & 1\n                    elif len(rest) == 2:\n                        rst = int(rest[0]) & 1\n                        data_in = int(rest[1]) & 15\n                    edge_found = True\n                    break\n            if not edge_found:\n                if len(vals) >= 4:\n                    rst = int(vals[0]) & 1\n                    data_in = int(vals[1]) & 15\n                    has = int(vals[2]) & 1\n                    pos = parse_edge(vals[3])\n                elif len(vals) == 3:\n                    rst = int(vals[0]) & 1\n                    data_in = int(vals[1]) & 15\n                    has = int(vals[2]) & 1\n                    pos = (i % 2 == 0)\n                elif len(vals) == 2:\n                    rst = int(vals[0]) & 1\n                    data_in = int(vals[1]) & 15\n                    pos = (i % 2 == 0)\n                elif len(vals) == 1:\n                    rst = int(vals[0]) & 1\n                    pos = (i % 2 == 0)\n                else:\n                    pos = (i % 2 == 0)\n\n        if rst:\n            state = 1\n\n        if rst:\n            tr = 1\n            tok = 0\n            data_out = 0\n        else:\n            tr = state & 15\n            if state == 1:\n                tok = 2\n            elif state == 2:\n                tok = 4\n            elif state == 4:\n                tok = 8\n            elif state == 8:\n                tok = 1\n            else:\n                tok = 0\n            if has and (state == 1 or state == 2 or state == 4 or state == 8):\n                data_out = data_in & 15\n            else:\n                data_out = 0\n\n        result.append({\n            'data_out': data_out & 15,\n            'token_received': tr & 15,\n            'token': tok & 15\n        })\n\n        if pos:\n            if rst:\n                state = 1\n            else:\n                if state == 1:\n                    state = 2\n                elif state == 2:\n                    state = 4\n                elif state == 4:\n                    state = 8\n                elif state == 8:\n                    state = 1\n                else:\n                    state = 1\n\n    return result\n"
