"def reference(vectors):\n    state = 0\n    res = []\n    for i, row in enumerate(vectors):\n        rst = row.get('rst', 0)\n        data_in = row.get('data_in', 0)\n        has = row.get('has_data_to_send', 0)\n        edge = row.get('edge')\n        if edge is None:\n            clk = row.get('clk')\n            if clk is not None:\n                pos = (clk == 1)\n            else:\n                pos = (i % 2 == 0)\n        else:\n            if isinstance(edge, str):\n                pos = edge.lower().startswith('p')\n            else:\n                pos = (edge == 1)\n        if rst:\n            state = 0\n            data_out = 0\n            token_received = 1\n            token = 0\n        else:\n            data_out = data_in if has else 0\n            token_received = 1 << state\n            token = 1 << ((state + 1) % 4)\n        res.append({\n            'data_out': data_out & 0xF,\n            'token_received': token_received & 0xF,\n            'token': token & 0xF\n        })\n        if pos and not rst:\n            state = (state + 1) % 4\n    return res\n"
