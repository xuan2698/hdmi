"def reference(vectors):\n    node = 0\n    out = []\n    fallback_pos = True\n    for row in vectors:\n        if isinstance(row, dict):\n            rst = int(row.get('rst', 0)) & 1\n            data_in = int(row.get('data_in', 0)) & 0xF\n            has = int(row.get('has_data_to_send', 0)) & 1\n            is_pos = None\n            if 'edge' in row:\n                e = row['edge']\n                if isinstance(e, str):\n                    s = e.lower()\n                    if 'pos' in s:\n                        is_pos = True\n                    elif 'neg' in s:\n                        is_pos = False\n                    else:\n                        try:\n                            is_pos = int(e) != 0\n                        except:\n                            is_pos = bool(e)\n                else:\n                    is_pos = bool(e)\n            elif 'clk' in row:\n                c = row['clk']\n                if isinstance(c, str):\n                    s = c.lower()\n                    if 'pos' in s:\n                        is_pos = True\n                    elif 'neg' in s:\n                        is_pos = False\n                    else:\n                        try:\n                            is_pos = int(c) != 0\n                        except:\n                            is_pos = bool(c)\n                else:\n                    is_pos = bool(c)\n        else:\n            vals = list(row)\n            is_pos = None\n            for i, v in enumerate(vals):\n                if isinstance(v, str):\n                    s = v.lower()\n                    if 'pos' in s or 'neg' in s:\n                        is_pos = 'pos' in s\n                        vals.pop(i)\n                        break\n            if len(vals) >= 4:\n                rst = int(vals[0]) & 1\n                data_in = int(vals[1]) & 0xF\n                has = int(vals[2]) & 1\n                if is_pos is None:\n                    is_pos = bool(vals[3])\n            elif len(vals) == 3:\n                rst = int(vals[0]) & 1\n                data_in = int(vals[1]) & 0xF\n                has = int(vals[2]) & 1\n            elif len(vals) == 2:\n                rst = int(vals[0]) & 1\n                data_in = int(vals[1]) & 0xF\n                has = 0\n            else:\n                rst = int(vals[0]) & 1 if vals else 0\n                data_in = 0\n                has = 0\n        if is_pos is None:\n            is_pos = fallback_pos\n        fallback_pos = not is_pos\n        if rst:\n            node = 0\n            tr = 0x1\n            tok = 0x0\n            dout = 0x0\n        else:\n            tr = 1 << node\n            tok = 1 << ((node + 1) & 3)\n            dout = (data_in & 0xF) if has else 0\n        out.append({'data_out': dout, 'token_received': tr, 'token': tok})\n        if is_pos and not rst:\n            node = (node + 1) & 3\n    return out\n"
