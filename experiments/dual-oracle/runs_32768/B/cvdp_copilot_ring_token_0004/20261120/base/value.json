"def reference(vectors):\n    state = 0\n    token_received = 1\n    token = 0\n    data_out = 0\n    results = []\n    \n    for i, row in enumerate(vectors):\n        rst = row.get('rst', 0)\n        data_in = row.get('data_in', 0) & 0xF\n        has_data = row.get('has_data_to_send', 0)\n        \n        if 'clk' in row:\n            is_posedge = (row['clk'] == 1)\n        else:\n            is_posedge = (i % 2 == 0)\n        \n        if rst:\n            state = 0\n            token_received = 1\n            token = 0\n            data_out = 0\n            reset_active = True\n        else:\n            reset_active = False\n        \n        results.append({\n            'data_out': data_out & 0xF,\n            'token_received': token_received & 0xF,\n            'token': token & 0xF\n        })\n        \n        if is_posedge and not reset_active:\n            if state == 0:\n                token_received = 2\n                token = 1\n                data_out = data_in if has_data else 0\n                state = 1\n            elif state == 1:\n                token_received = 4\n                token = 2\n                data_out = data_in if has_data else 0\n                state = 2\n            elif state == 2:\n                token_received = 8\n                token = 4\n                data_out = data_in if has_data else 0\n                state = 3\n            elif state == 3:\n                token_received = 1\n                token = 8\n                data_out = data_in if has_data else 0\n                state = 0\n            else:\n                state = 0\n                token_received = 1\n                token = 0\n                data_out = 0\n                \n    return results\n"
