  ],
  "RM": "def reference(vectors):\n    state = 1\n    prev_clk = 0\n    res = []\n    for i, v in enumerate(vectors):\n        rst = v.get('rst', 0) & 1\n        data_in = v.get('data_in', 0) & 0xF\n        has = v.get('has_data_to_send', 0) & 1\n\n        if 'edge' in v:\n            e = v['edge']\n            posedge = (e == 'posedge' or e == 'pos' or e == 1 or e == '1' or e is True)\n        elif 'clk' in v:\n            clk = v['clk'] & 1\n            posedge = (clk == 1 and prev_clk == 0)\n            prev_clk = clk\n        else:\n            posedge = (i % 2 == 0)\n\n        if rst:\n            state = 1\n\n        if rst:\n            tr = 1\n            to = 0\n            do = 0\n        else:\n            tr = state & 0xF\n            if state in (1, 2, 4, 8):\n                nxt = ((state << 1) | (state >> 3)) & 0xF\n                to = nxt\n                do = data_in if has else 0\n            else:\n                to = 0\n                do = 0\n\n        res.append({\n            'data_out': do & 0xF,\n            'token_received': tr & 0xF,\n            'token': to & 0xF\n        })\n\n        if posedge and not rst:\n            if state in (1, 2, 4, 8):\n                state = ((state << 1) | (state >> 3)) & 0xF\n            else:\n                state = 1\n\n    return res\n",
