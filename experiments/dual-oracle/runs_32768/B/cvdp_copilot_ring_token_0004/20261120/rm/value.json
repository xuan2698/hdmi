"def reference(vectors):\n    state = 1\n    token = 0\n    data_out = 0\n    res = []\n    prev_clk = 0\n    for i, v in enumerate(vectors):\n        rst = v.get('rst', 0)\n        data_in = v.get('data_in', 0) & 0xF\n        has = v.get('has_data_to_send', 0)\n        if 'clk' in v:\n            clk = v['clk']\n            posedge = (clk == 1 and prev_clk == 0)\n            prev_clk = clk\n        else:\n            posedge = (i % 2 == 0)\n        if rst == 1:\n            state = 1\n            token = 0\n            data_out = 0\n        res.append({\n            'data_out': data_out & 0xF,\n            'token_received': state & 0xF,\n            'token': token & 0xF\n        })\n        if posedge and rst == 0:\n            if state in (1, 2, 4, 8):\n                next_state = ((state << 1) | (state >> 3)) & 0xF\n                next_token = state\n                next_data_out = data_in if has else 0\n            else:\n                next_state = 1\n                next_token = 0\n                next_data_out = 0\n            state = next_state\n            token = next_token\n            data_out = next_data_out\n    return res\n"
