"def reference(vectors):\n    state = 1\n    prev_clk = 0\n    res = []\n    for i, v in enumerate(vectors):\n        rst = v.get('rst', 0)\n        data_in = v.get('data_in', 0) & 0xF\n        has = v.get('has_data_to_send', 0) & 1\n\n        posedge = None\n        e = v.get('edge')\n        if isinstance(e, str):\n            posedge = e.lower().startswith('p')\n        elif e is not None:\n            posedge = bool(e)\n\n        if posedge is None:\n            if 'clk' in v:\n                clk = v['clk']\n                posedge = (clk == 1 and prev_clk == 0)\n            else:\n                posedge = (i % 2 == 0)\n\n        if 'clk' in v:\n            prev_clk = v['clk']\n\n        if rst:\n            state = 1\n\n        if rst:\n            data_out = 0\n            token_received = 1\n            token = 0\n        else:\n            token_received = state & 0xF\n            if state in (1, 2, 4, 8):\n                token = ((state << 1) & 0xF) | (state >> 3)\n                data_out = data_in if has else 0\n            else:\n                token = 0\n                data_out = 0\n\n        res.append({\n            'data_out': data_out & 0xF,\n            'token_received': token_received & 0xF,\n            'token': token & 0xF\n        })\n\n        if posedge and not rst:\n            if state in (1, 2, 4, 8):\n                state = ((state << 1) & 0xF) | (state >> 3)\n            else:\n                state = 1\n\n    return res\n"
