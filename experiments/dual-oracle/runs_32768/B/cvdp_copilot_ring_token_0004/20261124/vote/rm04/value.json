"def reference(vectors):\n    state = 0\n    result = []\n    prev_clk = None\n    for i, row in enumerate(vectors):\n        rst = int(row.get('rst', 0))\n        data_in = int(row.get('data_in', 0)) & 0xF\n        has = int(row.get('has_data_to_send', 0)) & 1\n        if rst:\n            state = 0\n        token_received = 1 << state\n        if rst:\n            token = 0\n            data_out = 0\n        else:\n            token = ((token_received << 1) | (token_received >> 3)) & 0xF\n            data_out = data_in if has else 0\n        result.append({\n            'data_out': data_out,\n            'token_received': token_received,\n            'token': token\n        })\n        is_pos = False\n        edge = row.get('edge')\n        if edge is not None:\n            if isinstance(edge, str):\n                e = edge.lower()\n                is_pos = e.startswith('pos') or e == '1' or e == 'rising'\n            else:\n                is_pos = bool(edge)\n        else:\n            clk = row.get('clk')\n            if clk is not None:\n                clk = int(clk)\n                if prev_clk is None:\n                    is_pos = (clk == 1)\n                else:\n                    is_pos = (clk == 1 and prev_clk == 0)\n                prev_clk = clk\n            else:\n                is_pos = (i % 2 == 0)\n        if is_pos and not rst:\n            state = (state + 1) & 3\n    return result\n"
