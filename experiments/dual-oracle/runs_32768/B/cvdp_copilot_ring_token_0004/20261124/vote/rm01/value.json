"def reference(vectors):\n    state = 0\n    out = []\n    for i, v in enumerate(vectors):\n        rst = v.get('rst', 0)\n        if rst:\n            state = 0\n            tr = 1\n            to = 0\n            dout = 0\n        else:\n            tr = 1 << (state & 3)\n            to = ((tr << 1) | (tr >> 3)) & 0xF\n            dout = (v.get('data_in', 0) & 0xF) if v.get('has_data_to_send', 0) else 0\n\n        out.append({'data_out': dout, 'token_received': tr, 'token': to})\n\n        pos = False\n        if 'edge' in v:\n            e = v['edge']\n            if isinstance(e, str):\n                pos = e.lower().startswith('pos') or e.lower() == '1'\n            else:\n                pos = e == 1\n        elif 'clk' in v:\n            c = v['clk']\n            if isinstance(c, str):\n                pos = ('pos' in c.lower()) or c == '1'\n            else:\n                pos = c == 1\n        else:\n            pos = (i % 2 == 0)\n\n        if pos and not rst:\n            state = (state + 1) & 3\n\n    return out\n"
