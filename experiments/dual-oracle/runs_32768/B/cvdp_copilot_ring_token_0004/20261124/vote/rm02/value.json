"def reference(vectors):\n    tr = 1\n    tok = 0\n    dout = 0\n    prev_clk = None\n    idx = 0\n    last_rst = 0\n    last_data = 0\n    last_has = 0\n    res = []\n\n    for v in vectors:\n        if isinstance(v, dict):\n            if 'rst' in v:\n                last_rst = v['rst']\n            if 'data_in' in v:\n                last_data = v['data_in']\n            if 'has_data_to_send' in v:\n                last_has = v['has_data_to_send']\n\n            edge = None\n            if v.get('posedge', 0):\n                edge = 'posedge'\n            elif v.get('negedge', 0):\n                edge = 'negedge'\n            elif 'edge' in v:\n                e = v['edge']\n                if isinstance(e, str):\n                    le = e.lower()\n                    if 'pos' in le or e in ('+', '1'):\n                        edge = 'posedge'\n                    elif 'neg' in le or e in ('-', '0'):\n                        edge = 'negedge'\n                else:\n                    edge = 'posedge' if e else 'negedge'\n            elif 'clk' in v:\n                clk = v['clk']\n                if prev_clk is None:\n                    edge = 'posedge' if clk == 1 else 'negedge'\n                else:\n                    if prev_clk == 0 and clk == 1:\n                        edge = 'posedge'\n                    elif prev_clk == 1 and clk == 0:\n                        edge = 'negedge'\n                    else:\n                        edge = 'posedge' if (idx % 2 == 0) else 'negedge'\n                prev_clk = clk\n            else:\n                edge = 'posedge' if (idx % 2 == 0) else 'negedge'\n        else:\n            edge = 'posedge' if (idx % 2 == 0) else 'negedge'\n\n        rst = last_rst\n        data_in = last_data & 0xF\n        has = last_has\n\n        if rst:\n            tr = 1\n            tok = 0\n            dout = 0\n            res.append({'data_out': 0, 'token_received': 1, 'token': 0})\n            idx += 1\n            continue\n\n        if edge == 'posedge':\n            res.append({'data_out': dout, 'token_received': tr, 'token': tok})\n\n            if tr in (1, 2, 4, 8):\n                nxt_tr = ((tr << 1) & 0xF)\n                if tr & 8:\n                    nxt_tr |= 1\n                nxt_dout = data_in if has else 0\n                nxt_tok = nxt_tr\n            else:\n                nxt_tr = 1\n                nxt_dout = 0\n                nxt_tok = 0\n\n            tr = nxt_tr & 0xF\n            tok = nxt_tok & 0xF\n            dout = nxt_dout & 0xF\n        else:\n            res.append({'data_out': dout, 'token_received': tr, 'token': tok})\n\n        idx += 1\n\n    return res\n"
