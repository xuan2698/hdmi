"def reference(vectors):\n    def iv(v):\n        if isinstance(v, bool):\n            return 1 if v else 0\n        if isinstance(v, str):\n            s = v.strip().lower()\n            if s in ('1', 'true', 'high', 'h', 'yes', 'posedge'):\n                return 1\n            if s in ('0', 'false', 'low', 'l', 'no', 'negedge', ''):\n                return 0\n            try:\n                return int(s, 0)\n            except:\n                return 0\n        try:\n            return int(v)\n        except:\n            return 0\n\n    def get_field(row, key, default=0):\n        if isinstance(row, dict):\n            if key in row:\n                return row[key]\n            for k in row.keys():\n                if isinstance(k, str) and k.lower() == key.lower():\n                    return row[k]\n        return default\n\n    def is_posedge(edge, idx):\n        if edge is None:\n            return (idx % 2) == 0\n        if isinstance(edge, str):\n            s = edge.lower()\n            if 'pos' in s:\n                return True\n            if 'neg' in s:\n                return False\n        return iv(edge) != 0\n\n    state = 0\n    result = []\n\n    for idx, row in enumerate(vectors):\n        edge = None\n        rst = data_in = has = 0\n\n        if isinstance(row, dict):\n            edge = get_field(row, 'edge', None)\n            if edge is None:\n                for k in row.keys():\n                    if isinstance(k, str) and 'edge' in k.lower():\n                        edge = row[k]\n                        break\n            if edge is None and 'clk' in row:\n                edge = 'posedge' if iv(row['clk']) else 'negedge'\n            rst = iv(get_field(row, 'rst', get_field(row, 'reset', 0)))\n            data_in = iv(get_field(row, 'data_in', get_field(row, 'data', 0))) & 15\n            has = iv(get_field(row, 'has_data_to_send', get_field(row, 'has_data', 0)))\n        else:\n            try:\n                vals = list(row)\n            except:\n                vals = []\n\n            edge_idx = -1\n            for i, v in enumerate(vals):\n                if isinstance(v, str):\n                    s = v.lower()\n                    if 'pos' in s or 'neg' in s or 'edge' in s:\n                        edge = v\n                        edge_idx = i\n                        break\n\n            if edge_idx >= 0:\n                rem = vals[:edge_idx] + vals[edge_idx + 1:]\n                if len(rem) >= 3:\n                    rst = iv(rem[0])\n                    data_in = iv(rem[1]) & 15\n                    has = iv(rem[2])\n                elif len(rem) == 2:\n                    rst = iv(rem[0])\n                    data_in = iv(rem[1]) & 15\n                elif len(rem) == 1:\n                    rst = iv(rem[0])\n            else:\n                if len(vals) >= 4:\n                    rst = iv(vals[0])\n                    data_in = iv(vals[1]) & 15\n                    has = iv(vals[2])\n                    edge = vals[3]\n                elif len(vals) == 3:\n                    rst = iv(vals[0])\n                    data_in = iv(vals[1]) & 15\n                    has = iv(vals[2])\n                elif len(vals) == 2:\n                    rst = iv(vals[0])\n                    data_in = iv(vals[1]) & 15\n                elif len(vals) == 1:\n                    rst = iv(vals[0])\n\n        if rst:\n            state = 0\n            result.append({'data_out': 0, 'token_received': 1, 'token': 0})\n            continue\n\n        pos = is_posedge(edge, idx)\n\n        token_received = 1 << state\n        token = 1 << ((state + 1) & 3)\n        data_out = data_in if has else 0\n\n        result.append({\n            'data_out': data_out & 15,\n            'token_received': token_received & 15,\n            'token': token & 15\n        })\n\n        if pos:\n            state = (state + 1) & 3\n\n    return result\n"
