"def reference(vectors):\n    state = 1\n    token_reg = 0\n    data_reg = 0\n    outputs = []\n\n    for idx, row in enumerate(vectors):\n        if isinstance(row, dict):\n            rst = row.get('rst', 0)\n            data_in = row.get('data_in', 0)\n            has_data = row.get('has_data_to_send', 0)\n\n            ed = row.get('edge', None)\n            if ed is not None:\n                if isinstance(ed, str):\n                    is_posedge = ('pos' in ed.lower())\n                else:\n                    is_posedge = (ed == 1 or ed is True)\n            else:\n                clk = row.get('clk', None)\n                if clk is not None:\n                    is_posedge = (clk == 1)\n                else:\n                    is_posedge = (idx % 2 == 0)\n        else:\n            if len(row) == 4:\n                rst, data_in, has_data, clk = row\n                if isinstance(clk, str):\n                    is_posedge = ('pos' in clk.lower())\n                else:\n                    is_posedge = (clk == 1)\n            elif len(row) == 3:\n                rst, data_in, has_data = row\n                is_posedge = (idx % 2 == 0)\n            else:\n                ed = row[0] if len(row) > 0 else 1\n                rst = row[1] if len(row) > 1 else 0\n                data_in = row[2] if len(row) > 2 else 0\n                has_data = row[3] if len(row) > 3 else 0\n                if isinstance(ed, str):\n                    is_posedge = ('pos' in ed.lower())\n                else:\n                    is_posedge = (ed == 1)\n\n        if rst:\n            state = 1\n            token_reg = 0\n            data_reg = 0\n\n        outputs.append({\n            'data_out': data_reg & 0xF,\n            'token_received': state & 0xF,\n            'token': token_reg & 0xF\n        })\n\n        if is_posedge and not rst:\n            if state in (1, 2, 4, 8):\n                if state == 1:\n                    next_state = 2\n                elif state == 2:\n                    next_state = 4\n                elif state == 4:\n                    next_state = 8\n                else:\n                    next_state = 1\n                next_token = state\n                next_data = (data_in & 0xF) if has_data else 0\n            else:\n                next_state = 1\n                next_token = 0\n                next_data = 0\n\n            state = next_state\n            token_reg = next_token\n            data_reg = next_data\n\n    return outputs\n"
