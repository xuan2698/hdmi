"def reference(vectors):\n    state = 0\n    out = []\n    for i, row in enumerate(vectors):\n        rst = row.get('rst', 0)\n        if rst:\n            state = 0\n        if 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                is_pos = 'pos' in e.lower()\n            else:\n                is_pos = (e == 1)\n        else:\n            is_pos = (i % 2 == 0)\n        if rst:\n            token_received = 1\n            token = 0\n            data_out = 0\n        else:\n            token_received = 1 << state\n            token = 1 << ((state + 1) % 4)\n            if row.get('has_data_to_send', 0):\n                data_out = row.get('data_in', 0) & 0xF\n            else:\n                data_out = 0\n        out.append({\n            'data_out': data_out,\n            'token_received': token_received,\n            'token': token\n        })\n        if is_pos and not rst:\n            state = (state + 1) % 4\n        elif rst:\n            state = 0\n    return out\n"
