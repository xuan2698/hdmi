    {
      "id": "s5/5/data_out",
      "label": "RM",
      "spec_quote": "When a node holds the token and `has_data_to_send` is HIGH, `data_out` reflects `data_in`."
    }
  ],
  "RM": "def reference(vectors):\n    node = 0\n    out = []\n    for i, row in enumerate(vectors):\n        rst = row.get('rst', 0)\n        if rst:\n            node = 0\n\n        e = row.get('edge', 'posedge' if i % 2 == 0 else 'negedge')\n        if isinstance(e, str):\n            is_pos = 'pos' in e.lower()\n        else:\n            is_pos = (e == 1)\n\n        if rst:\n            data_out = 0\n            token_received = 1\n            token = 0\n        else:\n            token_received = 1 << node\n            token = 1 << ((node + 1) % 4)\n            if row.get('has_data_to_send', 0):\n                data_out = row.get('data_in', 0) & 0xF\n            else:\n                data_out = 0\n\n        out.append({\n            'data_out': data_out,\n            'token_received': token_received,\n            'token': token\n        })\n\n        if is_pos:\n            if rst:\n                node = 0\n            else:\n                node = (node + 1) % 4\n\n    return out\n",
  "TB": [
