"def reference(vectors):\n    s = 0\n    out = []\n    for i, row in enumerate(vectors):\n        rst = row.get('rst', 0)\n\n        if rst:\n            s = 0\n\n        edge = row.get('edge', None)\n        if edge is None:\n            pos = (i % 2 == 0)\n        elif isinstance(edge, str):\n            pos = 'pos' in edge.lower()\n        else:\n            pos = (edge == 1)\n\n        if rst:\n            data_out = 0\n            token_received = 1\n            token = 0\n        else:\n            token_received = 1 << s\n            token = 1 << ((s + 1) % 4)\n            if row.get('has_data_to_send', 0):\n                data_out = row.get('data_in', 0) & 0xF\n            else:\n                data_out = 0\n\n        out.append({\n            'data_out': data_out,\n            'token_received': token_received,\n            'token': token\n        })\n\n        if rst:\n            s = 0\n        elif pos:\n            s = (s + 1) % 4\n\n    return out\n"
