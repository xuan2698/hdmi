"def reference(vectors):\n    state = 1\n    out = []\n    for i, row in enumerate(vectors):\n        rst = row.get('rst', 0) & 1\n        data_in = row.get('data_in', 0) & 0xF\n        has = row.get('has_data_to_send', 0) & 1\n\n        if rst:\n            state = 1\n\n        if rst:\n            token_received = 1\n            token = 0\n            data_out = 0\n        else:\n            token_received = state\n            if state == 1:\n                token = 2\n            elif state == 2:\n                token = 4\n            elif state == 4:\n                token = 8\n            elif state == 8:\n                token = 1\n            else:\n                token = 1\n            if has and state in (1, 2, 4, 8):\n                data_out = data_in\n            else:\n                data_out = 0\n\n        out.append({\n            'data_out': data_out,\n            'token_received': token_received,\n            'token': token\n        })\n\n        if i % 2 == 0 and not rst:\n            state = token\n\n    return out\n"
