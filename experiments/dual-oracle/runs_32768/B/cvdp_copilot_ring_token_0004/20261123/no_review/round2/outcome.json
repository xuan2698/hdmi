  "RM": "def reference(vectors):\n    def nxt(s):\n        if s == 1: return 2\n        if s == 2: return 4\n        if s == 4: return 8\n        if s == 8: return 1\n        return 1\n\n    state = 1\n    out = []\n    prev_clk = None\n\n    for i, row in enumerate(vectors):\n        if isinstance(row, dict):\n            rst = int(row.get('rst', 0)) & 1\n            data_in = int(row.get('data_in', 0)) & 0xF\n            has = int(row.get('has_data_to_send', row.get('has_data', 0))) & 1\n            edge = row.get('edge', row.get('edge_type', None))\n            clk = row.get('clk', None)\n        else:\n            vals = list(row)\n            if len(vals) >= 4:\n                clk, rst, data_in, has = vals[0], vals[1], vals[2], vals[3]\n            elif len(vals) == 3:\n                clk = None\n                rst, data_in, has = vals[0], vals[1], vals[2]\n            else:\n                clk, rst, data_in, has = None, 0, 0, 0\n            edge = None\n            rst = int(rst) & 1\n            data_in = int(data_in) & 0xF\n            has = int(has) & 1\n\n        if clk is not None:\n            clk = int(clk) & 1\n\n        is_pos = False\n        is_neg = False\n\n        if edge is not None:\n            e = str(edge).lower()\n            if 'pos' in e or 'rise' in e or 'up' in e:\n                is_pos = True\n            elif 'neg' in e or 'fall' in e or 'down' in e:\n                is_neg = True\n\n        if not is_pos and not is_neg:\n            if clk is not None:\n                if prev_clk is None:\n                    is_pos = clk == 1\n                    is_neg = clk == 0\n                else:\n                    if prev_clk == 0 and clk == 1:\n                        is_pos = True\n                    elif prev_clk == 1 and clk == 0:\n                        is_neg = True\n                    else:\n                        is_pos = clk == 1\n                        is_neg = clk == 0\n            else:\n                is_pos = i % 2 == 0\n                is_neg = not is_pos\n\n        if rst:\n            state = 1\n            dout = 0\n            tr = 1\n            tok = 0\n        else:\n            tr = state & 0xF\n            tok = nxt(state)\n            dout = data_in if has else 0\n\n        out.append({\n            'data_out': dout & 0xF,\n            'token_received': tr & 0xF,\n            'token': tok & 0xF\n        })\n\n        if is_pos:\n            if rst:\n                state = 1\n            else:\n                state = nxt(state)\n\n        if clk is not None:\n            prev_clk = clk\n\n    return out\n",
