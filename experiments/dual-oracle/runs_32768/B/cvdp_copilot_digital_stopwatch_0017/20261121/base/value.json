"def reference(vectors):\n    counter = 0\n    one_sec_pulse = 0\n    seconds = 0\n    minutes = 0\n    hour = 0\n    out = []\n    for i, row in enumerate(vectors):\n        reset = row.get('reset', 0)\n        start_stop = row.get('start_stop', 0)\n        is_posedge = (i % 2 == 0)\n        if 'edge' in row:\n            e = row['edge']\n            if e in ('posedge', 1):\n                is_posedge = True\n            elif e in ('negedge', 0):\n                is_posedge = False\n        if reset == 1:\n            counter = 0\n            one_sec_pulse = 0\n            seconds = 0\n            minutes = 0\n            hour = 0\n        out.append({'seconds': seconds, 'minutes': minutes, 'hour': hour})\n        if is_posedge and reset == 0:\n            if start_stop:\n                if counter == 3:\n                    next_counter = 0\n                    next_one_sec_pulse = 1\n                else:\n                    next_counter = counter + 1\n                    next_one_sec_pulse = 0\n            else:\n                next_counter = counter\n                next_one_sec_pulse = 0\n            next_seconds = seconds\n            next_minutes = minutes\n            next_hour = hour\n            if one_sec_pulse:\n                if seconds == 59:\n                    next_seconds = 0\n                    if minutes == 59:\n                        next_minutes = 0\n                        next_hour = 1\n                    else:\n                        next_minutes = minutes + 1\n                else:\n                    next_seconds = seconds + 1\n            counter = next_counter\n            one_sec_pulse = next_one_sec_pulse\n            seconds = next_seconds\n            minutes = next_minutes\n            hour = next_hour\n    return out\n"
