"def reference(vectors):\n    sec = 0\n    mins = 0\n    hr = 0\n    cnt = 0\n    out = []\n    if isinstance(vectors, dict):\n        keys = list(vectors.keys())\n        n = len(vectors[keys[0]]) if keys else 0\n        rows = []\n        for i in range(n):\n            d = {}\n            for k in keys:\n                d[k] = vectors[k][i]\n            rows.append(d)\n        vectors = rows\n    for i, row in enumerate(vectors):\n        if isinstance(row, dict):\n            reset = row.get('reset', 0)\n            start = row.get('start_stop', 0)\n            if 'edge' in row:\n                e = row['edge']\n            elif 'clk' in row:\n                e = row['clk']\n            else:\n                e = 1 - (i & 1)\n        else:\n            if len(row) >= 3:\n                e = row[0]\n                reset = row[1]\n                start = row[2]\n            elif len(row) == 2:\n                e = 1 - (i & 1)\n                reset = row[0]\n                start = row[1]\n            else:\n                e = 1 - (i & 1)\n                reset = row[0] if len(row) > 0 else 0\n                start = 0\n        if isinstance(e, str):\n            pos = (e and e[0].lower() == 'p') or e == '1'\n        else:\n            pos = int(e) != 0\n        reset = int(reset) & 1\n        start = int(start) & 1\n        if reset:\n            sec = 0\n            mins = 0\n            hr = 0\n            cnt = 0\n        out.append({'seconds': sec, 'minutes': mins, 'hour': hr})\n        if pos and not reset and start:\n            if cnt >= 3:\n                cnt = 0\n                if sec == 59:\n                    sec = 0\n                    if mins == 59:\n                        mins = 0\n                        hr = 1\n                    else:\n                        mins += 1\n                else:\n                    sec += 1\n            else:\n                cnt += 1\n    return out\n"
