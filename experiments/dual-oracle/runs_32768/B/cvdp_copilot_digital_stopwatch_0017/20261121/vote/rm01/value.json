"def reference(vectors):\n    cc = 0\n    p = 0\n    s = 0\n    m = 0\n    h = 0\n    out = []\n    for i, v in enumerate(vectors):\n        if isinstance(v, dict):\n            r = v.get('reset', 0)\n            st = v.get('start_stop', 0)\n        else:\n            r = v[0] if len(v) > 0 else 0\n            st = v[1] if len(v) > 1 else 0\n        if r:\n            cc = 0\n            p = 0\n            s = 0\n            m = 0\n            h = 0\n        out.append({'seconds': s, 'minutes': m, 'hour': h})\n        if i % 2 == 0 and not r:\n            oc = cc\n            op = p\n            os = s\n            om = m\n            oh = h\n            if oc == 3:\n                cc = 0\n                p = 1\n            else:\n                cc = oc + 1\n                p = 0\n            if st and op:\n                if os == 59:\n                    s = 0\n                    if om == 59:\n                        m = 0\n                        h = 1 - oh\n                    else:\n                        m = om + 1\n                else:\n                    s = os + 1\n            else:\n                s = os\n                m = om\n                h = oh\n    return out\n"
