"def reference(vectors):\n    seconds = 0\n    minutes = 0\n    hour = 0\n    div = 0\n    out = []\n    prev_clk = 0\n    pos_edge_next = True\n    for row in vectors:\n        rst = row.get('reset', 0)\n        if rst:\n            seconds = 0\n            minutes = 0\n            hour = 0\n            div = 0\n\n        if 'clk' in row:\n            clk = row['clk']\n            posedge = (clk == 1 and prev_clk == 0)\n            prev_clk = clk\n        else:\n            posedge = pos_edge_next\n            pos_edge_next = not pos_edge_next\n\n        out.append({'seconds': seconds, 'minutes': minutes, 'hour': hour})\n\n        if posedge and not rst and row.get('start_stop', 0):\n            if div == 3:\n                div = 0\n                if seconds == 59:\n                    seconds = 0\n                    if minutes == 59:\n                        minutes = 0\n                        hour = 1\n                    else:\n                        minutes += 1\n                else:\n                    seconds += 1\n            else:\n                div += 1\n\n    return out\n"
