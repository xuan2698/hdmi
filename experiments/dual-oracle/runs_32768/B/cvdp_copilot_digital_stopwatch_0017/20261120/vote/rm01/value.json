"def reference(vectors):\n    seconds = 0\n    minutes = 0\n    hour = 0\n    divider = 0\n    out = []\n    for i, row in enumerate(vectors):\n        reset = 0\n        start_stop = 0\n        edge = None\n        if isinstance(row, dict):\n            reset = int(row.get('reset', 0))\n            start_stop = int(row.get('start_stop', 0))\n            edge = row.get('edge', row.get('clk', None))\n        else:\n            if isinstance(row, (list, tuple)):\n                if len(row) >= 3:\n                    if isinstance(row[-1], str) and ('pos' in row[-1].lower() or 'neg' in row[-1].lower()):\n                        edge = row[-1]\n                        reset = int(row[0])\n                        start_stop = int(row[1])\n                    elif isinstance(row[0], str) and ('pos' in row[0].lower() or 'neg' in row[0].lower()):\n                        edge = row[0]\n                        reset = int(row[1])\n                        start_stop = int(row[2])\n                    else:\n                        edge = row[0]\n                        reset = int(row[1])\n                        start_stop = int(row[2])\n                elif len(row) == 2:\n                    reset = int(row[0])\n                    start_stop = int(row[1])\n                elif len(row) == 1:\n                    reset = int(row[0])\n            else:\n                reset = int(row)\n\n        if isinstance(edge, str):\n            e = edge.lower()\n            is_pos = ('pos' in e) or ('ris' in e) or (e == '1') or (e == 'true')\n        else:\n            is_pos = (i % 2 == 0)\n\n        out.append({'seconds': seconds, 'minutes': minutes, 'hour': hour})\n\n        if reset:\n            seconds = 0\n            minutes = 0\n            hour = 0\n            divider = 0\n        elif is_pos and start_stop:\n            if divider == 3:\n                divider = 0\n                if seconds == 59:\n                    seconds = 0\n                    if minutes == 59:\n                        minutes = 0\n                        hour = 1\n                    else:\n                        minutes += 1\n                else:\n                    seconds += 1\n            else:\n                divider += 1\n\n    return out\n"
