"def reference(vectors):\n    sec = 0\n    min = 0\n    hr = 0\n    cnt = 0\n    res = []\n    prev_clk = None\n    for row in vectors:\n        reset = row.get('reset', 0)\n        start_stop = row.get('start_stop', 0)\n        edge = row.get('edge', None)\n        if edge is not None:\n            if isinstance(edge, str):\n                e = edge.lower()\n                if 'pos' in e:\n                    is_pos = True\n                elif 'neg' in e:\n                    is_pos = False\n                else:\n                    is_pos = (e == '1')\n            else:\n                is_pos = (edge == 1)\n        else:\n            clk = row.get('clk', None)\n            if clk is not None:\n                if prev_clk is None:\n                    is_pos = (clk == 1)\n                else:\n                    is_pos = (prev_clk == 0 and clk == 1)\n                prev_clk = clk\n            else:\n                is_pos = True\n\n        if reset == 1:\n            sec = 0\n            min = 0\n            hr = 0\n            cnt = 0\n\n        res.append({\n            'seconds': sec & 0x3f,\n            'minutes': min & 0x3f,\n            'hour': hr & 0x1\n        })\n\n        if is_pos and reset == 0:\n            one_sec_pulse = (cnt == 3)\n            nsec = sec\n            nmin = min\n            nhr = hr\n            if one_sec_pulse and start_stop == 1:\n                if sec == 59:\n                    nsec = 0\n                    if min == 59:\n                        nmin = 0\n                        nhr = hr ^ 1\n                    else:\n                        nmin = min + 1\n                else:\n                    nsec = sec + 1\n\n            if one_sec_pulse:\n                ncnt = 0\n            else:\n                ncnt = cnt + 1\n\n            sec = nsec\n            min = nmin\n            hr = nhr\n            cnt = ncnt\n\n    return res\n"
