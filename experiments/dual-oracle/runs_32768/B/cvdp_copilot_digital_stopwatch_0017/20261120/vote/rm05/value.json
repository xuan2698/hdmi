"def reference(vectors):\n    CLK_FREQ = 4\n    count = 0\n    pulse = 0\n    seconds = 0\n    minutes = 0\n    hour = 0\n    posedge = True\n    out = []\n    for row in vectors:\n        if isinstance(row, dict):\n            reset = row.get('reset', 0)\n            start_stop = row.get('start_stop', 0)\n        else:\n            n = len(row)\n            if n == 2:\n                reset, start_stop = row[0], row[1]\n            elif n >= 3:\n                reset, start_stop = row[1], row[2]\n            else:\n                reset = start_stop = 0\n        if reset == 1:\n            count = 0\n            pulse = 0\n            seconds = 0\n            minutes = 0\n            hour = 0\n        out.append({'seconds': seconds, 'minutes': minutes, 'hour': hour})\n        if posedge and reset == 0:\n            if count == CLK_FREQ - 1:\n                n_count = 0\n                n_pulse = 1\n            else:\n                n_count = count + 1\n                n_pulse = 0\n            n_seconds = seconds\n            n_minutes = minutes\n            n_hour = hour\n            if start_stop == 1 and pulse == 1:\n                if seconds == 59:\n                    n_seconds = 0\n                    if minutes == 59:\n                        n_minutes = 0\n                        n_hour = 1\n                    else:\n                        n_minutes = minutes + 1\n                else:\n                    n_seconds = seconds + 1\n            count = n_count\n            pulse = n_pulse\n            seconds = n_seconds\n            minutes = n_minutes\n            hour = n_hour\n        posedge = not posedge\n    return out\n"
