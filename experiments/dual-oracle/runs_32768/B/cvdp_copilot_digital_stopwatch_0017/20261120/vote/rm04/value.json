"def reference(vectors):\n    sec = 0\n    minute = 0\n    hour = 0\n    div = 0\n    out = []\n    CLK_FREQ = 4\n\n    for row in vectors:\n        reset = row.get('reset', 0)\n        if reset:\n            sec = 0\n            minute = 0\n            hour = 0\n            div = 0\n\n        out.append({\n            'seconds': sec & 0x3F,\n            'minutes': minute & 0x3F,\n            'hour': hour & 1\n        })\n\n        edge = row.get('edge', row.get('clk', 0))\n        if isinstance(edge, str):\n            s = edge.lower()\n            is_pos = s.startswith('pos') or s == 'p' or s == '1'\n        else:\n            is_pos = bool(edge)\n\n        if is_pos and not reset:\n            start_stop = row.get('start_stop', 0)\n            if start_stop:\n                if div == CLK_FREQ - 1:\n                    div = 0\n                    if sec == 59:\n                        sec = 0\n                        if minute == 59:\n                            minute = 0\n                            hour = (hour + 1) & 1\n                        else:\n                            minute += 1\n                    else:\n                        sec += 1\n                else:\n                    div += 1\n    return out\n"
