"def reference(vectors):\n    count = 0\n    pulse = 0\n    sec = 0\n    minute = 0\n    hour = 0\n    out = []\n    prev_clk = 0\n\n    for i, row in enumerate(vectors):\n        reset = 1 if row.get('reset', 0) else 0\n        start_stop = 1 if row.get('start_stop', 0) else 0\n\n        if reset:\n            count = 0\n            pulse = 0\n            sec = 0\n            minute = 0\n            hour = 0\n\n        out.append({\n            'seconds': sec & 63,\n            'minutes': minute & 63,\n            'hour': hour & 1\n        })\n\n        if 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                is_pos = e.lower().startswith('pos')\n            else:\n                is_pos = (int(e) == 1)\n        elif 'clk' in row:\n            c = int(row['clk'])\n            is_pos = (prev_clk == 0 and c == 1)\n            prev_clk = c\n        else:\n            is_pos = (i % 2 == 0)\n\n        if is_pos and not reset:\n            if count == 3:\n                new_count = 0\n                new_pulse = 1\n            else:\n                new_count = count + 1\n                new_pulse = 0\n\n            if start_stop and pulse:\n                if sec == 59:\n                    sec = 0\n                    if minute == 59:\n                        minute = 0\n                        hour = (hour + 1) & 1\n                    else:\n                        minute = (minute + 1) & 63\n                else:\n                    sec = (sec + 1) & 63\n\n            count = new_count\n            pulse = new_pulse\n\n    return out\n"
