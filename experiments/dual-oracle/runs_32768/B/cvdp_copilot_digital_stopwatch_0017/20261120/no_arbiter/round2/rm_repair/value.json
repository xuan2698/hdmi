"def reference(vectors):\n    count = 0\n    pulse = 0\n    sec = 0\n    minute = 0\n    hour = 0\n    out = []\n    for row in vectors:\n        reset = int(row.get('reset', 0)) & 1\n        start_stop = int(row.get('start_stop', 0)) & 1\n        if reset:\n            count = 0\n            pulse = 0\n            sec = 0\n            minute = 0\n            hour = 0\n        out.append({'seconds': sec & 63, 'minutes': minute & 63, 'hour': hour & 1})\n        e = row.get('edge', '')\n        if isinstance(e, str):\n            is_pos = e.lower().startswith('pos')\n        else:\n            is_pos = (int(e) == 1)\n        if is_pos and not reset:\n            if count == 3:\n                new_count = 0\n                new_pulse = 1\n            else:\n                new_count = count + 1\n                new_pulse = 0\n            if start_stop and pulse:\n                if sec == 59:\n                    sec = 0\n                    if minute == 59:\n                        minute = 0\n                        hour = (hour + 1) & 1\n                    else:\n                        minute = (minute + 1) & 63\n                else:\n                    sec = (sec + 1) & 63\n            count = new_count\n            pulse = new_pulse\n    return out\n"
