"def reference(vectors):\n    count = 0\n    pulse = 0\n    sec = 0\n    mins = 0\n    hr = 0\n    CLK_FREQ = 4\n    res = []\n    for i, row in enumerate(vectors):\n        if isinstance(row, dict):\n            rst = row.get('reset', 0)\n            ss = row.get('start_stop', 0)\n        else:\n            rst = row[0]\n            ss = row[1]\n        if rst:\n            count = 0\n            pulse = 0\n            sec = 0\n            mins = 0\n            hr = 0\n        res.append({'seconds': sec, 'minutes': mins, 'hour': hr})\n        if i % 2 == 0:\n            if rst:\n                n_count = 0\n                n_pulse = 0\n                n_sec = 0\n                n_mins = 0\n                n_hr = 0\n            else:\n                if count == CLK_FREQ - 1:\n                    n_count = 0\n                    n_pulse = 1\n                else:\n                    n_count = count + 1\n                    n_pulse = 0\n                if ss and pulse:\n                    if sec == 59:\n                        n_sec = 0\n                        if mins == 59:\n                            n_mins = 0\n                            n_hr = 1\n                        else:\n                            n_mins = mins + 1\n                            n_hr = hr\n                    else:\n                        n_sec = sec + 1\n                        n_mins = mins\n                        n_hr = hr\n                else:\n                    n_sec = sec\n                    n_mins = mins\n                    n_hr = hr\n            count = n_count\n            pulse = n_pulse\n            sec = n_sec\n            mins = n_mins\n            hr = n_hr\n    return res\n"
