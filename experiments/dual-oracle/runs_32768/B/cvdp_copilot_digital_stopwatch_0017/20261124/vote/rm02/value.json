"def reference(vectors):\n    counter = 0\n    seconds = 0\n    minutes = 0\n    hour = 0\n    out = []\n    for i, v in enumerate(vectors):\n        if isinstance(v, dict):\n            reset = v['reset']\n            start_stop = v['start_stop']\n        else:\n            reset = v[0]\n            start_stop = v[1]\n        if reset == 1:\n            counter = 0\n            seconds = 0\n            minutes = 0\n            hour = 0\n        out.append({'seconds': seconds, 'minutes': minutes, 'hour': hour})\n        if i % 2 == 0:  # posedge\n            if reset == 0 and start_stop == 1:\n                if counter == 3:  # CLK_FREQ - 1\n                    counter = 0\n                    if seconds == 59:\n                        seconds = 0\n                        if minutes == 59:\n                            minutes = 0\n                            hour = 1\n                        else:\n                            minutes += 1\n                    else:\n                        seconds += 1\n                else:\n                    counter += 1\n    return out\n"
