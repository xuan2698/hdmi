"def reference(vectors):\n    sec = 0\n    mins = 0\n    hour = 0\n    div = 0\n    pulse = 0\n    out = []\n    pos_default = True\n    for row in vectors:\n        if isinstance(row, dict):\n            reset = int(row.get('reset', 0)) & 1\n            start_stop = int(row.get('start_stop', 0)) & 1\n            if 'clk' in row:\n                v = row['clk']\n                if isinstance(v, str):\n                    is_pos = v.lower() in ('posedge', '1', 'true', 'high')\n                else:\n                    is_pos = int(v) != 0\n            elif 'edge' in row:\n                v = row['edge']\n                if isinstance(v, str):\n                    is_pos = v.lower() in ('posedge', '1', 'true', 'high')\n                else:\n                    is_pos = int(v) != 0\n            else:\n                is_pos = pos_default\n        else:\n            reset = 0\n            start_stop = 0\n            is_pos = pos_default\n            if len(row) >= 2:\n                reset = int(row[0]) & 1\n                start_stop = int(row[1]) & 1\n                if len(row) >= 3:\n                    v = row[2]\n                    if isinstance(v, str):\n                        is_pos = v.lower() in ('posedge', '1', 'true', 'high')\n                    else:\n                        is_pos = int(v) != 0\n            elif len(row) == 1:\n                reset = int(row[0]) & 1\n\n        if reset:\n            sec = 0\n            mins = 0\n            hour = 0\n            div = 0\n            pulse = 0\n\n        out.append({'seconds': sec & 63, 'minutes': mins & 63, 'hour': hour & 1})\n\n        if is_pos and not reset:\n            old_pulse = pulse\n            old_div = div\n            if old_div == 3:\n                div = 0\n                pulse = 1\n            else:\n                div = old_div + 1\n                pulse = 0\n            if start_stop and old_pulse:\n                if sec == 59:\n                    sec = 0\n                    if mins == 59:\n                        mins = 0\n                        hour = 1\n                    else:\n                        mins += 1\n                else:\n                    sec = sec + 1\n\n        pos_default = not pos_default\n\n    return out\n"
