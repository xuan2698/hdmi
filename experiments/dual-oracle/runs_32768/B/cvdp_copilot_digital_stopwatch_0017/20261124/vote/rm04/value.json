"def reference(vectors):\n    sec = 0\n    mins = 0\n    hour = 0\n    div = 0\n    results = []\n    for idx, row in enumerate(vectors):\n        reset = int(row.get('reset', 0)) & 1\n        if reset:\n            sec = 0\n            mins = 0\n            hour = 0\n            div = 0\n        if 'clk' in row:\n            clk_val = int(row['clk'])\n            posedge = (clk_val == 1)\n        elif 'clock' in row:\n            clk_val = int(row['clock'])\n            posedge = (clk_val == 1)\n        else:\n            edge = row.get('edge')\n            if isinstance(edge, str):\n                posedge = edge.lower().startswith('pos')\n            elif edge is not None:\n                posedge = (int(edge) == 1)\n            else:\n                posedge = (idx % 2 == 0)\n        results.append({'seconds': sec & 0x3F, 'minutes': mins & 0x3F, 'hour': hour & 1})\n        if posedge and not reset:\n            start_stop = int(row.get('start_stop', 0)) & 1\n            pulse = (div == 3)\n            div_next = 0 if pulse else div + 1\n            if start_stop and pulse:\n                if sec == 59:\n                    sec_next = 0\n                    if mins == 59:\n                        mins_next = 0\n                        hour_next = 1\n                    else:\n                        mins_next = mins + 1\n                        hour_next = hour\n                else:\n                    sec_next = sec + 1\n                    mins_next = mins\n                    hour_next = hour\n            else:\n                sec_next = sec\n                mins_next = mins\n                hour_next = hour\n            sec = sec_next\n            mins = mins_next\n            hour = hour_next\n            div = div_next\n    return results\n"
