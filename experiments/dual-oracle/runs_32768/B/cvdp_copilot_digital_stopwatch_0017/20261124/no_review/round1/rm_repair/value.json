"def reference(vectors):\n    def gv(row, names, default, pos):\n        if isinstance(row, dict):\n            for n in names:\n                if n in row:\n                    v = row[n]\n                    if isinstance(v, str):\n                        s = v.lower()\n                        if s in ('1', 'true', 'high'):\n                            return 1\n                        if s in ('0', 'false', 'low'):\n                            return 0\n                    return int(v) & 1\n            return default\n        if isinstance(row, (list, tuple)):\n            if len(row) > pos and not isinstance(row[0], str):\n                v = row[pos]\n            elif len(row) > pos + 1:\n                v = row[pos + 1]\n            elif len(row) > pos:\n                v = row[pos]\n            else:\n                return default\n            if isinstance(v, str):\n                s = v.lower()\n                if 'pos' in s or 'neg' in s:\n                    return default\n                if s in ('1', 'true', 'high'):\n                    return 1\n                if s in ('0', 'false', 'low'):\n                    return 0\n            return int(v) & 1\n        return default\n\n    def ge(row, idx):\n        if isinstance(row, dict):\n            for k in ('edge', 'clk', 'clock'):\n                if k in row:\n                    v = row[k]\n                    if isinstance(v, str):\n                        s = v.lower()\n                        if 'pos' in s:\n                            return 1\n                        if 'neg' in s:\n                            return 0\n                    return 1 if v else 0\n        elif isinstance(row, (list, tuple)):\n            for v in row:\n                if isinstance(v, str):\n                    s = v.lower()\n                    if 'pos' in s:\n                        return 1\n                    if 'neg' in s:\n                        return 0\n            if len(row) >= 3 and not isinstance(row[0], str):\n                v = row[0]\n                if v in (0, 1, False, True):\n                    return 1 if v else 0\n        return 1 if idx % 2 == 0 else 0\n\n    div = 0\n    pulse = 0\n    sec = 0\n    mins = 0\n    hr = 0\n    out = []\n\n    for idx, row in enumerate(vectors):\n        rst = gv(row, ('reset', 'rst'), 0, 0)\n        start = gv(row, ('start_stop', 'startstop', 'start'), 0, 1)\n        edge = ge(row, idx)\n\n        if rst:\n            div = 0\n            pulse = 0\n            sec = 0\n            mins = 0\n            hr = 0\n\n        out.append({'seconds': sec & 63, 'minutes': mins & 63, 'hour': hr & 1})\n\n        if edge:\n            if rst:\n                div = 0\n                pulse = 0\n                sec = 0\n                mins = 0\n                hr = 0\n            else:\n                np = 1 if div == 3 else 0\n                nd = 0 if div == 3 else div + 1\n                ns = sec\n                nm = mins\n                nh = hr\n\n                if pulse and start:\n                    if sec == 59:\n                        ns = 0\n                        if mins == 59:\n                            nm = 0\n                            nh = 1\n                        else:\n                            nm = mins + 1\n                    else:\n                        ns = sec + 1\n\n                div = nd\n                pulse = np\n                sec = ns\n                mins = nm\n                hr = nh\n\n    return out\n"
