"def reference(vectors):\n    s = m = h = d = 0\n    out = []\n    for r in vectors:\n        reset = r.get('reset', 0)\n        start = r.get('start_stop', 0)\n        e = r.get('edge', r.get('clk', 0))\n        if isinstance(e, str):\n            is_pos = e.lower().startswith('p') or e == '1'\n        else:\n            is_pos = bool(e)\n\n        if reset == 1:\n            s = m = h = 0\n            d = 0\n\n        out.append({'seconds': s, 'minutes': m, 'hour': h})\n\n        if is_pos and reset == 0 and start == 1:\n            if d == 3:\n                d = 0\n                if s == 59:\n                    s = 0\n                    if m == 59:\n                        m = 0\n                        h = 1\n                    else:\n                        m += 1\n                else:\n                    s += 1\n            else:\n                d += 1\n\n    return out\n"
