  "RM": "def reference(vectors):\n    def get_val(row, names, default, pos):\n        if isinstance(row, dict):\n            for n in names:\n                if n in row:\n                    return int(row[n]) & 1\n            return default\n        if isinstance(row, (list, tuple)):\n            if len(row) >= 3:\n                if isinstance(row[0], str):\n                    if len(row) > pos + 1:\n                        return int(row[pos + 1]) & 1\n                else:\n                    return int(row[pos + 1]) & 1\n            elif len(row) > pos:\n                return int(row[pos]) & 1\n            return default\n        return default\n\n    def get_edge(row, idx):\n        if isinstance(row, dict):\n            for k in ('edge', 'clk', 'clock'):\n                if k in row:\n                    v = row[k]\n                    if isinstance(v, str):\n                        s = v.lower()\n                        if 'pos' in s:\n                            return 1\n                        if 'neg' in s:\n                            return 0\n                    return 1 if v else 0\n        elif isinstance(row, (list, tuple)):\n            for v in row:\n                if isinstance(v, str):\n                    s = v.lower()\n                    if 'pos' in s:\n                        return 1\n                    if 'neg' in s:\n                        return 0\n            if len(row) >= 3 and not isinstance(row[0], str):\n                v = row[0]\n                if v in (0, 1, False, True):\n                    return 1 if v else 0\n        return 1 if (idx % 2 == 0) else 0\n\n    FREQ = 4\n    count = 0\n    seconds = 0\n    minutes = 0\n    hour = 0\n    out = []\n\n    for idx, row in enumerate(vectors):\n        rst = get_val(row, ('reset', 'rst'), 0, 0)\n        start = get_val(row, ('start_stop', 'startstop', 'start'), 0, 1)\n        edge = get_edge(row, idx)\n\n        if rst:\n            count = 0\n            seconds = 0\n            minutes = 0\n            hour = 0\n\n        out.append({'seconds': seconds & 0x3f, 'minutes': minutes & 0x3f, 'hour': hour & 1})\n\n        if edge:\n            if rst:\n                count = 0\n                seconds = 0\n                minutes = 0\n                hour = 0\n            elif start:\n                if count == FREQ - 1:\n                    count = 0\n                    if seconds == 59:\n                        seconds = 0\n                        if minutes == 59:\n                            minutes = 0\n                            hour = 1\n                        else:\n                            minutes += 1\n                    else:\n                        seconds += 1\n                else:\n                    count += 1\n\n    return out\n",
