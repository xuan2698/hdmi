"def reference(vectors):\n    cnt = 0\n    pulse = 0\n    sec = 0\n    mi = 0\n    hr = 0\n    out = []\n    for i, row in enumerate(vectors):\n        reset = row.get('reset', 0)\n        start = row.get('start_stop', 0)\n\n        if reset:\n            cnt = 0\n            pulse = 0\n            sec = 0\n            mi = 0\n            hr = 0\n\n        out.append({'seconds': sec, 'minutes': mi, 'hour': hr})\n\n        if i % 2 == 0:\n            if reset:\n                cnt = 0\n                pulse = 0\n                sec = 0\n                mi = 0\n                hr = 0\n            else:\n                if start:\n                    if cnt == 3:\n                        ncnt = 0\n                        npulse = 1\n                    else:\n                        ncnt = cnt + 1\n                        npulse = 0\n                else:\n                    ncnt = cnt\n                    npulse = 0\n\n                nsec = sec\n                nmi = mi\n                nhr = hr\n\n                if pulse:\n                    if sec == 59:\n                        nsec = 0\n                        if mi == 59:\n                            nmi = 0\n                            nhr = 1\n                        else:\n                            nmi = mi + 1\n                    else:\n                        nsec = sec + 1\n\n                cnt, pulse, sec, mi, hr = ncnt, npulse, nsec, nmi, nhr\n\n    return out\n"
