"def reference(vectors):\n    sec = 0\n    min_val = 0\n    hour = 0\n    div = 0\n    pulse = 0\n    CLK_FREQ = 4\n    res = []\n    for i, row in enumerate(vectors):\n        reset = row.get('reset', 0)\n        start_stop = row.get('start_stop', 0)\n        if reset == 1:\n            sec = 0\n            min_val = 0\n            hour = 0\n            div = 0\n            pulse = 0\n        out = {\n            'seconds': sec & 0x3F,\n            'minutes': min_val & 0x3F,\n            'hour': hour & 0x1\n        }\n        res.append(out)\n        if (i % 2 == 0) and (reset == 0):\n            if start_stop == 1 and pulse == 1:\n                if sec == 59:\n                    sec = 0\n                    if min_val == 59:\n                        min_val = 0\n                        hour = 1\n                    else:\n                        min_val += 1\n                else:\n                    sec += 1\n            if div == CLK_FREQ - 1:\n                div = 0\n                pulse = 1\n            else:\n                div += 1\n                pulse = 0\n    return res\n"
