"def reference(vectors):\n    clk_freq = 4\n    seconds = 0\n    minutes = 0\n    hour = 0\n    count = 0\n    prev_clk = 0\n    out = []\n    for i, row in enumerate(vectors):\n        reset = 0\n        start_stop = 0\n        e = None\n        if isinstance(row, dict):\n            try:\n                reset = int(row.get('reset', 0)) & 1\n            except Exception:\n                reset = 1 if row.get('reset', 0) else 0\n            try:\n                start_stop = int(row.get('start_stop', 0)) & 1\n            except Exception:\n                start_stop = 1 if row.get('start_stop', 0) else 0\n            e = row.get('edge', None)\n            if e is None:\n                e = row.get('clk_edge', None)\n            if e is None:\n                if 'clk' in row:\n                    cv = row['clk']\n                    if isinstance(cv, str):\n                        e = cv\n                    else:\n                        clk_val = int(cv) & 1\n                        if prev_clk == 0 and clk_val == 1:\n                            e = 'posedge'\n                        elif prev_clk == 1 and clk_val == 0:\n                            e = 'negedge'\n                        else:\n                            e = 'posedge' if (i % 2 == 0) else 'negedge'\n                        prev_clk = clk_val\n                else:\n                    e = 'posedge' if (i % 2 == 0) else 'negedge'\n        else:\n            vals = list(row) if not isinstance(row, (int, float)) else [row]\n            if vals and isinstance(vals[0], str):\n                e = vals[0]\n                if len(vals) > 1:\n                    reset = int(vals[1]) & 1\n                if len(vals) > 2:\n                    start_stop = int(vals[2]) & 1\n            else:\n                if len(vals) >= 3:\n                    v0 = int(vals[0]) & 1\n                    v1 = int(vals[1]) & 1\n                    v2 = int(vals[2]) & 1\n                    expected_clk = 1 if (i % 2 == 0) else 0\n                    if v0 == expected_clk:\n                        reset = v1\n                        start_stop = v2\n                        e = 'posedge' if v0 == 1 else 'negedge'\n                    else:\n                        reset = v0\n                        start_stop = v1\n                        e = 'posedge' if (i % 2 == 0) else 'negedge'\n                else:\n                    if len(vals) > 0:\n                        reset = int(vals[0]) & 1\n                    if len(vals) > 1:\n                        start_stop = int(vals[1]) & 1\n                    e = 'posedge' if (i % 2 == 0) else 'negedge'\n        if e is None:\n            edge = 'posedge' if (i % 2 == 0) else 'negedge'\n        else:\n            s = str(e).lower()\n            if 'pos' in s or s == '1' or s == 'rise' or s == 'rising':\n                edge = 'posedge'\n            elif 'neg' in s or s == '0' or s == 'fall' or s == 'falling':\n                edge = 'negedge'\n            else:\n                edge = 'posedge' if (i % 2 == 0) else 'negedge'\n        if reset:\n            seconds = 0\n            minutes = 0\n            hour = 0\n            count = 0\n        out.append({'seconds': seconds & 0x3F, 'minutes': minutes & 0x3F, 'hour': hour & 1})\n        if edge == 'posedge' and reset == 0:\n            one_sec = (count == clk_freq - 1)\n            nsec = seconds\n            nmin = minutes\n            nhour = hour\n            if one_sec and start_stop:\n                if seconds == 59:\n                    nsec = 0\n                    if minutes == 59:\n                        nmin = 0\n                        nhour = (hour + 1) & 1\n                    else:\n                        nmin = minutes + 1\n                else:\n                    nsec = seconds + 1\n            if count == clk_freq - 1:\n                count = 0\n            else:\n                count += 1\n            seconds = nsec\n            minutes = nmin\n            hour = nhour\n    return out\n"
