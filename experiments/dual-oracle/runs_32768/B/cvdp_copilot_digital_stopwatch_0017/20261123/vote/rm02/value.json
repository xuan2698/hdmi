"def reference(vectors):\n    seconds = 0\n    minutes = 0\n    hour = 0\n    counter = 0\n    pulse = 0\n    out = []\n    for row in vectors:\n        r = row[\"reset\"]\n        s = row[\"start_stop\"]\n        e = row[\"edge\"]\n        if r == 1 or r == \"1\":\n            seconds = 0\n            minutes = 0\n            hour = 0\n            counter = 0\n            pulse = 0\n        is_pos = (e == 1 or e == True or e == \"posedge\" or e == \"pos\" or e == \"1\")\n        out.append({\"seconds\": seconds, \"minutes\": minutes, \"hour\": hour})\n        running = (s == 1 or s == \"1\" or s == True)\n        if is_pos and not (r == 1 or r == \"1\"):\n            old_pulse = pulse\n            if running:\n                if counter == 3:\n                    counter_new = 0\n                    pulse_new = 1\n                else:\n                    counter_new = counter + 1\n                    pulse_new = 0\n            else:\n                counter_new = counter\n                pulse_new = 0\n            if old_pulse == 1:\n                if seconds == 59:\n                    seconds = 0\n                    if minutes == 59:\n                        minutes = 0\n                        hour = 1 - hour\n                    else:\n                        minutes = minutes + 1\n                else:\n                    seconds = seconds + 1\n            counter = counter_new\n            pulse = pulse_new\n    return out\n"
