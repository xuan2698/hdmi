"def reference(vectors):\n    cnt = 0\n    pulse = 0\n    seconds = 0\n    minutes = 0\n    hour = 0\n    out = []\n    toggle = 1\n    for row in vectors:\n        reset = row.get('reset', 0)\n        start_stop = row.get('start_stop', 0)\n\n        if reset:\n            cnt = 0\n            pulse = 0\n            seconds = 0\n            minutes = 0\n            hour = 0\n\n        clk = row.get('clk', -1)\n        if clk == -1:\n            edge = row.get('edge', -1)\n            if edge == -1:\n                posedge = toggle == 1\n            elif edge == 'posedge' or edge == 'pos' or edge == 'rising' or edge == 1:\n                posedge = 1\n            else:\n                posedge = 0\n        else:\n            posedge = clk == 1\n\n        out.append({'seconds': seconds, 'minutes': minutes, 'hour': hour})\n\n        if posedge and not reset:\n            old_cnt = cnt\n            old_pulse = pulse\n            old_seconds = seconds\n            old_minutes = minutes\n            old_hour = hour\n\n            if start_stop:\n                if old_cnt == 3:\n                    new_cnt = 0\n                    new_pulse = 1\n                else:\n                    new_cnt = old_cnt + 1\n                    new_pulse = 0\n            else:\n                new_cnt = old_cnt\n                new_pulse = 0\n\n            new_seconds = old_seconds\n            new_minutes = old_minutes\n            new_hour = old_hour\n\n            if old_pulse:\n                if old_seconds == 59:\n                    new_seconds = 0\n                    if old_minutes == 59:\n                        new_minutes = 0\n                        new_hour = 1\n                    else:\n                        new_minutes = old_minutes + 1\n                else:\n                    new_seconds = old_seconds + 1\n\n            cnt = new_cnt\n            pulse = new_pulse\n            seconds = new_seconds\n            minutes = new_minutes\n            hour = new_hour\n\n        if toggle == 1:\n            toggle = 0\n        else:\n            toggle = 1\n\n    return out\n"
