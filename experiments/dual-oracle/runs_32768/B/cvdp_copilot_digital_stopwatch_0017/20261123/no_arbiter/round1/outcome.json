  "RM": "def reference(vectors):\n    seconds = minutes = hour = div = 0\n    result = []\n    last_ss = 0\n    last_reset = 0\n\n    for i, row in enumerate(vectors):\n        def get(key):\n            if isinstance(row, dict):\n                if key in row:\n                    return row[key]\n                if 'inputs' in row and isinstance(row['inputs'], dict) and key in row['inputs']:\n                    return row['inputs'][key]\n            return None\n\n        edge = get('edge')\n        if edge is None:\n            edge = get('clk')\n        if edge is None:\n            edge = 1 if i % 2 == 0 else 0\n\n        if isinstance(edge, str):\n            e = edge.lower()\n            posedge = e.startswith('pos') or e in ('1', 'true', 'rising')\n        else:\n            posedge = bool(edge)\n\n        reset_value = get('reset')\n        if reset_value is None:\n            reset = last_reset\n        else:\n            reset = int(reset_value)\n            last_reset = reset\n\n        start_value = get('start_stop')\n        if start_value is None:\n            start_stop = last_ss\n        else:\n            start_stop = int(start_value)\n            last_ss = start_stop\n\n        if reset:\n            seconds = minutes = hour = div = 0\n\n        result.append({'seconds': seconds, 'minutes': minutes, 'hour': hour})\n\n        if posedge:\n            if reset:\n                seconds = minutes = hour = div = 0\n            elif start_stop:\n                if div == 3:\n                    div = 0\n                    if seconds == 59:\n                        seconds = 0\n                        if minutes == 59:\n                            minutes = 0\n                            hour = 1\n                        else:\n                            minutes += 1\n                    else:\n                        seconds += 1\n                else:\n                    div += 1\n\n    return result\n",
