"def reference(vectors):\n    CLK_FREQ = 4\n    sec = 0\n    minute = 0\n    hour = 0\n    div = 0\n    out = []\n    for i, row in enumerate(vectors):\n        out.append({'seconds': sec, 'minutes': minute, 'hour': hour})\n        rst = int(row.get('reset', 0))\n        ss = int(row.get('start_stop', 0))\n        if 'edge' in row:\n            edge = row['edge']\n            if isinstance(edge, str):\n                is_pos = edge.lower().startswith('p')\n            else:\n                is_pos = bool(edge)\n        else:\n            is_pos = (i % 2 == 0)\n        if is_pos:\n            if rst:\n                sec = 0\n                minute = 0\n                hour = 0\n                div = 0\n            else:\n                pulse = (div == CLK_FREQ - 1)\n                if pulse:\n                    div = 0\n                else:\n                    div += 1\n                if ss and pulse:\n                    if sec == 59:\n                        sec = 0\n                        if minute == 59:\n                            minute = 0\n                            hour = 1\n                        else:\n                            minute += 1\n                    else:\n                        sec += 1\n        else:\n            if rst:\n                sec = 0\n                minute = 0\n                hour = 0\n                div = 0\n    return out\n"
