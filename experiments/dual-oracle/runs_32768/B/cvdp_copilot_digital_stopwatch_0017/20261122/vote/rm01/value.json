"def reference(vectors):\n    count = 0\n    one_sec_pulse = 0\n    seconds = 0\n    minutes = 0\n    hour = 0\n    res = []\n    for v in vectors:\n        res.append({'seconds': seconds, 'minutes': minutes, 'hour': hour})\n        if v.get('reset', 0) == 1:\n            count = 0\n            one_sec_pulse = 0\n            seconds = 0\n            minutes = 0\n            hour = 0\n            continue\n        edge = v.get('edge')\n        if isinstance(edge, str):\n            is_pos = (edge == 'posedge')\n        else:\n            is_pos = (edge == 1)\n        if is_pos:\n            start_stop = v.get('start_stop', 0)\n            if start_stop == 1:\n                if count == 3:\n                    new_count = 0\n                    new_pulse = 1\n                else:\n                    new_count = count + 1\n                    new_pulse = 0\n            else:\n                new_count = count\n                new_pulse = 0\n            if one_sec_pulse == 1:\n                if seconds == 59:\n                    new_seconds = 0\n                    if minutes == 59:\n                        new_minutes = 0\n                        new_hour = 1 - hour\n                    else:\n                        new_minutes = minutes + 1\n                        new_hour = hour\n                else:\n                    new_seconds = seconds + 1\n                    new_minutes = minutes\n                    new_hour = hour\n            else:\n                new_seconds = seconds\n                new_minutes = minutes\n                new_hour = hour\n            count = new_count\n            one_sec_pulse = new_pulse\n            seconds = new_seconds\n            minutes = new_minutes\n            hour = new_hour\n    return res\n"
