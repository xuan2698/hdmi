"def reference(vectors):\n    count = 0\n    seconds = 0\n    minutes = 0\n    hour = 0\n    res = []\n    parity = 1\n    for row in vectors:\n        if isinstance(row, dict):\n            reset = row.get('reset', 0)\n            start_stop = row.get('start_stop', 0)\n            edge = row.get('edge', None)\n            if edge is None and 'clk' in row:\n                edge = row['clk']\n            if edge is None:\n                edge = parity\n                parity = 1 - parity\n        else:\n            if len(row) == 3:\n                edge, reset, start_stop = row\n            elif len(row) == 2:\n                reset, start_stop = row\n                edge = parity\n                parity = 1 - parity\n            else:\n                edge = 1\n                reset = 0\n                start_stop = 0\n        if isinstance(edge, str):\n            if 'pos' in edge.lower() or edge == '1':\n                is_pos = True\n            elif 'neg' in edge.lower() or edge == '0':\n                is_pos = False\n            else:\n                is_pos = False\n        else:\n            is_pos = (edge == 1)\n        if reset == 1:\n            count = 0\n            seconds = 0\n            minutes = 0\n            hour = 0\n        res.append({'seconds': seconds, 'minutes': minutes, 'hour': hour})\n        if is_pos:\n            if reset == 1:\n                count = 0\n                seconds = 0\n                minutes = 0\n                hour = 0\n            else:\n                pulse = (count == 3)\n                if count == 3:\n                    count = 0\n                else:\n                    count += 1\n                if start_stop == 1 and pulse:\n                    if seconds == 59:\n                        seconds = 0\n                        if minutes == 59:\n                            minutes = 0\n                            hour = 1\n                        else:\n                            minutes += 1\n                    else:\n                        seconds += 1\n    return res\n"
