"def reference(vectors):\n    if isinstance(vectors, dict):\n        keys = list(vectors.keys())\n        n = len(vectors[keys[0]]) if keys else 0\n        rows = []\n        for i in range(n):\n            row = {}\n            for k in keys:\n                row[k] = vectors[k][i]\n            rows.append(row)\n        vectors = rows\n\n    cnt = 0\n    sec = 0\n    mins = 0\n    hour = 0\n    out = []\n\n    for i, row in enumerate(vectors):\n        reset = 0\n        start_stop = 0\n        edge = None\n        clk = None\n\n        if isinstance(row, dict):\n            reset = row.get('reset', 0)\n            start_stop = row.get('start_stop', 0)\n            if 'edge' in row:\n                edge = row['edge']\n            if 'clk' in row:\n                clk = row['clk']\n        elif isinstance(row, (list, tuple)):\n            if len(row) >= 3:\n                edge = row[0]\n                reset = row[1]\n                start_stop = row[2]\n            elif len(row) == 2:\n                reset = row[0]\n                start_stop = row[1]\n\n        is_pos = None\n        if edge is not None:\n            if isinstance(edge, str):\n                s = edge.lower()\n                if 'pos' in s or s in ('1', 'p', 'rise', 'rising'):\n                    is_pos = True\n                elif 'neg' in s or s in ('0', 'n', 'fall', 'falling'):\n                    is_pos = False\n            else:\n                if edge == 1 or edge is True:\n                    is_pos = True\n                elif edge == 0 or edge is False:\n                    is_pos = False\n\n        if is_pos is None and clk is not None:\n            if clk == 1 or clk is True:\n                is_pos = True\n            elif clk == 0 or clk is False:\n                is_pos = False\n\n        if is_pos is None:\n            is_pos = (i % 2 == 0)\n\n        if reset == 1:\n            cnt = 0\n            sec = 0\n            mins = 0\n            hour = 0\n\n        out.append({'seconds': sec, 'minutes': mins, 'hour': hour})\n\n        if is_pos and reset == 0:\n            terminal = (cnt == 3)\n\n            if terminal and start_stop == 1:\n                if sec == 59:\n                    sec = 0\n                    if mins == 59:\n                        mins = 0\n                        hour = 1\n                    else:\n                        mins += 1\n                else:\n                    sec += 1\n\n            cnt = 0 if terminal else cnt + 1\n\n    return out\n"
