"def reference(vectors):\n    y1 = y2 = y3 = 0\n    outs = []\n\n    def s16(x):\n        x = int(x) & 0xFFFF\n        return x - 65536 if x >= 32768 else x\n\n    def sat(x):\n        if x > 32767:\n            return 32767\n        if x < -32768:\n            return -32768\n        return x\n\n    for row in vectors:\n        edge = row.get('edge', row.get('clk_edge', row.get('edge_type', 1)))\n        if isinstance(edge, str):\n            e = edge.lower()\n            is_pos = e.startswith('p') or e in ('1', 'high', 'pos')\n        else:\n            is_pos = bool(edge)\n\n        rst = int(row.get('reset', 0)) & 1\n        if rst:\n            y1 = y2 = y3 = 0\n\n        outs.append({\n            'out_1': y1 & 0xFFFF,\n            'out_2': y2 & 0xFFFF,\n            'out_3': y3 & 0xFFFF\n        })\n\n        if is_pos and not rst:\n            x1 = s16(row.get('in_1', 0))\n            x2 = s16(row.get('in_2', 0))\n            x3 = s16(row.get('in_3', 0))\n            fs = int(row.get('filter_select', 0)) & 3\n\n            y1 = sat(y1 + ((x1 - y1) >> fs))\n            y2 = sat(y2 + ((x2 - y2) >> fs))\n            y3 = sat(y3 + ((x3 - y3) >> fs))\n\n    return outs\n"
