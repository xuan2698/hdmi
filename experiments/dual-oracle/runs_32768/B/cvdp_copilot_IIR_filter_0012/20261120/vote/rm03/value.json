"def reference(vectors):\n    y1 = y2 = y3 = 0\n    prev_clk = 0\n    res = []\n    for row in vectors:\n        if isinstance(row, dict):\n            clk = row.get('clk', None)\n            rst = int(row.get('reset', 0))\n            in1 = row.get('in_1', 0)\n            in2 = row.get('in_2', 0)\n            in3 = row.get('in_3', 0)\n            sel = int(row.get('filter_select', 0)) & 3\n            edge = row.get('edge', None)\n        else:\n            clk = row[0] if len(row) > 0 else None\n            rst = int(row[1]) if len(row) > 1 else 0\n            in1 = row[2] if len(row) > 2 else 0\n            in2 = row[3] if len(row) > 3 else 0\n            in3 = row[4] if len(row) > 4 else 0\n            sel = int(row[5]) & 3 if len(row) > 5 else 0\n            edge = None\n\n        def s16(v):\n            v = int(v) & 0xFFFF\n            return v - 0x10000 if v >= 0x8000 else v\n\n        in1 = s16(in1)\n        in2 = s16(in2)\n        in3 = s16(in3)\n\n        is_pos = False\n        if edge is not None:\n            if isinstance(edge, str):\n                is_pos = 'pos' in edge.lower()\n            else:\n                is_pos = (int(edge) == 1)\n        elif clk is not None:\n            c = int(clk) & 1\n            if c == 1 and prev_clk == 0:\n                is_pos = True\n\n        if rst:\n            y1 = y2 = y3 = 0\n\n        res.append({\n            'out_1': y1 & 0xFFFF,\n            'out_2': y2 & 0xFFFF,\n            'out_3': y3 & 0xFFFF\n        })\n\n        if is_pos and not rst:\n            gain = sel + 1\n\n            def sat16(v):\n                if v > 32767:\n                    return 32767\n                if v < -32768:\n                    return -32768\n                return v\n\n            y1 = sat16(in1 * gain)\n            y2 = sat16(in2 * gain)\n            y3 = sat16(in3 * gain)\n\n        if clk is not None:\n            prev_clk = int(clk) & 1\n\n    return res\n"
