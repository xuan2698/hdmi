"def reference(vectors):\n    out1 = out2 = out3 = 0\n    result = []\n    for idx, row in enumerate(vectors):\n        if isinstance(row, dict):\n            r = int(row.get('reset', 0)) & 1\n            i1 = row.get('in_1', 0)\n            i2 = row.get('in_2', 0)\n            i3 = row.get('in_3', 0)\n            edge = row.get('edge', None)\n            clk = row.get('clk', None)\n        else:\n            try:\n                r = int(row.reset) & 1\n                i1 = row.in_1\n                i2 = row.in_2\n                i3 = row.in_3\n                edge = getattr(row, 'edge', None)\n                clk = getattr(row, 'clk', None)\n            except Exception:\n                r = i1 = i2 = i3 = edge = clk = 0\n\n        if r:\n            out1 = out2 = out3 = 0\n\n        result.append({\n            'out_1': out1 & 0xFFFF,\n            'out_2': out2 & 0xFFFF,\n            'out_3': out3 & 0xFFFF\n        })\n\n        pos = False\n        if edge is not None:\n            if isinstance(edge, str):\n                e = edge.lower()\n                if 'pos' in e or e == '1':\n                    pos = True\n                elif 'neg' in e or e == '0':\n                    pos = False\n                else:\n                    pos = (idx % 2 == 0)\n            else:\n                pos = bool(edge)\n        elif clk is not None:\n            pos = (int(clk) & 1) == 1\n        else:\n            pos = (idx % 2 == 0)\n\n        if pos:\n            if r:\n                out1 = out2 = out3 = 0\n            else:\n                out1 = int(i1) & 0xFFFF\n                out2 = int(i2) & 0xFFFF\n                out3 = int(i3) & 0xFFFF\n\n    return result\n"
