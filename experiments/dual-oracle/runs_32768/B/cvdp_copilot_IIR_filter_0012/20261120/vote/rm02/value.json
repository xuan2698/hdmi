"def reference(vectors):\n    def s16(x):\n        x &= 0xFFFF\n        return x - 0x10000 if x >= 0x8000 else x\n\n    out1 = out2 = out3 = 0\n    results = []\n\n    for i, row in enumerate(vectors):\n        if 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                is_posedge = e.lower() in ('posedge', 'pos', 'rising', '1')\n            else:\n                is_posedge = bool(e)\n        else:\n            is_posedge = (i % 2 == 0)\n\n        rst = row.get('reset', 0)\n        in1 = s16(row.get('in_1', 0))\n        in2 = s16(row.get('in_2', 0))\n        in3 = s16(row.get('in_3', 0))\n        sel = row.get('filter_select', 0) & 3\n\n        if rst:\n            out1 = out2 = out3 = 0\n\n        results.append({\n            'out_1': out1 & 0xFFFF,\n            'out_2': out2 & 0xFFFF,\n            'out_3': out3 & 0xFFFF\n        })\n\n        if is_posedge and not rst:\n            def update(cur, inp, s):\n                nxt = cur + ((inp - cur) >> s)\n                if nxt > 32767:\n                    nxt = 32767\n                elif nxt < -32768:\n                    nxt = -32768\n                return nxt\n\n            out1 = update(out1, in1, sel)\n            out2 = update(out2, in2, sel)\n            out3 = update(out3, in3, sel)\n\n    return results\n"
