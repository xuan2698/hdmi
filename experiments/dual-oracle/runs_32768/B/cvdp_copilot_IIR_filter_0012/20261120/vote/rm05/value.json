"def reference(vectors):\n    y1 = y2 = y3 = 0\n    result = []\n    for row in vectors:\n        result.append({\n            \"out_1\": y1 & 0xFFFF,\n            \"out_2\": y2 & 0xFFFF,\n            \"out_3\": y3 & 0xFFFF\n        })\n        reset = int(row.get(\"reset\", 0)) & 1\n        if reset:\n            y1 = y2 = y3 = 0\n        else:\n            edge = str(row.get(\"edge\", \"\")).lower()\n            if \"pos\" in edge:\n                y1 = int(row.get(\"in_1\", 0)) & 0xFFFF\n                y2 = int(row.get(\"in_2\", 0)) & 0xFFFF\n                y3 = int(row.get(\"in_3\", 0)) & 0xFFFF\n    return result\n"
