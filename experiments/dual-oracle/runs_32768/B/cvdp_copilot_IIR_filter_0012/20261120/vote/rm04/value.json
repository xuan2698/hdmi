"def reference(vectors):\n    def s16(v):\n        v = int(v) & 0xFFFF\n        return v - 0x10000 if v & 0x8000 else v\n\n    def clamp(v):\n        if v > 32767:\n            return 32767\n        if v < -32768:\n            return -32768\n        return v\n\n    out1 = out2 = out3 = 0\n    prev1 = prev2 = prev3 = 0\n    res = []\n\n    for i, row in enumerate(vectors):\n        reset = int(row.get('reset', 0)) & 1\n\n        if reset:\n            out1 = out2 = out3 = 0\n            prev1 = prev2 = prev3 = 0\n            res.append({'out_1': 0, 'out_2': 0, 'out_3': 0})\n            continue\n\n        if 'edge' in row:\n            is_pos = str(row['edge']).lower() in ('posedge', 'pos', '1')\n        else:\n            is_pos = (i % 2 == 0)\n\n        res.append({\n            'out_1': out1 & 0xFFFF,\n            'out_2': out2 & 0xFFFF,\n            'out_3': out3 & 0xFFFF\n        })\n\n        if is_pos:\n            x1 = s16(row.get('in_1', 0))\n            x2 = s16(row.get('in_2', 0))\n            x3 = s16(row.get('in_3', 0))\n            fs = int(row.get('filter_select', 0)) & 3\n\n            def apply_filter(x, p):\n                if fs == 0:\n                    y = x\n                elif fs == 1:\n                    y = (x + p) >> 1\n                elif fs == 2:\n                    y = x - p\n                else:\n                    y = x + p\n                return clamp(y)\n\n            out1 = apply_filter(x1, prev1)\n            out2 = apply_filter(x2, prev2)\n            out3 = apply_filter(x3, prev3)\n\n            prev1, prev2, prev3 = x1, x2, x3\n\n    return res\n"
