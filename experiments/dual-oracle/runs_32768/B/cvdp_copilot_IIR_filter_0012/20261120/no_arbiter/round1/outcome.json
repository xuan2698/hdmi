  "RM": "def reference(vectors):\n    s1 = s2 = s3 = 0\n    res = []\n    for v in vectors:\n        e = v.get('edge')\n        r = v.get('reset', 0)\n        a = v.get('in_1', 0)\n        b = v.get('in_2', 0)\n        c = v.get('in_3', 0)\n        sel = v.get('filter_select', 0)\n        if r:\n            s1 = s2 = s3 = 0\n            o1 = o2 = o3 = 0\n        else:\n            po = (e == 'posedge' or e == 1)\n            if po:\n                o1, o2, o3 = s1, s2, s3\n                if sel == 0:\n                    s1 = (a + s1) >> 1\n                    s2 = (b + s2) >> 1\n                    s3 = (c + s3) >> 1\n                elif sel == 1:\n                    s1 = (a + 3 * s1) >> 2\n                    s2 = (b + 3 * s2) >> 2\n                    s3 = (c + 3 * s3) >> 2\n                elif sel == 2:\n                    s1 = (a + 7 * s1) >> 3\n                    s2 = (b + 7 * s2) >> 3\n                    s3 = (c + 7 * s3) >> 3\n                else:\n                    s1 = (a + 15 * s1) >> 4\n                    s2 = (b + 15 * s2) >> 4\n                    s3 = (c + 15 * s3) >> 4\n            else:\n                o1, o2, o3 = s1, s2, s3\n        res.append({'out_1': o1 & 0xFFFF, 'out_2': o2 & 0xFFFF, 'out_3': o3 & 0xFFFF})\n    return res\n",
