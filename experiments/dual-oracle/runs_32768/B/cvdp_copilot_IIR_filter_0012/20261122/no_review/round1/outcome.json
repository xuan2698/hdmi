{
  "decisions": [],
  "RM": "def reference(vectors):\n    y1 = y2 = y3 = 0\n    outputs = []\n    for row in vectors:\n        rst = row.get('reset', 0)\n        if rst == 1:\n            y1 = y2 = y3 = 0\n\n        if 'edge' in row:\n            ev = row['edge']\n            if ev == 'posedge' or ev == 1 or ev is True:\n                edge = 'posedge'\n            else:\n                edge = 'negedge'\n        elif 'clk' in row:\n            edge = 'posedge' if row['clk'] == 1 else 'negedge'\n        else:\n            edge = 'posedge' if len(outputs) % 2 == 0 else 'negedge'\n\n        outputs.append({\n            'out_1': y1 & 0xFFFF,\n            'out_2': y2 & 0xFFFF,\n            'out_3': y3 & 0xFFFF\n        })\n\n        if edge == 'posedge' and rst == 0:\n            in1 = row.get('in_1', 0)\n            in2 = row.get('in_2', 0)\n            in3 = row.get('in_3', 0)\n            if in1 >= 32768: in1 -= 65536\n            if in2 >= 32768: in2 -= 65536\n            if in3 >= 32768: in3 -= 65536\n            fs = row.get('filter_select', 0)\n            shift = fs\n\n            n1 = y1 + ((in1 - y1) >> shift)\n            n2 = y2 + ((in2 - y2) >> shift)\n            n3 = y3 + ((in3 - y3) >> shift)\n\n            if n1 < -32768: n1 = -32768\n            elif n1 > 32767: n1 = 32767\n            if n2 < -32768: n2 = -32768\n            elif n2 > 32767: n2 = 32767\n            if n3 < -32768: n3 = -32768\n            elif n3 > 32767: n3 = 32767\n\n            y1, y2, y3 = n1, n2, n3\n\n    return outputs\n",
