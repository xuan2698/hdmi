"def reference(vectors):\n    def s16(x):\n        x = x & 0xFFFF\n        if x >= 0x8000:\n            x -= 0x10000\n        return x\n\n    def clamp16(x):\n        if x > 32767:\n            return 32767\n        if x < -32768:\n            return -32768\n        return x\n\n    def u16(x):\n        return x & 0xFFFF\n\n    y1 = y2 = y3 = 0\n    out = []\n\n    for idx, row in enumerate(vectors):\n        res = row.get('reset', 0)\n        if res:\n            y1 = y2 = y3 = 0\n\n        out.append({\n            'out_1': u16(y1),\n            'out_2': u16(y2),\n            'out_3': u16(y3)\n        })\n\n        if 'clk' in row:\n            clk = row['clk']\n        else:\n            clk = 1 if idx % 2 == 0 else 0\n\n        if clk == 1:\n            if res:\n                y1 = y2 = y3 = 0\n            else:\n                k = row.get('filter_select', 0)\n                x1 = s16(row.get('in_1', 0))\n                x2 = s16(row.get('in_2', 0))\n                x3 = s16(row.get('in_3', 0))\n\n                y1 = clamp16(y1 + ((x1 - y1) >> k))\n                y2 = clamp16(y2 + ((x2 - y2) >> k))\n                y3 = clamp16(y3 + ((x3 - y3) >> k))\n\n    return out\n"
