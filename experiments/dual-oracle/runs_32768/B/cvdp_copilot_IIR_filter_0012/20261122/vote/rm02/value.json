"def reference(vectors):\n    out = []\n    o1 = o2 = o3 = 0\n    d11 = d12 = d13 = 0\n    d21 = d22 = d23 = 0\n    prev_clk = 0\n\n    for row in vectors:\n        rst = row.get('reset', 0)\n        if rst:\n            o1 = o2 = o3 = 0\n            d11 = d12 = d13 = 0\n            d21 = d22 = d23 = 0\n            out.append({'out_1': 0, 'out_2': 0, 'out_3': 0})\n            if 'clk' in row:\n                prev_clk = row['clk'] & 1\n            continue\n\n        is_pos = False\n        if 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                is_pos = ('pos' in e.lower())\n            else:\n                is_pos = bool(e)\n        elif 'clk' in row:\n            clk = row['clk'] & 1\n            if prev_clk == 0 and clk == 1:\n                is_pos = True\n            prev_clk = clk\n\n        out.append({\n            'out_1': o1 & 0xFFFF,\n            'out_2': o2 & 0xFFFF,\n            'out_3': o3 & 0xFFFF\n        })\n\n        if is_pos:\n            in1 = row.get('in_1', 0) & 0xFFFF\n            in2 = row.get('in_2', 0) & 0xFFFF\n            in3 = row.get('in_3', 0) & 0xFFFF\n            fs = row.get('filter_select', 0) & 3\n\n            s1 = in1 - 0x10000 if in1 & 0x8000 else in1\n            s2 = in2 - 0x10000 if in2 & 0x8000 else in2\n            s3 = in3 - 0x10000 if in3 & 0x8000 else in3\n\n            if fs == 0:\n                no1 = s1\n                no2 = s2\n                no3 = s3\n            elif fs == 1:\n                no1 = (s1 + d11) >> 1\n                no2 = (s2 + d12) >> 1\n                no3 = (s3 + d13) >> 1\n            elif fs == 2:\n                no1 = (s1 + (d11 << 1) + d21) >> 2\n                no2 = (s2 + (d12 << 1) + d22) >> 2\n                no3 = (s3 + (d13 << 1) + d23) >> 2\n            else:\n                no1 = (s1 - (d11 << 1) + d21) >> 2\n                no2 = (s2 - (d12 << 1) + d22) >> 2\n                no3 = (s3 - (d13 << 1) + d23) >> 2\n\n            d21 = d11\n            d22 = d12\n            d23 = d13\n            d11 = s1\n            d12 = s2\n            d13 = s3\n\n            o1 = no1\n            o2 = no2\n            o3 = no3\n\n    return out\n"
