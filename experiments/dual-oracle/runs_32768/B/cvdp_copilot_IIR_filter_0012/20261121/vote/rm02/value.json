"def reference(vectors):\n    state = [0, 0, 0]\n    results = []\n    prev_clk = 0\n    for row in vectors:\n        reset = int(row.get('reset', 0))\n        # Output current state before any registered updates\n        results.append({\n            'out_1': state[0] & 0xFFFF,\n            'out_2': state[1] & 0xFFFF,\n            'out_3': state[2] & 0xFFFF\n        })\n        # Asynchronous reset (applied after edge sampling, like NBA)\n        if reset == 1:\n            state = [0, 0, 0]\n            prev_clk = int(row.get('clk', 0))\n            continue\n        # Determine if this row is a positive clock edge\n        is_posedge = False\n        if 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                if 'pos' in e.lower():\n                    is_posedge = True\n            elif isinstance(e, (int, bool)):\n                is_posedge = bool(e)\n        elif 'clk' in row:\n            clk = int(row['clk'])\n            if clk == 1 and prev_clk == 0:\n                is_posedge = True\n            prev_clk = clk\n        if is_posedge:\n            sel = int(row.get('filter_select', 0)) & 0x3\n            for i in range(3):\n                x = int(row.get(f'in_{i+1}', 0)) & 0xFFFF\n                if x & 0x8000:\n                    x_signed = x - 0x10000\n                else:\n                    x_signed = x\n                prev = state[i]\n                s = (4 - sel) * x_signed + sel * prev\n                new_val = s >> 2\n                if new_val > 32767:\n                    new_val = 32767\n                elif new_val < -32768:\n                    new_val = -32768\n                state[i] = new_val\n    return results\n"
