"def reference(vectors):\n    def to_signed16(x):\n        if x >= 32768:\n            return x - 65536\n        return x\n\n    def to_unsigned16(x):\n        if x < 0:\n            return x + 65536\n        return x\n\n    def sat16(x):\n        if x > 32767:\n            return 32767\n        if x < -32768:\n            return -32768\n        return x\n\n    out1 = 0\n    out2 = 0\n    out3 = 0\n    prev_clk = 0\n    results = []\n\n    for row in vectors:\n        clk = row.get('clk', 0)\n        rst = row.get('reset', 0)\n\n        if rst == 1:\n            out1 = out2 = out3 = 0\n            results.append({\n                'out_1': 0,\n                'out_2': 0,\n                'out_3': 0\n            })\n            prev_clk = clk\n            continue\n\n        results.append({\n            'out_1': to_unsigned16(out1),\n            'out_2': to_unsigned16(out2),\n            'out_3': to_unsigned16(out3)\n        })\n\n        if clk == 1 and prev_clk == 0:\n            shift = row.get('filter_select', 0) & 0x3\n            in1 = to_signed16(row.get('in_1', 0))\n            in2 = to_signed16(row.get('in_2', 0))\n            in3 = to_signed16(row.get('in_3', 0))\n\n            delta1 = (in1 - out1) >> shift\n            delta2 = (in2 - out2) >> shift\n            delta3 = (in3 - out3) >> shift\n\n            out1 = sat16(out1 + delta1)\n            out2 = sat16(out2 + delta2)\n            out3 = sat16(out3 + delta3)\n\n        prev_clk = clk\n\n    return results\n"
