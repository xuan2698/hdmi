"def reference(vectors):\n    st = [0, 0, 0]\n    prev_clk = 0\n    result = []\n    for row in vectors:\n        reset = row.get('reset', 0) & 1\n        clk = row.get('clk', 0) & 1\n        if reset:\n            st = [0, 0, 0]\n        result.append({\n            'out_1': st[0] & 0xFFFF,\n            'out_2': st[1] & 0xFFFF,\n            'out_3': st[2] & 0xFFFF,\n        })\n        if clk == 1 and prev_clk == 0 and not reset:\n            st[0] = row.get('in_1', 0) & 0xFFFF\n            st[1] = row.get('in_2', 0) & 0xFFFF\n            st[2] = row.get('in_3', 0) & 0xFFFF\n        prev_clk = clk\n    return result\n"
