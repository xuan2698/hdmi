"def reference(vectors):\n    def s16(v):\n        v = int(v) & 0xFFFF\n        return v - 0x10000 if v & 0x8000 else v\n    def sat(v):\n        if v > 32767:\n            v = 32767\n        elif v < -32768:\n            v = -32768\n        return v & 0xFFFF\n    coeffs = ((1, 2, 1, 2), (3, 2, -1, 2), (1, -1, 0, 1), (2, 3, 1, 3))\n    o1 = o2 = o3 = 0\n    h1 = h1p = h2 = h2p = h3 = h3p = 0\n    prev_clk = 0\n    res = []\n    for i, row in enumerate(vectors):\n        if 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                clk = 1 if 'pos' in e.lower() else 0\n            else:\n                clk = 1 if e else 0\n        else:\n            clk = row.get('clk', 1 if i % 2 == 0 else 0)\n        is_pos = (clk == 1 and prev_clk == 0)\n        reset = int(row.get('reset', 0))\n        if reset == 1:\n            o1 = o2 = o3 = 0\n            h1 = h1p = h2 = h2p = h3 = h3p = 0\n        res.append({'out_1': o1 & 0xFFFF, 'out_2': o2 & 0xFFFF, 'out_3': o3 & 0xFFFF})\n        if reset == 0 and is_pos:\n            x1 = s16(row.get('in_1', 0))\n            x2 = s16(row.get('in_2', 0))\n            x3 = s16(row.get('in_3', 0))\n            sel = int(row.get('filter_select', 0)) & 3\n            a, b, c, sh = coeffs[sel]\n            o1 = sat((a * x1 + b * h1 + c * h1p) >> sh)\n            o2 = sat((a * x2 + b * h2 + c * h2p) >> sh)\n            o3 = sat((a * x3 + b * h3 + c * h3p) >> sh)\n            h1p = h1\n            h1 = x1\n            h2p = h2\n            h2 = x2\n            h3p = h3\n            h3 = x3\n        prev_clk = clk\n    return res\n"
