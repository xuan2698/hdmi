"def reference(vectors):\n    o1 = o2 = o3 = 0\n    pc = 0\n    res = []\n    for r in vectors:\n        reset = r.get('reset', 0)\n        if reset:\n            o1 = o2 = o3 = 0\n        if 'edge' in r:\n            e = r['edge']\n        else:\n            c = r.get('clk', 0)\n            if c == 1 and pc == 0:\n                e = 'posedge'\n            elif c == 0 and pc == 1:\n                e = 'negedge'\n            else:\n                e = None\n            pc = c\n        res.append({'out_1': o1 & 0xFFFF, 'out_2': o2 & 0xFFFF, 'out_3': o3 & 0xFFFF})\n        if not reset and e == 'posedge':\n            o1 = r.get('in_1', 0) & 0xFFFF\n            o2 = r.get('in_2', 0) & 0xFFFF\n            o3 = r.get('in_3', 0) & 0xFFFF\n    return res\n"
