"def reference(vectors):\n    def s(v):\n        v = int(v) & 0xFFFF\n        return v - 0x10000 if v & 0x8000 else v\n    o1 = o2 = o3 = 0\n    res = []\n    for row in vectors:\n        rst = row.get('reset', 0)\n        if rst:\n            o1 = o2 = o3 = 0\n        res.append({\n            'out_1': o1 & 0xFFFF,\n            'out_2': o2 & 0xFFFF,\n            'out_3': o3 & 0xFFFF\n        })\n        edge = row.get('edge')\n        if edge is None:\n            pos = (row.get('clk', 0) == 1 or row.get('clk', 0) is True)\n        else:\n            pos = (edge == 'posedge' or edge == 1 or edge is True)\n        if pos and not rst:\n            sh = int(row.get('filter_select', 0)) & 3\n            i1 = s(row.get('in_1', 0))\n            i2 = s(row.get('in_2', 0))\n            i3 = s(row.get('in_3', 0))\n            o1 = o1 + ((i1 - o1) >> sh)\n            o2 = o2 + ((i2 - o2) >> sh)\n            o3 = o3 + ((i3 - o3) >> sh)\n            if o1 > 32767:\n                o1 = 32767\n            elif o1 < -32768:\n                o1 = -32768\n            if o2 > 32767:\n                o2 = 32767\n            elif o2 < -32768:\n                o2 = -32768\n            if o3 > 32767:\n                o3 = 32767\n            elif o3 < -32768:\n                o3 = -32768\n    return res\n"
