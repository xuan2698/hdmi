"def reference(vectors):\n    s1 = s2 = s3 = 0\n    res = []\n    for idx, row in enumerate(vectors):\n        if isinstance(row, dict):\n            reset = row.get('reset', 0)\n            in1 = row.get('in_1', 0)\n            in2 = row.get('in_2', 0)\n            in3 = row.get('in_3', 0)\n            sel = row.get('filter_select', 0)\n            edge = row.get('edge', None)\n            if edge is not None:\n                if isinstance(edge, str):\n                    is_pos = 'pos' in edge.lower()\n                else:\n                    is_pos = (edge == 1)\n            else:\n                clk = row.get('clk', None)\n                if clk is not None:\n                    is_pos = (clk == 1)\n                else:\n                    is_pos = (idx % 2 == 0)\n        else:\n            if len(row) >= 6:\n                ev = row[0]\n                if isinstance(ev, str):\n                    is_pos = 'pos' in ev.lower()\n                elif ev in (0, 1):\n                    is_pos = (ev == 1)\n                else:\n                    is_pos = (idx % 2 == 0)\n                reset, in1, in2, in3, sel = row[1], row[2], row[3], row[4], row[5]\n            else:\n                reset = row[0] if len(row) > 0 else 0\n                in1 = row[1] if len(row) > 1 else 0\n                in2 = row[2] if len(row) > 2 else 0\n                in3 = row[3] if len(row) > 3 else 0\n                sel = row[4] if len(row) > 4 else 0\n                is_pos = (idx % 2 == 0)\n\n        if reset:\n            s1 = s2 = s3 = 0\n\n        res.append({\n            'out_1': s1 & 0xFFFF,\n            'out_2': s2 & 0xFFFF,\n            'out_3': s3 & 0xFFFF\n        })\n\n        if is_pos and not reset:\n            def s16(x):\n                x = x & 0xFFFF\n                return x - 0x10000 if x & 0x8000 else x\n            shift = sel & 3\n            s1 = s1 + ((s16(in1) - s1) >> shift)\n            s2 = s2 + ((s16(in2) - s2) >> shift)\n            s3 = s3 + ((s16(in3) - s3) >> shift)\n            if s1 > 32767: s1 = 32767\n            elif s1 < -32768: s1 = -32768\n            if s2 > 32767: s2 = 32767\n            elif s2 < -32768: s2 = -32768\n            if s3 > 32767: s3 = 32767\n            elif s3 < -32768: s3 = -32768\n    return res\n"
