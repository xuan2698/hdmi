"def reference(vectors):\n    def s16(v):\n        v = v & 0xFFFF\n        if v & 0x8000:\n            v -= 0x10000\n        return v\n\n    def u16(v):\n        return v & 0xFFFF\n\n    def sat16(v):\n        if v > 32767:\n            return 32767\n        if v < -32768:\n            return -32768\n        return v\n\n    out1 = 0\n    out2 = 0\n    out3 = 0\n    res = []\n\n    for row in vectors:\n        reset = row['reset']\n        edge = row['edge']\n        in1 = s16(row['in_1'])\n        in2 = s16(row['in_2'])\n        in3 = s16(row['in_3'])\n        fs = row['filter_select'] & 0x3\n\n        if reset:\n            out1 = 0\n            out2 = 0\n            out3 = 0\n\n        res.append({\n            'out_1': u16(out1),\n            'out_2': u16(out2),\n            'out_3': u16(out3)\n        })\n\n        if edge == 'posedge' and not reset:\n            n1 = out1 + ((in1 - out1) >> fs)\n            n2 = out2 + ((in2 - out2) >> fs)\n            n3 = out3 + ((in3 - out3) >> fs)\n            out1 = sat16(n1)\n            out2 = sat16(n2)\n            out3 = sat16(n3)\n\n    return res\n"
