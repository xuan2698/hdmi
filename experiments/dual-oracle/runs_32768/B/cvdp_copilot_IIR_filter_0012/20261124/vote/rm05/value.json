"def reference(vectors):\n    o1 = o2 = o3 = 0\n    res = []\n    prev_clk = None\n    for i, v in enumerate(vectors):\n        if isinstance(v, dict):\n            rst = v.get('reset', 0)\n            fsel = v.get('filter_select', 0)\n            in1 = v.get('in_1', 0)\n            in2 = v.get('in_2', 0)\n            in3 = v.get('in_3', 0)\n            edge = v.get('edge', None)\n            clk = v.get('clk', None)\n        else:\n            rst = fsel = in1 = in2 = in3 = 0\n            edge = None\n            clk = None\n        if edge is None and clk is not None:\n            if prev_clk is not None:\n                if clk == 1 and prev_clk == 0:\n                    edge = 'posedge'\n                elif clk == 0 and prev_clk == 1:\n                    edge = 'negedge'\n            prev_clk = clk\n        if edge is None:\n            edge = 'posedge' if i % 2 == 0 else 'negedge'\n        def s16(x):\n            x = x & 0xFFFF\n            return x - 0x10000 if x >= 0x8000 else x\n        a1, a2, a3 = s16(in1), s16(in2), s16(in3)\n        if rst == 1:\n            o1 = o2 = o3 = 0\n        res.append({'out_1': o1 & 0xFFFF, 'out_2': o2 & 0xFFFF, 'out_3': o3 & 0xFFFF})\n        if edge == 'posedge' or edge == 1 or edge is True:\n            if rst != 1:\n                sh = fsel & 3\n                o1 = o1 + ((a1 - o1) >> sh)\n                if o1 > 32767: o1 = 32767\n                elif o1 < -32768: o1 = -32768\n                o2 = o2 + ((a2 - o2) >> sh)\n                if o2 > 32767: o2 = 32767\n                elif o2 < -32768: o2 = -32768\n                o3 = o3 + ((a3 - o3) >> sh)\n                if o3 > 32767: o3 = 32767\n                elif o3 < -32768: o3 = -32768\n    return res\n"
