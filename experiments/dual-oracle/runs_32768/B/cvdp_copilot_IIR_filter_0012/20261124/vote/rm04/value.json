"def reference(vectors):\n    y1 = y2 = y3 = 0\n    res = []\n    for r in vectors:\n        reset = r.get('reset', 0)\n        in1_u = r.get('in_1', 0)\n        in2_u = r.get('in_2', 0)\n        in3_u = r.get('in_3', 0)\n        sel = r.get('filter_select', 0) & 3\n        clk = r.get('clk', r.get('edge', 0))\n        if isinstance(clk, str):\n            is_pos = ('pos' in clk.lower()) or clk == '1'\n        else:\n            is_pos = (clk == 1)\n        in1 = in1_u if in1_u < 32768 else in1_u - 65536\n        in2 = in2_u if in2_u < 32768 else in2_u - 65536\n        in3 = in3_u if in3_u < 32768 else in3_u - 65536\n        if reset == 1:\n            y1 = y2 = y3 = 0\n            out1 = out2 = out3 = 0\n        else:\n            if is_pos:\n                out1, out2, out3 = y1, y2, y3\n                mask = (1 << sel) - 1\n                y1 = (in1 + mask * y1) >> sel\n                y2 = (in2 + mask * y2) >> sel\n                y3 = (in3 + mask * y3) >> sel\n            else:\n                out1, out2, out3 = y1, y2, y3\n        res.append({\n            'out_1': out1 & 0xFFFF,\n            'out_2': out2 & 0xFFFF,\n            'out_3': out3 & 0xFFFF\n        })\n    return res\n"
