"def reference(vectors):\n    out1 = 0\n    out2 = 0\n    out3 = 0\n    prev_clk = None\n    res = []\n    for row in vectors:\n        edge = row.get('edge')\n        if isinstance(edge, str):\n            edge = edge.lower()\n        clk = row.get('clk', None)\n        if edge is None and clk is not None:\n            if prev_clk is None:\n                prev_clk = 0\n            if clk != prev_clk:\n                edge = 'posedge' if clk == 1 else 'negedge'\n            prev_clk = clk\n        rst = row.get('reset', 0)\n        if rst:\n            out1 = out2 = out3 = 0\n        res.append({\n            'out_1': out1 & 0xFFFF,\n            'out_2': out2 & 0xFFFF,\n            'out_3': out3 & 0xFFFF\n        })\n        if edge == 'posedge' and not rst:\n            in1 = row.get('in_1', 0) & 0xFFFF\n            if in1 >= 0x8000:\n                in1 -= 0x10000\n            in2 = row.get('in_2', 0) & 0xFFFF\n            if in2 >= 0x8000:\n                in2 -= 0x10000\n            in3 = row.get('in_3', 0) & 0xFFFF\n            if in3 >= 0x8000:\n                in3 -= 0x10000\n            s = int(row.get('filter_select', 0))\n            if s < 0:\n                s = 0\n            elif s > 15:\n                s = 15\n            d1 = in1 - out1\n            d2 = in2 - out2\n            d3 = in3 - out3\n            n1 = out1 + (d1 >> s)\n            n2 = out2 + (d2 >> s)\n            n3 = out3 + (d3 >> s)\n            if n1 > 32767:\n                n1 = 32767\n            elif n1 < -32768:\n                n1 = -32768\n            if n2 > 32767:\n                n2 = 32767\n            elif n2 < -32768:\n                n2 = -32768\n            if n3 > 32767:\n                n3 = 32767\n            elif n3 < -32768:\n                n3 = -32768\n            out1, out2, out3 = n1, n2, n3\n    return res\n"
