"def reference(vectors):\n    y1 = y2 = y3 = 0\n    result = []\n    for i, row in enumerate(vectors):\n        rst = row.get('reset', 0)\n        def s16(v):\n            v = int(v) & 0xFFFF\n            if v >= 0x8000:\n                v -= 0x10000\n            return v\n        in1 = s16(row.get('in_1', 0))\n        in2 = s16(row.get('in_2', 0))\n        in3 = s16(row.get('in_3', 0))\n        sel = int(row.get('filter_select', 0)) & 3\n\n        if 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                if 'pos' in e.lower():\n                    edge = 'pos'\n                elif 'neg' in e.lower():\n                    edge = 'neg'\n                else:\n                    edge = 'pos' if i % 2 == 0 else 'neg'\n            else:\n                edge = 'pos' if e else 'neg'\n        elif 'clk' in row:\n            edge = 'pos' if row['clk'] else 'neg'\n        else:\n            edge = 'pos' if i % 2 == 0 else 'neg'\n\n        if rst:\n            y1 = y2 = y3 = 0\n            result.append({'out_1': 0, 'out_2': 0, 'out_3': 0})\n            continue\n\n        result.append({\n            'out_1': y1 & 0xFFFF,\n            'out_2': y2 & 0xFFFF,\n            'out_3': y3 & 0xFFFF\n        })\n\n        if edge == 'pos':\n            shift = sel\n            def update(x, y):\n                diff = x - y\n                delta = diff >> shift if shift > 0 else diff\n                yn = y + delta\n                if yn > 32767:\n                    yn = 32767\n                elif yn < -32768:\n                    yn = -32768\n                return yn\n            y1 = update(in1, y1)\n            y2 = update(in2, y2)\n            y3 = update(in3, y3)\n    return result\n"
