"def reference(vectors):\n    q1 = q2 = q3 = 0\n    out = []\n    for i, row in enumerate(vectors):\n        rst = row.get('reset', 0)\n        if rst:\n            q1 = q2 = q3 = 0\n        out.append({\n            'out_1': q1 & 0xFFFF,\n            'out_2': q2 & 0xFFFF,\n            'out_3': q3 & 0xFFFF\n        })\n        e = row.get('edge', None)\n        if e is not None:\n            if isinstance(e, str):\n                is_pos = e.lower().startswith('pos') or e == '1'\n            else:\n                is_pos = bool(e)\n        elif 'clk' in row:\n            is_pos = (row['clk'] == 1)\n        else:\n            is_pos = (i % 2 == 0)\n        if is_pos and not rst:\n            q1 = row.get('in_1', 0) & 0xFFFF\n            q2 = row.get('in_2', 0) & 0xFFFF\n            q3 = row.get('in_3', 0) & 0xFFFF\n    return out\n"
