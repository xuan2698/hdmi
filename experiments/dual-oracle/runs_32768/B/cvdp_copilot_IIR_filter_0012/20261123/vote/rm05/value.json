"def reference(vectors):\n    def sat(x):\n        if x > 32767:\n            return 32767\n        if x < -32768:\n            return -32768\n        return x\n    def to_s(x):\n        x = x & 0xFFFF\n        return x - 0x10000 if x >= 0x8000 else x\n    s1 = s2 = s3 = 0\n    res = []\n    for v in vectors:\n        reset = v.get('reset', 0)\n        if reset:\n            s1 = s2 = s3 = 0\n            o1 = o2 = o3 = 0\n        else:\n            o1, o2, o3 = s1, s2, s3\n            edge = v.get('edge', v.get('clk', 0))\n            if isinstance(edge, str):\n                is_pos = 'pos' in edge.lower()\n            else:\n                is_pos = (edge == 1 or edge == '1')\n            if is_pos:\n                x1 = to_s(v['in_1'])\n                x2 = to_s(v['in_2'])\n                x3 = to_s(v['in_3'])\n                shift = v.get('filter_select', 0)\n                n1 = s1 + ((x1 - s1) >> shift)\n                n2 = s2 + ((x2 - s2) >> shift)\n                n3 = s3 + ((x3 - s3) >> shift)\n                s1 = sat(n1)\n                s2 = sat(n2)\n                s3 = sat(n3)\n        res.append({\n            'out_1': o1 & 0xFFFF,\n            'out_2': o2 & 0xFFFF,\n            'out_3': o3 & 0xFFFF\n        })\n    return res\n"
