"def reference(vectors):\n    q1 = q2 = q3 = 0\n    res = []\n    if isinstance(vectors, dict):\n        keys = list(vectors.keys())\n        n = len(vectors[keys[0]]) if keys else 0\n        rows = [{k: vectors[k][i] for k in keys} for i in range(n)]\n    else:\n        rows = vectors\n    for row in rows:\n        if isinstance(row, dict):\n            reset = row.get(\"reset\", 0)\n            edge = row.get(\"edge\", \"\")\n            in1 = row.get(\"in_1\", 0)\n            in2 = row.get(\"in_2\", 0)\n            in3 = row.get(\"in_3\", 0)\n        else:\n            reset = edge = 0\n            in1 = in2 = in3 = 0\n        if reset:\n            q1 = q2 = q3 = 0\n        res.append({\n            \"out_1\": q1 & 0xFFFF,\n            \"out_2\": q2 & 0xFFFF,\n            \"out_3\": q3 & 0xFFFF\n        })\n        if edge == \"posedge\" and not reset:\n            q1 = int(in1) & 0xFFFF\n            q2 = int(in2) & 0xFFFF\n            q3 = int(in3) & 0xFFFF\n    return res\n"
