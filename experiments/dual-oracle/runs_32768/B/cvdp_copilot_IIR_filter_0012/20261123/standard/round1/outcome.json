  "RM": "def reference(vectors):\n    def to_signed(x):\n        try:\n            x = int(x)\n        except Exception:\n            x = 0\n        x &= 0xFFFF\n        return x - 0x10000 if x >= 0x8000 else x\n\n    def get(row, key, default=0):\n        if isinstance(row, dict):\n            if key in row:\n                return row[key]\n            for k, v in row.items():\n                if isinstance(k, str) and k.lower() == key.lower():\n                    return v\n        return default\n\n    y = [0, 0, 0]\n    res = []\n    for idx, row in enumerate(vectors):\n        edge = None\n        for ek in ('edge', 'clk', 'clock', 'clk_edge'):\n            if isinstance(row, dict):\n                if ek in row:\n                    edge = row[ek]\n                    break\n                for k in row:\n                    if isinstance(k, str) and k.lower() == ek.lower():\n                        edge = row[k]\n                        break\n                if edge is not None:\n                    break\n        pos = False\n        if edge is not None:\n            if isinstance(edge, str):\n                el = edge.lower()\n                if 'pos' in el or 'rise' in el or el in ('1', 'true'):\n                    pos = True\n                elif 'neg' in el or 'fall' in el or el in ('0', 'false'):\n                    pos = False\n                else:\n                    pos = (idx % 2 == 0)\n            else:\n                pos = (int(edge) != 0)\n        else:\n            pos = (idx % 2 == 0)\n\n        rst = int(get(row, 'reset', 0))\n        if rst == 1:\n            y = [0, 0, 0]\n\n        res.append({\n            'out_1': y[0] & 0xFFFF,\n            'out_2': y[1] & 0xFFFF,\n            'out_3': y[2] & 0xFFFF\n        })\n\n        if pos and rst == 0:\n            fs = int(get(row, 'filter_select', 0)) & 3\n            shift = fs\n            x0 = to_signed(get(row, 'in_1', 0))\n            x1 = to_signed(get(row, 'in_2', 0))\n            x2 = to_signed(get(row, 'in_3', 0))\n            def clamp(v):\n                if v > 32767: return 32767\n                if v < -32768: return -32768\n                return v\n            y[0] = clamp(y[0] + ((x0 - y[0]) >> shift))\n            y[1] = clamp(y[1] + ((x1 - y[1]) >> shift))\n            y[2] = clamp(y[2] + ((x2 - y[2]) >> shift))\n    return res\n",
