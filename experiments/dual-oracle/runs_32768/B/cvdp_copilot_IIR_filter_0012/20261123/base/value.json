"def reference(vectors):\n    def s16(v):\n        v = v & 0xFFFF\n        return v - 0x10000 if v >= 0x8000 else v\n    y1 = y2 = y3 = 0\n    prev_clk = 0\n    res = []\n    for row in vectors:\n        reset = row.get('reset', 0)\n        in1 = s16(row.get('in_1', 0))\n        in2 = s16(row.get('in_2', 0))\n        in3 = s16(row.get('in_3', 0))\n        fsel = row.get('filter_select', 0) & 3\n        \n        is_posedge = False\n        if 'edge' in row:\n            e = row['edge']\n            if e in ('posedge', 'pos', 1, True):\n                is_posedge = True\n            elif e in ('negedge', 'neg', 0, False):\n                is_posedge = False\n            else:\n                is_posedge = str(e).lower().startswith('pos')\n        elif 'clk' in row:\n            clk = row['clk']\n            if clk == 1 and prev_clk == 0:\n                is_posedge = True\n            elif clk == 0 and prev_clk == 1:\n                is_posedge = False\n            else:\n                is_posedge = False\n            prev_clk = clk\n        \n        if reset:\n            y1 = y2 = y3 = 0\n        \n        res.append({'out_1': y1 & 0xFFFF,\n                    'out_2': y2 & 0xFFFF,\n                    'out_3': y3 & 0xFFFF})\n        \n        if not reset and is_posedge:\n            shift = fsel\n            d1 = in1 - y1\n            n1 = y1 + (d1 >> shift)\n            if n1 > 32767: n1 = 32767\n            elif n1 < -32768: n1 = -32768\n            d2 = in2 - y2\n            n2 = y2 + (d2 >> shift)\n            if n2 > 32767: n2 = 32767\n            elif n2 < -32768: n2 = -32768\n            d3 = in3 - y3\n            n3 = y3 + (d3 >> shift)\n            if n3 > 32767: n3 = 32767\n            elif n3 < -32768: n3 = -32768\n            y1, y2, y3 = n1, n2, n3\n    return res\n"
