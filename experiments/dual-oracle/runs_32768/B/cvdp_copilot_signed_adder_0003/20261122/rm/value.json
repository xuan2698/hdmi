"def reference(vectors):\n    state = 0\n    result = 0\n    overflow = 0\n    operand_a = 0\n    operand_b = 0\n    out = []\n    for idx, row in enumerate(vectors):\n        rst = row.get('i_rst_n', 1) & 1\n        if rst == 0:\n            state = 0\n            result = 0\n            overflow = 0\n            operand_a = 0\n            operand_b = 0\n        o_status = state & 3\n        o_ready = 1 if state == 3 else 0\n        o_resultant_sum = result & 0xFF\n        o_overflow = overflow & 1\n        out.append({\n            'o_resultant_sum': o_resultant_sum,\n            'o_overflow': o_overflow,\n            'o_ready': o_ready,\n            'o_status': o_status\n        })\n        is_posedge = (idx % 2 == 0)\n        if is_posedge and rst != 0:\n            if row.get('i_clear', 0) & 1:\n                state = 0\n                result = 0\n                overflow = 0\n            else:\n                if state == 0:\n                    if (row.get('i_enable', 0) & 1) and (row.get('i_start', 0) & 1):\n                        state = 1\n                    else:\n                        state = 0\n                elif state == 1:\n                    operand_a = row.get('i_operand_a', 0) & 0xFF\n                    operand_b = row.get('i_operand_b', 0) & 0xFF\n                    state = 2\n                elif state == 2:\n                    a = operand_a\n                    b = operand_b\n                    mode = row.get('i_mode', 0) & 1\n                    if mode == 0:\n                        res = (a + b) & 0xFF\n                        sa = (a >> 7) & 1\n                        sb = (b >> 7) & 1\n                        sr = (res >> 7) & 1\n                        ov = 1 if (sa == sb and sr != sa) else 0\n                    else:\n                        res = (a - b) & 0xFF\n                        sa = (a >> 7) & 1\n                        sb = (b >> 7) & 1\n                        sr = (res >> 7) & 1\n                        ov = 1 if (sa != sb and sr != sa) else 0\n                    result = res\n                    overflow = ov\n                    state = 3\n                elif state == 3:\n                    state = 0\n    return out\n"
