"def reference(vectors):\n    state = 0\n    reg_a = 0\n    reg_b = 0\n    result = 0\n    overflow = 0\n    outputs = []\n\n    def getv(row, key, default=0):\n        if isinstance(row, dict):\n            return row.get(key, default)\n        return default\n\n    def signed8(v):\n        v &= 0xFF\n        if v & 0x80:\n            return v - 0x100\n        return v\n\n    def is_pos(row, idx):\n        if isinstance(row, dict):\n            if 'edge' in row:\n                e = row['edge']\n                if isinstance(e, str):\n                    e2 = e.lower()\n                    if 'pos' in e2 or 'rise' in e2 or e2 in ('1', 'high'):\n                        return True\n                    if 'neg' in e2 or 'fall' in e2 or e2 in ('0', 'low'):\n                        return False\n                else:\n                    return bool(e)\n            if 'i_clk' in row:\n                return bool(row['i_clk'])\n            if 'clk' in row:\n                return bool(row['clk'])\n        return idx % 2 == 0\n\n    for idx, row in enumerate(vectors):\n        rst = getv(row, 'i_rst_n', 1)\n        if rst == 0:\n            state = 0\n            reg_a = 0\n            reg_b = 0\n            result = 0\n            overflow = 0\n            outputs.append({\n                'o_resultant_sum': 0,\n                'o_overflow': 0,\n                'o_ready': 0,\n                'o_status': 0\n            })\n            continue\n\n        ready = 1 if state == 3 else 0\n        outputs.append({\n            'o_resultant_sum': result & 0xFF,\n            'o_overflow': overflow & 1,\n            'o_ready': ready,\n            'o_status': state & 3\n        })\n\n        if not is_pos(row, idx):\n            continue\n\n        clear = getv(row, 'i_clear', 0)\n        if clear:\n            state = 0\n            result = 0\n            overflow = 0\n            continue\n\n        enable = getv(row, 'i_enable', 0)\n        start = getv(row, 'i_start', 0)\n        mode = getv(row, 'i_mode', 0)\n        a_in = getv(row, 'i_operand_a', 0) & 0xFF\n        b_in = getv(row, 'i_operand_b', 0) & 0xFF\n\n        if state == 0:\n            if enable and start:\n                state = 1\n        elif state == 1:\n            reg_a = a_in\n            reg_b = b_in\n            state = 2\n        elif state == 2:\n            sa = signed8(reg_a)\n            sb = signed8(reg_b)\n            if mode == 0:\n                full = sa + sb\n            else:\n                full = sa - sb\n            result = full & 0xFF\n            overflow = 1 if (full < -128 or full > 127) else 0\n            state = 3\n        elif state == 3:\n            state = 0\n\n    return outputs\n"
