"def reference(vectors):\n    state = 0\n    a_reg = 0\n    b_reg = 0\n    sum_reg = 0\n    ov_reg = 0\n    cur_rst = 1\n    cur_start = 0\n    cur_enable = 0\n    cur_mode = 0\n    cur_clear = 0\n    cur_a = 0\n    cur_b = 0\n    res = []\n    idx = 0\n\n    for row in vectors:\n        edge = None\n        if isinstance(row, dict):\n            for k, v in row.items():\n                lk = k.lower() if isinstance(k, str) else k\n                if lk == 'i_rst_n' or lk == 'rst_n':\n                    cur_rst = int(v) & 1\n                elif lk == 'i_start' or lk == 'start':\n                    cur_start = int(v) & 1\n                elif lk == 'i_enable' or lk == 'enable':\n                    cur_enable = int(v) & 1\n                elif lk == 'i_mode' or lk == 'mode':\n                    cur_mode = int(v) & 1\n                elif lk == 'i_clear' or lk == 'clear':\n                    cur_clear = int(v) & 1\n                elif lk == 'i_operand_a' or lk == 'operand_a' or lk == 'a':\n                    cur_a = int(v) & 0xFF\n                elif lk == 'i_operand_b' or lk == 'operand_b' or lk == 'b':\n                    cur_b = int(v) & 0xFF\n            for ekey in ('edge', 'i_edge', 'clk_edge'):\n                if ekey in row:\n                    edge = row[ekey]\n                    break\n            if edge is None:\n                if 'i_clk' in row:\n                    edge = row['i_clk']\n                elif 'clk' in row:\n                    edge = row['clk']\n                elif 'clock' in row:\n                    edge = row['clock']\n        elif isinstance(row, (list, tuple)):\n            seq = list(row)\n            if len(seq) == 8:\n                edge = seq[0]\n                cur_rst = int(seq[1]) & 1\n                cur_start = int(seq[2]) & 1\n                cur_enable = int(seq[3]) & 1\n                cur_mode = int(seq[4]) & 1\n                cur_clear = int(seq[5]) & 1\n                cur_a = int(seq[6]) & 0xFF\n                cur_b = int(seq[7]) & 0xFF\n            elif len(seq) == 7:\n                cur_rst = int(seq[0]) & 1\n                cur_start = int(seq[1]) & 1\n                cur_enable = int(seq[2]) & 1\n                cur_mode = int(seq[3]) & 1\n                cur_clear = int(seq[4]) & 1\n                cur_a = int(seq[5]) & 0xFF\n                cur_b = int(seq[6]) & 0xFF\n            elif len(seq) > 0:\n                edge = seq[0]\n\n        if edge is None:\n            edge_pos = (idx % 2 == 0)\n        else:\n            if isinstance(edge, str):\n                e = edge.lower()\n                if 'pos' in e or e == '1':\n                    edge_pos = True\n                elif 'neg' in e or e == '0':\n                    edge_pos = False\n                else:\n                    edge_pos = (idx % 2 == 0)\n            else:\n                edge_pos = bool(edge)\n        idx += 1\n\n        if cur_rst == 0:\n            state = 0\n            a_reg = 0\n            b_reg = 0\n            sum_reg = 0\n            ov_reg = 0\n\n        out_status = state\n        out_ready = 1 if state == 3 else 0\n        out_sum = sum_reg & 0xFF\n        out_ov = ov_reg & 1\n        res.append({\n            'o_resultant_sum': out_sum,\n            'o_overflow': out_ov,\n            'o_ready': out_ready,\n            'o_status': out_status\n        })\n\n        if edge_pos:\n            if cur_rst == 0:\n                state = 0\n                a_reg = 0\n                b_reg = 0\n                sum_reg = 0\n                ov_reg = 0\n            elif cur_clear == 1:\n                state = 0\n                a_reg = 0\n                b_reg = 0\n                sum_reg = 0\n                ov_reg = 0\n            elif cur_enable == 0:\n                state = 0\n            else:\n                if state == 0:\n                    if cur_start == 1:\n                        state = 1\n                elif state == 1:\n                    a_reg = cur_a & 0xFF\n                    b_reg = cur_b & 0xFF\n                    state = 2\n                elif state == 2:\n                    a = a_reg if a_reg < 128 else a_reg - 256\n                    b = b_reg if b_reg < 128 else b_reg - 256\n                    if cur_mode == 0:\n                        full = a + b\n                    else:\n                        full = a - b\n                    sum_reg = full & 0xFF\n                    ov_reg = 1 if (full < -128 or full > 127) else 0\n                    state = 3\n                elif state == 3:\n                    state = 0\n\n    return res\n"
