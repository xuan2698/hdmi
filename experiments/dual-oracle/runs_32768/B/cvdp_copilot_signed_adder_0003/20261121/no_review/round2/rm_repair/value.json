"def reference(vectors):\n    IDLE, LOAD, COMPUTE, OUTPUT = 0, 1, 2, 3\n    state = IDLE\n    a_reg = b_reg = res = ov = 0\n    results = []\n    prev_clk = 0\n\n    for idx, row in enumerate(vectors):\n        d = row if isinstance(row, dict) else {}\n        edge = d.get('edge')\n        if 'i_clk' in d:\n            clk = int(d.get('i_clk', 0) or 0)\n            if edge is None:\n                if idx == 0:\n                    edge = 'posedge' if clk else 'negedge'\n                elif prev_clk == 0 and clk == 1:\n                    edge = 'posedge'\n                elif prev_clk == 1 and clk == 0:\n                    edge = 'negedge'\n                else:\n                    edge = 'posedge' if idx % 2 == 0 else 'negedge'\n            prev_clk = clk\n        if edge is None:\n            edge = 'posedge' if idx % 2 == 0 else 'negedge'\n\n        s = str(edge).lower()\n        pos = ('posedge' in s) or s in ('pos', 'p', '1', 'rise')\n\n        def g(name):\n            v = d.get(name, 0)\n            try:\n                return int(v)\n            except:\n                return 0\n\n        rst_n = g('i_rst_n')\n        start = g('i_start')\n        en = g('i_enable')\n        mode = g('i_mode')\n        clear = g('i_clear')\n        a_in = g('i_operand_a') & 0xFF\n        b_in = g('i_operand_b') & 0xFF\n\n        if rst_n == 0:\n            state = IDLE\n            a_reg = b_reg = res = ov = 0\n\n        results.append({\n            'o_resultant_sum': res & 0xFF,\n            'o_overflow': ov & 1,\n            'o_ready': 1 if state == OUTPUT else 0,\n            'o_status': state & 3\n        })\n\n        if rst_n != 0 and pos:\n            if clear:\n                state = IDLE\n                a_reg = b_reg = res = ov = 0\n            elif en == 0:\n                state = IDLE\n            else:\n                if state == IDLE:\n                    if start:\n                        state = LOAD\n                elif state == LOAD:\n                    a_reg = a_in\n                    b_reg = b_in\n                    state = COMPUTE\n                elif state == COMPUTE:\n                    a = a_reg\n                    b = b_reg\n                    if mode == 0:\n                        r = (a + b) & 0xFF\n                        sa = (a >> 7) & 1\n                        sb = (b >> 7) & 1\n                        sr = (r >> 7) & 1\n                        ov = 1 if (sa == sb and sr != sa) else 0\n                    else:\n                        r = (a - b) & 0xFF\n                        sa = (a >> 7) & 1\n                        sb = (b >> 7) & 1\n                        sr = (r >> 7) & 1\n                        ov = 1 if (sa != sb and sr != sa) else 0\n                    res = r\n                    state = OUTPUT\n                elif state == OUTPUT:\n                    state = IDLE\n\n    return results\n"
