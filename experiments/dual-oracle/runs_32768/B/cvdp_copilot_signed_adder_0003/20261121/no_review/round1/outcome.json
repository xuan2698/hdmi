{
  "decisions": [
    {
      "id": "s5/9/o_resultant_sum",
      "label": "RM",
      "spec_quote": "Updates `o_resultant_sum` and `o_overflow`, asserts `o_ready`"
    },
    {
      "id": "s5/9/o_ready",
      "label": "RM",
      "spec_quote": "High in **OUTPUT** state, then returns low in **IDLE**."
    },
    {
      "id": "s5/9/o_status",
      "label": "RM",
      "spec_quote": "`11`: OUTPUT"
    }
  ],
  "RM": "def reference(vectors):\n    state = 0\n    a_reg = 0\n    b_reg = 0\n    res = 0\n    ov = 0\n    results = []\n    prev_clk = 0\n\n    for idx, row in enumerate(vectors):\n        edge = None\n        if isinstance(row, dict):\n            edge = row.get('edge')\n            if edge is None and 'i_clk' in row:\n                clk = int(row.get('i_clk', 0))\n                if idx == 0:\n                    edge = 'posedge' if clk else 'negedge'\n                else:\n                    if prev_clk == 0 and clk == 1:\n                        edge = 'posedge'\n                    elif prev_clk == 1 and clk == 0:\n                        edge = 'negedge'\n                    else:\n                        edge = 'posedge' if idx % 2 == 0 else 'negedge'\n                prev_clk = clk\n        if edge is None:\n            edge = 'posedge' if idx % 2 == 0 else 'negedge'\n\n        s_edge = str(edge).lower()\n        is_pos = ('posedge' in s_edge) or s_edge in ('pos', 'p', '1', 'rise')\n\n        def g(name):\n            if isinstance(row, dict):\n                v = row.get(name, 0)\n                try:\n                    return int(v)\n                except:\n                    return 0\n            return 0\n\n        rst_n = g('i_rst_n')\n        start = g('i_start')\n        enable = g('i_enable')\n        mode = g('i_mode')\n        clear = g('i_clear')\n        a_in = g('i_operand_a') & 0xFF\n        b_in = g('i_operand_b') & 0xFF\n\n        if rst_n == 0:\n            state = 0\n            a_reg = 0\n            b_reg = 0\n            res = 0\n            ov = 0\n\n        results.append({\n            'o_resultant_sum': res & 0xFF,\n            'o_overflow': ov & 1,\n            'o_ready': 1 if state == 3 else 0,\n            'o_status': state & 3\n        })\n\n        if rst_n != 0 and is_pos:\n            if clear:\n                state = 0\n                a_reg = 0\n                b_reg = 0\n                res = 0\n                ov = 0\n            else:\n                if state == 0:\n                    if enable and start:\n                        state = 1\n                elif state == 1:\n                    a_reg = a_in\n                    b_reg = b_in\n                    state = 2\n                elif state == 2:\n                    a = a_reg\n                    b = b_reg\n                    if mode == 0:\n                        s = (a + b) & 0xFF\n                        sa = (a >> 7) & 1\n                        sb = (b >> 7) & 1\n                        sr = (s >> 7) & 1\n                        ov = 1 if (sa == sb and sr != sa) else 0\n                        res = s\n                    else:\n                        d = (a - b) & 0xFF\n                        sa = (a >> 7) & 1\n                        sb = (b >> 7) & 1\n                        sr = (d >> 7) & 1\n                        ov = 1 if (sa != sb and sr != sa) else 0\n                        res = d\n                    state = 3\n                elif state == 3:\n                    state = 0\n\n    return results\n",
  "TB": [
