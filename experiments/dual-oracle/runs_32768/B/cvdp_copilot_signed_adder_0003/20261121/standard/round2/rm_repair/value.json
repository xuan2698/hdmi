"def reference(vectors):\n    st = 0\n    a_reg = b_reg = 0\n    res = 0\n    ov = 0\n    out = []\n    prev_clk = 0\n    for idx, row in enumerate(vectors):\n        if isinstance(row, dict) and 'edge' in row:\n            edge = row['edge']\n        elif isinstance(row, dict) and 'i_clk' in row:\n            clk = int(row.get('i_clk', 0) or 0)\n            if idx == 0:\n                edge = 'posedge' if clk else 'negedge'\n            else:\n                if prev_clk == 0 and clk == 1:\n                    edge = 'posedge'\n                elif prev_clk == 1 and clk == 0:\n                    edge = 'negedge'\n                else:\n                    edge = 'posedge' if idx % 2 == 0 else 'negedge'\n            prev_clk = clk\n        else:\n            edge = 'posedge' if idx % 2 == 0 else 'negedge'\n\n        if isinstance(edge, str):\n            s = edge.lower()\n            is_pos = ('posedge' in s) or s in ('pos', 'p', '1', 'rise')\n        else:\n            is_pos = bool(edge)\n\n        def g(name):\n            if isinstance(row, dict):\n                v = row.get(name, 0)\n                try:\n                    return int(v)\n                except Exception:\n                    return 0\n            return 0\n\n        rst_n = g('i_rst_n')\n        start = g('i_start')\n        enable = g('i_enable')\n        mode = g('i_mode')\n        clear = g('i_clear')\n        a_in = g('i_operand_a') & 0xFF\n        b_in = g('i_operand_b') & 0xFF\n\n        if rst_n == 0:\n            st = 0\n            a_reg = 0\n            b_reg = 0\n            res = 0\n            ov = 0\n\n        out.append({\n            'o_resultant_sum': res & 0xFF,\n            'o_overflow': ov & 1,\n            'o_ready': 1 if st == 3 else 0,\n            'o_status': st & 3\n        })\n\n        if rst_n != 0 and is_pos:\n            if clear:\n                st = 0\n                a_reg = 0\n                b_reg = 0\n                res = 0\n                ov = 0\n            elif not enable:\n                st = 0\n            else:\n                if st == 0:\n                    if start:\n                        st = 1\n                elif st == 1:\n                    a_reg = a_in\n                    b_reg = b_in\n                    st = 2\n                elif st == 2:\n                    a = a_reg\n                    b = b_reg\n                    if mode == 0:\n                        s = (a + b) & 0xFF\n                        sa = (a >> 7) & 1\n                        sb = (b >> 7) & 1\n                        sr = (s >> 7) & 1\n                        ov = 1 if (sa == sb and sr != sa) else 0\n                        res = s\n                    else:\n                        d = (a - b) & 0xFF\n                        sa = (a >> 7) & 1\n                        sb = (b >> 7) & 1\n                        sr = (d >> 7) & 1\n                        ov = 1 if (sa != sb and sr != sa) else 0\n                        res = d\n                    st = 3\n                elif st == 3:\n                    st = 0\n\n    return out\n"
