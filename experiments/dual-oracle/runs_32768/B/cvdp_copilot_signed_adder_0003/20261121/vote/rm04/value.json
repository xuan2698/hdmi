"def reference(vectors):\n    state = 0\n    a_reg = 0\n    b_reg = 0\n    o_resultant_sum = 0\n    o_overflow = 0\n    outputs = []\n    for idx, row in enumerate(vectors):\n        if isinstance(row, dict):\n            i_rst_n = row.get('i_rst_n', 1)\n            i_start = row.get('i_start', 0)\n            i_enable = row.get('i_enable', 0)\n            i_mode = row.get('i_mode', 0)\n            i_clear = row.get('i_clear', 0)\n            i_operand_a = row.get('i_operand_a', 0)\n            i_operand_b = row.get('i_operand_b', 0)\n            if 'edge' in row:\n                edge_val = row['edge']\n            elif 'i_clk' in row:\n                edge_val = row['i_clk']\n            else:\n                edge_val = 1 if idx % 2 == 0 else 0\n        else:\n            i_rst_n = 1\n            i_start = 0\n            i_enable = 0\n            i_mode = 0\n            i_clear = 0\n            i_operand_a = 0\n            i_operand_b = 0\n            edge_val = 1 if idx % 2 == 0 else 0\n\n        if isinstance(edge_val, str):\n            s = edge_val.lower()\n            if 'pos' in s or 'rise' in s or s == '1':\n                is_posedge = True\n            else:\n                is_posedge = False\n        else:\n            is_posedge = bool(edge_val)\n\n        if i_rst_n == 0:\n            state = 0\n            a_reg = 0\n            b_reg = 0\n            o_resultant_sum = 0\n            o_overflow = 0\n\n        o_status = state\n        o_ready = 1 if state == 3 else 0\n        outputs.append({\n            'o_resultant_sum': o_resultant_sum & 0xFF,\n            'o_overflow': o_overflow & 1,\n            'o_ready': o_ready,\n            'o_status': o_status\n        })\n\n        if is_posedge and i_rst_n == 1:\n            if i_clear == 1:\n                state = 0\n                a_reg = 0\n                b_reg = 0\n                o_resultant_sum = 0\n                o_overflow = 0\n            else:\n                if state == 0:\n                    if i_enable == 1 and i_start == 1:\n                        state = 1\n                elif state == 1:\n                    a_reg = i_operand_a & 0xFF\n                    b_reg = i_operand_b & 0xFF\n                    state = 2\n                elif state == 2:\n                    if i_mode == 0:\n                        full = a_reg + b_reg\n                        result = full & 0xFF\n                        a_sign = (a_reg >> 7) & 1\n                        b_sign = (b_reg >> 7) & 1\n                        r_sign = (result >> 7) & 1\n                        ovf = 1 if (a_sign == b_sign and a_sign != r_sign) else 0\n                    else:\n                        full = a_reg - b_reg\n                        result = full & 0xFF\n                        a_sign = (a_reg >> 7) & 1\n                        b_sign = (b_reg >> 7) & 1\n                        r_sign = (result >> 7) & 1\n                        ovf = 1 if (a_sign != b_sign and a_sign != r_sign) else 0\n                    o_resultant_sum = result\n                    o_overflow = ovf\n                    state = 3\n                elif state == 3:\n                    state = 0\n    return outputs\n"
