"def reference(vectors):\n    IDLE, LOAD, COMPUTE, OUTPUT = 0, 1, 2, 3\n    state = IDLE\n    result_reg = 0\n    overflow_reg = 0\n    operand_a_reg = 0\n    operand_b_reg = 0\n    outputs = []\n\n    def to_signed(v):\n        return v - 256 if (v & 0x80) else v\n\n    for idx, row in enumerate(vectors):\n        rst_n = row.get('i_rst_n', 1)\n        start = row.get('i_start', 0)\n        enable = row.get('i_enable', 0)\n        mode = row.get('i_mode', 0)\n        clear = row.get('i_clear', 0)\n        a = row.get('i_operand_a', 0) & 0xFF\n        b = row.get('i_operand_b', 0) & 0xFF\n\n        if 'i_clk' in row:\n            clk = row['i_clk']\n            is_posedge = (clk == 1 or clk == '1')\n        elif 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                is_posedge = e.lower() in ('posedge', 'pos', 'p', '1', 'rising')\n            else:\n                is_posedge = (e == 1 or e == '1')\n        else:\n            is_posedge = (idx % 2 == 0)\n\n        if rst_n == 0:\n            state = IDLE\n            result_reg = 0\n            overflow_reg = 0\n            operand_a_reg = 0\n            operand_b_reg = 0\n\n        outputs.append({\n            'o_resultant_sum': result_reg & 0xFF,\n            'o_overflow': overflow_reg & 1,\n            'o_ready': 1 if state == OUTPUT else 0,\n            'o_status': state & 3\n        })\n\n        if is_posedge:\n            if rst_n == 0:\n                pass\n            elif clear == 1:\n                state = IDLE\n                result_reg = 0\n                overflow_reg = 0\n                operand_a_reg = 0\n                operand_b_reg = 0\n            else:\n                if state == IDLE:\n                    if enable == 1 and start == 1:\n                        state = LOAD\n                elif state == LOAD:\n                    operand_a_reg = a\n                    operand_b_reg = b\n                    state = COMPUTE\n                elif state == COMPUTE:\n                    sa = to_signed(operand_a_reg)\n                    sb = to_signed(operand_b_reg)\n                    if mode == 0:\n                        res = sa + sb\n                    else:\n                        res = sa - sb\n                    if res < -128 or res > 127:\n                        overflow_reg = 1\n                    else:\n                        overflow_reg = 0\n                    result_reg = res & 0xFF\n                    state = OUTPUT\n                elif state == OUTPUT:\n                    state = IDLE\n\n    return outputs\n"
