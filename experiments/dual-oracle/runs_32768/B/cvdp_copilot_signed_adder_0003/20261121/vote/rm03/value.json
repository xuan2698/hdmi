"def reference(vectors):\n    state = 0\n    result = 0\n    overflow = 0\n    op_a = 0\n    op_b = 0\n    out_list = []\n\n    for idx, row in enumerate(vectors):\n        edge = row.get('edge', None)\n        if edge is None:\n            edge = row.get('i_clk', None)\n        if edge is None:\n            posedge = (idx % 2 == 0)\n        else:\n            s = str(edge).lower()\n            if 'posedge' in s or s == '1' or s == 'true':\n                posedge = True\n            elif 'negedge' in s or s == '0' or s == 'false':\n                posedge = False\n            else:\n                posedge = (idx % 2 == 0)\n\n        rst_n = int(row.get('i_rst_n', 1)) & 1\n        clear = int(row.get('i_clear', 0)) & 1\n        enable = int(row.get('i_enable', 0)) & 1\n        start = int(row.get('i_start', 0)) & 1\n        mode = int(row.get('i_mode', 0)) & 1\n        a_in = int(row.get('i_operand_a', 0)) & 0xFF\n        b_in = int(row.get('i_operand_b', 0)) & 0xFF\n\n        if rst_n == 0:\n            state = 0\n            result = 0\n            overflow = 0\n            op_a = 0\n            op_b = 0\n        elif clear == 1:\n            state = 0\n            result = 0\n            overflow = 0\n            op_a = 0\n            op_b = 0\n\n        out_status = state & 3\n        out_ready = 1 if state == 3 else 0\n        out_sum = result & 0xFF\n        out_ov = overflow & 1\n\n        out_list.append({\n            'o_resultant_sum': out_sum,\n            'o_overflow': out_ov,\n            'o_ready': out_ready,\n            'o_status': out_status\n        })\n\n        if posedge and rst_n == 1 and clear == 0:\n            if enable == 0:\n                state = 0\n            else:\n                if state == 0:\n                    if start == 1:\n                        state = 1\n                elif state == 1:\n                    op_a = a_in\n                    op_b = b_in\n                    state = 2\n                elif state == 2:\n                    a_s = op_a - 256 if op_a >= 128 else op_a\n                    b_s = op_b - 256 if op_b >= 128 else op_b\n\n                    if mode == 0:\n                        full = a_s + b_s\n                    else:\n                        full = a_s - b_s\n\n                    result = full & 0xFF\n                    overflow = 1 if (full < -128 or full > 127) else 0\n                    state = 3\n                elif state == 3:\n                    state = 0\n\n    return out_list\n"
