{
  "decisions": [
    {
      "id": "s5/9/o_resultant_sum",
      "label": "RM",
      "source": "TB assumed correct per baseline"
    },
    {
      "id": "s5/9/o_ready",
      "label": "RM",
      "source": "TB assumed correct per baseline"
    },
    {
      "id": "s5/9/o_status",
      "label": "RM",
      "source": "TB assumed correct per baseline"
    }
  ],
  "RM": "def reference(vectors):\n    IDLE, LOAD, COMPUTE, OUTPUT = 0, 1, 2, 3\n    state = IDLE\n    a_reg = 0\n    b_reg = 0\n    res = 0\n    ov = 0\n    out = []\n\n    for idx, row in enumerate(vectors):\n        if isinstance(row, dict):\n            edge_val = row.get('edge', None)\n\n            def g(name):\n                try:\n                    return int(row.get(name, 0))\n                except Exception:\n                    return 0\n        else:\n            edge_val = None\n\n            def g(name):\n                return 0\n\n        if edge_val is None:\n            is_pos = (idx % 2 == 0)\n        else:\n            s = str(edge_val).lower()\n            is_pos = ('posedge' in s) or s in ('pos', 'p', '1', 'rise')\n\n        rst_n = g('i_rst_n')\n\n        if rst_n == 0:\n            state = IDLE\n            a_reg = 0\n            b_reg = 0\n            res = 0\n            ov = 0\n\n        out.append({\n            'o_resultant_sum': res & 0xFF,\n            'o_overflow': ov & 1,\n            'o_ready': 1 if state == OUTPUT else 0,\n            'o_status': state & 3\n        })\n\n        if rst_n != 0 and is_pos:\n            clear = g('i_clear')\n            enable = g('i_enable')\n            start = g('i_start')\n            mode = g('i_mode')\n\n            if clear:\n                state = IDLE\n                a_reg = 0\n                b_reg = 0\n                res = 0\n                ov = 0\n            elif not enable:\n                state = IDLE\n            else:\n                if state == IDLE:\n                    if start:\n                        state = LOAD\n                elif state == LOAD:\n                    a_reg = g('i_operand_a') & 0xFF\n                    b_reg = g('i_operand_b') & 0xFF\n                    state = COMPUTE\n                elif state == COMPUTE:\n                    a = a_reg\n                    b = b_reg\n\n                    if mode == 0:\n                        s = (a + b) & 0xFF\n                        sa = (a >> 7) & 1\n                        sb = (b >> 7) & 1\n                        sr = (s >> 7) & 1\n                        ov = 1 if (sa == sb and sr != sa) else 0\n                        res = s\n                    else:\n                        d = (a - b) & 0xFF\n                        sa = (a >> 7) & 1\n                        sb = (b >> 7) & 1\n                        sr = (d >> 7) & 1\n                        ov = 1 if (sa != sb and sr != sa) else 0\n                        res = d\n\n                    state = OUTPUT\n                elif state == OUTPUT:\n                    state = IDLE\n\n    return out\n",
