"def reference(vectors):\n    state = 0\n    opa = 0\n    opb = 0\n    res = 0\n    ov = 0\n    outs = []\n    for i, row in enumerate(vectors):\n        def g(k, d=0):\n            try:\n                return row.get(k, d)\n            except AttributeError:\n                return d\n\n        pos = (i % 2 == 0)\n        if isinstance(row, dict):\n            if 'edge' in row:\n                e = row['edge']\n                if isinstance(e, str):\n                    pos = e.lower() in ('posedge', 'p', '1', 'rise', 'rising')\n                else:\n                    pos = bool(e)\n            elif 'i_clk' in row:\n                pos = bool(row['i_clk'])\n\n        rst = g('i_rst_n', 1)\n        if rst == 0:\n            state = 0\n            opa = 0\n            opb = 0\n            res = 0\n            ov = 0\n\n        outs.append({\n            'o_resultant_sum': res & 0xFF,\n            'o_overflow': ov & 1,\n            'o_ready': 1 if state == 3 else 0,\n            'o_status': state & 3\n        })\n\n        if pos:\n            if rst == 0:\n                state = 0\n                opa = 0\n                opb = 0\n                res = 0\n                ov = 0\n            else:\n                if g('i_clear', 0):\n                    state = 0\n                    opa = 0\n                    opb = 0\n                    res = 0\n                    ov = 0\n                else:\n                    if state == 0:\n                        if g('i_enable', 0) and g('i_start', 0):\n                            state = 1\n                    elif state == 1:\n                        opa = g('i_operand_a', 0) & 0xFF\n                        opb = g('i_operand_b', 0) & 0xFF\n                        state = 2\n                    elif state == 2:\n                        a = opa\n                        b = opb\n                        a_s = a - 256 if (a & 0x80) else a\n                        b_s = b - 256 if (b & 0x80) else b\n                        mode = g('i_mode', 0) & 1\n                        if mode == 0:\n                            full = a_s + b_s\n                        else:\n                            full = a_s - b_s\n                        rr = full & 0xFF\n                        rr_s = rr - 256 if (rr & 0x80) else rr\n                        sa = 1 if a_s < 0 else 0\n                        sb = 1 if b_s < 0 else 0\n                        sr = 1 if rr_s < 0 else 0\n                        if mode == 0:\n                            o = 1 if (sa == sb and sr != sa) else 0\n                        else:\n                            o = 1 if (sa != sb and sr != sa) else 0\n                        res = rr\n                        ov = o\n                        state = 3\n                    elif state == 3:\n                        state = 0\n                    else:\n                        state = 0\n    return outs\n"
