"def reference(vectors):\n    W = 8\n    MASK = (1 << W) - 1\n    HALF = 1 << (W - 1)\n\n    def to_signed(v):\n        v &= MASK\n        return v - (1 << W) if v >= HALF else v\n\n    state = 0  # 0: IDLE, 1: LOAD, 2: COMPUTE, 3: OUTPUT\n    a_reg = 0\n    b_reg = 0\n    result_reg = 0\n    overflow_reg = 0\n    out = []\n    prev_clk = None\n\n    for idx, row in enumerate(vectors):\n        rst_n = row.get('i_rst_n', 1)\n        enable = row.get('i_enable', 0)\n        start = row.get('i_start', 0)\n        mode = row.get('i_mode', 0)\n        clear = row.get('i_clear', 0)\n        op_a = row.get('i_operand_a', 0) & MASK\n        op_b = row.get('i_operand_b', 0) & MASK\n\n        # Determine edge type\n        if 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                es = e.lower()\n                edge = 'posedge' if ('pos' in es or es in ('1', 'p', 'rise')) else 'negedge'\n            else:\n                edge = 'posedge' if e in (1, True) else 'negedge'\n        elif 'i_clk' in row:\n            edge = 'posedge' if row['i_clk'] == 1 else 'negedge'\n        else:\n            edge = 'posedge' if (idx % 2 == 0) else 'negedge'\n\n        # Asynchronous reset applied before output sampling\n        if rst_n == 0:\n            state = 0\n            a_reg = 0\n            b_reg = 0\n            result_reg = 0\n            overflow_reg = 0\n\n        # Sample outputs before registered NBA updates\n        out.append({\n            'o_resultant_sum': result_reg & MASK,\n            'o_overflow': overflow_reg & 1,\n            'o_ready': 1 if state == 3 else 0,\n            'o_status': state & 3,\n        })\n\n        # Active reset prevents synchronous updates\n        if rst_n == 0:\n            if 'i_clk' in row:\n                prev_clk = row['i_clk']\n            continue\n\n        # Synchronous updates at posedge\n        if edge == 'posedge':\n            if clear:\n                state = 0\n                a_reg = 0\n                b_reg = 0\n                result_reg = 0\n                overflow_reg = 0\n            else:\n                if state == 0:  # IDLE\n                    if enable and start:\n                        state = 1  # LOAD\n                elif state == 1:  # LOAD\n                    a_reg = op_a\n                    b_reg = op_b\n                    state = 2  # COMPUTE\n                elif state == 2:  # COMPUTE\n                    sa = to_signed(a_reg)\n                    sb = to_signed(b_reg)\n                    full = sa + sb if mode == 0 else sa - sb\n                    result_reg = full & MASK\n                    overflow_reg = 1 if (full < -HALF or full > HALF - 1) else 0\n                    state = 3  # OUTPUT\n                elif state == 3:  # OUTPUT\n                    state = 0  # IDLE\n\n        if 'i_clk' in row:\n            prev_clk = row['i_clk']\n\n    return out\n"
