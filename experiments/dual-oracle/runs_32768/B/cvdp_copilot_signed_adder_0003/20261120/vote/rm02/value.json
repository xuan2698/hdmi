"def reference(vectors):\n    state = 0  # 0:IDLE, 1:LOAD, 2:COMPUTE, 3:OUTPUT\n    opa = 0\n    opb = 0\n    result = 0\n    overflow = 0\n    out = []\n    for idx, row in enumerate(vectors):\n        rst_n = row.get('i_rst_n', 1)\n        if rst_n == 0:\n            state = 0\n            opa = 0\n            opb = 0\n            result = 0\n            overflow = 0\n\n        out.append({\n            'o_resultant_sum': result & 0xFF,\n            'o_overflow': overflow & 1,\n            'o_ready': 1 if state == 3 else 0,\n            'o_status': state & 3\n        })\n\n        is_posedge = False\n        found = False\n        if 'edge' in row:\n            found = True\n            e = row['edge']\n            if isinstance(e, str):\n                if e.lower() in ('posedge', 'pos', '1'):\n                    is_posedge = True\n                elif e.lower() in ('negedge', 'neg', '0'):\n                    is_posedge = False\n            else:\n                if e == 1:\n                    is_posedge = True\n        elif 'i_clk' in row:\n            found = True\n            if row['i_clk'] == 1:\n                is_posedge = True\n        elif 'clk' in row:\n            found = True\n            if row['clk'] == 1:\n                is_posedge = True\n        if not found:\n            is_posedge = (idx % 2 == 0)\n\n        if is_posedge and rst_n != 0:\n            i_clear = row.get('i_clear', 0)\n            i_enable = row.get('i_enable', 0)\n            i_start = row.get('i_start', 0)\n            i_mode = row.get('i_mode', 0)\n            i_a = row.get('i_operand_a', 0) & 0xFF\n            i_b = row.get('i_operand_b', 0) & 0xFF\n\n            if i_clear:\n                state = 0\n                result = 0\n                overflow = 0\n            elif not i_enable:\n                state = 0\n            else:\n                if state == 0:\n                    if i_start:\n                        state = 1\n                elif state == 1:\n                    opa = i_a\n                    opb = i_b\n                    state = 2\n                elif state == 2:\n                    a = opa\n                    b = opb\n                    if i_mode == 0:\n                        res = (a + b) & 0xFF\n                        ov = 1 if (((a & 0x80) == (b & 0x80)) and ((res & 0x80) != (a & 0x80))) else 0\n                    else:\n                        res = (a - b) & 0xFF\n                        ov = 1 if (((a & 0x80) != (b & 0x80)) and ((res & 0x80) != (a & 0x80))) else 0\n                    result = res\n                    overflow = ov\n                    state = 3\n                elif state == 3:\n                    state = 0\n    return out\n"
