"def reference(vectors):\n    state = 0\n    result_reg = 0\n    overflow_reg = 0\n    a_reg = 0\n    b_reg = 0\n    outputs = []\n    for idx, row in enumerate(vectors):\n        rst_n = row.get('i_rst_n', 1)\n        start = row.get('i_start', 0)\n        enable = row.get('i_enable', 0)\n        mode = row.get('i_mode', 0)\n        clear = row.get('i_clear', 0)\n        op_a = row.get('i_operand_a', 0) & 0xFF\n        op_b = row.get('i_operand_b', 0) & 0xFF\n\n        if rst_n == 0:\n            state = 0\n            result_reg = 0\n            overflow_reg = 0\n            a_reg = 0\n            b_reg = 0\n\n        outputs.append({\n            'o_resultant_sum': result_reg & 0xFF,\n            'o_overflow': overflow_reg & 1,\n            'o_ready': 1 if state == 3 else 0,\n            'o_status': state & 3\n        })\n\n        if 'edge' in row:\n            e = row['edge']\n            if e == 'posedge' or e == 1 or e == '1':\n                is_posedge = True\n            elif e == 'negedge' or e == 0 or e == '0':\n                is_posedge = False\n            else:\n                is_posedge = (idx % 2 == 0)\n        else:\n            is_posedge = (idx % 2 == 0)\n\n        if is_posedge:\n            if rst_n == 0:\n                pass\n            elif clear == 1:\n                state = 0\n                result_reg = 0\n                overflow_reg = 0\n            elif enable == 0:\n                state = 0\n            else:\n                if state == 0:\n                    if start == 1:\n                        state = 1\n                elif state == 1:\n                    a_reg = op_a\n                    b_reg = op_b\n                    state = 2\n                elif state == 2:\n                    a_s = a_reg if a_reg < 128 else a_reg - 256\n                    b_s = b_reg if b_reg < 128 else b_reg - 256\n                    if mode == 0:\n                        res = a_s + b_s\n                    else:\n                        res = a_s - b_s\n                    if res < -128 or res > 127:\n                        ovf = 1\n                    else:\n                        ovf = 0\n                    result_reg = res & 0xFF\n                    overflow_reg = ovf\n                    state = 3\n                elif state == 3:\n                    state = 0\n    return outputs\n"
