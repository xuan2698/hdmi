"def reference(vectors):\n    state = 0\n    reg_a = 0\n    reg_b = 0\n    result = 0\n    overflow = 0\n    ready = 0\n    out_list = []\n    for idx, row in enumerate(vectors):\n        rst_n = row.get('i_rst_n', 1)\n        if rst_n == 0:\n            state = 0\n            reg_a = 0\n            reg_b = 0\n            result = 0\n            overflow = 0\n            ready = 0\n        out_list.append({\n            'o_resultant_sum': result & 0xFF,\n            'o_overflow': overflow & 1,\n            'o_ready': ready & 1,\n            'o_status': state & 3\n        })\n        if 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                pos = ('pos' in e.lower() or 'rise' in e.lower())\n            else:\n                pos = (e == 1 or e is True)\n        elif 'i_clk' in row:\n            pos = (row['i_clk'] == 1)\n        else:\n            pos = (idx % 2 == 0)\n        if rst_n == 0:\n            continue\n        if pos:\n            i_clear = row.get('i_clear', 0)\n            if i_clear == 1:\n                state = 0\n                reg_a = 0\n                reg_b = 0\n                result = 0\n                overflow = 0\n                ready = 0\n            else:\n                i_enable = row.get('i_enable', 0)\n                if i_enable == 0:\n                    state = 0\n                    ready = 0\n                else:\n                    if state == 0:\n                        ready = 0\n                        i_start = row.get('i_start', 0)\n                        if i_start == 1:\n                            state = 1\n                    elif state == 1:\n                        reg_a = row.get('i_operand_a', 0) & 0xFF\n                        reg_b = row.get('i_operand_b', 0) & 0xFF\n                        state = 2\n                    elif state == 2:\n                        a_val = reg_a\n                        b_val = reg_b\n                        a_signed = a_val - 0x100 if (a_val & 0x80) else a_val\n                        b_signed = b_val - 0x100 if (b_val & 0x80) else b_val\n                        i_mode = row.get('i_mode', 0)\n                        if i_mode == 1:\n                            val = a_signed - b_signed\n                        else:\n                            val = a_signed + b_signed\n                        ov = 1 if (val < -128 or val > 127) else 0\n                        result = val & 0xFF\n                        overflow = ov\n                        ready = 1\n                        state = 3\n                    elif state == 3:\n                        ready = 0\n                        state = 0\n    return out_list\n"
