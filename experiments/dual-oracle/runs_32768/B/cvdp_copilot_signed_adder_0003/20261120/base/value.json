"def reference(vectors):\n    M = (1 << 8) - 1\n    IDLE, LOAD, COMPUTE, OUTPUT = 0, 1, 2, 3\n\n    st = IDLE\n    a_reg = 0\n    b_reg = 0\n    res = 0\n    ov = 0\n    prev_clk = 0\n    out = []\n\n    for idx, row in enumerate(vectors):\n        def g(name, default=0):\n            if isinstance(row, dict):\n                return row.get(name, default)\n            if isinstance(row, (list, tuple)):\n                if len(row) >= 8:\n                    mp = {\n                        'i_clk': 0, 'i_rst_n': 1, 'i_start': 2, 'i_enable': 3,\n                        'i_mode': 4, 'i_clear': 5, 'i_operand_a': 6, 'i_operand_b': 7\n                    }\n                else:\n                    mp = {\n                        'i_rst_n': 0, 'i_start': 1, 'i_enable': 2,\n                        'i_mode': 3, 'i_clear': 4, 'i_operand_a': 5, 'i_operand_b': 6\n                    }\n                pos = mp.get(name)\n                if pos is not None and pos < len(row):\n                    return row[pos]\n            return default\n\n        rst = g('i_rst_n', 1)\n\n        if rst == 0:\n            st = IDLE\n            a_reg = 0\n            b_reg = 0\n            res = 0\n            ov = 0\n\n        is_pos = None\n        if isinstance(row, dict) and 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                is_pos = ('pos' in e.lower())\n            else:\n                is_pos = (e == 1)\n        else:\n            clk = g('i_clk', None)\n            if clk is not None:\n                is_pos = (clk == 1 and prev_clk == 0)\n                prev_clk = clk\n            else:\n                is_pos = (idx % 2 == 0)\n                prev_clk = 1 if is_pos else 0\n\n        out.append({\n            'o_resultant_sum': res & M,\n            'o_overflow': ov & 1,\n            'o_ready': 1 if st == OUTPUT else 0,\n            'o_status': st & 3\n        })\n\n        if is_pos:\n            if rst == 0:\n                st = IDLE\n                a_reg = 0\n                b_reg = 0\n                res = 0\n                ov = 0\n            elif g('i_clear', 0) == 1:\n                st = IDLE\n                a_reg = 0\n                b_reg = 0\n                res = 0\n                ov = 0\n            else:\n                if st == IDLE:\n                    if g('i_enable', 0) == 1 and g('i_start', 0) == 1:\n                        st = LOAD\n                    else:\n                        st = IDLE\n                elif st == LOAD:\n                    a_reg = g('i_operand_a', 0) & M\n                    b_reg = g('i_operand_b', 0) & M\n                    st = COMPUTE\n                elif st == COMPUTE:\n                    a = a_reg - 256 if (a_reg & 0x80) else a_reg\n                    b = b_reg - 256 if (b_reg & 0x80) else b_reg\n                    if g('i_mode', 0) == 1:\n                        full = a - b\n                    else:\n                        full = a + b\n                    res = full & M\n                    ov = 1 if (full < -128 or full > 127) else 0\n                    st = OUTPUT\n                elif st == OUTPUT:\n                    st = IDLE\n\n    return out\n"
