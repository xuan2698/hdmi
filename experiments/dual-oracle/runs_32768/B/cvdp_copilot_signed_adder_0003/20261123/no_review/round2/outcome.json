{
  "decisions": [
    {
      "id": "s5/7/o_status",
      "label": "RM",
      "spec_quote": "Immediately clears outputs and resets the state machine to **IDLE**."
    }
  ],
  "RM": "def reference(vectors):\n    def get(row, name, default=0):\n        if isinstance(row, dict):\n            if name in row:\n                return row[name]\n            if name.startswith('i_') and name[2:] in row:\n                return row[name[2:]]\n            lname = name.lower()\n            for k in row:\n                if isinstance(k, str) and k.lower() == lname:\n                    return row[k]\n            return default\n        if hasattr(row, name):\n            return getattr(row, name)\n        if name.startswith('i_') and hasattr(row, name[2:]):\n            return getattr(row, name[2:])\n        return default\n\n    def as_int(x, default=0):\n        if x is None:\n            return default\n        if isinstance(x, bool):\n            return 1 if x else 0\n        if isinstance(x, int):\n            return x\n        if isinstance(x, str):\n            s = x.strip().lower()\n            if s in ('true', 'high', '1'):\n                return 1\n            if s in ('false', 'low', '0'):\n                return 0\n            try:\n                return int(s, 0)\n            except:\n                return default\n        return default\n\n    def edge_is_pos(row):\n        e = get(row, 'edge', None)\n        if e is None:\n            clk = get(row, 'i_clk', None)\n            if clk is not None:\n                return as_int(clk, 0) != 0\n            return True\n        if isinstance(e, str):\n            s = e.strip().lower()\n            if 'pos' in s or 'ris' in s or 'rise' in s:\n                return True\n            if 'neg' in s or 'fall' in s:\n                return False\n            if s in ('1', 'true', 'high'):\n                return True\n            if s in ('0', 'false', 'low'):\n                return False\n            return True\n        if isinstance(e, bool):\n            return e\n        if isinstance(e, int):\n            return e != 0\n        return True\n\n    if isinstance(vectors, dict):\n        if 'vectors' in vectors:\n            vectors = vectors['vectors']\n        elif any(k in vectors for k in ('edge', 'i_rst_n', 'i_clk', 'i_enable')):\n            vectors = [vectors]\n\n    state = 0\n    a_reg = 0\n    b_reg = 0\n    result = 0\n    overflow = 0\n    out_rows = []\n\n    for row in vectors:\n        rst = as_int(get(row, 'i_rst_n', 1), 1)\n        clear = as_int(get(row, 'i_clear', 0), 0)\n        start = as_int(get(row, 'i_start', 0), 0)\n        enable = as_int(get(row, 'i_enable', 0), 0)\n        mode = as_int(get(row, 'i_mode', 0), 0)\n        a_in = as_int(get(row, 'i_operand_a', 0), 0) & 0xFF\n        b_in = as_int(get(row, 'i_operand_b', 0), 0) & 0xFF\n        pos = edge_is_pos(row)\n\n        async_ctrl = False\n        if rst == 0:\n            state = 0\n            a_reg = 0\n            b_reg = 0\n            result = 0\n            overflow = 0\n            async_ctrl = True\n        elif clear != 0:\n            state = 0\n            a_reg = 0\n            b_reg = 0\n            result = 0\n            overflow = 0\n            async_ctrl = True\n\n        out_rows.append({\n            'o_resultant_sum': result & 0xFF,\n            'o_overflow': overflow & 1,\n            'o_ready': 1 if state == 3 else 0,\n            'o_status': state & 3\n        })\n\n        if pos and not async_ctrl:\n            if enable == 0:\n                state = 0\n            else:\n                if state == 0:\n                    if start != 0:\n                        state = 1\n                elif state == 1:\n                    a_reg = a_in\n                    b_reg = b_in\n                    state = 2\n                elif state == 2:\n                    if mode & 1:\n                        res = (a_reg - b_reg) & 0xFF\n                        sa = (a_reg >> 7) & 1\n                        sb = (b_reg >> 7) & 1\n                        sr = (res >> 7) & 1\n                        overflow = 1 if (sa != sb and sr != sa) else 0\n                        result = res\n                    else:\n                        res = (a_reg + b_reg) & 0xFF\n                        sa = (a_reg >> 7) & 1\n                        sb = (b_reg >> 7) & 1\n                        sr = (res >> 7) & 1\n                        overflow = 1 if (sa == sb and sr != sa) else 0\n                        result = res\n                    state = 3\n                elif state == 3:\n                    state = 0\n\n    return out_rows\n",
