"def reference(vectors):\n    state = 0\n    a_reg = 0\n    b_reg = 0\n    result = 0\n    overflow = 0\n    outputs = []\n\n    for row in vectors:\n        edge = row.get('edge', None)\n        if edge is None:\n            clk = row.get('i_clk', 1)\n            posedge = (clk == 1 or clk == '1' or clk is True)\n        else:\n            if isinstance(edge, str):\n                posedge = edge.lower().startswith('pos') or edge == '1'\n            else:\n                posedge = bool(edge)\n\n        rst_n = row.get('i_rst_n', 1)\n        start = row.get('i_start', 0)\n        enable = row.get('i_enable', 0)\n        mode = row.get('i_mode', 0)\n        clear = row.get('i_clear', 0)\n        opa = row.get('i_operand_a', 0) & 0xFF\n        opb = row.get('i_operand_b', 0) & 0xFF\n\n        if rst_n == 0:\n            state = 0\n            a_reg = 0\n            b_reg = 0\n            result = 0\n            overflow = 0\n\n        outputs.append({\n            'o_resultant_sum': result & 0xFF,\n            'o_overflow': overflow & 1,\n            'o_ready': 1 if state == 3 else 0,\n            'o_status': state & 3\n        })\n\n        if posedge:\n            if rst_n == 0:\n                state = 0\n                a_reg = 0\n                b_reg = 0\n                result = 0\n                overflow = 0\n            elif clear:\n                state = 0\n                result = 0\n                overflow = 0\n            elif enable == 0:\n                state = 0\n            else:\n                if state == 0:\n                    if start:\n                        state = 1\n                elif state == 1:\n                    a_reg = opa\n                    b_reg = opb\n                    state = 2\n                elif state == 2:\n                    av = a_reg - 256 if a_reg >= 128 else a_reg\n                    bv = b_reg - 256 if b_reg >= 128 else b_reg\n                    if mode == 1:\n                        val = av - bv\n                    else:\n                        val = av + bv\n                    result = val & 0xFF\n                    overflow = 1 if (val < -128 or val > 127) else 0\n                    state = 3\n                elif state == 3:\n                    state = 0\n\n    return outputs\n"
