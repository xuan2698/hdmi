"def reference(vectors):\n    IDLE, LOAD, COMPUTE, OUTPUT = 0, 1, 2, 3\n    state = IDLE\n    a_reg = 0\n    b_reg = 0\n    result = 0\n    overflow = 0\n    out = []\n\n    for idx, row in enumerate(vectors):\n        def get(name, default=0):\n            if isinstance(row, dict):\n                return int(row.get(name, default))\n            return default\n\n        rst_n = get('i_rst_n', 1)\n\n        if rst_n == 0:\n            state = IDLE\n            a_reg = 0\n            b_reg = 0\n            result = 0\n            overflow = 0\n\n        out.append({\n            'o_resultant_sum': result & 0xFF,\n            'o_overflow': overflow & 1,\n            'o_ready': 1 if state == OUTPUT else 0,\n            'o_status': state & 3\n        })\n\n        is_posedge = (idx % 2 == 0)\n\n        if is_posedge and rst_n != 0:\n            clear = get('i_clear', 0)\n\n            if clear:\n                state = IDLE\n                a_reg = 0\n                b_reg = 0\n                result = 0\n                overflow = 0\n            else:\n                if state == IDLE:\n                    if get('i_enable', 0) and get('i_start', 0):\n                        state = LOAD\n                elif state == LOAD:\n                    a_reg = get('i_operand_a', 0) & 0xFF\n                    b_reg = get('i_operand_b', 0) & 0xFF\n                    state = COMPUTE\n                elif state == COMPUTE:\n                    av = a_reg & 0xFF\n                    bv = b_reg & 0xFF\n                    av_s = av - 256 if av >= 128 else av\n                    bv_s = bv - 256 if bv >= 128 else bv\n\n                    if get('i_mode', 0):\n                        full = av_s - bv_s\n                    else:\n                        full = av_s + bv_s\n\n                    result = full & 0xFF\n                    overflow = 1 if (full < -128 or full > 127) else 0\n                    state = OUTPUT\n                elif state == OUTPUT:\n                    state = IDLE\n\n    return out\n"
