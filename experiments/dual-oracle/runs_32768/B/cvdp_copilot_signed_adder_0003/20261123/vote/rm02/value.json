"def reference(vectors):\n    state = 0\n    a_reg = 0\n    b_reg = 0\n    result = 0\n    overflow = 0\n    outs = []\n    for idx, row in enumerate(vectors):\n        def get(k, d=0):\n            return row.get(k, d) if isinstance(row, dict) else d\n\n        rst = get('i_rst_n', 1) & 1\n        if rst == 0:\n            state = 0\n            a_reg = 0\n            b_reg = 0\n            result = 0\n            overflow = 0\n\n        ev = None\n        if isinstance(row, dict):\n            for k in ('edge', 'i_edge', 'clk_edge', 'edge_type'):\n                if k in row:\n                    ev = row[k]\n                    break\n\n        if ev is None:\n            clk = get('i_clk', None)\n            if clk is not None:\n                if isinstance(clk, str):\n                    is_pos = ('pos' in clk.lower())\n                else:\n                    is_pos = (clk == 1)\n            else:\n                is_pos = (idx % 2 == 0)\n        else:\n            if isinstance(ev, str):\n                is_pos = ('pos' in ev.lower())\n            else:\n                is_pos = (ev == 1)\n\n        outs.append({\n            'o_resultant_sum': result & 0xff,\n            'o_overflow': overflow & 1,\n            'o_ready': 1 if state == 3 else 0,\n            'o_status': state & 3\n        })\n\n        if is_pos and rst != 0:\n            clear = get('i_clear', 0) & 1\n            enable = get('i_enable', 0) & 1\n            start = get('i_start', 0) & 1\n            mode = get('i_mode', 0) & 1\n\n            if clear:\n                state = 0\n                a_reg = 0\n                b_reg = 0\n                result = 0\n                overflow = 0\n            else:\n                if state == 0:\n                    if enable and start:\n                        state = 1\n                elif state == 1:\n                    a_reg = get('i_operand_a', 0) & 0xff\n                    b_reg = get('i_operand_b', 0) & 0xff\n                    state = 2\n                elif state == 2:\n                    sa = a_reg - 256 if (a_reg & 0x80) else a_reg\n                    sb = b_reg - 256 if (b_reg & 0x80) else b_reg\n                    full = (sa - sb) if mode else (sa + sb)\n                    res_u = full & 0xff\n                    a_sign = (a_reg >> 7) & 1\n                    b_sign = (b_reg >> 7) & 1\n                    r_sign = (res_u >> 7) & 1\n                    if mode:\n                        overflow = 1 if (a_sign != b_sign and r_sign != a_sign) else 0\n                    else:\n                        overflow = 1 if (a_sign == b_sign and r_sign != a_sign) else 0\n                    result = res_u\n                    state = 3\n                elif state == 3:\n                    state = 0\n\n    return outs\n"
