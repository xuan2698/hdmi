"def reference(vectors):\n    IDLE, LOAD, COMPUTE, OUTPUT = 0, 1, 2, 3\n    W = 8\n    MASK = (1 << W) - 1\n    MINV = -(1 << (W - 1))\n    MAXV = (1 << (W - 1)) - 1\n\n    state = IDLE\n    a_reg = 0\n    b_reg = 0\n    result = 0\n    overflow = 0\n    out = []\n\n    for idx, row in enumerate(vectors):\n        rst_n = row.get('i_rst_n', 1)\n        start = row.get('i_start', 0)\n        enable = row.get('i_enable', 1)\n        mode = row.get('i_mode', 0)\n        clear = row.get('i_clear', 0)\n        opa = row.get('i_operand_a', 0) & MASK\n        opb = row.get('i_operand_b', 0) & MASK\n\n        if rst_n == 0:\n            state = IDLE\n            a_reg = 0\n            b_reg = 0\n            result = 0\n            overflow = 0\n\n        if 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                is_pos = ('pos' in e.lower()) or (e == '1')\n            else:\n                is_pos = (e == 1)\n        elif 'i_clk' in row:\n            is_pos = (row['i_clk'] == 1)\n        elif 'clk' in row:\n            is_pos = (row['clk'] == 1)\n        else:\n            is_pos = (idx % 2 == 0)\n\n        out.append({\n            'o_resultant_sum': result & MASK,\n            'o_overflow': overflow & 1,\n            'o_ready': 1 if state == OUTPUT else 0,\n            'o_status': state\n        })\n\n        if is_pos:\n            if rst_n == 0:\n                pass\n            elif clear == 1:\n                state = IDLE\n                a_reg = 0\n                b_reg = 0\n                result = 0\n                overflow = 0\n            elif enable == 0:\n                state = IDLE\n            else:\n                if state == IDLE:\n                    if start == 1:\n                        state = LOAD\n                elif state == LOAD:\n                    a_reg = opa\n                    b_reg = opb\n                    state = COMPUTE\n                elif state == COMPUTE:\n                    sa = a_reg if a_reg < (1 << (W - 1)) else a_reg - (1 << W)\n                    sb = b_reg if b_reg < (1 << (W - 1)) else b_reg - (1 << W)\n                    if mode == 1:\n                        s = sa - sb\n                    else:\n                        s = sa + sb\n                    result = s & MASK\n                    overflow = 1 if (s < MINV or s > MAXV) else 0\n                    state = OUTPUT\n                elif state == OUTPUT:\n                    state = IDLE\n\n    return out\n"
