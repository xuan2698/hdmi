"def reference(vectors):\n    state = 0\n    result = 0\n    overflow = 0\n    opa = 0\n    opb = 0\n    prev_clk = 0\n    outs = []\n    for idx, row in enumerate(vectors):\n        def gv(name, default=0):\n            if isinstance(row, dict):\n                return row.get(name, default)\n            if isinstance(row, (list, tuple)):\n                if len(row) == 8:\n                    mp = {'i_clk':0, 'i_rst_n':1, 'i_start':2, 'i_enable':3, 'i_mode':4, 'i_clear':5, 'i_operand_a':6, 'i_operand_b':7}\n                elif len(row) == 7:\n                    mp = {'i_rst_n':0, 'i_start':1, 'i_enable':2, 'i_mode':3, 'i_clear':4, 'i_operand_a':5, 'i_operand_b':6}\n                else:\n                    mp = {}\n                if name in mp and mp[name] < len(row):\n                    return row[mp[name]]\n                return default\n            return getattr(row, name, default)\n\n        clk = gv('i_clk', None)\n        rst = gv('i_rst_n', 1)\n        start = gv('i_start', 0)\n        enable = gv('i_enable', 1)\n        mode = gv('i_mode', 0)\n        clear = gv('i_clear', 0)\n        a = gv('i_operand_a', 0)\n        b = gv('i_operand_b', 0)\n\n        if clk is None:\n            posedge = (idx % 2 == 0)\n            negedge = not posedge\n        else:\n            posedge = (prev_clk == 0 and clk == 1)\n            negedge = (prev_clk == 1 and clk == 0)\n            prev_clk = clk\n\n        if rst == 0:\n            state = 0\n            result = 0\n            overflow = 0\n            opa = 0\n            opb = 0\n\n        outs.append({\n            'o_resultant_sum': result & 0xFF,\n            'o_overflow': overflow & 1,\n            'o_ready': 1 if state == 3 else 0,\n            'o_status': state & 3\n        })\n\n        if posedge and rst != 0:\n            if clear:\n                state = 0\n                result = 0\n                overflow = 0\n                opa = 0\n                opb = 0\n            elif enable == 0:\n                state = 0\n            else:\n                if state == 0:\n                    if start:\n                        state = 1\n                elif state == 1:\n                    opa = a & 0xFF\n                    opb = b & 0xFF\n                    state = 2\n                elif state == 2:\n                    a_s = opa if opa < 128 else opa - 256\n                    b_s = opb if opb < 128 else opb - 256\n                    if mode == 0:\n                        res_s = a_s + b_s\n                    else:\n                        res_s = a_s - b_s\n                    overflow = 1 if (res_s < -128 or res_s > 127) else 0\n                    result = res_s & 0xFF\n                    state = 3\n                elif state == 3:\n                    state = 0\n    return outs\n"
