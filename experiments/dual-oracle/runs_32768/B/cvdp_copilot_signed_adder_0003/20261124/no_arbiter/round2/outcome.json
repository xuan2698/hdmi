  "RM": "def reference(vectors):\n    IDLE, LOAD, COMPUTE, OUTPUT = 0, 1, 2, 3\n    state = IDLE\n    reg_a = 0\n    reg_b = 0\n    result = 0\n    ov = 0\n    prev = {\n        'i_rst_n': 1, 'i_start': 0, 'i_enable': 0, 'i_mode': 0,\n        'i_clear': 0, 'i_operand_a': 0, 'i_operand_b': 0\n    }\n    keys = ['i_rst_n', 'i_start', 'i_enable', 'i_mode', 'i_clear', 'i_operand_a', 'i_operand_b']\n    outs = []\n    for idx, row in enumerate(vectors):\n        edge = None\n        if isinstance(row, dict):\n            for k in prev:\n                if k in row:\n                    prev[k] = row[k]\n            if 'edge' in row:\n                e = row['edge']\n                if isinstance(e, str):\n                    if 'pos' in e.lower():\n                        edge = 1\n                    elif 'neg' in e.lower():\n                        edge = 0\n                else:\n                    edge = 1 if e else 0\n            elif 'i_clk' in row:\n                edge = 1 if (row['i_clk'] & 1) else 0\n        elif isinstance(row, (list, tuple)):\n            for i, k in enumerate(keys):\n                if i < len(row):\n                    prev[k] = row[i]\n            if len(row) > len(keys):\n                e = row[len(keys)]\n                if isinstance(e, str):\n                    if 'pos' in e.lower():\n                        edge = 1\n                    elif 'neg' in e.lower():\n                        edge = 0\n                else:\n                    edge = 1 if e else 0\n        if edge is None:\n            edge = 1 if (idx % 2 == 0) else 0\n        rst_n = prev['i_rst_n'] & 1\n        start = prev['i_start'] & 1\n        enable = prev['i_enable'] & 1\n        mode = prev['i_mode'] & 1\n        clear = prev['i_clear'] & 1\n        a = prev['i_operand_a'] & 255\n        b = prev['i_operand_b'] & 255\n        if rst_n == 0:\n            state = IDLE\n            reg_a = 0\n            reg_b = 0\n            result = 0\n            ov = 0\n        elif clear == 1:\n            state = IDLE\n            result = 0\n            ov = 0\n        outs.append({\n            'o_resultant_sum': result & 255,\n            'o_overflow': ov & 1,\n            'o_ready': 1 if state == OUTPUT else 0,\n            'o_status': state & 3\n        })\n        if rst_n == 0:\n            state = IDLE\n            reg_a = 0\n            reg_b = 0\n            result = 0\n            ov = 0\n            continue\n        if clear == 1:\n            state = IDLE\n            result = 0\n            ov = 0\n            continue\n        if edge == 1:\n            if enable == 0:\n                state = IDLE\n            elif state == IDLE:\n                if start == 1:\n                    state = LOAD\n            elif state == LOAD:\n                reg_a = a\n                reg_b = b\n                state = COMPUTE\n            elif state == COMPUTE:\n                sa = reg_a - 256 if reg_a >= 128 else reg_a\n                sb = reg_b - 256 if reg_b >= 128 else reg_b\n                if mode == 0:\n                    full = sa + sb\n                else:\n                    full = sa - sb\n                res_u = full & 255\n                sres = res_u - 256 if res_u >= 128 else res_u\n                if mode == 0:\n                    if (sa >= 0 and sb >= 0 and sres < 0) or (sa < 0 and sb < 0 and sres >= 0):\n                        ov_new = 1\n                    else:\n                        ov_new = 0\n                else:\n                    if (sa >= 0 and sb < 0 and sres < 0) or (sa < 0 and sb >= 0 and sres >= 0):\n                        ov_new = 1\n                    else:\n                        ov_new = 0\n                result = res_u\n                ov = ov_new\n                state = OUTPUT\n            elif state == OUTPUT:\n                state = IDLE\n    return outs\n",
