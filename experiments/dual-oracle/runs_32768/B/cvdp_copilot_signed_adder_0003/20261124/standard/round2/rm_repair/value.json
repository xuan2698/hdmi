"def reference(vectors):\n    state = 0\n    reg_a = 0\n    reg_b = 0\n    result = 0\n    ov = 0\n    cur = {\n        'i_rst_n': 1,\n        'i_start': 0,\n        'i_enable': 0,\n        'i_mode': 0,\n        'i_clear': 0,\n        'i_operand_a': 0,\n        'i_operand_b': 0\n    }\n    outs = []\n    keys = ['i_rst_n', 'i_start', 'i_enable', 'i_mode', 'i_clear', 'i_operand_a', 'i_operand_b']\n    bit_keys = {'i_rst_n', 'i_start', 'i_enable', 'i_mode', 'i_clear'}\n    for idx, row in enumerate(vectors):\n        edge = None\n        if isinstance(row, dict):\n            for k in keys:\n                if k in row:\n                    v = row[k]\n                    cur[k] = v & (1 if k in bit_keys else 255)\n            if 'edge' in row:\n                e = row['edge']\n                if isinstance(e, str):\n                    el = e.lower()\n                    if 'pos' in el:\n                        edge = 1\n                    elif 'neg' in el:\n                        edge = 0\n                else:\n                    edge = 1 if e else 0\n            elif 'i_clk' in row:\n                edge = 1 if (row['i_clk'] & 1) else 0\n        elif isinstance(row, (list, tuple)):\n            for i, k in enumerate(keys):\n                if i < len(row):\n                    v = row[i]\n                    if isinstance(v, int):\n                        cur[k] = v & (1 if k in bit_keys else 255)\n                    else:\n                        cur[k] = v\n            if len(row) > 7:\n                e = row[7]\n                if isinstance(e, str):\n                    el = e.lower()\n                    if 'pos' in el:\n                        edge = 1\n                    elif 'neg' in el:\n                        edge = 0\n                else:\n                    edge = 1 if e else 0\n        if edge is None:\n            edge = 1 if (idx % 2 == 0) else 0\n\n        rst_n = cur['i_rst_n'] & 1\n        start = cur['i_start'] & 1\n        enable = cur['i_enable'] & 1\n        mode = cur['i_mode'] & 1\n        clear = cur['i_clear'] & 1\n        a = cur['i_operand_a'] & 255\n        b = cur['i_operand_b'] & 255\n\n        if rst_n == 0:\n            state = 0\n            reg_a = 0\n            reg_b = 0\n            result = 0\n            ov = 0\n        elif clear == 1:\n            state = 0\n            result = 0\n            ov = 0\n\n        outs.append({\n            'o_resultant_sum': result & 255,\n            'o_overflow': ov & 1,\n            'o_ready': 1 if state == 3 else 0,\n            'o_status': state & 3\n        })\n\n        if rst_n == 0 or clear == 1:\n            continue\n\n        if edge == 1:\n            if enable == 0:\n                state = 0\n            elif state == 0:\n                if start == 1:\n                    state = 1\n            elif state == 1:\n                reg_a = a\n                reg_b = b\n                state = 2\n            elif state == 2:\n                sa = reg_a - 256 if reg_a >= 128 else reg_a\n                sb = reg_b - 256 if reg_b >= 128 else reg_b\n                if mode == 0:\n                    full = sa + sb\n                else:\n                    full = sa - sb\n                res_u = full & 255\n                sres = res_u - 256 if res_u >= 128 else res_u\n                if mode == 0:\n                    ov_new = 1 if ((sa >= 0 and sb >= 0 and sres < 0) or (sa < 0 and sb < 0 and sres >= 0)) else 0\n                else:\n                    ov_new = 1 if ((sa >= 0 and sb < 0 and sres < 0) or (sa < 0 and sb >= 0 and sres >= 0)) else 0\n                result = res_u\n                ov = ov_new\n                state = 3\n            elif state == 3:\n                state = 0\n    return outs\n"
