"def reference(vectors):\n    IDLE = 0\n    LOAD = 1\n    COMPUTE = 2\n    OUTPUT = 3\n    MASK = 0xFF\n\n    def to_signed(x):\n        x &= MASK\n        return x - 256 if x & 0x80 else x\n\n    state = IDLE\n    a_reg = 0\n    b_reg = 0\n    res_reg = 0\n    ov_reg = 0\n    out_list = []\n\n    for idx, row in enumerate(vectors):\n        rst_n = int(row.get('i_rst_n', 1))\n        clear = int(row.get('i_clear', 0))\n        enable = int(row.get('i_enable', 0))\n        start = int(row.get('i_start', 0))\n        mode = int(row.get('i_mode', 0))\n        opa = int(row.get('i_operand_a', 0)) & MASK\n        opb = int(row.get('i_operand_b', 0)) & MASK\n        clk = int(row.get('i_clk', 1 if idx % 2 == 0 else 0))\n\n        if rst_n == 0:\n            state = IDLE\n            a_reg = 0\n            b_reg = 0\n            res_reg = 0\n            ov_reg = 0\n\n        out_list.append({\n            'o_resultant_sum': res_reg & MASK,\n            'o_overflow': ov_reg & 1,\n            'o_ready': 1 if state == OUTPUT else 0,\n            'o_status': state & 3\n        })\n\n        if clk == 1:\n            if rst_n == 0:\n                pass\n            elif clear == 1:\n                state = IDLE\n                a_reg = 0\n                b_reg = 0\n                res_reg = 0\n                ov_reg = 0\n            else:\n                if state == IDLE:\n                    if enable == 1 and start == 1:\n                        state = LOAD\n                elif state == LOAD:\n                    a_reg = opa\n                    b_reg = opb\n                    state = COMPUTE\n                elif state == COMPUTE:\n                    sa = to_signed(a_reg)\n                    sb = to_signed(b_reg)\n                    if mode == 0:\n                        full_res = sa + sb\n                    else:\n                        full_res = sa - sb\n                    res_reg = full_res & MASK\n                    if full_res < -128 or full_res > 127:\n                        ov_reg = 1\n                    else:\n                        ov_reg = 0\n                    state = OUTPUT\n                elif state == OUTPUT:\n                    state = IDLE\n\n    return out_list\n"
