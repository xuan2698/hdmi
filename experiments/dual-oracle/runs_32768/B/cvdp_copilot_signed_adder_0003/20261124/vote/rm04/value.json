"def reference(vectors):\n    W = 8\n    mask = (1 << W) - 1\n    signbit = 1 << (W - 1)\n    state = 0\n    reg_a = 0\n    reg_b = 0\n    result = 0\n    overflow = 0\n    out = []\n    for idx, row in enumerate(vectors):\n        rst_n = row.get('i_rst_n', 1)\n        start = row.get('i_start', 0)\n        enable = row.get('i_enable', 0)\n        mode = row.get('i_mode', 0)\n        clear = row.get('i_clear', 0)\n        a_in = row.get('i_operand_a', 0)\n        b_in = row.get('i_operand_b', 0)\n        is_posedge = (idx % 2 == 0)\n\n        if rst_n == 0:\n            state = 0\n            reg_a = 0\n            reg_b = 0\n            result = 0\n            overflow = 0\n\n        out.append({\n            'o_resultant_sum': result & mask,\n            'o_overflow': overflow & 1,\n            'o_ready': 1 if state == 3 else 0,\n            'o_status': state & 3\n        })\n\n        if is_posedge and rst_n != 0:\n            if clear:\n                state = 0\n                result = 0\n                overflow = 0\n            elif enable == 0:\n                state = 0\n            else:\n                if state == 0:\n                    if start:\n                        state = 1\n                elif state == 1:\n                    reg_a = a_in & mask\n                    reg_b = b_in & mask\n                    state = 2\n                elif state == 2:\n                    a = reg_a & mask\n                    b = reg_b & mask\n                    a_s = a - (1 << W) if a & signbit else a\n                    b_s = b - (1 << W) if b & signbit else b\n                    if mode & 1:\n                        full = a_s - b_s\n                        res = full & mask\n                        res_s = res - (1 << W) if res & signbit else res\n                        ov = 1 if ((a_s >= 0 and b_s < 0 and res_s < 0) or\n                                   (a_s < 0 and b_s >= 0 and res_s >= 0)) else 0\n                    else:\n                        full = a_s + b_s\n                        res = full & mask\n                        res_s = res - (1 << W) if res & signbit else res\n                        ov = 1 if ((a_s >= 0 and b_s >= 0 and res_s < 0) or\n                                   (a_s < 0 and b_s < 0 and res_s >= 0)) else 0\n                    result = res & mask\n                    overflow = ov & 1\n                    state = 3\n                elif state == 3:\n                    state = 0\n    return out\n"
