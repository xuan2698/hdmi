"def reference(vectors):\n    state = 0\n    reg_a = 0\n    reg_b = 0\n    result = 0\n    overflow = 0\n    outputs = []\n    for idx, row in enumerate(vectors):\n        rst_n = row.get('i_rst_n', 1)\n        if rst_n == 0:\n            state = 0\n            reg_a = 0\n            reg_b = 0\n            result = 0\n            overflow = 0\n        out = {\n            'o_resultant_sum': result & 0xFF,\n            'o_overflow': overflow & 1,\n            'o_ready': 1 if state == 3 else 0,\n            'o_status': state & 3\n        }\n        outputs.append(out)\n        posedge = (idx % 2 == 0)\n        if posedge:\n            i_clear = row.get('i_clear', 0)\n            i_enable = row.get('i_enable', 0)\n            i_start = row.get('i_start', 0)\n            i_mode = row.get('i_mode', 0)\n            i_a = row.get('i_operand_a', 0) & 0xFF\n            i_b = row.get('i_operand_b', 0) & 0xFF\n            if rst_n == 0:\n                state = 0\n                reg_a = 0\n                reg_b = 0\n                result = 0\n                overflow = 0\n            elif i_clear:\n                state = 0\n                result = 0\n                overflow = 0\n            else:\n                if i_enable == 0:\n                    state = 0\n                else:\n                    if state == 0:\n                        if i_start:\n                            state = 1\n                    elif state == 1:\n                        reg_a = i_a\n                        reg_b = i_b\n                        state = 2\n                    elif state == 2:\n                        if i_mode == 0:\n                            raw = reg_a + reg_b\n                            a_sign = (reg_a >> 7) & 1\n                            b_sign = (reg_b >> 7) & 1\n                            res_sign = (raw >> 7) & 1\n                            ov = 1 if (a_sign == b_sign and res_sign != a_sign) else 0\n                        else:\n                            raw = reg_a - reg_b\n                            a_sign = (reg_a >> 7) & 1\n                            b_sign = (reg_b >> 7) & 1\n                            res_sign = (raw >> 7) & 1\n                            ov = 1 if (a_sign != b_sign and res_sign != a_sign) else 0\n                        result = raw & 0xFF\n                        overflow = ov\n                        state = 3\n                    elif state == 3:\n                        state = 0\n    return outputs\n"
