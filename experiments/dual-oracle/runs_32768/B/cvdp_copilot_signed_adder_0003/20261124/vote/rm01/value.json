"def reference(vectors):\n    state = 0\n    opa = 0\n    opb = 0\n    res = 0\n    ov = 0\n    outputs = []\n\n    for idx, row in enumerate(vectors):\n        if isinstance(row, dict):\n            rst = row.get('i_rst_n', 1)\n            start = row.get('i_start', 0)\n            en = row.get('i_enable', 0)\n            mode = row.get('i_mode', 0)\n            clear = row.get('i_clear', 0)\n            a_in = row.get('i_operand_a', 0) & 255\n            b_in = row.get('i_operand_b', 0) & 255\n            ev = row.get('edge', None)\n            if ev is None and 'i_clk' in row:\n                ev = row['i_clk']\n        else:\n            rst = 1\n            start = 0\n            en = 0\n            mode = 0\n            clear = 0\n            a_in = 0\n            b_in = 0\n            ev = None\n\n        if isinstance(ev, str):\n            s = ev.lower()\n            if 'pos' in s:\n                edge = 1\n            elif 'neg' in s:\n                edge = 0\n            else:\n                edge = 1 if idx % 2 == 0 else 0\n        elif ev is not None:\n            edge = 1 if (ev == 1 or ev is True) else 0\n        else:\n            edge = 1 if idx % 2 == 0 else 0\n\n        if rst == 0:\n            state = 0\n            opa = 0\n            opb = 0\n            res = 0\n            ov = 0\n        elif clear == 1:\n            state = 0\n            opa = 0\n            opb = 0\n            res = 0\n            ov = 0\n\n        outputs.append({\n            'o_resultant_sum': res & 255,\n            'o_overflow': ov & 1,\n            'o_ready': 1 if state == 3 else 0,\n            'o_status': state & 3\n        })\n\n        if edge == 1:\n            if rst == 0 or clear == 1:\n                pass\n            else:\n                if state == 0:\n                    if en == 1 and start == 1:\n                        state = 1\n                elif state == 1:\n                    opa = a_in\n                    opb = b_in\n                    state = 2\n                elif state == 2:\n                    sa = opa if opa < 128 else opa - 256\n                    sb = opb if opb < 128 else opb - 256\n                    if mode == 0:\n                        true_res = sa + sb\n                        bits = (opa + opb) & 255\n                    else:\n                        true_res = sa - sb\n                        bits = (opa - opb) & 255\n                    if true_res < -128 or true_res > 127:\n                        ov = 1\n                    else:\n                        ov = 0\n                    res = bits & 255\n                    state = 3\n                elif state == 3:\n                    state = 0\n\n    return outputs\n"
