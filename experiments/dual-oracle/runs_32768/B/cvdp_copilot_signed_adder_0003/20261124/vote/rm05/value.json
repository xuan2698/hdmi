"def reference(vectors):\n    state = 0\n    reg_a = 0\n    reg_b = 0\n    result = 0\n    overflow = 0\n    outputs = []\n\n    def get(row, key, default):\n        if isinstance(row, dict):\n            return row.get(key, default)\n        return default\n\n    for idx, row in enumerate(vectors):\n        rstn = get(row, 'i_rst_n', 1)\n        start = get(row, 'i_start', 0)\n        enable = get(row, 'i_enable', 0)\n        mode = get(row, 'i_mode', 0)\n        clear = get(row, 'i_clear', 0)\n        opa = get(row, 'i_operand_a', 0)\n        opb = get(row, 'i_operand_b', 0)\n\n        ev = None\n        if isinstance(row, dict):\n            if 'i_clk' in row:\n                ev = row['i_clk']\n            elif 'edge' in row:\n                ev = row['edge']\n\n        if ev is None:\n            posedge = (idx % 2 == 0)\n        elif isinstance(ev, str):\n            posedge = ev.lower() in ('posedge', 'pos', 'p', '1', 'rise', 'rising')\n        else:\n            posedge = (ev == 1)\n\n        if rstn == 0:\n            state = 0\n            reg_a = 0\n            reg_b = 0\n            result = 0\n            overflow = 0\n\n        outputs.append({\n            'o_resultant_sum': result & 0xFF,\n            'o_overflow': overflow & 1,\n            'o_ready': 1 if state == 3 else 0,\n            'o_status': state & 3\n        })\n\n        if posedge:\n            if rstn == 0:\n                state = 0\n                reg_a = 0\n                reg_b = 0\n                result = 0\n                overflow = 0\n            elif clear == 1:\n                state = 0\n                result = 0\n                overflow = 0\n            elif state == 0:\n                if enable == 1 and start == 1:\n                    state = 1\n            elif state == 1:\n                reg_a = opa & 0xFF\n                reg_b = opb & 0xFF\n                state = 2\n            elif state == 2:\n                a = reg_a\n                if a & 0x80:\n                    a -= 256\n                b = reg_b\n                if b & 0x80:\n                    b -= 256\n\n                if mode == 0:\n                    calc = a + b\n                else:\n                    calc = a - b\n\n                result = calc & 0xFF\n                overflow = 1 if (calc < -128 or calc > 127) else 0\n                state = 3\n            elif state == 3:\n                state = 0\n\n    return outputs\n"
