"def reference(vectors):\n    current = {\n        'i_rst_n': 0,\n        'i_start': 0,\n        'i_enable': 0,\n        'i_mode': 0,\n        'i_clear': 0,\n        'i_operand_a': 0,\n        'i_operand_b': 0\n    }\n    state = 0\n    a_reg = 0\n    b_reg = 0\n    result = 0\n    overflow = 0\n    outs = []\n    keys = ('i_rst_n', 'i_start', 'i_enable', 'i_mode', 'i_clear', 'i_operand_a', 'i_operand_b')\n    for idx, row in enumerate(vectors):\n        for k in keys:\n            if k in row:\n                current[k] = int(row[k])\n        pos = False\n        if 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                el = e.lower()\n                pos = el.startswith('pos') or el == 'p' or el == '1'\n            else:\n                pos = bool(e)\n        elif 'clk_edge' in row:\n            e = row['clk_edge']\n            if isinstance(e, str):\n                el = e.lower()\n                pos = el.startswith('pos') or el == 'p' or el == '1'\n            else:\n                pos = bool(e)\n        elif 'i_clk' in row:\n            pos = bool(int(row['i_clk']))\n        else:\n            pos = (idx % 2 == 0)\n        if current['i_rst_n'] == 0:\n            state = 0\n            a_reg = 0\n            b_reg = 0\n            result = 0\n            overflow = 0\n        outs.append({\n            'o_resultant_sum': result & 0xFF,\n            'o_overflow': overflow & 1,\n            'o_ready': 1 if state == 3 else 0,\n            'o_status': state & 3\n        })\n        if pos and current['i_rst_n'] == 1:\n            if current['i_clear'] == 1:\n                state = 0\n                result = 0\n                overflow = 0\n            else:\n                if state == 0:\n                    if current['i_enable'] == 1 and current['i_start'] == 1:\n                        state = 1\n                elif state == 1:\n                    a_reg = current['i_operand_a'] & 0xFF\n                    b_reg = current['i_operand_b'] & 0xFF\n                    state = 2\n                elif state == 2:\n                    a_s = a_reg if a_reg < 128 else a_reg - 256\n                    b_s = b_reg if b_reg < 128 else b_reg - 256\n                    if current['i_mode'] == 1:\n                        full = a_s - b_s\n                    else:\n                        full = a_s + b_s\n                    result = full & 0xFF\n                    overflow = 1 if (full < -128 or full > 127) else 0\n                    state = 3\n                elif state == 3:\n                    state = 0\n    return outs\n"
