    "source": "def reference(vectors):\n    out = 0\n    prev = 0\n    result = []\n    mask = 0xFFFFFFFF\n    for row in vectors:\n        reset = int(row['reset']) & 1\n        inp = int(row['in']) & mask\n        if reset:\n            out = 0\n        else:\n            out = (out | (prev & (~inp & mask))) & mask\n        prev = inp\n        result.append({'out': out})\n    return result\n"
