"def reference(vectors):\n    state = 0\n    result = []\n    for v in vectors:\n        reset = v.get('reset', 0)\n        inp = v.get('in', 0)\n        if reset:\n            state = 0\n        elif state == 0:\n            state = 1 if inp else 0\n        elif state == 1:\n            state = 2 if not inp else 1\n        elif state == 2:\n            state = 3 if inp else 0\n        else:\n            state = 2 if not inp else 1\n        result.append({'out': 1 if state == 3 else 0})\n    return result\n"
