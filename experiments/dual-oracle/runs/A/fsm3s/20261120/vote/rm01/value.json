"def reference(vectors):\n    state = 0\n    outputs = []\n    for row in vectors:\n        rst = int(row.get('reset', 0))\n        inp = int(row.get('in', 0))\n\n        if rst:\n            state = 0\n        elif state == 0:\n            state = 1 if inp else 0\n        elif state == 1:\n            state = 2 if inp == 0 else 1\n        elif state == 2:\n            state = 3 if inp else 0\n        else:\n            state = 1 if inp else 2\n\n        outputs.append({'out': 1 if state == 3 else 0})\n\n    return outputs\n"
