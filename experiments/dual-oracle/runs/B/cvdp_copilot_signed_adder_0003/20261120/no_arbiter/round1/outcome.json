  "RM": "def reference(vectors):\n    IDLE, LOAD, COMPUTE, OUTPUT = 0, 1, 2, 3\n    state = IDLE\n    result = 0\n    overflow = 0\n    a_reg = 0\n    b_reg = 0\n    prev_clk = 0\n    out = []\n\n    for idx, row in enumerate(vectors):\n        if 'edge' in row:\n            e = row['edge']\n            if isinstance(e, str):\n                el = e.lower()\n                pe = el.startswith('p') or el == '1' or el == 'true'\n            else:\n                pe = (e == 1 or e is True)\n        elif 'i_clk' in row:\n            clk = row.get('i_clk', 0)\n            pe = (prev_clk == 0 and clk == 1)\n            prev_clk = clk\n        else:\n            pe = (idx % 2 == 0)\n\n        rst = row.get('i_rst_n', 1)\n        clear = row.get('i_clear', 0)\n        en = row.get('i_enable', 0)\n        start = row.get('i_start', 0)\n        mode = row.get('i_mode', 0)\n        opa = row.get('i_operand_a', 0)\n        opb = row.get('i_operand_b', 0)\n\n        if rst == 0 or clear == 1:\n            state = IDLE\n            result = 0\n            overflow = 0\n            a_reg = 0\n            b_reg = 0\n        elif pe:\n            if en == 0:\n                state = IDLE\n            else:\n                if state == IDLE:\n                    if start == 1:\n                        state = LOAD\n                elif state == LOAD:\n                    a_reg = opa & 0xFF\n                    b_reg = opb & 0xFF\n                    state = COMPUTE\n                elif state == COMPUTE:\n                    a_s = a_reg - 256 if (a_reg & 0x80) else a_reg\n                    b_s = b_reg - 256 if (b_reg & 0x80) else b_reg\n\n                    if mode == 0:\n                        r = a_s + b_s\n                    else:\n                        r = a_s - b_s\n\n                    overflow = 1 if (r < -128 or r > 127) else 0\n                    result = r & 0xFF\n                    state = OUTPUT\n                elif state == OUTPUT:\n                    state = IDLE\n\n        out.append({\n            'o_resultant_sum': result & 0xFF,\n            'o_overflow': overflow & 1,\n            'o_ready': 1 if state == OUTPUT else 0,\n            'o_status': state & 3\n        })\n\n    return out\n",
