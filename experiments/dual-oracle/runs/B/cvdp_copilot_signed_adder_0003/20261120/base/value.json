"def reference(vectors):\n    state = 0\n    a_reg = 0\n    b_reg = 0\n    res_reg = 0\n    ov_reg = 0\n\n    def val(row, name, default=0):\n        if name in row:\n            v = row[name]\n            if isinstance(v, str):\n                try:\n                    return int(v, 0)\n                except:\n                    return 0\n            return int(v)\n        return default\n\n    def is_pos(edge):\n        if isinstance(edge, str):\n            s = edge.lower()\n            if 'pos' in s or s in ('1', 'p', 'rise', 'rising'):\n                return True\n            if 'neg' in s or s in ('0', 'n', 'fall', 'falling'):\n                return False\n            return False\n        return int(edge) == 1\n\n    outputs = []\n    for idx, row in enumerate(vectors):\n        rst_n = val(row, 'i_rst_n', 1)\n        start = val(row, 'i_start', 0)\n        enable = val(row, 'i_enable', 1)\n        mode = val(row, 'i_mode', 0)\n        clear = val(row, 'i_clear', 0)\n        opa = val(row, 'i_operand_a', 0) & 0xFF\n        opb = val(row, 'i_operand_b', 0) & 0xFF\n\n        if rst_n == 0:\n            state = 0\n            a_reg = 0\n            b_reg = 0\n            res_reg = 0\n            ov_reg = 0\n\n        outputs.append({\n            'o_resultant_sum': res_reg & 0xFF,\n            'o_overflow': ov_reg & 1,\n            'o_ready': 1 if state == 3 else 0,\n            'o_status': state & 3\n        })\n\n        if 'edge' in row:\n            posedge = is_pos(row['edge'])\n        else:\n            posedge = (idx % 2 == 0)\n\n        if not posedge:\n            continue\n\n        if rst_n == 0:\n            continue\n        if clear:\n            state = 0\n            a_reg = 0\n            b_reg = 0\n            res_reg = 0\n            ov_reg = 0\n        elif enable == 0:\n            state = 0\n        else:\n            if state == 0:\n                if start == 1:\n                    state = 1\n            elif state == 1:\n                a_reg = opa\n                b_reg = opb\n                state = 2\n            elif state == 2:\n                a_s = a_reg - 256 if (a_reg & 0x80) else a_reg\n                b_s = b_reg - 256 if (b_reg & 0x80) else b_reg\n                if mode == 1:\n                    full = a_s - b_s\n                else:\n                    full = a_s + b_s\n                res_reg = full & 0xFF\n                ov_reg = 1 if (full < -128 or full > 127) else 0\n                state = 3\n            elif state == 3:\n                state = 0\n            else:\n                state = 0\n\n    return outputs\n"
