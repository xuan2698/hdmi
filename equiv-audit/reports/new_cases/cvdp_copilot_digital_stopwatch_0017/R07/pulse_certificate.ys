read_verilog -sv -formal reference_transition.sv changed_transition.sv; proc; opt -keepdc; miter -equiv -ignore_gold_x -make_outputs -flatten reference_dig_stopwatch changed_dig_stopwatch pulse; hierarchy -top pulse; dffunmap; sat -seq 2 -enable_undef -set-def-inputs -set-init-undef -set in_start_stop 1 -set in_clk 0 -set in_reset 0 -prove-skip 1 -prove trigger 0 -show trigger -dump_json pulse_witness.json pulse
